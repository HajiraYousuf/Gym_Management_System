    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Receptionist Dashboard";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";
}

<!-- Main Dashboard Container -->
<div class="p-4 bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 font-sans min-h-screen transition-colors duration-300">

    <!-- Quick Actions Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-5 bg-white dark:bg-zinc-900 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm transition-colors duration-300">
        <div>
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Receptionist Dashboard</h2>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">Welcome back! Here is what's happening today.</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
            <button class="bg-lime-400 hover:bg-lime-300 text-black text-xs font-bold px-3.5 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                New Member
            </button>
            <button class="bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-white text-xs font-semibold px-3.5 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 transition flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4 text-lime-600 dark:text-lime-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Quick Check-in
            </button>
            <button class="bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-white text-xs font-semibold px-3.5 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 transition flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4 text-lime-600 dark:text-lime-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Record Payment
            </button>
        </div>
    </div>

    <!-- Row 1: Top 4 Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
        @{ 
            var statsCards = new[] {
                new { Title = "New Registrations", Value = "12", SubText = "Today", PercentageGrowth = "20%" },
                new { Title = "Today's Payments", Value = "$1,250", SubText = "Total Amount", PercentageGrowth = "15%" },
                new { Title = "Membership Renewals", Value = "8", SubText = "Today", PercentageGrowth = "10%" },
                new { Title = "Visitors Today", Value = "15", SubText = "Total Visitors", PercentageGrowth = "7%" }
            };

            foreach (var stat in statsCards) { 
                <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl flex flex-col justify-between shadow-sm transition-colors duration-300">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-wider">@stat.Title</p>
                            <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@stat.Value</h3>
                            <p class="text-xs text-zinc-400 mt-0.5">@stat.SubText</p>
                        </div>
                        <div class="p-2.5 bg-lime-500/10 rounded-lg text-lime-600 dark:text-lime-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                        </div>
                    </div>
                    <div class="text-xs text-lime-600 dark:text-lime-400 flex items-center mt-3 font-medium">
                        <span class="mr-1">↑</span> @stat.PercentageGrowth this week
                    </div>
                </div>
            }
        }
    </div>

    <!-- Row 2: Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Daily Registrations</h4>
                <select class="bg-zinc-100 dark:bg-zinc-800 text-xs text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 rounded px-2 py-1 focus:outline-none cursor-pointer">
                    <option>This Week</option>
                </select>
            </div>
            <div class="h-48 relative">
                <canvas id="dailyRegChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Payment Overview</h4>
            <div class="h-48 relative">
                <canvas id="paymentOverviewChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Membership Types</h4>
            <div class="h-48 relative">
                <canvas id="membershipTypesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Row 3: Operational Section (Table with Actions) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
        
        <!-- Expiring Soon Memberships -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl lg:col-span-2 shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Memberships Expiring Soon (3 Days)</h4>
                <a href="#" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">View All →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-zinc-400 border-b border-zinc-200 dark:border-zinc-800">
                            <th class="pb-2">Member Name</th>
                            <th class="pb-2">Phone</th>
                            <th class="pb-2">Plan</th>
                            <th class="pb-2">Expires In</th>
                            <th class="pb-2 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @{ 
                            var expiringMembers = new[] {
                                new { Name = "Saeed Jama", Phone = "0615554433", Plan = "Gold (1 Year)", Days = "1 Day", DaysColor = "text-red-500 bg-red-500/10" },
                                new { Name = "Hodman Khalid", Phone = "0618889900", Plan = "Silver (3 Months)", Days = "2 Days", DaysColor = "text-amber-500 bg-amber-500/10" },
                                new { Name = "Abdirahman Ali", Phone = "0622233445", Plan = "Basic (1 Month)", Days = "3 Days", DaysColor = "text-amber-500 bg-amber-500/10" }
                            };

                            foreach (var member in expiringMembers) {
                                <tr class="text-zinc-700 dark:text-zinc-300">
                                    <td class="py-2.5 font-medium text-zinc-900 dark:text-white">@member.Name</td>
                                    <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@member.Phone</td>
                                    <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@member.Plan</td>
                                    <td class="py-2.5">
                                        <span class="px-2 py-0.5 rounded text-xs font-semibold @member.DaysColor">
                                            @member.Days
                                        </span>
                                    </td>
                                    <td class="py-2.5 text-right flex justify-end gap-1.5">
                                        <button class="bg-lime-400 hover:bg-lime-300 text-black text-[11px] px-2.5 py-1 rounded font-bold transition cursor-pointer">Renew</button>
                                        <button class="bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 text-[11px] px-2 py-1 rounded transition cursor-pointer" title="Send Reminder">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Today's Schedule -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Today's Class Schedule</h4>
                <a href="#" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">Full Schedule →</a>
            </div>
            <div class="space-y-3">
                @{ 
                    var classes = new[] {
                        new { Name = "Morning Cardio & HIIT", Time = "07:00 AM - 08:30 AM", Trainer = "Coach Alex", Status = "Completed", StatusColor = "text-zinc-400 border-zinc-200 dark:border-zinc-800" },
                        new { Name = "CrossFit Beginners", Time = "04:30 PM - 05:30 PM", Trainer = "Coach Sarah", Status = "Upcoming", StatusColor = "text-lime-600 dark:text-lime-400 border-lime-500/30 bg-lime-500/5" },
                        new { Name = "Heavy Weightlifting", Time = "06:00 PM - 07:30 PM", Trainer = "Coach Hassan", Status = "Upcoming", StatusColor = "text-zinc-500 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800" }
                    };

                    foreach (var cls in classes) {
                        <div class="p-3 rounded-lg border @cls.StatusColor flex justify-between items-center transition-colors">
                            <div>
                                <p class="text-xs font-semibold text-zinc-900 dark:text-white">@cls.Name</p>
                                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">@cls.Time • @cls.Trainer</p>
                            </div>
                            <span class="text-[10px] font-bold uppercase tracking-wider">@cls.Status</span>
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <!-- Row 4: Tables Section with Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
        
        <!-- Recent Registrations -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Recent Registrations</h4>
                <a href="#" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">View All →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-zinc-400 border-b border-zinc-200 dark:border-zinc-800">
                            <th class="pb-2">Name</th>
                            <th class="pb-2">Phone</th>
                            <th class="pb-2">Membership</th>
                            <th class="pb-2">Date</th>
                            <th class="pb-2 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @{ 
                            var recentRegistrations = new[] {
                                new { Name = "Ahmed Hassan", Phone = "0612345678", MembershipType = "Gold", Color = "text-amber-500", Date = "19 May 2025" },
                                new { Name = "Fatima Ali", Phone = "0623456789", MembershipType = "Platinum", Color = "text-cyan-500", Date = "17 May 2025" },
                                new { Name = "Omar Farah", Phone = "0634567890", MembershipType = "Silver", Color = "text-zinc-500", Date = "19 May 2025" }
                            };

                            foreach (var reg in recentRegistrations) {
                                <tr class="text-zinc-700 dark:text-zinc-300">
                                    <td class="py-2.5 font-medium text-zinc-900 dark:text-white">@reg.Name</td>
                                    <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@reg.Phone</td>
                                    <td class="py-2.5"><span class="@reg.Color font-medium">@reg.MembershipType</span></td>
                                    <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@reg.Date</td>
                                    <td class="py-2.5 text-right">
                                        <button class="text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition font-medium cursor-pointer" title="View Profile">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Today's Payments -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Today's Payments</h4>
                <a href="#" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">View All →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-zinc-400 border-b border-zinc-200 dark:border-zinc-800">
                            <th class="pb-2">Member</th>
                            <th class="pb-2">Amount</th>
                            <th class="pb-2">Method</th>
                            <th class="pb-2">Status</th>
                            <th class="pb-2 text-right">Receipt</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @{ 
                            var todaysPayments = new[] {
                                new { MemberName = "Ahmed Hassan", Amount = "$150", Method = "Cash", Status = "Paid" },
                                new { MemberName = "Fatima Ali", Amount = "$200", Method = "Card", Status = "Paid" },
                                new { MemberName = "Hassan Yusuf", Amount = "$100", Method = "Card", Status = "Pending" }
                            };

                            foreach (var payment in todaysPayments) {
                                <tr class="text-zinc-700 dark:text-zinc-300">
                                    <td class="py-2.5 font-medium text-zinc-900 dark:text-white">@payment.MemberName</td>
                                    <td class="py-2.5 text-zinc-900 dark:text-white font-medium">@payment.Amount</td>
                                    <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@payment.Method</td>
                                    <td class="py-2.5">
                                        <span class='px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider @(payment.Status == "Paid" ? "bg-green-500/10 text-green-500" : "bg-amber-500/10 text-amber-500")'>
                                            @payment.Status
                                        </span>
                                    </td>
                                    <td class="py-2.5 text-right">
                                        <button class="text-zinc-400 hover:text-lime-600 dark:hover:text-lime-400 transition cursor-pointer" title="Print Receipt">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Load Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Load Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Helper function to check dark mode status
    const isDarkMode = () => document.documentElement.classList.contains('dark');
    const getTextColor = () => isDarkMode() ? '#a1a1aa' : '#71717a';
    const getGridColor = () => isDarkMode() ? 'rgba(82, 82, 91, 0.3)' : 'rgba(228, 228, 231, 0.8)';

    // 1. Daily Registrations Line Chart (Horizontal grid lines removed)
    const ctxLine = document.getElementById('dailyRegChart').getContext('2d');
    new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
                label: 'Registrations',
                data: [10, 17, 12, 15, 23, 18, 11],
                borderColor: '#84cc16',
                backgroundColor: 'rgba(132, 204, 22, 0.05)',
                borderWidth: 2,
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 11 } } },
                y: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 11 } } } // Halkan ayaa la damiyay grid-ka jiifka ah
            }
        }
    });

    // 2. Payment Overview Donut Chart
    const ctxDonut = document.getElementById('paymentOverviewChart').getContext('2d');
    new Chart(ctxDonut, {
        type: 'doughnut',
        data: {
            labels: ['Cash', 'Card', 'Bank Transfer'],
            datasets: [{
                data: [30, 50, 20],
                backgroundColor: ['#65a30d', '#84cc16', '#16a34a'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'right', labels: { color: getTextColor(), font: { size: 11 } } }
            },
            cutout: '70%'
        }
    });

    // 3. Membership Types Bar Chart
    const ctxBar = document.getElementById('membershipTypesChart').getContext('2d');
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: ['Gold', 'Silver', 'Platinum', 'Basic'],
            datasets: [{
                data: [35, 22, 30, 15],
                backgroundColor: '#84cc16',
                borderRadius: 4,
                barThickness: 14
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 11 } } },
                y: { grid: { color: getGridColor() }, ticks: { color: getTextColor(), font: { size: 11 } } }
            }
        }
    });
</script>