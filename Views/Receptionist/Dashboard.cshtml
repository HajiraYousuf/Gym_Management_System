@model dynamic
@{
    ViewData["Title"] = "Receptionist Dashboard";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";
}

<!-- Main Dashboard Container -->
<div class="p-4 bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 font-sans min-h-screen transition-colors duration-300">

    <!-- Quick Actions Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-5 bg-white dark:bg-zinc-900 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-sm transition-colors duration-300">
        <div>
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Receptionist Dashboard</h2>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">Welcome back! Here is live operational data from database.</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
            <a href="@Url.Action("Reports", "Receptionist", new { tab = "registrations" })" class="bg-lime-400 hover:bg-lime-300 text-black text-xs font-bold px-3.5 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                View Users
            </a>
            <a href="@Url.Action("Reports", "Receptionist", new { tab = "attendance" })" class="bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-white text-xs font-semibold px-3.5 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 transition flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4 text-lime-600 dark:text-lime-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Check-ins
            </a>
            <a href="@Url.Action("Reports", "Receptionist", new { tab = "payments" })" class="bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-white text-xs font-semibold px-3.5 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 transition flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4 text-lime-600 dark:text-lime-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Payments
            </a>
        </div>
    </div>

    <!-- Row 1: Top 4 Stats Cards (Dynamic Database Values) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">

        <!-- Card 1: Users/Registrations -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-wider">Total Users</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@ViewBag.RecentRegistrationsCount</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Registered Accounts</p>
                </div>
                <div class="p-2.5 bg-lime-500/10 rounded-lg text-lime-600 dark:text-lime-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
            </div>
            <div class="text-xs text-lime-600 dark:text-lime-400 flex items-center mt-3 font-medium">
                <span class="mr-1">↑</span> Live DB Count
            </div>
        </div>

        <!-- Card 2: Today's Payments -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-wider">Today's Payments</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">$@ViewBag.TodayPaymentsTotal</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">@ViewBag.TodayPaymentsCount Transactions</p>
                </div>
                <div class="p-2.5 bg-lime-500/10 rounded-lg text-lime-600 dark:text-lime-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
            </div>
            <div class="text-xs text-lime-600 dark:text-lime-400 flex items-center mt-3 font-medium">
                <span class="mr-1">↑</span> Collected Today
            </div>
        </div>

        <!-- Card 3: Visitors Today -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-wider">Visitors Today</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@ViewBag.TodayVisitorsCount</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Guest Check-ins</p>
                </div>
                <div class="p-2.5 bg-lime-500/10 rounded-lg text-lime-600 dark:text-lime-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
            </div>
            <div class="text-xs text-lime-600 dark:text-lime-400 flex items-center mt-3 font-medium">
                <span class="mr-1">↑</span> Active Visitors
            </div>
        </div>

        <!-- Card 4: Reservations -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-wider">Reservations</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@(ViewBag.Reservations?.Count ?? 0)</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Total Bookings</p>
                </div>
                <div class="p-2.5 bg-lime-500/10 rounded-lg text-lime-600 dark:text-lime-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
            </div>
            <div class="text-xs text-lime-600 dark:text-lime-400 flex items-center mt-3 font-medium">
                <span class="mr-1">↑</span> Class Bookings
            </div>
        </div>

    </div>

    <!-- Row 2: Charts (Powered by Dynamic ViewBag Arrays) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Daily Registrations</h4>
            </div>
            <div class="h-48 relative">
                <canvas id="dailyRegChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Payment Overview</h4>
            <div class="h-48 relative">
                <canvas id="paymentOverviewChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Membership Types</h4>
            <div class="h-48 relative">
                <canvas id="membershipTypesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Row 3: Operational Tables Section (Dynamic Data) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">

        <!-- Recent Users Table -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl lg:col-span-2 shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Recent User Accounts</h4>
                <a href="@Url.Action("Reports", "Receptionist", new { tab = "registrations" })" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">View All →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-zinc-400 border-b border-zinc-200 dark:border-zinc-800">
                            <th class="pb-2">Username</th>
                            <th class="pb-2">Email</th>
                            <th class="pb-2">Role</th>
                            <th class="pb-2 text-right">ID</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @{
                            var recentUsers = ViewBag.RecentRegistrations;
                            if (recentUsers != null)
                            {
                                foreach (var user in recentUsers)
                                {
                                    // Waxaan ka dhigaynaa inay isticmaasho dynamic si ay u akhriso Username iyo Email
                                    var item = (dynamic)user;
                                    <tr class="text-zinc-700 dark:text-zinc-300">
                                        <td class="py-2.5 font-medium text-zinc-900 dark:text-white">@item.Username</td>
                                        <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@item.Email</td>
                                        <td class="py-2.5"><span class="px-2 py-0.5 rounded bg-lime-400/20 text-lime-600 dark:text-lime-400 font-bold">@item.Role</span></td>
                                        <td class="py-2.5 text-right font-mono text-[10px]">#@(item.Id.Length > 8 ? item.Id.Substring(0, 8) + "..." : item.Id)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-zinc-400">No users found.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Today's Class Schedule -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Class Schedules</h4>
                <a href="@Url.Action("Reports", "Receptionist", new { tab = "reservations" })" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">View →</a>
            </div>
            <div class="space-y-3">
                @{
                    var schedules = ViewBag.ClassSchedules as List<GymManagementSystem.Models.ClassSchedule>;
                    if (schedules != null && schedules.Any())
                    {
                        foreach (var sch in schedules)
                        {
                            <div class="p-3 rounded-lg border border-zinc-200 dark:border-zinc-800 flex justify-between items-center transition-colors">
                                <div>
                                    <p class="text-xs font-semibold text-zinc-900 dark:text-white">@sch.ClassName</p>
                                    <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">@sch.Date.ToString("dd MMM yyyy") • @sch.StartTime (@sch.TrainerName)</p>
                                </div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-lime-600 dark:text-lime-400">Active</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-zinc-400 text-center py-4">No schedules available.</p>
                    }
                }
            </div>
        </div>

    </div>

    <!-- Row 4: Payments Table Section -->
    <div class="grid grid-cols-1 lg:grid-cols-1 gap-4 mb-4">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-xl shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-3">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Today's Payments</h4>
                <a href="@Url.Action("Reports", "Receptionist", new { tab = "payments" })" class="text-xs text-lime-600 dark:text-lime-400 font-medium hover:underline">View All →</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-zinc-400 border-b border-zinc-200 dark:border-zinc-800">
                            <th class="pb-2">Date & Time</th>
                            <th class="pb-2">Payment Type</th>
                            <th class="pb-2">Method</th>
                            <th class="pb-2">Amount</th>
                            <th class="pb-2 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @{
                            var payments = ViewBag.TodayPaymentsList as List<GymManagementSystem.Models.Payment>;
                            if (payments != null && payments.Any())
                            {
                                foreach (var pay in payments)
                                {
                                    <tr class="text-zinc-700 dark:text-zinc-300">
                                        <td class="py-2.5 font-mono">@pay.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="py-2.5 font-medium text-zinc-900 dark:text-white">@pay.PaymentFor</td>
                                        <td class="py-2.5 text-zinc-500 dark:text-zinc-400">@pay.Method</td>
                                        <td class="py-2.5 text-zinc-900 dark:text-white font-bold text-lime-600 dark:text-lime-400">$@pay.AmountPaid</td>
                                        <td class="py-2.5 text-right">
                                            <span class='px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-green-500/10 text-green-500'>
                                                Completed
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-zinc-400">No payments recorded today.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Load Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const isDarkMode = () => document.documentElement.classList.contains('dark');
    const getTextColor = () => isDarkMode() ? '#a1a1aa' : '#71717a';
    const getGridColor = () => isDarkMode() ? 'rgba(82, 82, 91, 0.3)' : 'rgba(228, 228, 231, 0.8)';

    // 1. Daily Registrations Line Chart (Dynamic Data from Controller)
    // 1. Daily Registrations Line Chart
    const dailyRegsData = @Html.Raw(Json.Serialize(ViewBag.ChartDailyRegs ?? new int[] { 0, 0, 0, 0, 0, 0, 0 }));
    const ctxLine = document.getElementById('dailyRegChart').getContext('2d');
    new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
                label: 'Registrations',
                data: dailyRegsData,
                borderColor: '#84cc16',
                backgroundColor: 'rgba(132, 204, 22, 0.05)',
                borderWidth: 2,
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            // Gudaha Chart options...
            scales: {
                x: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 11 } } },
                y: {
                    grid: { color: getGridColor() },
                    ticks: { color: getTextColor(), font: { size: 11 }, stepSize: 1 }, // Waxaan ku darnay stepSize si uu u muujiyo lambaro sax ah
                    suggestedMin: 0,
                    suggestedMax: 5 // Waxaad ka dhigi kartaa 5 si uu u muuqdo mid bannaan xitaa haddii hal qof la diiwaangeliyo
                }
            }
        }
    });

    // 2. Payment Overview Donut Chart (Dynamic Data from Controller)
    const paymentBreakdown = @Html.Raw(Json.Serialize(ViewBag.PaymentBreakdown ?? new int[] { 1, 1, 1 }));
    const ctxDonut = document.getElementById('paymentOverviewChart').getContext('2d');
    new Chart(ctxDonut, {
        type: 'doughnut',
        data: {
            labels: ['Cash', 'Card', 'Bank Transfer'],
            datasets: [{
                data: paymentBreakdown,
                backgroundColor: ['#65a30d', '#84cc16', '#16a34a'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'right', labels: { color: getTextColor(), font: { size: 11 } } }
            },
            cutout: '70%'
        }
    });

    // 3. Membership Types Bar Chart (Dynamic Data from Controller)
    const planLabels = @Html.Raw(Json.Serialize(ViewBag.MembershipPlanNames ?? new string[] { }));
    const membershipCounts = @Html.Raw(Json.Serialize(ViewBag.MembershipTypesCount ?? new int[] { }));

    const ctxBar = document.getElementById('membershipTypesChart').getContext('2d');
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: planLabels, // Magacyada qorshayaasha oo dynamic ah (VIP Elite, Pro Plan, iwm.)
            datasets: [{
                data: membershipCounts,
                backgroundColor: '#84cc16',
                borderRadius: 4,
                barThickness: 14
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 11 } } },
                y: { grid: { color: getGridColor() }, ticks: { color: getTextColor(), font: { size: 11 } } }
            }
        }
    });
</script>