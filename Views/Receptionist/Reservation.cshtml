@{
    ViewData["Title"] = "Class Reservations Management";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-6 md:p-8 max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-zinc-900/60 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="p-2.5 bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 rounded-xl border border-emerald-100 dark:border-lime-400/20">
                <i class="fa-solid fa-bookmark text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Class Reservations</h1>
                <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Manage member bookings, process approvals, and monitor class seat availability</p>
            </div>
        </div>
        <button onclick="openNewReservationModal()" class="px-5 h-11 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition shadow-md flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-plus text-sm"></i>
            New Reservation
        </button>
    </div>

    <!-- STATS OVERVIEW CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Stat 1 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-emerald-600 dark:text-lime-400 font-bold block">Today's Reservations</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">84 <span class="text-xs font-semibold text-emerald-600 dark:text-lime-400">+12%</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">This Week Volume</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
        </div>

        <!-- Stat 2 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-zinc-400 font-bold block">Today's Classes</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">12 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Active</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Scheduled Today</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300 flex items-center justify-center text-xl">
                <i class="fa-solid fa-dumbbell"></i>
            </div>
        </div>

        <!-- Stat 3 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block">Available Seats</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">36 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Open</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Across Today's Classes</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-chair"></i>
            </div>
        </div>

        <!-- Stat 4 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-red-600 dark:text-red-400 font-bold block">Cancelled Bookings</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">8 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Total</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">This Month</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 dark:bg-red-500/10 dark:text-red-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-ban"></i>
            </div>
        </div>

    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="bg-white dark:bg-zinc-900/80 p-4 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- Tab Filters -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="flex p-1 bg-slate-100 dark:bg-black rounded-xl border border-slate-200 dark:border-zinc-800 w-full sm:w-auto text-xs font-bold">
                <button onclick="filterTab('all')" id="tabAll" class="px-4 py-2 rounded-lg bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 transition cursor-pointer">Today's Reservations</button>
                <button onclick="filterTab('confirmed')" id="tabConfirmed" class="px-4 py-2 rounded-lg text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer">Confirmed</button>
                <button onclick="filterTab('pending')" id="tabPending" class="px-4 py-2 rounded-lg text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer">Pending</button>
            </div>
        </div>

        <!-- Search Reservation Input -->
        <div class="relative w-full sm:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="txtSearchReservation" onkeyup="searchReservationsTable()" placeholder="Search member, ID or class..." 
                class="w-full h-11 pl-10 pr-4 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-zinc-600 text-xs font-medium outline-none transition shadow-inner" />
        </div>
    </div>

    <!-- RESERVATION LIST TABLE CARD -->
    <div class="bg-white dark:bg-zinc-900/80 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 dark:border-zinc-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-list-check text-emerald-600 dark:text-lime-400"></i>
                Live Bookings & Reservation List
            </h3>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-lime-400/10 dark:text-lime-400 font-bold">RECEPTION DESK</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="reservationTable">
                <thead>
                    <tr class="bg-slate-50 dark:bg-zinc-950/60 text-[10px] uppercase tracking-wider text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 font-bold">
                        <th class="py-3.5 px-6">Reservation ID</th>
                        <th class="py-3.5 px-4">Member Name</th>
                        <th class="py-3.5 px-4">Class</th>
                        <th class="py-3.5 px-4">Trainer</th>
                        <th class="py-3.5 px-4">Date & Time</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/80 text-xs font-medium text-slate-800 dark:text-zinc-200">
                    
                    <!-- Row 1 -->
                    <tr class="reservation-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="confirmed">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">RES-1024</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Ahmed Ali</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Yoga Class</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Ali Hassan</td>
                        <td class="py-4 px-4 font-mono text-slate-600 dark:text-zinc-400">05 Aug • 05:00 PM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400">Confirmed</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('RES-1024', 'Ahmed Ali', 'Yoga Class', 'Ali Hassan', '05 Aug 2026', '05:00 PM', 'Confirmed')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="confirmReservationAction('RES-1024')" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Confirm</button>
                            <button onclick="cancelReservation('RES-1024')" class="px-2.5 py-1.5 bg-red-50 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 text-red-600 dark:text-red-400 font-bold rounded-lg transition cursor-pointer">Cancel</button>
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr class="reservation-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="pending">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">RES-1025</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Hassan Omar</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Cardio Session</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Ahmed Mohamed</td>
                        <td class="py-4 px-4 font-mono text-slate-600 dark:text-zinc-400">05 Aug • 06:00 PM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">Pending</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('RES-1025', 'Hassan Omar', 'Cardio Session', 'Ahmed Mohamed', '05 Aug 2026', '06:00 PM', 'Pending')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="confirmReservationAction('RES-1025')" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Confirm</button>
                            <button onclick="cancelReservation('RES-1025')" class="px-2.5 py-1.5 bg-red-50 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 text-red-600 dark:text-red-400 font-bold rounded-lg transition cursor-pointer">Cancel</button>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- NEW RESERVATION MODAL (POP-UP FORM) -->
<div id="newReservationModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden space-y-6 p-6 my-8">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <div class="flex items-center gap-3">
                <span class="p-2 bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 rounded-xl">
                    <i class="fa-solid fa-bookmark"></i>
                </span>
                <div>
                    <h3 class="font-black text-base text-slate-900 dark:text-white">Create New Reservation</h3>
                    <p class="text-xs text-slate-500 dark:text-zinc-400">Book class spots for active gym members</p>
                </div>
            </div>
            <button onclick="closeNewReservationModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Modal Form Content -->
        <form class="space-y-6 text-xs" onsubmit="event.preventDefault(); alert('Reservation successfully created!'); closeNewReservationModal();">
            
            <!-- Step 1: Member Information -->
            <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
                <h4 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 uppercase tracking-wider text-[11px]">
                    <span class="w-5 h-5 rounded-full bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 flex items-center justify-center text-[10px] font-black">1</span>
                    Member Information
                </h4>
                
                <div class="space-y-1.5">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Search Member *</label>
                    <div class="flex gap-2">
                        <input type="text" id="txtMemberLookup" placeholder="Example: Ahmed Mohamed - MEM-8821" value="Ahmed Mohamed - MEM-8821" 
                            class="w-full h-10 px-3.5 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none transition" />
                        <button type="button" class="px-4 h-10 bg-slate-900 hover:bg-slate-800 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-white font-bold rounded-xl transition cursor-pointer">Verify</button>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                    <div>
                        <span class="text-slate-500 block text-[10px] uppercase">Member Name</span>
                        <strong class="text-slate-900 dark:text-white font-bold">Ahmed Mohamed Hassan</strong>
                    </div>
                    <div>
                        <span class="text-slate-500 block text-[10px] uppercase">Member ID</span>
                        <strong class="font-mono text-emerald-600 dark:text-lime-400">MEM-8821</strong>
                    </div>
                    <div>
                        <span class="text-slate-500 block text-[10px] uppercase">Membership</span>
                        <strong class="text-slate-900 dark:text-white">VIP Premium</strong>
                    </div>
                    <div>
                        <span class="text-slate-500 block text-[10px] uppercase">Status Check</span>
                        <strong class="text-emerald-600 dark:text-lime-400">Active ✅</strong>
                    </div>
                </div>
            </div>

            <!-- Step 2: Class Details -->
            <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
                <h4 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 uppercase tracking-wider text-[11px]">
                    <span class="w-5 h-5 rounded-full bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 flex items-center justify-center text-[10px] font-black">2</span>
                    Class Details
                </h4>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Select Class *</label>
                        <select class="w-full h-10 px-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                            <option>Select Class</option>
                            <option selected>Yoga Class</option>
                            <option>Cardio Session</option>
                            <option>CrossFit</option>
                            <option>Bodybuilding Advanced</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Select Trainer</label>
                        <select class="w-full h-10 px-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                            <option selected>Ali Hassan</option>
                            <option>Ahmed Mohamed</option>
                            <option>Mohamed Ali</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Date *</label>
                        <input type="date" value="2026-08-11" class="w-full h-10 px-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none" />
                    </div>
                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Time *</label>
                        <select class="w-full h-10 px-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                            <option selected>05:00 PM</option>
                            <option>06:00 PM</option>
                            <option>07:00 PM</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Available Seats</label>
                        <div class="h-10 px-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 rounded-xl flex items-center font-mono font-bold text-emerald-600 dark:text-lime-400">
                            12 / 20 Open
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Reservation Details -->
            <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
                <h4 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 uppercase tracking-wider text-[11px]">
                    <span class="w-5 h-5 rounded-full bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 flex items-center justify-center text-[10px] font-black">3</span>
                    Reservation Details
                </h4>

                <div class="space-y-3">
                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Booking Status *</label>
                        <select class="w-full h-10 px-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                            <option selected>Confirmed</option>
                            <option>Pending</option>
                            <option>Cancelled</option>
                            <option>Completed</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="block font-bold text-slate-700 dark:text-zinc-400">Notes (Optional)</label>
                        <textarea rows="2" placeholder="Add any special instructions or member notes..." class="w-full p-3 bg-white dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none resize-none"></textarea>
                    </div>
                </div>
            </div>

            <!-- Modal Action Footer -->
            <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-200 dark:border-zinc-800">
                <button type="button" onclick="closeNewReservationModal()" class="px-4 h-11 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit" class="px-6 h-11 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold uppercase tracking-wider rounded-xl transition shadow-md cursor-pointer">
                    Save Reservation
                </button>
            </div>

        </form>
    </div>
</div>

<!-- VIEW RESERVATION MODAL -->
<div id="viewReservationModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden space-y-5 p-6">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-emerald-600 dark:text-lime-400"></i>
                Reservation Summary
            </h3>
            <button onclick="closeViewModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-3 text-xs">
            <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
                <span class="text-slate-500">Reservation ID:</span>
                <strong id="viewResId" class="font-mono text-slate-900 dark:text-white">RES-1024</strong>
            </div>
            <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
                <span class="text-slate-500">Member Name:</span>
                <strong id="viewMemberName" class="text-slate-900 dark:text-white">Ahmed Ali</strong>
            </div>
            <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
                <span class="text-slate-500">Class:</span>
                <strong id="viewClassName" class="text-slate-900 dark:text-white">Yoga Class</strong>
            </div>
            <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
                <span class="text-slate-500">Trainer:</span>
                <strong id="viewTrainer" class="text-slate-900 dark:text-white">Ali Hassan</strong>
            </div>
            <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
                <span class="text-slate-500">Schedule:</span>
                <strong id="viewSchedule" class="font-mono text-emerald-600 dark:text-lime-400">05 Aug 2026 • 05:00 PM</strong>
            </div>
            <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
                <span class="text-slate-500">Status:</span>
                <strong id="viewStatus" class="text-emerald-600 dark:text-lime-400">Confirmed</strong>
            </div>
        </div>

        <div class="flex justify-end pt-2 border-t border-slate-200 dark:border-zinc-800">
            <button onclick="closeViewModal()" class="px-5 h-10 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold text-xs rounded-xl transition cursor-pointer">
                Close
            </button>
        </div>
    </div>
</div>

<!-- JavaScript Controls -->
<script>
    // New Reservation Modal Controls
    function openNewReservationModal() {
        document.getElementById('newReservationModal').classList.remove('hidden');
    }
    function closeNewReservationModal() {
        document.getElementById('newReservationModal').classList.add('hidden');
    }

    // View Modal Controls
    function openViewModal(id, member, className, trainer, date, time, status) {
        document.getElementById('viewResId').innerText = id;
        document.getElementById('viewMemberName').innerText = member;
        document.getElementById('viewClassName').innerText = className;
        document.getElementById('viewTrainer').innerText = trainer;
        document.getElementById('viewSchedule').innerText = date + ' • ' + time;
        document.getElementById('viewStatus').innerText = status;
        document.getElementById('viewReservationModal').classList.remove('hidden');
    }
    function closeViewModal() {
        document.getElementById('viewReservationModal').classList.add('hidden');
    }

    // Confirm Action
    function confirmReservationAction(id) {
        alert("Reservation " + id + " has been successfully confirmed!");
    }

    // Cancel Action
    function cancelReservation(id) {
        if(confirm("Are you sure you want to cancel reservation " + id + "?")) {
            alert("Reservation " + id + " has been cancelled.");
        }
    }

    // Search Filter Table
    function searchReservationsTable() {
        const input = document.getElementById('txtSearchReservation').value.toLowerCase();
        const rows = document.querySelectorAll('.reservation-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
        });
    }

    // Tab Filters
    function filterTab(status) {
        const rows = document.querySelectorAll('.reservation-row');
        const btnAll = document.getElementById('tabAll');
        const btnConfirmed = document.getElementById('tabConfirmed');
        const btnPending = document.getElementById('tabPending');

        // Reset classes
        [btnAll, btnConfirmed, btnPending].forEach(btn => {
            btn.className = "px-4 py-2 rounded-lg text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer";
        });

        if(status === 'all') {
            btnAll.className = "px-4 py-2 rounded-lg bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 transition cursor-pointer";
            rows.forEach(r => r.style.display = '');
        } else if(status === 'confirmed') {
            btnConfirmed.className = "px-4 py-2 rounded-lg bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 transition cursor-pointer";
            rows.forEach(r => {
                r.style.display = r.getAttribute('data-status') === 'confirmed' ? '' : 'none';
            });
        } else if(status === 'pending') {
            btnPending.className = "px-4 py-2 rounded-lg bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 transition cursor-pointer";
            rows.forEach(r => {
                r.style.display = r.getAttribute('data-status') === 'pending' ? '' : 'none';
            });
        }
    }
</script>