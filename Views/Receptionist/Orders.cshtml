@model IEnumerable<GymManagementSystem.Models.GuestOrder>

@{
    ViewData["Title"] = "Gym Product Orders Management";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";

    // Tirakoobka Dynamic-ka ah ee Card-yada
    var totalOrdersCount = Model != null ? Model.Count() : 0;
    var pendingOrdersCount = Model != null ? Model.Count(o => o.Status == "Pending") : 0;
    var confirmedOrdersCount = Model != null ? Model.Count(o => o.Status == "Confirmed") : 0;
    var completedOrdersCount = Model != null ? Model.Count(o => o.Status == "Completed") : 0;
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-6 md:p-8 max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-zinc-900/60 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="p-2.5 bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 rounded-xl border border-emerald-100 dark:border-lime-400/20">
                <i class="fa-solid fa-cart-shopping text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Gym Product Orders</h1>
                <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Manage customer supplement and gear purchases, track order states, and forward payments to Payments desk</p>
            </div>
        </div>
        <button onclick="openNewOrderModal()" class="px-5 h-11 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition shadow-md flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-plus text-sm"></i>
            New Order
        </button>
    </div>

    <!-- 1. SUMMARY CARDS (DYNAMIC) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Card 1: Total Orders -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-zinc-400 font-bold block">Total Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">@totalOrdersCount <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Total</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Logged in System</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300 flex items-center justify-center text-xl">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>

        <!-- Card 2: Pending Orders -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400 font-bold block">Pending Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">@pendingOrdersCount <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Awaiting</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Require Confirmation</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-400/10 dark:text-amber-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>

        <!-- Card 3: Confirmed Orders -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-emerald-600 dark:text-lime-400 font-bold block">Confirmed Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">@confirmedOrdersCount <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Active</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Ready / Processing</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>

        <!-- Card 4: Completed Orders -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block">Completed Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">@completedOrdersCount <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Fulfilled</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Delivered & Paid</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-box-archive"></i>
            </div>
        </div>

    </div>

    <!-- 2. SEARCH & FILTERS -->
    <div class="bg-white dark:bg-zinc-900/80 p-4 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- Status Filters -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative w-full sm:w-48">
                <select id="filterStatus" onchange="filterTable()" class="w-full h-11 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white text-xs font-semibold outline-none cursor-pointer appearance-none">
                    <option value="all">Status: All</option>
                    <option value="pending">Pending</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="completed">Completed</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
            </div>
        </div>

        <!-- Search Order ID / Member / Product -->
        <div class="relative w-full sm:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="txtOrderSearch" onkeyup="filterTable()" placeholder="Search Order ID / Member / Product..."
                   class="w-full h-11 pl-10 pr-4 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-zinc-600 text-xs font-medium outline-none transition shadow-inner" />
        </div>
    </div>

    <!-- 3. ORDERS TABLE (DYNAMIC LOOP) -->
    <div class="bg-white dark:bg-zinc-900/80 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 dark:border-zinc-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-list-check text-emerald-600 dark:text-lime-400"></i>
                Active Order Transactions Desk
            </h3>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-lime-400/10 dark:text-lime-400 font-bold">DATABASE CONNECTED</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="ordersTable">
                <thead>
                    <tr class="bg-slate-50 dark:bg-zinc-950/60 text-[10px] uppercase tracking-wider text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 font-bold">
                        <th class="py-3.5 px-6">Order ID</th>
                        <th class="py-3.5 px-4">Member</th>
                        <th class="py-3.5 px-4">Items</th>
                        <th class="py-3.5 px-4">Total</th>
                        <th class="py-3.5 px-4">Date & Time</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-4 text-center">Payment</th>
                        <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/80 text-xs font-medium text-slate-800 dark:text-zinc-200">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr class="order-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="@order.Status.ToLower()">
                                <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">@order.OrderNumber</td>
                                <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">
                                    @order.FullName
                                    <div class="text-[10px] text-slate-400 font-normal">@order.Phone</div>
                                </td>
                                <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">
                                    @if (order.Items != null && order.Items.Any())
                                    {
                                        foreach (var item in order.Items)
                                        {
                                            <div>@item.ProductName ×@item.Quantity</div>
                                        }
                                    }
                                </td>
                                <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$@order.TotalAmount</td>
                                <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">@order.OrderDate.ToString("dd MMM • hh:mm tt")</td>

                                <td class="py-4 px-4 text-center">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold
                                        @(order.Status == "Pending" ? "bg-amber-100 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400" :
                                          order.Status == "Confirmed" ? "bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400" :
                                          "bg-blue-100 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400")">
                                        @order.Status
                                    </span>
                                </td>

                                <td class="py-4 px-4 text-center">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold
                                        @(order.PaymentMethod == "Cash" && order.Status == "Pending" ? "bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400" : "bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400")">
                                        @(order.Status == "Pending" ? "Unpaid" : "Paid")
                                    </span>
                                </td>

                                <td class="py-4 px-6 text-right space-x-1.5">
                                    @if (order.Status == "Pending")
                                    {
                                        <form asp-action="ProcessOrder" method="post" class="inline">
                                            <input type="hidden" name="id" value="@order.OrderID" />
                                            <input type="hidden" name="actionType" value="Confirm" />
                                            <button type="submit" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Confirm</button>
                                        </form>
                                        <form asp-action="ProcessOrder" method="post" class="inline">
                                            <input type="hidden" name="id" value="@order.OrderID" />
                                            <input type="hidden" name="actionType" value="Cancel" />
                                            <button type="submit" class="px-2.5 py-1.5 bg-red-50 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 text-red-600 dark:text-red-400 font-bold rounded-lg transition cursor-pointer">Cancel</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button onclick="openReceiptModal('@order.OrderNumber', '@order.FullName', @order.TotalAmount)" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 dark:bg-blue-500/10 dark:hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 font-bold rounded-lg transition cursor-pointer">Receipt</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-6 text-slate-400">Wali ma jiraan wax dalabaad ah (Orders) oo soo galay.</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- VIEW RECEIPT MODAL -->
<div id="receiptModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden space-y-4 p-6 text-xs text-center">
        <div class="flex justify-end">
            <button onclick="closeReceiptModal()" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 flex items-center justify-center transition cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="space-y-1">
            <span class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-lime-400/10 text-emerald-600 dark:text-lime-400 inline-flex items-center justify-center text-lg mb-1"><i class="fa-solid fa-check"></i></span>
            <h4 class="font-black text-base text-slate-900 dark:text-white">GYM STORE RECEIPT</h4>
            <p class="text-[11px] text-slate-400">Official Payment Slip</p>
        </div>

        <div class="space-y-2 text-left p-3 rounded-xl bg-slate-50 dark:bg-zinc-950 font-mono text-[11px]">
            <div class="flex justify-between"><span>Order ID:</span> <strong id="receiptId" class="text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span>Member:</span> <strong id="receiptMember" class="text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span>Status:</span> <strong class="text-emerald-600 dark:text-lime-400">PAID</strong></div>
            <div class="flex justify-between border-t border-slate-200 dark:border-zinc-800 pt-2 font-bold text-xs"><span>Total Paid:</span> <strong id="receiptTotal" class="text-emerald-600 dark:text-lime-400"></strong></div>
        </div>

        <div class="flex gap-2 pt-2">
            <button onclick="window.print()" class="w-full h-10 bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">Print Slip</button>
            <button onclick="closeReceiptModal()" class="w-full h-10 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:text-zinc-950 font-extrabold rounded-xl transition cursor-pointer">Done</button>
        </div>
    </div>
</div>

<!-- JavaScript Filtering & Modals -->
<script>
    function filterTable() {
        let statusFilter = document.getElementById('filterStatus').value.toLowerCase();
        let searchInput = document.getElementById('txtOrderSearch').value.toLowerCase();
        let rows = document.querySelectorAll('.order-row');

        rows.forEach(row => {
            let rowStatus = row.getAttribute('data-status');
            let rowText = row.innerText.toLowerCase();

            let matchesStatus = (statusFilter === 'all' || rowStatus === statusFilter);
            let matchesSearch = (rowText.includes(searchInput));

            if (matchesStatus && matchesSearch) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    function openReceiptModal(id, member, total) {
        document.getElementById('receiptId').innerText = id;
        document.getElementById('receiptMember').innerText = member;
        document.getElementById('receiptTotal').innerText = '$' + total;
        document.getElementById('receiptModal').classList.remove('hidden');
    }
    function closeReceiptModal() {
        document.getElementById('receiptModal').classList.add('hidden');
    }
</script>