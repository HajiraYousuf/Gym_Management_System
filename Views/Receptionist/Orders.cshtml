<!-- JavaScript Logic & Router Emulation -->
<script>
    // New Order Modal Controls
    function openNewOrderModal() { document.getElementById('newOrderModal').classList.remove('hidden'); }
    function closeNewOrderModal() { document.getElementById('newOrderModal').classList.add('hidden'); }

    // View Modal Controls
    function openViewModal(id, member, date, status, payment, total) {
        document.getElementById('viewModalId').innerText = id;
        document.getElementById('viewModalMember').innerText = member;
        document.getElementById('viewModalDate').innerText = date;
        document.getElementById('viewModalStatus').innerText = status;
        document.getElementById('viewModalPayment').innerText = payment;
        document.getElementById('viewModalTotal').innerText = '$' + total;
        document.getElementById('viewOrderModal').classList.remove('hidden');
    }
    function closeViewModal() { document.getElementById('viewOrderModal').classList.add('hidden'); }

    // Confirm Modal Controls
    function openConfirmModal(id, member, total) {
        document.getElementById('confirmModalId').innerText = 'Order #' + id;
        document.getElementById('confirmModalMember').innerText = member;
        document.getElementById('confirmModalTotal').innerText = '$' + total;
        document.getElementById('confirmOrderModal').classList.remove('hidden');
    }
    function closeConfirmModal() { document.getElementById('confirmOrderModal').classList.add('hidden'); }

    function executeOrderConfirmation() {
        alert("Order verified and confirmed! Redirecting to Payments.aspx for official payment processing...");
        closeConfirmModal();
        window.location.href = '#payments'; // Emulating redirect to Payments.aspx
    }

    // Cancel Action
    function cancelOrder(id) {
        if(confirm("Are you sure you want to cancel order " + id + "?")) {
            alert("Order " + id + " has been cancelled.");
        }
    }

    // Receipt Modal Controls
    function openReceiptModal(id, member, total) {
        document.getElementById('receiptId').innerText = id;
        document.getElementById('receiptMember').innerText = member;
        document.getElementById('receiptTotal').innerText = '$' + total;
        document.getElementById('receiptModal').classList.remove('hidden');
    }
    function closeReceiptModal() { document.getElementById('receiptModal').classList.add('hidden'); }

    // Table Filter & Search Engine
    function filterOrders() {
        const searchInput = document.getElementById('txtOrderSearch').value.toLowerCase();
        const statusFilter = document.getElementById('filterStatus').value;
        const rows = document.querySelectorAll('.order-row');

        rows.forEach(row => {
            const rowText = row.innerText.toLowerCase();
            const rowStatus = row.getAttribute('data-status');
            
            const matchesSearch = rowText.includes(searchInput);
            const matchesStatus = (statusFilter === 'all' || rowStatus === statusFilter);

            if(matchesSearch && matchesStatus) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>