@{
    ViewData["Title"] = "Gym Product Orders Management";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-6 md:p-8 max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-zinc-900/60 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="p-2.5 bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 rounded-xl border border-emerald-100 dark:border-lime-400/20">
                <i class="fa-solid fa-cart-shopping text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Gym Product Orders</h1>
                <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Manage customer supplement and gear purchases, track order states, and forward payments to Payments desk</p>
            </div>
        </div>
        <button onclick="openNewOrderModal()" class="px-5 h-11 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition shadow-md flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-plus text-sm"></i>
            New Order
        </button>
    </div>

    <!-- 1. SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Card 1 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-zinc-400 font-bold block">Today's Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">24 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Total</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Logged Today</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300 flex items-center justify-center text-xl">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400 font-bold block">Pending Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">5 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Awaiting</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Require Confirmation</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-400/10 dark:text-amber-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-emerald-600 dark:text-lime-400 font-bold block">Confirmed Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">15 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Active</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Ready / Processing</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block">Completed Orders</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">4 <span class="text-sm font-normal text-slate-500 dark:text-zinc-400">Fulfilled</span></h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Delivered & Paid</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-box-archive"></i>
            </div>
        </div>

    </div>

    <!-- 2. SEARCH & FILTERS -->
    <div class="bg-white dark:bg-zinc-900/80 p-4 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- Status & Date Filters -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative w-full sm:w-40">
                <select id="filterStatus" onchange="filterOrders()" class="w-full h-11 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white text-xs font-semibold outline-none cursor-pointer appearance-none">
                    <option value="all">Status: All</option>
                    <option value="pending">Pending</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="completed">Completed</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
            </div>
            <div class="relative w-full sm:w-40">
                <select id="filterDate" onchange="filterOrders()" class="w-full h-11 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white text-xs font-semibold outline-none cursor-pointer appearance-none">
                    <option value="today">Date: Today</option>
                    <option value="yesterday">Yesterday</option>
                    <option value="week">This Week</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
            </div>
        </div>

        <!-- Search Order ID / Member / Product -->
        <div class="relative w-full sm:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="txtOrderSearch" onkeyup="filterOrders()" placeholder="Search Order ID / Member / Product..." 
                class="w-full h-11 pl-10 pr-4 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-zinc-600 text-xs font-medium outline-none transition shadow-inner" />
        </div>
    </div>

    <!-- 3. ORDERS TABLE -->
    <div class="bg-white dark:bg-zinc-900/80 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 dark:border-zinc-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-list-check text-emerald-600 dark:text-lime-400"></i>
                Active Order Transactions Desk
            </h3>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-lime-400/10 dark:text-lime-400 font-bold">ORDERS.ASPX</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="ordersTable">
                <thead>
                    <tr class="bg-slate-50 dark:bg-zinc-950/60 text-[10px] uppercase tracking-wider text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 font-bold">
                        <th class="py-3.5 px-6">Order ID</th>
                        <th class="py-3.5 px-4">Member</th>
                        <th class="py-3.5 px-4">Items</th>
                        <th class="py-3.5 px-4">Total</th>
                        <th class="py-3.5 px-4">Date & Time</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-4 text-center">Payment</th>
                        <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/80 text-xs font-medium text-slate-800 dark:text-zinc-200">
                    
                    <!-- Row ORD-1025 -->
                    <tr class="order-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="pending">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">ORD-1025</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Ahmed Ali</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Whey Protein ×2</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$100</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">11 Aug • 10:30 AM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">Pending</span>
                        </td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400">Unpaid</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('ORD-1025', 'Ahmed Ali', '11 Aug 2026', 'Pending', 'Unpaid', 100)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openConfirmModal('ORD-1025', 'Ahmed Ali', 100)" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Confirm</button>
                            <button onclick="cancelOrder('ORD-1025')" class="px-2.5 py-1.5 bg-red-50 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 text-red-600 dark:text-red-400 font-bold rounded-lg transition cursor-pointer">Cancel</button>
                        </td>
                    </tr>

                    <!-- Row ORD-1026 -->
                    <tr class="order-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="confirmed">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">ORD-1026</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Farhiya Abdi</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Water ×3</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$6</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">11 Aug • 11:15 AM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400">Confirmed</span>
                        </td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400">Paid</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('ORD-1026', 'Farhiya Abdi', '11 Aug 2026', 'Confirmed', 'Paid', 6)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openReceiptModal('ORD-1026', 'Farhiya Abdi', 6)" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 dark:bg-blue-500/10 dark:hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 font-bold rounded-lg transition cursor-pointer">Receipt</button>
                        </td>
                    </tr>

                    <!-- Row ORD-1027 -->
                    <tr class="order-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="completed">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">ORD-1027</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Mohamed Jama</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Gloves ×1</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$15</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">11 Aug • 12:05 PM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400">Completed</span>
                        </td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400">Paid</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('ORD-1027', 'Mohamed Jama', '11 Aug 2026', 'Completed', 'Paid', 15)" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openReceiptModal('ORD-1027', 'Mohamed Jama', 15)" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 dark:bg-blue-500/10 dark:hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 font-bold rounded-lg transition cursor-pointer">Receipt</button>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- 4. VIEW ORDER MODAL -->
<div id="viewOrderModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden space-y-5 p-6 text-xs">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-file-invoice text-emerald-600 dark:text-lime-400"></i>
                Order Details
            </h3>
            <button onclick="closeViewModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
            <div><span class="text-slate-500">Order ID:</span> <strong id="viewModalId" class="font-mono text-slate-900 dark:text-white block">ORD-1025</strong></div>
            <div><span class="text-slate-500">Member:</span> <strong id="viewModalMember" class="text-slate-900 dark:text-white block">Ahmed Ali</strong></div>
            <div><span class="text-slate-500">Date:</span> <strong id="viewModalDate" class="font-mono text-slate-900 dark:text-white block">11 Aug 2026</strong></div>
            <div><span class="text-slate-500">Status:</span> <strong id="viewModalStatus" class="text-emerald-600 dark:text-lime-400 block">Pending</strong></div>
        </div>

        <div class="space-y-2">
            <span class="font-bold uppercase tracking-wider text-slate-500 block">Items</span>
            <div class="border border-slate-200 dark:border-zinc-800 rounded-xl overflow-hidden">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-slate-100 dark:bg-zinc-950 text-[10px] uppercase text-slate-500">
                            <th class="p-2.5">Product</th>
                            <th class="p-2.5 text-center">Qty</th>
                            <th class="p-2.5 text-right">Price</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-zinc-800">
                        <tr>
                            <td class="p-2.5 font-bold">Whey Protein</td>
                            <td class="p-2.5 text-center font-mono">2</td>
                            <td class="p-2.5 text-right font-mono">$50</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="flex justify-between items-center p-3 rounded-xl bg-slate-50 dark:bg-zinc-950 font-bold">
                <span>Total:</span>
                <span id="viewModalTotal" class="font-mono text-sm text-emerald-600 dark:text-lime-400">$100</span>
            </div>
            <div class="flex justify-between items-center px-1">
                <span class="text-slate-500">Payment Status:</span>
                <strong id="viewModalPayment" class="text-red-600 dark:text-red-400">Unpaid</strong>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-zinc-800">
            <button onclick="closeViewModal(); openConfirmModal('ORD-1025', 'Ahmed Ali', 100)" class="px-4 h-10 bg-emerald-600 text-white dark:bg-lime-400 dark:text-zinc-950 font-bold rounded-xl transition cursor-pointer">Confirm Order</button>
            <button onclick="closeViewModal(); cancelOrder('ORD-1025')" class="px-4 h-10 bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400 font-bold rounded-xl transition cursor-pointer">Cancel Order</button>
            <button onclick="closeViewModal()" class="px-4 h-10 bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">Close</button>
        </div>
    </div>
</div>

<!-- 5. CONFIRM ORDER MODAL -->
<div id="confirmOrderModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden space-y-5 p-6 text-xs">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-600 dark:text-lime-400"></i>
                Confirm Order Verification
            </h3>
            <button onclick="closeConfirmModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
            <p class="text-slate-600 dark:text-zinc-400">Receptionist-ku wuxuu hubinayaa in order-ku sax yahay:</p>
            <div class="space-y-1">
                <h4 id="confirmModalId" class="font-black text-sm text-slate-900 dark:text-white font-mono">Order #ORD-1025</h4>
                <p>Member: <strong id="confirmModalMember" class="text-slate-900 dark:text-white">Ahmed Ali</strong></p>
                <p>Total: <strong id="confirmModalTotal" class="font-mono text-emerald-600 dark:text-lime-400">$100</strong></p>
            </div>
            <p class="text-[11px] text-slate-400 dark:text-zinc-500 italic pt-1">Order → Confirmed → Forwarded to Payments.aspx for Paid → Receipt generation.</p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-zinc-800">
            <button onclick="closeConfirmModal()" class="px-4 h-10 bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">Cancel</button>
            <button onclick="executeOrderConfirmation()" class="px-5 h-10 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold rounded-xl transition shadow-md cursor-pointer">Confirm Order & Pay</button>
        </div>
    </div>
</div>

<!-- 6. NEW ORDER MODAL (POPUP FORM) -->
<div id="newOrderModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden space-y-5 p-6 text-xs my-8">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-cart-plus text-emerald-600 dark:text-lime-400"></i>
                New Product Order
            </h3>
            <button onclick="closeNewOrderModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Order successfully created!'); closeNewOrderModal();">
            
            <div class="space-y-1">
                <label class="block font-bold text-slate-700 dark:text-zinc-400">Member</label>
                <input type="text" placeholder="Search Member (e.g. Ahmed Ali - MEM-1044)..." class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="space-y-1 sm:col-span-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Product</label>
                    <select class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
