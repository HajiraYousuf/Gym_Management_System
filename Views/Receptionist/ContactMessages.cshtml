@model IEnumerable<GymManagementSystem.Models.ContactMessage>

@{
    ViewData["Title"] = "Contact Messages";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-colors duration-200">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">Contact Messages</h1>
            <p class="text-sm text-gray-500 dark:text-zinc-400 mt-1">Manage and respond to inquiries submitted through the website.</p>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div class="bg-white dark:bg-zinc-900 overflow-hidden shadow-sm rounded-xl border border-gray-100 dark:border-zinc-800 p-6 flex items-center">
            <div class="p-3 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 mr-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500 dark:text-zinc-400">Total Messages</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">@ViewBag.TotalMessages</h3>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 overflow-hidden shadow-sm rounded-xl border border-gray-100 dark:border-zinc-800 p-6 flex items-center">
            <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 mr-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500 dark:text-zinc-400">Unread Messages</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">@ViewBag.UnreadMessages</h3>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="bg-white dark:bg-zinc-900 rounded-xl shadow-sm border border-gray-100 dark:border-zinc-800 p-4 mb-6">
        <form method="get" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-grow">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="w-4 h-4 text-gray-400 dark:text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="block w-full pl-10 pr-3 py-2.5 border border-gray-200 dark:border-zinc-800 dark:bg-zinc-950 text-gray-900 dark:text-white rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-lime-500 focus:border-transparent placeholder-gray-400 dark:placeholder-zinc-500" placeholder="Search by name, email, or subject...">
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-5 py-2.5 bg-gray-900 dark:bg-lime-500 text-white dark:text-black font-semibold text-sm rounded-lg hover:bg-gray-800 dark:hover:bg-lime-400 transition duration-150">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                {
                    <a asp-action="ContactMessages" class="px-4 py-2.5 bg-gray-100 dark:bg-zinc-800 text-gray-700 dark:text-zinc-300 text-sm font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition duration-150">Clear</a>
                }
            </div>
        </form>
    </div>

    <!-- Messages Table Card -->
    <div class="bg-white dark:bg-zinc-900 rounded-xl shadow-sm border border-gray-100 dark:border-zinc-800 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-zinc-800">
                <thead class="bg-gray-50 dark:bg-zinc-950">
                    <tr>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Name</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Email</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Subject</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Message</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Date</th>
                        <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500 dark:text-zinc-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white dark:bg-zinc-900 divide-y divide-gray-200 dark:divide-zinc-800">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsRead ? "hover:bg-gray-50 dark:hover:bg-zinc-850" : "bg-amber-50/50 dark:bg-amber-950/20 hover:bg-amber-50/80 dark:hover:bg-amber-950/30 font-medium") transition duration-150">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (item.IsRead)
                                    {
                                        <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50">Read</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50">New</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-zinc-100 font-medium">@item.Name</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-zinc-400">
                                    <a href="mailto:@item.Email" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-900 dark:hover:text-indigo-300 underline">@item.Email</a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-zinc-200">@item.Subject</td>
                                <td class="px-6 py-4 text-sm text-gray-500 dark:text-zinc-400 max-w-xs truncate" title="@item.Message">
                                    @item.Message
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-zinc-400">@item.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (!item.IsRead)
                                        {
                                            <form asp-action="MarkAsRead" asp-route-id="@item.ContactID" method="post">
                                                <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-emerald-600 dark:bg-emerald-600/80 text-white text-xs font-medium rounded-lg hover:bg-emerald-700 dark:hover:bg-emerald-600 transition duration-150 shadow-sm" title="Mark as Read">
                                                    Mark Read
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="DeleteContactMessage" asp-route-id="@item.ContactID" method="post" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-rose-600 dark:bg-rose-600/80 text-white text-xs font-medium rounded-lg hover:bg-rose-700 dark:hover:bg-rose-600 transition duration-150 shadow-sm" title="Delete">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-sm text-gray-500 dark:text-zinc-400">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="w-12 h-12 text-gray-300 dark:text-zinc-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
                                    <p class="text-gray-500 dark:text-zinc-400 font-medium">No messages found.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>