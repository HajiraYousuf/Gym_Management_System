@{
    ViewData["Title"] = "Unified Payment Ledger & Collections";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-6 md:p-8 max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-zinc-900/60 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="p-2.5 bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 rounded-xl border border-emerald-100 dark:border-lime-400/20">
                <i class="fa-solid fa-file-invoice-dollar text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Payment Collections & Ledger</h1>
                <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Manage financial transactions, process collections, and generate standard 80mm receipts</p>
            </div>
        </div>
        <button onclick="openRecordPaymentModal()" class="px-5 h-11 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition shadow-md flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-plus text-sm"></i>
            Record Payment
        </button>
    </div>

    <!-- 1. TOP SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Card 1 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-emerald-600 dark:text-lime-400 font-bold block">Today's Collections</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">$1,450</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Collected Today</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-wallet"></i>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-zinc-400 font-bold block">Payments Received</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">18</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Successful Invoices</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300 flex items-center justify-center text-xl">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400 font-bold block">Pending Balances</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">$210</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Awaiting Collection</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-400/10 dark:text-amber-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block">Receipts Issued</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">18</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Total Generated</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>

    </div>

    <!-- SEARCH & FILTER CONTROLS -->
    <div class="bg-white dark:bg-zinc-900/80 p-4 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative w-full sm:w-44">
                <select id="filterStatus" onchange="filterPaymentsTable()" class="w-full h-11 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white text-xs font-semibold outline-none cursor-pointer appearance-none">
                    <option value="all">Status: All</option>
                    <option value="paid">Paid</option>
                    <option value="partial">Partial</option>
                    <option value="pending">Pending</option>
                    <option value="overdue">Overdue</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
            </div>
        </div>

        <div class="relative w-full sm:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="txtSearchPayment" onkeyup="filterPaymentsTable()" placeholder="Search Receipt #, Member, Reference..." 
                class="w-full h-11 pl-10 pr-4 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-zinc-600 text-xs font-medium outline-none transition shadow-inner" />
        </div>
    </div>

    <!-- 3. PAYMENT LEDGER TABLE -->
    <div class="bg-white dark:bg-zinc-900/80 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 dark:border-zinc-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-list-check text-emerald-600 dark:text-lime-400"></i>
                Financial Transactions & Ledgers
            </h3>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-lime-400/10 dark:text-lime-400 font-bold">PAYMENTS.ASPX</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="paymentsTable">
                <thead>
                    <tr class="bg-slate-50 dark:bg-zinc-950/60 text-[10px] uppercase tracking-wider text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 font-bold">
                        <th class="py-3.5 px-6">Receipt #</th>
                        <th class="py-3.5 px-4">Reference</th>
                        <th class="py-3.5 px-4">Member</th>
                        <th class="py-3.5 px-4">Payment For</th>
                        <th class="py-3.5 px-4">Method</th>
                        <th class="py-3.5 px-4">Amount</th>
                        <th class="py-3.5 px-4">Date</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/80 text-xs font-medium text-slate-800 dark:text-zinc-200">
                    
                    <!-- Row 1: Paid -->
                    <tr class="payment-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="paid">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">REC-8041</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">INV-2026-091</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Mohamed Abdi</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Membership</td>
                        <td class="py-4 px-4 font-semibold text-slate-700 dark:text-zinc-300">ZAAD</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$80</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">05 Aug • 10:15 AM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400">Paid</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('REC-8041', 'INV-2026-091', 'Mohamed Abdi', 'Membership', 'ZAAD', '$80', '05 Aug 2026 • 10:15 AM', 'Paid')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openReceiptModal('REC-8041', 'INV-2026-091', 'Mohamed Abdi', 'Membership', 'ZAAD', '$80', '05 Aug 2026')" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 dark:bg-blue-500/10 dark:hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 font-bold rounded-lg transition cursor-pointer">Print</button>
                        </td>
                    </tr>

                    <!-- Row 2: Partial -->
                    <tr class="payment-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="partial">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">REC-8039</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">INV-2026-088</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Hassan Omar</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Renewal</td>
                        <td class="py-4 px-4 font-semibold text-slate-700 dark:text-zinc-300">EVC Plus</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$100 / $150</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">04 Aug • 04:20 PM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400">Partial</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('REC-8039', 'INV-2026-088', 'Hassan Omar', 'Renewal', 'EVC Plus', '$100 / $150', '04 Aug 2026 • 04:20 PM', 'Partial')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openRecordPaymentModalWithData('Hassan Omar', 'Renewal', '$50')" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Pay Due</button>
                        </td>
                    </tr>

                    <!-- Row 3: Pending -->
                    <tr class="payment-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="pending">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">—</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">INV-2026-095</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Amina Ahmed</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Membership</td>
                        <td class="py-4 px-4 font-semibold text-slate-400">—</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$40</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">05 Aug • 11:00 AM</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300">Pending</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('—', 'INV-2026-095', 'Amina Ahmed', 'Membership', '—', '$40', '05 Aug 2026 • 11:00 AM', 'Pending')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openRecordPaymentModalWithData('Amina Ahmed', 'Membership', '$40')" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Collect</button>
                        </td>
                    </tr>

                    <!-- Row 4: Overdue -->
                    <tr class="payment-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="overdue">
                        <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">REC-8040</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">INV-2026-012</td>
                        <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">Khalid Hassan</td>
                        <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">Membership</td>
                        <td class="py-4 px-4 font-semibold text-slate-700 dark:text-zinc-300">Cash</td>
                        <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">$30</td>
                        <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">01 Aug • Overdue</td>
                        <td class="py-4 px-4 text-center">
                            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400">Overdue</span>
                        </td>
                        <td class="py-4 px-6 text-right space-x-1.5">
                            <button onclick="openViewModal('REC-8040', 'INV-2026-012', 'Khalid Hassan', 'Membership', 'Cash', '$30', '01 Aug 2026', 'Overdue')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                            <button onclick="openRecordPaymentModalWithData('Khalid Hassan', 'Membership', '$30')" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Collect</button>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- 2. RECORD NEW PAYMENT MODAL -->
<div id="recordPaymentModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden space-y-5 p-6 text-xs my-8">
        
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-cash-register text-emerald-600 dark:text-lime-400"></i>
                Record New Payment
            </h3>
            <button onclick="closeRecordPaymentModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Payment recorded successfully! Receipt generated.'); closeRecordPaymentModal();">
            
            <div class="space-y-1">
                <label class="block font-bold text-slate-700 dark:text-zinc-400">Member / Order</label>
                <input type="text" id="modalSearchMember" placeholder="Search Member, Order ID..." value="Amina Ahmed - MEM-9021"
                    class="w-full h-10 px-3.5 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none transition" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Payment For</label>
                    <select id="modalPaymentFor" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                        <option value="Membership">Membership</option>
                        <option value="Renewal">Renewal</option>
                        <option value="Order">Order</option>
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Reference</label>
                    <input type="text" value="INV-2026-095" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Amount Due</label>
                    <div id="modalAmountDue" class="h-10 px-3 bg-slate-100 dark:bg-zinc-950 border border-slate-300 dark:border-zinc-700 rounded-xl flex items-center font-mono font-bold text-slate-500 dark:text-zinc-400">
                        $40.00
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Amount Paid</label>
                    <input type="text" id="modalAmountPaid" value="$40.00" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono font-bold" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Payment Method</label>
                    <select class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                        <option>ZAAD</option>
                        <option>eDahab</option>
                        <option>EVC Plus</option>
                        <option>Cash</option>
                        <option>Credit/Debit Card</option>
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Payment Date</label>
                    <input type="text" value="11 Aug 2026" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono" />
                </div>
            </div>

            <div class="space-y-1">
                <label class="block font-bold text-slate-700 dark:text-zinc-400">Notes (Optional)</label>
                <textarea rows="2" placeholder="Add transaction comments..." class="w-full p-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none resize-none"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-zinc-800">
                <button type="button" onclick="closeRecordPaymentModal()" class="px-4 h-10 bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">Cancel</button>
                <button type="submit" class="px-5 h-10 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold uppercase tracking-wider rounded-xl transition shadow-md cursor-pointer">Confirm Payment</button>
            </div>
        </form>
    </div>
</div>

<!-- VIEW TRANSACTION MODAL -->
<div id="viewPaymentModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden space-y-4 p-6 text-xs">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-emerald-600 dark:text-lime-400"></i>
                Transaction Details
            </h3>
            <button onclick="closeViewModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-2.5 p-3.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
            <div class="flex justify-between"><span class="text-slate-500">Receipt #:</span> <strong id="viewReceiptNo" class="font-mono text-slate-900 dark:text-white">REC-8041</strong></div>
