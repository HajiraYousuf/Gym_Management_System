@model IEnumerable<GymManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "Unified Payment Ledger & Collections";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";

    // Tirakoobka Dynamic-ka ah (Card-yada sare)
    var totalCollectionsToday = Model != null ? Model.Where(p => p.PaymentDate.Date == DateTime.Today).Sum(p => p.AmountPaid) : 0;
    var successfulPaymentsCount = Model != null ? Model.Count(p => p.Status == "Paid") : 0;
    var pendingBalancesSum = Model != null ? Model.Where(p => p.Status == "Pending" || p.Status == "Partial" || p.Status == "Overdue").Sum(p => p.AmountDue - p.AmountPaid) : 0;
    var receiptsIssuedCount = Model != null ? Model.Count(p => !string.IsNullOrEmpty(p.ReceiptNumber)) : 0;
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-6 md:p-8 max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-zinc-900/60 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm">
        <div class="flex items-center gap-3">
            <span class="p-2.5 bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 rounded-xl border border-emerald-100 dark:border-lime-400/20">
                <i class="fa-solid fa-file-invoice-dollar text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">Payment Collections & Ledger</h1>
                <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Manage financial transactions, process collections, and generate standard 80mm receipts</p>
            </div>
        </div>
        <button onclick="openRecordPaymentModal()" class="px-5 h-11 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition shadow-md flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-plus text-sm"></i>
            Record Payment
        </button>
    </div>

    <!-- 1. TOP SUMMARY CARDS (DYNAMIC) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Card 1 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-emerald-600 dark:text-lime-400 font-bold block">Today's Collections</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">$@totalCollectionsToday</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Collected Today</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 dark:bg-lime-400/10 dark:text-lime-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-wallet"></i>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-zinc-400 font-bold block">Payments Received</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">@successfulPaymentsCount</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Successful Invoices</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300 flex items-center justify-center text-xl">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400 font-bold block">Pending Balances</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">$@pendingBalancesSum</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Awaiting Collection</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-400/10 dark:text-amber-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white dark:bg-zinc-900/80 p-5 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex items-center justify-between">
            <div class="space-y-1">
                <span class="text-xs uppercase tracking-wider text-blue-600 dark:text-blue-400 font-bold block">Receipts Issued</span>
                <h3 class="text-3xl font-black text-slate-900 dark:text-white">@receiptsIssuedCount</h3>
                <p class="text-[11px] text-slate-400 dark:text-zinc-500 font-medium">Total Generated</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 flex items-center justify-center text-xl">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>

    </div>

    <!-- SEARCH & FILTER CONTROLS -->
    <div class="bg-white dark:bg-zinc-900/80 p-4 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative w-full sm:w-44">
                <select id="filterStatus" onchange="filterPaymentsTable()" class="w-full h-11 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white text-xs font-semibold outline-none cursor-pointer appearance-none">
                    <option value="all">Status: All</option>
                    <option value="paid">Paid</option>
                    <option value="partial">Partial</option>
                    <option value="pending">Pending</option>
                    <option value="overdue">Overdue</option>
                </select>
                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
            </div>
        </div>

        <div class="relative w-full sm:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="txtSearchPayment" onkeyup="filterPaymentsTable()" placeholder="Search Receipt #, Member, Reference..." 
                class="w-full h-11 pl-10 pr-4 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-zinc-600 text-xs font-medium outline-none transition shadow-inner" />
        </div>
    </div>

    <!-- 3. PAYMENT LEDGER TABLE (DYNAMIC LOOP) -->
    <div class="bg-white dark:bg-zinc-900/80 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 dark:border-zinc-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-list-check text-emerald-600 dark:text-lime-400"></i>
                Financial Transactions & Ledgers
            </h3>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-lime-400/10 dark:text-lime-400 font-bold">DATABASE CONNECTED</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="paymentsTable">
                <thead>
                    <tr class="bg-slate-50 dark:bg-zinc-950/60 text-[10px] uppercase tracking-wider text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 font-bold">
                        <th class="py-3.5 px-6">Receipt #</th>
                        <th class="py-3.5 px-4">Reference</th>
                        <th class="py-3.5 px-4">Member</th>
                        <th class="py-3.5 px-4">Payment For</th>
                        <th class="py-3.5 px-4">Method</th>
                        <th class="py-3.5 px-4">Amount</th>
                        <th class="py-3.5 px-4">Date</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/80 text-xs font-medium text-slate-800 dark:text-zinc-200">
                    
                    @if (Model != null && Model.Any())
                    {
                        foreach (var pay in Model)
                        {
                            <tr class="payment-row hover:bg-slate-50/60 dark:hover:bg-zinc-800/30 transition" data-status="@pay.Status.ToLower()">
                                <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">@(string.IsNullOrEmpty(pay.ReceiptNumber) ? "—" : pay.ReceiptNumber)</td>
                                <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">@pay.Reference</td>
                                <td class="py-4 px-4 font-bold text-slate-900 dark:text-white">@pay.MemberName</td>
                                <td class="py-4 px-4 text-slate-600 dark:text-zinc-400">@pay.PaymentFor</td>
                                <td class="py-4 px-4 font-semibold text-slate-700 dark:text-zinc-300">@(string.IsNullOrEmpty(pay.Method) ? "—" : pay.Method)</td>
                                <td class="py-4 px-4 font-mono font-bold text-slate-900 dark:text-white">
                                    @(pay.Status == "Partial" ? $"${pay.AmountPaid} / ${pay.AmountDue}" : $"${pay.AmountPaid}")
                                </td>
                                <td class="py-4 px-4 font-mono text-slate-500 dark:text-zinc-400">@pay.PaymentDate.ToString("dd MMM yyyy • hh:mm tt")</td>
                                <td class="py-4 px-4 text-center">
                                    <span class="px-2.5 py-0.5 rounded text-[10px] font-bold 
                                        @(pay.Status == "Paid" ? "bg-emerald-100 text-emerald-700 dark:bg-lime-400/10 dark:text-lime-400" :
                                          pay.Status == "Partial" ? "bg-amber-100 text-amber-700 dark:bg-amber-400/10 dark:text-amber-400" :
                                          pay.Status == "Overdue" ? "bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400" :
                                          "bg-slate-100 text-slate-700 dark:bg-zinc-800 dark:text-zinc-300")">
                                        @pay.Status
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right space-x-1.5">
                                    <button onclick="openViewModal('@pay.ReceiptNumber', '@pay.Reference', '@pay.MemberName', '@pay.PaymentFor', '@pay.Method', '$@pay.AmountPaid', '@pay.PaymentDate.ToString("dd MMM yyyy")', '@pay.Status')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold rounded-lg transition cursor-pointer">View</button>
                                    
                                    @if (pay.Status == "Paid")
                                    {
                                        <button onclick="openReceiptModal('@pay.ReceiptNumber', '@pay.Reference', '@pay.MemberName', '@pay.PaymentFor', '@pay.Method', '$@pay.AmountPaid', '@pay.PaymentDate.ToString("dd MMM yyyy")')" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 dark:bg-blue-500/10 dark:hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 font-bold rounded-lg transition cursor-pointer">Print</button>
                                    }
                                    else
                                    {
                                        <button onclick="openRecordPaymentModalWithData('@pay.MemberName', '@pay.PaymentFor', '@pay.AmountDue')" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 dark:bg-lime-400/10 dark:hover:bg-lime-400/20 text-emerald-600 dark:text-lime-400 font-bold rounded-lg transition cursor-pointer">Collect</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-6 text-slate-400">Wali ma jiraan wax lacag-bixinayaal ah (Payments) oo la diiwaangeliyay.</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- 2. RECORD NEW PAYMENT MODAL (POST to Controller) -->
<div id="recordPaymentModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden space-y-5 p-6 text-xs my-8">
        
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-cash-register text-emerald-600 dark:text-lime-400"></i>
                Record New Payment
            </h3>
            <button onclick="closeRecordPaymentModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-action="RecordPayment" method="post" class="space-y-4">
            
            <div class="space-y-1">
                <label class="block font-bold text-slate-700 dark:text-zinc-400">Member / Order</label>
                <input type="text" id="modalSearchMember" name="MemberName" placeholder="Search Member, Order ID..." required
                    class="w-full h-10 px-3.5 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none transition" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Payment For</label>
                    <select id="modalPaymentFor" name="PaymentFor" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                        <option value="Membership">Membership</option>
                        <option value="Renewal">Renewal</option>
                        <option value="Order">Order</option>
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Reference</label>
                    <input type="text" name="Reference" value="INV-@DateTime.Now.ToString("yyyy-fff")" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Amount Due</label>
                    <input type="number" step="0.01" id="modalAmountDue" name="AmountDue" value="40.00" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono font-bold" />
                </div>
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Amount Paid</label>
                    <input type="number" step="0.01" id="modalAmountPaid" name="AmountPaid" value="40.00" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono font-bold" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Payment Method</label>
                    <select name="Method" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none cursor-pointer">
                        <option value="ZAAD">ZAAD</option>
                        <option value="eDahab">eDahab</option>
                        <option value="EVC Plus">EVC Plus</option>
                        <option value="Cash">Cash</option>
                        <option value="Credit/Debit Card">Credit/Debit Card</option>
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="block font-bold text-slate-700 dark:text-zinc-400">Payment Date</label>
                    <input type="date" name="PaymentDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full h-10 px-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none font-mono" />
                </div>
            </div>

            <div class="space-y-1">
                <label class="block font-bold text-slate-700 dark:text-zinc-400">Notes (Optional)</label>
                <textarea name="Notes" rows="2" placeholder="Add transaction comments..." class="w-full p-3 bg-slate-50 dark:bg-black border border-slate-300 dark:border-zinc-700 focus:border-emerald-500 dark:focus:border-lime-400 rounded-xl text-slate-900 dark:text-white outline-none resize-none"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-zinc-800">
                <button type="button" onclick="closeRecordPaymentModal()" class="px-4 h-10 bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">Cancel</button>
                <button type="submit" class="px-5 h-10 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold uppercase tracking-wider rounded-xl transition shadow-md cursor-pointer">Confirm Payment</button>
            </div>
        </form>
    </div>
</div>

<!-- VIEW TRANSACTION MODAL -->
<div id="viewPaymentModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden space-y-4 p-6 text-xs">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-4">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-emerald-600 dark:text-lime-400"></i>
                Transaction Details
            </h3>
            <button onclick="closeViewModal()" class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-2.5 p-3.5 rounded-xl bg-slate-50 dark:bg-zinc-950">
            <div class="flex justify-between"><span class="text-slate-500">Receipt #:</span> <strong id="viewReceiptNo" class="font-mono text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Reference:</span> <strong id="viewReference" class="font-mono text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Member:</span> <strong id="viewMember" class="text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Payment For:</span> <strong id="viewPaymentFor" class="text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Method:</span> <strong id="viewMethod" class="text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Amount:</span> <strong id="viewAmount" class="font-mono text-emerald-600 dark:text-lime-400"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Date:</span> <strong id="viewDate" class="font-mono text-slate-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span class="text-slate-500">Status:</span> <strong id="viewStatus" class="text-emerald-600 dark:text-lime-400"></strong></div>
        </div>

        <div class="flex justify-end pt-2 border-t border-slate-200 dark:border-zinc-800">
            <button onclick="closeViewModal()" class="px-4 h-10 bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-xl transition cursor-pointer">Close</button>
        </div>
    </div>
</div>

<!-- 80mm THERMAL RECEIPT MODAL -->
<div id="receiptModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl shadow-2xl overflow-hidden p-6 my-8" style="width: 80mm; min-height: auto;">
        
        <!-- Modal Top Bar -->
        <div class="flex justify-between items-center pb-3 mb-4 border-b border-slate-200 dark:border-zinc-800 no-print">
            <span class="text-xs font-bold text-slate-500 uppercase">80mm Thermal Receipt</span>
            <button onclick="closeReceiptModal()" class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Thermal Receipt Print Area -->
        <div id="thermalReceiptContent" class="bg-white text-zinc-900 p-4 rounded-xl font-mono text-[11px] leading-tight space-y-3 shadow-inner border border-slate-200">
            
            <div class="text-center space-y-1">
                <h3 class="font-black text-sm tracking-widest uppercase">POWER GYM CLUB</h3>
                <p class="text-[10px] text-zinc-600">Hargeisa, Main Branch</p>
                <p class="text-[10px] text-zinc-600">Tel: +252 63 0000000</p>
            </div>

            <div class="border-t border-dashed border-zinc-400 pt-2 space-y-1">
                <div class="flex justify-between"><span>Receipt #:</span> <strong id="rcptNo"></strong></div>
                <div class="flex justify-between"><span>Ref:</span> <strong id="rcptRef"></strong></div>
                <div class="flex justify-between"><span>Member:</span> <strong id="rcptMember"></strong></div>
                <div class="flex justify-between"><span>Date:</span> <span id="rcptDate"></span></div>
            </div>

            <div class="border-t border-dashed border-zinc-400 pt-2">
                <table class="w-full text-left text-[11px]">
                    <thead>
                        <tr class="border-b border-dashed border-zinc-300">
                            <th class="pb-1">Description</th>
                            <th class="pb-1 text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="rcptDesc" class="py-1">Gym Payment</td>
                            <td id="rcptDescAmount" class="py-1 text-right"></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="border-t border-dashed border-zinc-400 pt-2 space-y-1 font-bold">
                <div class="flex justify-between text-xs"><span>TOTAL PAID:</span> <span id="rcptTotal"></span></div>
                <div class="flex justify-between text-[10px] font-normal text-zinc-600"><span>Method:</span> <span id="rcptMethod"></span></div>
                <div class="flex justify-between text-[10px] font-normal text-zinc-600"><span>Status:</span> <span class="text-emerald-600 font-bold">PAID</span></div>
            </div>

            <div class="border-t border-dashed border-zinc-400 pt-3 text-center space-y-1">
                <p class="font-bold text-[10px]">MAHADSANID! THANK YOU!</p>
                <p class="text-[9px] text-zinc-500">No refunds after 24 hours.</p>
            </div>

        </div>

        <!-- Print Actions -->
        <div class="flex gap-2 pt-4 no-print">
            <button onclick="window.print()" class="w-full h-10 bg-slate-100 hover:bg-slate-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-700 dark:text-zinc-300 font-bold text-xs rounded-xl transition cursor-pointer">Print Slip</button>
            <button onclick="closeReceiptModal()" class="w-full h-10 bg-emerald-600 hover:bg-emerald-700 dark:bg-lime-400 dark:hover:bg-lime-300 text-white dark:text-zinc-950 font-extrabold text-xs uppercase tracking-wider rounded-xl transition cursor-pointer">Done</button>
        </div>

    </div>
</div>

<!-- JavaScript Controls & Filtering -->
<script>
    function filterPaymentsTable() {
        let statusFilter = document.getElementById('filterStatus').value.toLowerCase();
        let searchInput = document.getElementById('txtSearchPayment').value.toLowerCase();
        let rows = document.querySelectorAll('.payment-row');

        rows.forEach(row => {
            let rowStatus = row.getAttribute('data-status');
            let rowText = row.innerText.toLowerCase();

            let matchesStatus = (statusFilter === 'all' || rowStatus === statusFilter);
            let matchesSearch = (rowText.includes(searchInput));

            if (matchesStatus && matchesSearch) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    function openRecordPaymentModal() {
        document.getElementById('recordPaymentModal').classList.remove('hidden');
    }
    
    function openRecordPaymentModalWithData(memberName, paymentFor, dueAmount) {
        document.getElementById('modalSearchMember').value = memberName;
        document.getElementById('modalPaymentFor').value = paymentFor;
        document.getElementById('modalAmountDue').value = dueAmount;
        document.getElementById('modalAmountPaid').value = dueAmount;
        document.getElementById('recordPaymentModal').classList.remove('hidden');
    }
    
    function closeRecordPaymentModal() {
        document.getElementById('recordPaymentModal').classList.add('hidden');
    }

    function openViewModal(receipt, ref, member, paymentFor, method, amount, date, status) {
        document.getElementById('viewReceiptNo').innerText = receipt || '—';
        document.getElementById('viewReference').innerText = ref;
        document.getElementById('viewMember').innerText = member;
        document.getElementById('viewPaymentFor').innerText = paymentFor;
        document.getElementById('viewMethod').innerText = method || '—';
        document.getElementById('viewAmount').innerText = amount;
        document.getElementById('viewDate').innerText = date;
        document.getElementById('viewStatus').innerText = status;
        document.getElementById('viewPaymentModal').classList.remove('hidden');
    }
    
    function closeViewModal() {
        document.getElementById('viewPaymentModal').classList.add('hidden');
    }

    function openReceiptModal(receipt, ref, member, paymentFor, method, amount, date) {
        document.getElementById('rcptNo').innerText = receipt || 'REC-000';
        document.getElementById('rcptRef').innerText = ref;
        document.getElementById('rcptMember').innerText = member;
        document.getElementById('rcptDesc').innerText = 'Gym ' + paymentFor;
        document.getElementById('rcptDescAmount').innerText = amount;
        document.getElementById('rcptTotal').innerText = amount;
        document.getElementById('rcptMethod').innerText = method || 'Cash';
        document.getElementById('rcptDate').innerText = date;
        document.getElementById('receiptModal').classList.remove('hidden');
    }
    
    function closeReceiptModal() { 
        document.getElementById('receiptModal').classList.add('hidden'); 
    }
</script>