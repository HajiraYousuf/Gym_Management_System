<!-- JavaScript Controls -->
<script>
    // Record Payment Modal
    function openRecordPaymentModal() {
        document.getElementById('recordPaymentModal').classList.remove('hidden');
    }
    function openRecordPaymentModalWithData(memberName, paymentFor, dueAmount) {
        document.getElementById('modalSearchMember').value = memberName;
        document.getElementById('modalPaymentFor').value = paymentFor;
        document.getElementById('modalAmountDue').innerText = dueAmount + '.00';
        document.getElementById('modalAmountPaid').value = dueAmount + '.00';
        document.getElementById('recordPaymentModal').classList.remove('hidden');
    }
    function closeRecordPaymentModal() {
        document.getElementById('recordPaymentModal').classList.add('hidden');
    }

    // View Modal
    function openViewModal(receipt, ref, member, paymentFor, method, amount, date, status) {
        document.getElementById('viewReceiptNo').innerText = receipt;
        document.getElementById('viewReference').innerText = ref;
        document.getElementById('viewMember').innerText = member;
        document.getElementById('viewPaymentFor').innerText = paymentFor;
        document.getElementById('viewMethod').innerText = method;
        document.getElementById('viewAmount').innerText = amount;
        document.getElementById('viewDate').innerText = date;
        document.getElementById('viewStatus').innerText = status;
        document.getElementById('viewPaymentModal').classList.remove('hidden');
    }
    function closeViewModal() {
        document.getElementById('viewPaymentModal').classList.add('hidden');
    }

    // Thermal Receipt Modal (80mm width)
    function openReceiptModal(receipt, ref, member, paymentFor, method, amount, date) {
        document.getElementById('rcptNo').innerText = receipt;
        document.getElementById('rcptRef').innerText = ref;
        document.getElementById('rcptMember').innerText = member;
        document.getElementById('rcptDesc').innerText = 'Gym ' + paymentFor;
        document.getElementById('rcptDescAmount').innerText = amount;
        document.getElementById('rcptTotal').innerText = amount;
        document.getElementById('rcptMethod').innerText = method;
        document.getElementById('rcptDate').innerText = date;
        document.getElementById('receiptModal').classList.remove('hidden');
    }
    function closeReceiptModal() {
        document.getElementById('receiptModal').classList.add('hidden');
    }

    // Filter & Search Engine
    function filterPaymentsTable() {
        const query = document.getElementById('txtSearchPayment').value.toLowerCase();
        const statusFilter = document.getElementById('filterStatus').value;
        const rows = document.querySelectorAll('.payment-row');

        rows.forEach(row => {
            const rowText = row.innerText.toLowerCase();
            const rowStatus = row.getAttribute('data-status');

            const matchesSearch = rowText.includes(query);
            const matchesStatus = (statusFilter === 'all' || rowStatus === statusFilter);

            if (matchesSearch && matchesStatus) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>