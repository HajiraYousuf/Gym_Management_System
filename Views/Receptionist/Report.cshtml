@{
    ViewData["Title"] = "Front Desk Reports";
    Layout = "~/Views/layouts/ReceptionMaster.cshtml";
    
    string currentTab = ViewBag.CurrentTab ?? "attendance";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="space-y-6 min-h-screen bg-gray-50 dark:bg-black text-gray-800 dark:text-gray-100 p-2 sm:p-4 transition-colors duration-300">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-200 dark:border-zinc-800 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-wider mb-0.5">
                <span>Receptionist Module</span> • <span>Reports</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">Front Desk Reports</h1>
            <p class="text-xs sm:text-sm text-gray-500 dark:text-zinc-400 mt-1">Select a report category to view live database records.</p>
        </div>

        <!-- Global Action Buttons -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <a href="@Url.Action("ExportReport", new { tab = currentTab })" class="bg-lime-400 hover:bg-lime-500 text-black font-extrabold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg shadow-lime-500/20 transition-all w-full sm:w-auto">
                <i class="fas fa-file-export"></i> Export Selected
            </a>
            
            <button type="button" onclick="window.print();" class="bg-white dark:bg-zinc-900 hover:bg-gray-100 dark:hover:bg-zinc-800 text-gray-700 dark:text-gray-200 px-4 py-2.5 rounded-xl border border-gray-200 dark:border-zinc-800 font-medium text-sm flex items-center justify-center gap-2 transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-print text-lime-500"></i> Print Report
            </button>
        </div>
    </div>

    <!-- 1. Report Selector Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        
        <!-- Attendance Card -->
        <div onclick="switchReportTab('attendance')" id="card-attendance" class="report-card bg-white dark:bg-zinc-900 border @(currentTab == "attendance" ? "border-lime-500 ring-2 ring-lime-500/20" : "border-gray-200 dark:border-zinc-800") rounded-2xl p-5 shadow-sm hover:border-lime-500/50 transition-all cursor-pointer">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-clipboard-user"></i>
                </div>
                <span class="text-xs font-mono font-bold text-gray-400">@ViewBag.TotalCheckIns Check-ins</span>
            </div>
            <h3 class="text-base font-bold text-gray-900 dark:text-white">Attendance Report</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 mb-4">Track member check-ins, check-outs, and active gym users.</p>
            <div class="w-full bg-gray-100 dark:bg-zinc-800 text-gray-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2">
                <i class="fas fa-eye"></i> View Attendance
            </div>
        </div>

        <!-- Payments Card -->
        <div onclick="switchReportTab('payments')" id="card-payments" class="report-card bg-white dark:bg-zinc-900 border @(currentTab == "payments" ? "border-lime-500 ring-2 ring-lime-500/20" : "border-gray-200 dark:border-zinc-800") rounded-2xl p-5 shadow-sm hover:border-lime-500/50 transition-all cursor-pointer">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-receipt"></i>
                </div>
                <span class="text-xs font-mono font-bold text-lime-600 dark:text-lime-400">$@ViewBag.TotalCollectedToday Today</span>
            </div>
            <h3 class="text-base font-bold text-gray-900 dark:text-white">Payment Collection</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 mb-4">Front desk daily transactions, fee receipts, and collections.</p>
            <div class="w-full bg-gray-100 dark:bg-zinc-800 text-gray-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2">
                <i class="fas fa-eye"></i> View Payments
            </div>
        </div>

        <!-- Users / Registrations Card -->
        <div onclick="switchReportTab('registrations')" id="card-registrations" class="report-card bg-white dark:bg-zinc-900 border @(currentTab == "registrations" ? "border-lime-500 ring-2 ring-lime-500/20" : "border-gray-200 dark:border-zinc-800") rounded-2xl p-5 shadow-sm hover:border-lime-500/50 transition-all cursor-pointer">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-user-plus"></i>
                </div>
                <span class="text-xs font-mono font-bold text-blue-500">@ViewBag.NewMembersCount Users</span>
            </div>
            <h3 class="text-base font-bold text-gray-900 dark:text-white">User Accounts</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 mb-4">Newly registered system users and members.</p>
            <div class="w-full bg-gray-100 dark:bg-zinc-800 text-gray-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2">
                <i class="fas fa-eye"></i> View Registrations
            </div>
        </div>

        <!-- Visitors Card -->
        <div onclick="switchReportTab('visitors')" id="card-visitors" class="report-card bg-white dark:bg-zinc-900 border @(currentTab == "visitors" ? "border-lime-500 ring-2 ring-lime-500/20" : "border-gray-200 dark:border-zinc-800") rounded-2xl p-5 shadow-sm hover:border-lime-500/50 transition-all cursor-pointer">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-users"></i>
                </div>
                <span class="text-xs font-mono font-bold text-amber-500">@ViewBag.VisitorCount Visitors</span>
            </div>
            <h3 class="text-base font-bold text-gray-900 dark:text-white">Visitor Report</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 mb-4">Guest entries, trial visits, and current active visitors.</p>
            <div class="w-full bg-gray-100 dark:bg-zinc-800 text-gray-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2">
                <i class="fas fa-eye"></i> View Visitors
            </div>
        </div>

        <!-- Reservations Card -->
        <div onclick="switchReportTab('reservations')" id="card-reservations" class="report-card bg-white dark:bg-zinc-900 border @(currentTab == "reservations" ? "border-lime-500 ring-2 ring-lime-500/20" : "border-gray-200 dark:border-zinc-800") rounded-2xl p-5 shadow-sm hover:border-lime-500/50 transition-all cursor-pointer">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <span class="text-xs font-mono font-bold text-rose-500">@ViewBag.ReservationCount Bookings</span>
            </div>
            <h3 class="text-base font-bold text-gray-900 dark:text-white">Reservation Report</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1 mb-4">Daily class booking status and capacity check.</p>
            <div class="w-full bg-gray-100 dark:bg-zinc-800 text-gray-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-2">
                <i class="fas fa-eye"></i> View Reservations
            </div>
        </div>

    </div>

    <!-- 2. Navigation Tabs Bar -->
    <div class="flex items-center gap-2 border-b border-gray-200 dark:border-zinc-800 overflow-x-auto pt-4 pb-1">
        <button onclick="switchReportTab('attendance')" id="tab-attendance" class="report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 @(currentTab == "attendance" ? "bg-lime-400 text-black shadow-md shadow-lime-500/10" : "bg-white dark:bg-zinc-900 text-gray-600 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white cursor-pointer")">
            <i class="fas fa-clipboard-user"></i> Attendance
        </button>
        <button onclick="switchReportTab('payments')" id="tab-payments" class="report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 @(currentTab == "payments" ? "bg-lime-400 text-black shadow-md shadow-lime-500/10" : "bg-white dark:bg-zinc-900 text-gray-600 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white cursor-pointer")">
            <i class="fas fa-receipt"></i> Payments
        </button>
        <button onclick="switchReportTab('registrations')" id="tab-registrations" class="report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 @(currentTab == "registrations" ? "bg-lime-400 text-black shadow-md shadow-lime-500/10" : "bg-white dark:bg-zinc-900 text-gray-600 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white cursor-pointer")">
            <i class="fas fa-user-plus"></i> User Accounts
        </button>
        <button onclick="switchReportTab('visitors')" id="tab-visitors" class="report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 @(currentTab == "visitors" ? "bg-lime-400 text-black shadow-md shadow-lime-500/10" : "bg-white dark:bg-zinc-900 text-gray-600 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white cursor-pointer")">
            <i class="fas fa-users"></i> Visitors
        </button>
        <button onclick="switchReportTab('reservations')" id="tab-reservations" class="report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 @(currentTab == "reservations" ? "bg-lime-400 text-black shadow-md shadow-lime-500/10" : "bg-white dark:bg-zinc-900 text-gray-600 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white cursor-pointer")">
            <i class="fas fa-calendar-check"></i> Reservations
        </button>
    </div>

    <!-- 3. Dynamic Detail Tables Section -->
    <div>
        <!-- ATTENDANCE PANEL -->
        <div id="panel-attendance" class="report-panel bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm space-y-6 @(currentTab == "attendance" ? "" : "hidden")">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-100 dark:border-zinc-800 pb-4">
                <div>
                    <h2 class="text-lg font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-clipboard-user text-lime-500"></i> Attendance Report Details
                    </h2>
                    <p class="text-xs text-gray-500 dark:text-zinc-400">Live database records of check-ins for today</p>
                </div>
                <div class="flex items-center gap-3 text-xs font-mono">
                    <span class="px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 font-bold">Total: @ViewBag.TotalCheckIns</span>
                    <span class="px-3 py-1.5 rounded-xl bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 font-bold">Inside: @ViewBag.CurrentlyInsideCount</span>
                    <span class="px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 font-bold">Check-Outs: @ViewBag.CheckedOutCount</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 dark:text-zinc-300">
                    <thead class="bg-gray-50 dark:bg-black text-gray-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider">
                        <tr>
                            <th class="p-3.5">ID</th>
                            <th class="p-3.5">Member Name</th>
                            <th class="p-3.5">Check-In Time</th>
                            <th class="p-3.5 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-zinc-800 text-xs">
                        @{
                            var attendances = ViewBag.AttendanceList as List<GymManagementSystem.Models.AttendanceRecord>;
                            if (attendances != null && attendances.Any())
                            {
                                foreach (var att in attendances)
                                {
                                    <tr>
                                        <td class="p-3.5 font-mono font-bold text-lime-600 dark:text-lime-400">#@att.Id</td>
                                        <td class="p-3.5 font-bold text-gray-900 dark:text-white">@att.MemberId                                         </td>
                                        <td class="p-3.5 font-mono">@att.CheckIn</td>
                                        <td class="p-3.5 text-right">
                                            <span class="px-2.5 py-1 font-bold rounded-full bg-lime-400/20 text-lime-600 dark:text-lime-400">
                                                @att.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-6 text-gray-400 font-medium">No attendance records found for today.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PAYMENTS PANEL -->
        <div id="panel-payments" class="report-panel bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm space-y-6 @(currentTab == "payments" ? "" : "hidden")">
            <div class="flex justify-between items-center border-b border-gray-100 dark:border-zinc-800 pb-4">
                <div>
                    <h2 class="text-lg font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-receipt text-lime-500"></i> Payment Collection Details
                    </h2>
                    <p class="text-xs text-gray-500 dark:text-zinc-400">Live transactions recorded today</p>
                </div>
                <span class="text-sm font-black text-lime-600 dark:text-lime-400 font-mono">Total Collected: $@ViewBag.TotalCollectedToday</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 dark:text-zinc-300">
                    <thead class="bg-gray-50 dark:bg-black text-gray-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider">
                        <tr>
                            <th class="p-3.5">Date & Time</th>
                            <th class="p-3.5">Payment Method</th>
                            <th class="p-3.5">Amount</th>
                            <th class="p-3.5 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-zinc-800 text-xs">
                        @{
                            var payments = ViewBag.PaymentList as List<GymManagementSystem.Models.Payment>;
                            if (payments != null && payments.Any())
                            {
                                foreach (var pay in payments)
                                {
                                    <tr>
                                        <td class="p-3.5 font-mono">@pay.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="p-3.5 font-bold text-gray-900 dark:text-white">@pay.Method</td>
                                        <td class="p-3.5 font-mono font-bold text-lime-600 dark:text-lime-400">$@pay.AmountPaid</td>
                                        <td class="p-3.5 text-right"><span class="px-2.5 py-1 font-bold rounded-full bg-lime-400/20 text-lime-600 dark:text-lime-400">Completed</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-6 text-gray-400 font-medium">No payments recorded today.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- REGISTRATIONS PANEL -->
        <div id="panel-registrations" class="report-panel bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm space-y-6 @(currentTab == "registrations" ? "" : "hidden")">
            <div class="flex justify-between items-center border-b border-gray-100 dark:border-zinc-800 pb-4">
                <div>
                    <h2 class="text-lg font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-user-plus text-blue-500"></i> User Accounts Details
                    </h2>
                    <p class="text-xs text-gray-500 dark:text-zinc-400">Registered system users</p>
                </div>
                <span class="text-xs font-mono font-bold text-blue-500">@ViewBag.NewMembersCount Users</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 dark:text-zinc-300">
                    <thead class="bg-gray-50 dark:bg-black text-gray-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider">
                        <tr>
                            <th class="p-3.5">User ID</th>
                            <th class="p-3.5">Username</th>
                            <th class="p-3.5">Email</th>
                            <th class="p-3.5 text-right">Role</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-zinc-800 text-xs">
                        @{
                            var registrations = ViewBag.RegistrationList as List<GymManagementSystem.Models.UserProfile>;
                            if (registrations != null && registrations.Any())
                            {
                                foreach (var reg in registrations)
                                {
                                    <tr>
                                        <td class="p-3.5 font-mono font-bold text-lime-600 dark:text-lime-400">#@reg.Id</td>
                                        <td class="p-3.5 font-bold text-gray-900 dark:text-white">@reg.Username</td>
                                        <td class="p-3.5">@reg.Email</td>
                                        <td class="p-3.5 text-right"><span class="px-2.5 py-1 font-bold rounded-full bg-lime-400/20 text-lime-600 dark:text-lime-400">@reg.Role</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-6 text-gray-400 font-medium">No user accounts found.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- VISITORS PANEL -->
        <div id="panel-visitors" class="report-panel bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm space-y-6 @(currentTab == "visitors" ? "" : "hidden")">
            <div class="flex justify-between items-center border-b border-gray-100 dark:border-zinc-800 pb-4">
                <div>
                    <h2 class="text-lg font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-users text-amber-500"></i> Visitor Activity Report Details
                    </h2>
                    <p class="text-xs text-gray-500 dark:text-zinc-400">Front desk visitor log for today</p>
                </div>
                <span class="px-3 py-1 rounded-lg bg-gray-100 dark:bg-zinc-800 font-bold text-xs font-mono">Total: @ViewBag.VisitorCount</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 dark:text-zinc-300">
                    <thead class="bg-gray-50 dark:bg-black text-gray-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider">
                        <tr>
                            <th class="p-3.5">Visitor Name</th>
                            <th class="p-3.5">Visit Type</th>
                            <th class="p-3.5">Check In</th>
                            <th class="p-3.5 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-zinc-800 text-xs">
                        @{
                            var visitors = ViewBag.VisitorList as List<GymManagementSystem.Models.Visitor>;
                            if (visitors != null && visitors.Any())
                            {
                                foreach (var vis in visitors)
                                {
                                    <tr>
                                        <td class="p-3.5 font-bold text-gray-900 dark:text-white">@vis.FullName</td>
                                        <td class="p-3.5">@vis.VisitType</td>
                                        <td class="p-3.5 font-mono">@vis.CheckInTime</td>
                                        <td class="p-3.5 text-right">
                                            <span class="px-2.5 py-1 font-bold rounded-full @(vis.Status == "Inside" ? "bg-lime-400/20 text-lime-600 dark:text-lime-400" : "bg-blue-500/20 text-blue-500")">
                                                @vis.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-6 text-gray-400 font-medium">No visitors recorded today.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- RESERVATIONS PANEL -->
        <div id="panel-reservations" class="report-panel bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm space-y-6 @(currentTab == "reservations" ? "" : "hidden")">
            <div class="flex justify-between items-center border-b border-gray-100 dark:border-zinc-800 pb-4">
                <div>
                    <h2 class="text-lg font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="fas fa-calendar-check text-rose-500"></i> Reservation Report Details
                    </h2>
                    <p class="text-xs text-gray-500 dark:text-zinc-400">Class bookings overview</p>
                </div>
                <span class="text-xs font-mono font-bold text-lime-600 dark:text-lime-400">Total Bookings: @ViewBag.ReservationCount</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 dark:text-zinc-300">
                    <thead class="bg-gray-50 dark:bg-black text-gray-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider">
                        <tr>
                            <th class="p-3.5">Class Name</th>
                            <th class="p-3.5">Reservation Date</th>
                            <th class="p-3.5 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-zinc-800 text-xs">
                        @{
                            var reservations = ViewBag.ReservationList as List<GymManagementSystem.Models.GymReservation>;
                            if (reservations != null && reservations.Any())
                            {
                                foreach (var res in reservations)
                                {
                                    <tr>
                                        <td class="p-3.5 font-bold text-gray-900 dark:text-white">@(res.ClassName ?? "General Class")</td>
                                        <td class="p-3.5 font-mono">@res.ReservationDate.ToString("dd MMM yyyy")</td>
                                        <td class="p-3.5 text-right"><span class="px-2.5 py-1 font-bold rounded-full bg-lime-400/20 text-lime-600 dark:text-lime-400">Confirmed</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-6 text-gray-400 font-medium">No class reservations found.</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Client-Side Tab Switcher Script -->
<script>
    function switchReportTab(tabName) {
        // 1. Hide all detail table panels
        const panels = document.querySelectorAll('.report-panel');
        panels.forEach(p => p.classList.add('hidden'));

        // Show target panel
        const targetPanel = document.getElementById('panel-' + tabName);
        if (targetPanel) {
            targetPanel.classList.remove('hidden');
        }

        // 2. Reset and update Navigation Tabs styling
        const tabs = document.querySelectorAll('.report-tab');
        tabs.forEach(t => {
            t.className = "report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 bg-white dark:bg-zinc-900 text-gray-600 dark:text-zinc-400 hover:text-gray-900 dark:hover:text-white cursor-pointer";
        });
        const activeTab = document.getElementById('tab-' + tabName);
        if (activeTab) {
            activeTab.className = "report-tab px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all flex items-center gap-2 bg-lime-400 text-black shadow-md shadow-lime-500/10";
        }

        // 3. Reset and update Overview Cards border & ring styling
        const cards = document.querySelectorAll('.report-card');
        cards.forEach(c => {
            c.className = "report-card bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm hover:border-lime-500/50 transition-all cursor-pointer";
        });
        const activeCard = document.getElementById('card-' + tabName);
        if (activeCard) {
            activeCard.className = "report-card bg-white dark:bg-zinc-900 border border-lime-500 ring-2 ring-lime-500/20 rounded-2xl p-5 shadow-sm transition-all cursor-pointer";
        }

        // Update URL query string without reloading page
        const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + '?tab=' + tabName;
        window.history.pushState({path: newUrl}, '', newUrl);
    }
</script>