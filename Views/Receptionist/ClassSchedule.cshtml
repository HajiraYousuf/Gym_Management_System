<!-- JavaScript for Table Search & Modal Actions -->
<script>
    function filterClassTable() {
        const input = document.getElementById('txtClassSearch').value.toLowerCase();
        const rows = document.querySelectorAll('.class-row');

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (text.includes(input)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Booking Modal Controls
    function openBookingModal(className, trainer, date, time, available) {
        document.getElementById('modalClassName').innerText = className;
        document.getElementById('modalTrainerName').innerText = trainer;
        document.getElementById('modalDateTime').innerText = date + ' • ' + time;
        document.getElementById('modalAvailableSeats').innerText = available + ' Seats';
        
        document.getElementById('foundMemberCard').classList.add('hidden');
        document.getElementById('txtMemberSearchInput').value = '';
        document.getElementById('bookingModal').classList.remove('hidden');
    }

    function closeBookingModal() {
        document.getElementById('bookingModal').classList.add('hidden');
    }

    function simulateMemberSearch() {
        const val = document.getElementById('txtMemberSearchInput').value.trim();
        if(val.length > 0) {
            document.getElementById('foundMemberCard').classList.remove('hidden');
        }
    }

    function confirmBookingAction() {
        alert("Reservation successfully created! Redirecting to Reservations manager view.");
        closeBookingModal();
    }

    // View Details Modal Controls
    function openViewModal(className, trainer, date, time, capacity, booked, available) {
        document.getElementById('viewClassName').innerText = className;
        document.getElementById('viewTrainerName').innerText = trainer;
        document.getElementById('viewDate').innerText = date;
        document.getElementById('viewTime').innerText = time;
        document.getElementById('viewCapacity').innerText = capacity;
        document.getElementById('viewBooked').innerText = booked;
        document.getElementById('viewAvailable').innerText = available;
        
        document.getElementById('viewClassModal').classList.remove('hidden');
    }

    function closeViewModal() {
        document.getElementById('viewClassModal').classList.add('hidden');
    }
</script>