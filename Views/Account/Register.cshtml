@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model GymManagementSystem.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FitZone - Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: '#ccff00',
                        }
                    }
                }
            }
    </script>
</head>
<body class="bg-black text-white font-sans min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-4xl">

        <form asp-action="Register" asp-controller="Account" method="post" class="grid grid-cols-1 md:grid-cols-12 bg-[#0c0c0e] rounded-3xl overflow-hidden border border-zinc-800 shadow-2xl my-auto">

            <!-- Left Hero Section -->
            <div class="md:col-span-5 relative bg-[#08080a] p-8 flex flex-col justify-between overflow-hidden min-h-[520px]">
                <div class="absolute inset-0 bg-cover bg-center opacity-30 mix-blend-luminosity" style="background-image: url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=800&auto=format&fit=crop');"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/60"></div>

                <!-- Logo -->
                <div class="relative z-10 flex items-center space-x-3">
                    <div class="w-9 h-9 bg-[#ccff00] rounded-xl flex items-center justify-center text-black font-black text-xl">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold tracking-wide text-white leading-tight">FitZone</h1>
                        <p class="text-[10px] text-zinc-400">Stronger Every Day</p>
                    </div>
                </div>

                <!-- Text -->
                <div class="relative z-10 my-auto pt-20">
                    <h2 class="text-2xl font-bold tracking-tight text-white">
                        Join <span class="text-[#ccff00]">FitZone</span>
                    </h2>
                    <p class="text-zinc-400 text-xs mt-1">Create an account and start<br />your transformation today</p>
                </div>

                <!-- Accent Shape -->
                <div class="absolute -bottom-1 -left-1 w-24 h-24 bg-[#ccff00] z-10" style="clip-path: polygon(0 100%, 100% 100%, 0 0);"></div>
            </div>

            <!-- Right Form Section -->
            <div class="md:col-span-7 p-6 md:p-8 flex flex-col justify-center bg-[#0c0c0e]">
                <div class="max-w-sm mx-auto w-full space-y-3.5">

                    <div>
                        <h2 class="text-2xl font-bold text-white">Reg<span class="text-[#ccff00]">ister</span></h2>
                        <p class="text-zinc-400 text-xs">Create your account to get started</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-red-400 bg-red-500/10 border border-red-500/30 rounded-xl px-3 py-2 text-[11px] empty:hidden"></div>

                    <!-- Full Name Field -->
                    <div class="space-y-1">
                        <label class="text-[11px] font-medium text-zinc-300">Full Name</label>
                        <div class="relative flex items-center">
                            <svg class="w-4 h-4 absolute left-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                            <input asp-for="FullName" type="text"
                                   class="w-full bg-[#141417] border border-zinc-800 rounded-xl py-2 pl-10 pr-4 text-xs text-white placeholder-zinc-600 focus:outline-none focus:border-[#ccff00] transition"
                                   placeholder="Enter your full name" />
                        </div>
                        <span asp-validation-for="FullName" class="text-red-500 text-[10px]"></span>
                    </div>

                    <!-- Email Field -->
                    <div class="space-y-1">
                        <label class="text-[11px] font-medium text-zinc-300">Email Address</label>
                        <div class="relative flex items-center">
                            <svg class="w-4 h-4 absolute left-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            <input asp-for="Email" type="email"
                                   class="w-full bg-[#141417] border border-zinc-800 rounded-xl py-2 pl-10 pr-4 text-xs text-white placeholder-zinc-600 focus:outline-none focus:border-[#ccff00] transition"
                                   placeholder="Enter your email" />
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-[10px]"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="space-y-1">
                        <label class="text-[11px] font-medium text-zinc-300">Password</label>
                        <div class="relative flex items-center">
                            <svg class="w-4 h-4 absolute left-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            <input asp-for="Password" id="passwordInput" type="password"
                                   class="w-full bg-[#141417] border border-zinc-800 rounded-xl py-2 pl-10 pr-10 text-xs text-white placeholder-zinc-600 focus:outline-none focus:border-[#ccff00] transition"
                                   placeholder="Create a password" />
                            <button type="button" onclick="toggleVisibility('passwordInput', 'eyeIcon1')" class="absolute right-3.5 text-zinc-500 hover:text-[#ccff00] focus:outline-none">
                                <svg id="eyeIcon1" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-[10px]"></span>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="space-y-1">
                        <label class="text-[11px] font-medium text-zinc-300">Confirm Password</label>
                        <div class="relative flex items-center">
                            <svg class="w-4 h-4 absolute left-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            <input asp-for="ConfirmPassword" id="confirmPasswordInput" type="password"
                                   class="w-full bg-[#141417] border border-zinc-800 rounded-xl py-2 pl-10 pr-10 text-xs text-white placeholder-zinc-600 focus:outline-none focus:border-[#ccff00] transition"
                                   placeholder="Confirm your password" />
                            <button type="button" onclick="toggleVisibility('confirmPasswordInput', 'eyeIcon2')" class="absolute right-3.5 text-zinc-500 hover:text-[#ccff00] focus:outline-none">
                                <svg id="eyeIcon2" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-[10px]"></span>
                    </div>

                    <!-- Terms -->
                    <div class="flex items-center space-x-2 text-[10px] text-zinc-400">
                        <input asp-for="AgreeToTerms" type="checkbox" class="accent-[#ccff00]" />
                        <span>
                            I agree to
                            <a href="#" class="text-[#ccff00] hover:underline">Terms</a> &
                            <a href="#" class="text-[#ccff00] hover:underline">Privacy Policy</a>
                        </span>
                    </div>
                    <span asp-validation-for="AgreeToTerms" class="text-red-500 text-[10px] block"></span>

                    <!-- Register Button -->
                    <button type="submit" class="w-full bg-[#ccff00] hover:bg-lime-400 text-black font-bold py-2.5 rounded-xl transition duration-200 cursor-pointer text-xs uppercase tracking-wider">
                        Create Account &rarr;
                    </button>

                    <!-- Divider -->
                    <div class="relative flex items-center justify-center my-2">
                        <div class="border-t border-zinc-800 w-full"></div>
                        <span class="bg-[#0c0c0e] px-2 text-[10px] text-zinc-500 uppercase">or continue with</span>
                        <div class="border-t border-zinc-800 w-full"></div>
                    </div>

                    <!-- Social Media Buttons -->
                    <div class="grid grid-cols-4 gap-2.5">
                        <button type="button" id="btnGoogle" class="w-full bg-[#141417] hover:bg-zinc-800 border border-zinc-800 py-2 rounded-xl flex items-center justify-center transition cursor-pointer group">
                            <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.1 9 5 12 5z" /><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z" /><path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15s.7 5.3 1.9 7.7l3.7-2.9c-.6-1.5-1-3.2-1-5z" /><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.1-6.4-5.2L1.9 16C3.7 19.7 7.5 23 12 23z" /></svg>
                        </button>
                        <button type="button" id="btnFacebook" class="w-full bg-[#141417] hover:bg-zinc-800 border border-zinc-800 py-2 rounded-xl flex items-center justify-center transition cursor-pointer group">
                            <svg class="w-4 h-4 fill-[#1877F2]" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
                        </button>
                        <button type="button" id="btnLinkedIn" class="w-full bg-[#141417] hover:bg-zinc-800 border border-zinc-800 py-2 rounded-xl flex items-center justify-center transition cursor-pointer group">
                            <svg class="w-4 h-4 fill-[#0A66C2]" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.48 1.48 0 1 0 0 2.96 1.48 1.48 0 0 0 0-2.96z" /></svg>
                        </button>
                        <button type="button" id="btnGitHub" class="w-full bg-[#141417] hover:bg-zinc-800 border border-zinc-800 py-2 rounded-xl flex items-center justify-center transition cursor-pointer group">
                            <svg class="w-4 h-4 fill-white group-hover:fill-[#ccff00] transition" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" /></svg>
                        </button>
                    </div>

                    <!-- Login Link -->
                    <div class="text-center text-[11px] text-zinc-400 pt-1">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" class="text-[#ccff00] hover:underline font-semibold ml-1">Login</a>
                    </div>

                </div>
            </div>

        </form>
    </div>

    <!-- JavaScript Script -->
    <script>
            function toggleVisibility(inputId, iconId) {
                const field = document.getElementById(inputId);
                const icon = document.getElementById(iconId);

                if (field.type === 'password') {
                    field.type = 'text';
                    // Eyestrike Icon (isha oo xiran)
                    icon.innerHTML = `
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a10.038 10.038 0 013.122-.387c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m-6.168-2.13a3 3 0 11-4.243-4.243M3 3l18 18" />
                            `;
                } else {
                    field.type = 'password';
                    // Eye Icon (isha oo furan)
                    icon.innerHTML = `
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            `;
                }
            }
    </script>
</body>
</html>