@model IEnumerable<GymManagementSystem.Models.GymReservation>

@{
    ViewData["Title"] = "My Class Schedule";
    Layout = "~/Views/layouts/MemberMaster.cshtml";
    var reservedCount = ViewBag.ReservedCount ?? 0;
    var completedSessions = ViewBag.CompletedSessions ?? 0;
    var attendanceRate = ViewBag.AttendanceRate ?? 100;
    var currentMonthName = ViewBag.CurrentMonthName ?? DateTime.Now.ToString("MMMM yyyy");
}

<div class="max-w-7xl mx-auto space-y-8 pb-12 text-zinc-800 dark:text-zinc-100">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Member Portal</span>
            <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white mt-1">My Class Schedule</h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-lime-400/10 border border-lime-400/20 text-lime-600 dark:text-lime-400 text-xs font-bold flex items-center gap-2">
                <i data-lucide="calendar-check" class="w-4 h-4"></i> Reserved Classes: <span id="litReservedCount">@reservedCount</span> Active
            </span>
        </div>
    </div>

    <!-- NAVIGATION TABS -->
    <div class="border-b border-zinc-200 dark:border-zinc-800 flex items-center gap-8">
        <button type="button" class="pb-4 text-sm font-bold border-b-2 border-lime-400 text-zinc-900 dark:text-white flex items-center gap-2 cursor-pointer">
            <i data-lucide="user-check" class="w-4 h-4 text-lime-500"></i> My Enrolled Classes (<span id="litTabCount">@reservedCount</span>)
        </button>
    </div>

    <!-- TAB CONTENT: MY SCHEDULE -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- ACTIVE RESERVATION CARDS (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">

            <h3 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <i data-lucide="clock" class="w-4 h-4 text-lime-500"></i> Upcoming Sessions
            </h3>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    bool isToday = item.ReservationDate.Date == DateTime.Today;

                    <div class="bg-white dark:bg-zinc-900 @(isToday ? "border-2 border-lime-400/50" : "border border-zinc-200 dark:border-zinc-800") rounded-3xl p-6 shadow-sm space-y-4">
                        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b border-zinc-100 dark:border-zinc-800 pb-4">
                            <div>
                                <span class="px-2.5 py-0.5 rounded-md @(isToday ? "bg-lime-400/15 text-lime-600 dark:text-lime-400 border border-lime-400/20" : "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20") text-[10px] font-bold">
                                    @(isToday ? "Today" : item.ReservationDate.ToString("MMM dd, yyyy")) • @item.ReservationDate.ToString("hh:mm tt")
                                </span>
                                <h3 class="text-lg font-black text-zinc-900 dark:text-white mt-1">@item.ClassName</h3>
                            </div>
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 w-fit">
                                @item.Status ✓
                            </span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                            <div class="bg-zinc-50 dark:bg-zinc-800/50 p-3 rounded-2xl">
                                <span class="text-zinc-400 block text-[10px] uppercase font-bold">Trainer</span>
                                <span class="font-bold text-zinc-900 dark:text-white">@(item.TrainerName ?? "N/A")</span>
                            </div>
                            <div class="bg-zinc-50 dark:bg-zinc-800/50 p-3 rounded-2xl">
                                <span class="text-zinc-400 block text-[10px] uppercase font-bold">Reservation ID</span>
                                <span class="font-bold text-zinc-900 dark:text-white">@item.ReservationNumber</span>
                            </div>
                            <div class="bg-zinc-50 dark:bg-zinc-800/50 p-3 rounded-2xl">
                                <span class="text-zinc-400 block text-[10px] uppercase font-bold">Duration</span>
                                <span class="font-bold text-zinc-900 dark:text-white">60 Minutes</span>
                            </div>
                        </div>

                        <div class="flex justify-end pt-2">
                            <form asp-action="CancelReservation" asp-route-id="@item.ReservationID" method="post" onsubmit="return confirm('Ma hubtaa in aad baajiso fasalkan?');">
                                <button type="submit" class="px-4 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-rose-500 font-bold text-xs hover:bg-rose-500 hover:text-white transition cursor-pointer">
                                    Cancel Reservation
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-8 text-center text-zinc-400 space-y-2">
                    <i data-lucide="calendar-x" class="w-8 h-8 mx-auto text-zinc-400"></i>
                    <p class="text-sm font-bold">Wali fasal ma aad book-garaysan.</p>
                    <p class="text-xs text-zinc-500">Soo eeg fasallada bixinta ku jira si aad boos ka qabsato.</p>
                </div>
            }

        </div>

        <!-- SIDEBAR: CLASS ATTENDANCE SUMMARY & RULES (1 Col) -->
        <div class="space-y-6">

            <!-- Monthly Attendance Quick Stats -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm space-y-4">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800 pb-3">
                    This Month's Class Attendance
                </h3>
                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-2xl font-black text-zinc-900 dark:text-white"><span id="lblCompletedSessions">@completedSessions</span> Sessions</span>
                        <span class="text-xs text-zinc-400 block">Completed in <span id="litCurrentMonth">@currentMonthName</span></span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-lime-400/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold text-xs">
                        <span id="litAttendanceRate">@attendanceRate%</span>
                    </div>
                </div>
            </div>

            <!-- Class Rules Notice -->
            <div class="bg-zinc-900 text-white rounded-3xl p-6 space-y-3 shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-lime-400/10 rounded-full blur-2xl"></div>
                <div class="flex items-center gap-2 text-lime-400">
                    <i data-lucide="info" class="w-4 h-4"></i>
                    <span class="text-[10px] font-bold uppercase tracking-widest">Attendance Policy</span>
                </div>
                <p class="text-xs text-zinc-400 leading-relaxed">
                    Please arrive at the class 10 minutes before the scheduled start time. If you need to cancel your booking, please cancel it at least 24 hours in advance.
                </p>
            </div>

        </div>

    </div>
</div>