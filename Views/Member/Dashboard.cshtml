@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/layouts/MemberMaster.cshtml";
}

<!-- Main Dashboard Container -->
<div class="p-4 sm:p-6 bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 font-sans min-h-screen transition-colors duration-300">

    <!-- 1. TOP BANNER (Hero Section) -->
    <div class="relative w-full rounded-2xl overflow-hidden bg-white dark:bg-zinc-900 p-6 sm:p-8 border border-zinc-200 dark:border-zinc-800 mb-6 shadow-xl transition-colors duration-300">
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1200&auto=format&fit=crop" alt="Gym Background" class="w-full h-full object-cover object-center opacity-20 dark:opacity-40 mix-blend-luminosity" />
            <div class="absolute inset-0 bg-gradient-to-r from-white dark:from-zinc-950 via-white/90 dark:via-zinc-950/90 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-lg">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight flex items-center gap-2">
                Welcome back, <span>@(Model?.MemberName ?? "Member!")</span> 💪
            </h1>
            <p class="text-zinc-600 dark:text-zinc-400 text-xs sm:text-sm mt-2 font-medium">Keep pushing your limits and achieve your goals.</p>
        </div>
    </div>

    <!-- 2. STATS CARDS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        
        <!-- Card 1: Membership Status -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl flex items-center justify-between shadow-md transition-colors duration-300">
            <div>
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400 font-medium block mb-1">Membership Status</span>
                <h3 class="text-xl font-bold text-lime-600 dark:text-lime-400 tracking-wide">
                    @(Model?.Status ?? "Active")
                </h3>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-1 block font-medium">Valid until @(Model?.ExpiryDate ?? "-")</span>
            </div>
            <div class="p-3 bg-lime-500/10 border border-lime-500/20 text-lime-600 dark:text-lime-400 rounded-xl flex items-center justify-center">
                <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
        </div>

        <!-- Card 2: Days Remaining -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl flex items-center justify-between shadow-md transition-colors duration-300">
            <div>
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400 font-medium block mb-1">Days Remaining</span>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white tracking-wide">
                    @(Model?.DaysRemaining ?? "0") Days
                </h3>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-1 block font-medium">Until Expiry</span>
            </div>
            <div class="p-3 bg-purple-500/10 border border-purple-500/20 text-purple-600 dark:text-purple-400 rounded-xl flex items-center justify-center">
                <i data-lucide="calendar" class="w-6 h-6"></i>
            </div>
        </div>

        <!-- Card 3: Upcoming Classes -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl flex items-center justify-between shadow-md transition-colors duration-300">
            <div>
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400 font-medium block mb-1">Upcoming Classes</span>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white tracking-wide">
                    @(Model?.UpcomingClassesCount ?? 0) Classes
                </h3>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-1 block font-medium">This Week</span>
            </div>
            <div class="p-3 bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center">
                <i data-lucide="clock" class="w-6 h-6"></i>
            </div>
        </div>

        <!-- Card 4: Workouts Completed -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl flex items-center justify-between shadow-md transition-colors duration-300">
            <div>
                <span class="text-[11px] text-zinc-500 dark:text-zinc-400 font-medium block mb-1">Workouts Completed</span>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white tracking-wide">
                    @(Model?.WorkoutsCompletedCount ?? 0)
                </h3>
                <span class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-1 block font-medium">This Month</span>
            </div>
            <div class="p-3 bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 rounded-xl flex items-center justify-center">
                <i data-lucide="clipboard-check" class="w-6 h-6"></i>
            </div>
        </div>

    </div>

    <!-- 3. MIDDLE SECTION: OVERVIEW CHART + QUICK ACTIONS + LATEST NOTICE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        
        <!-- Overview Chart (Chart.js) -->
        <div class="lg:col-span-6 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-5 rounded-2xl flex flex-col justify-between shadow-md transition-colors duration-300">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white tracking-wide">Overview Progress</h3>
                <select id="overviewFilter" class="bg-zinc-100 dark:bg-zinc-800 text-xs text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 rounded-lg px-3 py-1.5 focus:outline-none cursor-pointer">
                    <option value="Month">This Month</option>
                    <option value="Week">This Week</option>
                </select>
            </div>
            
            <div class="w-full h-48 relative">
                <canvas id="overviewChart"></canvas>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="lg:col-span-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-5 rounded-2xl shadow-md transition-colors duration-300">
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white mb-4 tracking-wide">Quick Actions</h3>
            <div class="space-y-2.5">
                
                <a href="@Url.Action("ClassSchedule", "Member")" class="flex items-center justify-between p-3 bg-zinc-50 dark:bg-zinc-800/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/80 rounded-xl text-xs font-semibold text-zinc-700 dark:text-zinc-200 transition group">
                    <span>Book a Class</span>
                    <span class="bg-lime-400 text-black p-1.5 rounded-lg shadow-md shadow-lime-400/10 group-hover:scale-105 transition"><i data-lucide="arrow-right" class="w-3.5 h-3.5 stroke-[2.5]"></i></span>
                </a>

                <a href="@Url.Action("Attendance", "Member")" class="flex items-center justify-between p-3 bg-zinc-50 dark:bg-zinc-800/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/80 rounded-xl text-xs font-semibold text-zinc-700 dark:text-zinc-200 transition group">
                    <span>Record Attendance</span>
                    <span class="bg-lime-400 text-black p-1.5 rounded-lg shadow-md shadow-lime-400/10 group-hover:scale-105 transition"><i data-lucide="arrow-right" class="w-3.5 h-3.5 stroke-[2.5]"></i></span>
                </a>

                <a href="@Url.Action("Payments", "Member")" class="flex items-center justify-between p-3 bg-zinc-50 dark:bg-zinc-800/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/80 rounded-xl text-xs font-semibold text-zinc-700 dark:text-zinc-200 transition group">
                    <span>Make a Payment</span>
                    <span class="bg-lime-400 text-black p-1.5 rounded-lg shadow-md shadow-lime-400/10 group-hover:scale-105 transition"><i data-lucide="arrow-right" class="w-3.5 h-3.5 stroke-[2.5]"></i></span>
                </a>

                <a href="@Url.Action("Profile", "Member")" class="flex items-center justify-between p-3 bg-zinc-50 dark:bg-zinc-800/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/80 rounded-xl text-xs font-semibold text-zinc-700 dark:text-zinc-200 transition group">
                    <span>Update Profile</span>
                    <span class="bg-lime-400 text-black p-1.5 rounded-lg shadow-md shadow-lime-400/10 group-hover:scale-105 transition"><i data-lucide="arrow-right" class="w-3.5 h-3.5 stroke-[2.5]"></i></span>
                </a>

            </div>
        </div>

        <!-- Latest Notice / Messages -->
        <div class="lg:col-span-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-5 rounded-2xl flex flex-col justify-between shadow-md transition-colors duration-300">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-white tracking-wide flex items-center gap-2">
                        Latest Notices
                    </h3>
                    <span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
                </div>
                
                <!-- Dynamic Notices Loop -->
                <div class="space-y-3">
                    @if (Model?.Notices != null && Model.Notices.Any())
                    {
                        foreach (var notice in Model.Notices)
                        {
                            <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/40 hover:border-zinc-300 dark:hover:border-zinc-700 transition group cursor-pointer">
                                <div class="flex items-start gap-2.5">
                                    <div class="p-1.5 rounded-lg bg-lime-500/10 text-lime-600 dark:text-lime-400 mt-0.5 shrink-0">
                                        <i data-lucide="bell" class="w-3.5 h-3.5"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-zinc-950 dark:group-hover:text-white transition truncate">@notice.Title</h4>
                                        <span class="text-[10px] font-medium text-zinc-500 block mt-0.5">@notice.Date</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Static Fallback Notice -->
                        <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/40 hover:border-zinc-300 dark:hover:border-zinc-700 transition group cursor-pointer">
                            <div class="flex items-start gap-2.5">
                                <div class="p-1.5 rounded-lg bg-lime-500/10 text-lime-600 dark:text-lime-400 mt-0.5 shrink-0">
                                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-lime-600 dark:group-hover:text-lime-400 transition truncate">Yoga Class Added</h4>
                                    <span class="text-[10px] font-medium text-zinc-500 block mt-0.5">22 Aug 2026</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <a href="@Url.Action("Notifications", "Member")" class="w-full text-center py-2.5 mt-4 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-900 dark:hover:text-white border border-zinc-200 dark:border-zinc-700 rounded-xl text-xs text-zinc-600 dark:text-zinc-400 font-semibold block transition">
                View All Notices
            </a>
        </div>
        
    </div>
</div>

<!-- Load Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Chart.js Script with ASP.NET Core JSON serialization -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const ctx = document.getElementById('overviewChart').getContext('2d');

        const gradient = ctx.createLinearGradient(0, 0, 0, 180);
        gradient.addColorStop(0, 'rgba(163, 230, 53, 0.25)');
        gradient.addColorStop(1, 'rgba(163, 230, 53, 0.0)');

        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ChartLabels ?? new[] { "Week 1", "Week 2", "Week 3", "Week 4" }));
        const chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ChartData ?? new[] { 10, 25, 18, 30 }));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Progress',
                    data: chartData,
                    borderColor: '#84cc16',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    backgroundColor: gradient,
                    pointBackgroundColor: '#84cc16',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: document.documentElement.classList.contains('dark') ? '#a1a1aa' : '#71717a', font: { size: 10, weight: 'bold' } }
                    },
                    y: {
                        grid: { color: document.documentElement.classList.contains('dark') ? 'rgba(82, 82, 91, 0.3)' : 'rgba(228, 228, 231, 0.8)' },
                        ticks: { color: document.documentElement.classList.contains('dark') ? '#a1a1aa' : '#71717a', font: { size: 10 } },
                        border: { dash: [4, 4] }
                    }
                }
            }
        });
    });
</script>