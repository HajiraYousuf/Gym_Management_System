@{
    ViewData["Title"] = "My Workout Plan";
    Layout = "~/Views/layouts/MemberMaster.cshtml";
}

<div class="max-w-7xl mx-auto space-y-8 pb-12 text-zinc-800 dark:text-zinc-100">

    <!-- NOTIFICATION MESSAGE -->
    <div id="alertMessage" class="hidden p-4 rounded-xl text-xs font-bold mb-4"></div>

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Training & Routine</span>
            <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white mt-1">My Workout Plan</h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-bold flex items-center gap-2">
                <i data-lucide="user" class="w-4 h-4 text-lime-500"></i>Trainer:
                <span id="lblTrainerName">Capt. Mohamed</span>
            </span>
        </div>
    </div>

    <!-- WEEKLY ROUTINE SELECTOR GRID (STATIC MOCK / DYNAMIC LOOP) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
        <!-- Active Day -->
        <div class="p-4 rounded-2xl bg-lime-400 text-black font-bold text-center shadow-lg shadow-lime-400/20 border-2 border-lime-400">
            <span class="text-[10px] uppercase tracking-wider block text-black/70">Monday (Today)</span>
            <h4 class="text-xs font-black mt-1">Chest & Triceps</h4>
            <span class="text-[10px] bg-black/10 px-2 py-0.5 rounded-full inline-block mt-1">In Progress</span>
        </div>

        <!-- Completed Day -->
        <div class="p-4 rounded-2xl bg-zinc-100 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/50 text-center opacity-70">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block">Tuesday</span>
            <h4 class="text-xs font-bold text-zinc-900 dark:text-white mt-1">Back & Biceps</h4>
            <span class="text-[10px] text-zinc-500 block mt-1">Completed</span>
        </div>

        <!-- Upcoming Day -->
        <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block">Wednesday</span>
            <h4 class="text-xs font-bold text-zinc-900 dark:text-white mt-1">Legs & Abs</h4>
            <span class="text-[10px] text-zinc-400 block mt-1">Upcoming</span>
        </div>

        <!-- Rest / Recovery Day -->
        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/40 border border-zinc-200/50 dark:border-zinc-800/50 text-center opacity-50">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block">Thursday</span>
            <h4 class="text-xs font-bold text-zinc-500 mt-1">Rest Day</h4>
            <span class="text-[10px] text-zinc-400 block mt-1">Recovery</span>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block">Friday</span>
            <h4 class="text-xs font-bold text-zinc-900 dark:text-white mt-1">Shoulders</h4>
            <span class="text-[10px] text-zinc-400 block mt-1">Upcoming</span>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block">Saturday</span>
            <h4 class="text-xs font-bold text-zinc-900 dark:text-white mt-1">Full Body</h4>
            <span class="text-[10px] text-zinc-400 block mt-1">Upcoming</span>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/40 border border-zinc-200/50 dark:border-zinc-800/50 text-center opacity-50">
            <span class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider block">Sunday</span>
            <h4 class="text-xs font-bold text-zinc-500 mt-1">Rest Day</h4>
            <span class="text-[10px] text-zinc-400 block mt-1">Recovery</span>
        </div>
    </div>

    <!-- MAIN WORKOUT DETAIL TABLE & TRAINER NOTES -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- EXERCISES LIST (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">

            <!-- TODAY'S WORKOUT PROGRESS BANNER -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-5 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
                <div class="space-y-1 w-full sm:w-auto">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-zinc-500 uppercase tracking-wider">Today's Progress</span>
                        <span class="px-2 py-0.5 text-[10px] font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 rounded-md">
                            <span id="lblProgressPercent">50% Completed</span>
                        </span>
                    </div>
                    <h4 class="text-base font-black text-zinc-900 dark:text-white">
                        <span id="lblCompletedSummary">Completed Exercises: 2 / 4</span>
                    </h4>
                </div>

                <!-- Progress Bar & Actions -->
                <div class="w-full sm:w-64 space-y-2">
                    <div class="w-full bg-zinc-100 dark:bg-zinc-800 h-2.5 rounded-full overflow-hidden">
                        <div id="progressBarFill" class="bg-lime-400 h-full rounded-full transition-all duration-300" style="width: 50%;"></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" class="w-1/2 py-2 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-black font-bold text-xs hover:opacity-90 transition cursor-pointer">Start Workout</button>
                        <button type="button" class="w-1/2 py-2 rounded-xl bg-lime-400 hover:bg-lime-300 text-black font-bold text-xs transition cursor-pointer shadow-md shadow-lime-400/20">Mark Completed</button>
                    </div>
                </div>
            </div>

            <!-- EXERCISES LIST CONTAINER -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm">
                <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-4 mb-4">
                    <div>
                        <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Today's Exercises</h3>
                        <p class="text-xs text-zinc-500">Aalad kasta ama layli calaamadi marka aad dhameyso.</p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-400/20">
                        <span id="lblExercisesBadge">4 Exercises</span>
                    </span>
                </div>

                <div class="space-y-4">
                    <!-- Exercise Item 1 (Completed) -->
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200/80 dark:border-zinc-700/60">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-base border border-emerald-500/20">
                                <i data-lucide="check" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-zinc-900 dark:text-white line-through opacity-70">Barbell Bench Press</h4>
                                <span class="text-xs text-zinc-500">Target: Chest & Triceps</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 text-right">
                            <div>
                                <span class="text-xs font-bold text-zinc-900 dark:text-white block">4 Sets x 10 Reps</span>
                                <span class="text-[11px] text-zinc-500">Rest: 90 sec</span>
                            </div>
                            <input type="checkbox" checked="checked" class="w-5 h-5 accent-lime-400 rounded cursor-pointer" />
                        </div>
                    </div>

                    <!-- Exercise Item 2 (Completed) -->
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200/80 dark:border-zinc-700/60">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-base border border-emerald-500/20">
                                <i data-lucide="check" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-zinc-900 dark:text-white line-through opacity-70">Incline Dumbbell Press</h4>
                                <span class="text-xs text-zinc-500">Target: Upper Chest</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 text-right">
                            <div>
                                <span class="text-xs font-bold text-zinc-900 dark:text-white block">3 Sets x 12 Reps</span>
                                <span class="text-[11px] text-zinc-500">Rest: 60 sec</span>
                            </div>
                            <input type="checkbox" checked="checked" class="w-5 h-5 accent-lime-400 rounded cursor-pointer" />
                        </div>
                    </div>

                    <!-- Exercise Item 3 (Pending) -->
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200/80 dark:border-zinc-700/60">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 flex items-center justify-center font-black text-base">
                                3
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-zinc-900 dark:text-white">Cable Crossovers</h4>
                                <span class="text-xs text-zinc-500">Target: Inner Chest</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 text-right">
                            <div>
                                <span class="text-xs font-bold text-zinc-900 dark:text-white block">3 Sets x 15 Reps</span>
                                <span class="text-[11px] text-zinc-500">Rest: 60 sec</span>
                            </div>
                            <input type="checkbox" class="w-5 h-5 accent-lime-400 rounded cursor-pointer" />
                        </div>
                    </div>

                    <!-- Exercise Item 4 (Pending) -->
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200/80 dark:border-zinc-700/60">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 flex items-center justify-center font-black text-base">
                                4
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-zinc-900 dark:text-white">Tricep Pushdowns</h4>
                                <span class="text-xs text-zinc-500">Target: Triceps</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 text-right">
                            <div>
                                <span class="text-xs font-bold text-zinc-900 dark:text-white block">4 Sets x 12 Reps</span>
                                <span class="text-[11px] text-zinc-500">Rest: 60 sec</span>
                            </div>
                            <input type="checkbox" class="w-5 h-5 accent-lime-400 rounded cursor-pointer" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRAINER NOTES & GOALS (1 Col) -->
        <div class="space-y-6">
            <!-- Trainer Note Card -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm space-y-4">
                <h3 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="message-square-quote" class="w-5 h-5 text-lime-500"></i>Trainer Instructions
                </h3>
                <div class="p-4 rounded-2xl bg-lime-400/10 border border-lime-400/20 text-xs text-zinc-700 dark:text-zinc-300 space-y-2">
                    <p class="font-medium">
                        "<span id="lblTrainerInstructions">Hubi in aad miisaanka si tartiib ah u qaado, adoo ilaalinaya foomka saxda ah (form). Ha ilaawin in aad biyo ku filan cabto inta u dhaxeysa set-yada.</span>"
                    </p>
                    <span class="block text-[10px] text-lime-600 dark:text-lime-400 font-bold text-right">
                        <span id="lblTrainerNameSignature">- Capt. Mohamed</span>
                    </span>
                </div>
            </div>

            <!-- Daily Summary Box -->
            <div class="bg-zinc-900 text-white rounded-3xl p-6 space-y-4 shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-lime-400/20 rounded-full blur-2xl"></div>
                <h4 class="text-sm font-bold text-lime-400 uppercase tracking-wider">Today's Target</h4>

                <div class="space-y-3">
                    <div class="flex justify-between text-xs">
                        <span class="text-zinc-400">Total Exercises</span>
                        <span class="font-bold">
                            <span id="lblTotalExercisesCount">4 Activities</span>
                        </span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-zinc-400">Est. Duration</span>
                        <span class="font-bold">
                            <span id="lblEstDuration">55 Minutes</span>
                        </span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-zinc-400">Est. Calories Burn</span>
                        <span class="font-bold">
                            <span id="lblEstCalories">450 kcal</span>
                        </span>
                    </div>
                </div>

                <button type="button" class="w-full py-3 rounded-xl bg-lime-400 text-black font-bold text-xs shadow-lg shadow-lime-400/20 hover:bg-lime-300 transition cursor-pointer mt-2">Complete Workout</button>
            </div>
        </div>

    </div>
</div>