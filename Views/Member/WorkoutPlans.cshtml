@using System.Web
@model GymManagementSystem.Models.WorkoutPlan

@{
    ViewData["Title"] = "My Workout Plan";
    Layout = "~/Views/layouts/MemberMaster.cshtml";
}

<div class="max-w-7xl mx-auto space-y-8 pb-12 text-zinc-800 dark:text-zinc-100">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Training & Routine</span>
            <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white mt-1">@Model.Title</h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-bold flex items-center gap-2">
                <i data-lucide="dumbbell" class="w-4 h-4 text-lime-500"></i>Goal:
                <span class="uppercase">@Model.TargetGoal</span>
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-bold flex items-center gap-2">
                <i data-lucide="layers" class="w-4 h-4 text-lime-500"></i>Level:
                <span class="capitalize">@Model.DifficultyLevel</span>
            </span>
        </div>
    </div>

    <!-- QUICK STATS ROW -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm">
            <span class="text-[10px] uppercase font-bold text-zinc-400 block">Duration</span>
            <h4 class="text-lg font-black text-zinc-900 dark:text-white mt-1">@Model.DurationWeeks <span class="text-xs font-normal">Weeks</span></h4>
        </div>
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm">
            <span class="text-[10px] uppercase font-bold text-zinc-400 block">Schedule</span>
            <h4 class="text-lg font-black text-zinc-900 dark:text-white mt-1">@Model.DaysPerWeek <span class="text-xs font-normal">Days / week</span></h4>
        </div>
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm">
            <span class="text-[10px] uppercase font-bold text-zinc-400 block">Session Time</span>
            <h4 class="text-lg font-black text-zinc-900 dark:text-white mt-1">@Model.SessionDurationMinutes <span class="text-xs font-normal">Minutes</span></h4>
        </div>
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm">
            <span class="text-[10px] uppercase font-bold text-zinc-400 block">Assigned Date</span>
            <h4 class="text-xs font-bold text-zinc-900 dark:text-white mt-2">@Model.CreatedAt.ToString("yyyy-MM-dd")</h4>
        </div>
    </div>

    <!-- MAIN WORKOUT DETAIL TABLE & TRAINER NOTES -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- EXERCISES LIST (2 Cols) -->
        <div class="lg:col-span-2 space-y-4">
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm">
                <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-4 mb-4">
                    <div>
                        <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Workout Exercises</h3>
                        <p class="text-xs text-zinc-500">Liiska laylisyada ee ku jira plan-kaaga.</p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-400/20">
                        <span id="exerciseCountBadge">0 Exercises</span>
                    </span>
                </div>

                <!-- Dynamic Container for Exercises parsed from JSON -->
                <div id="exercisesContainer" class="space-y-4">
                    <div class="p-6 text-center text-zinc-400 text-xs">Loading exercises...</div>
                </div>
            </div>
        </div>

        <!-- TRAINER NOTES & GOALS (1 Col) -->
        <div class="space-y-6">
            <!-- Trainer Note Card -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm space-y-4">
                <h3 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="message-square-quote" class="w-5 h-5 text-lime-500"></i>Trainer Notes
                </h3>
                <div class="p-4 rounded-2xl bg-lime-400/10 border border-lime-400/20 text-xs text-zinc-700 dark:text-zinc-300 space-y-2">
                    <p class="font-medium italic">
                        "@(string.IsNullOrWhiteSpace(Model.Notes) ? "No special instructions provided by your trainer." : Model.Notes)"
                    </p>
                    <div class="flex items-center justify-end gap-2 pt-2 border-t border-lime-400/20">
                        <span class="block text-[11px] text-lime-600 dark:text-lime-400 font-bold">
                            - @(Model.Title != null ? Model.Title : "Assigned Gym Trainer")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Daily Summary Box -->
            <div class="bg-zinc-900 text-white rounded-3xl p-6 space-y-4 shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-lime-400/20 rounded-full blur-2xl"></div>
                <h4 class="text-sm font-bold text-lime-400 uppercase tracking-wider">Plan Summary</h4>

                <div class="space-y-3">
                    <div class="flex justify-between text-xs">
                        <span class="text-zinc-400">Total Duration</span>
                        <span class="font-bold">@Model.DurationWeeks Weeks</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-zinc-400">Session Length</span>
                        <span class="font-bold">@Model.SessionDurationMinutes Minutes</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-zinc-400">Frequency</span>
                        <span class="font-bold">@Model.DaysPerWeek Days a week</span>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- JavaScript to parse ExercisesJson dynamically -->
<!-- JavaScript to parse ExercisesJson safely -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Ammaan ahaan, waxaan ka dhigaynaa variable-ka mid aan marnaba undefined ama break noqon karin
        let rawJson = '@Html.Raw(Model?.ExercisesJson ?? "[]")';
        let container = document.getElementById('exercisesContainer');
        let badge = document.getElementById('exerciseCountBadge');

        let exercises = [];

        try {
            // Haddii rawJson uu yahay string mar hore serialized ah ama array
            if (typeof rawJson === 'string' && rawJson.trim() !== '') {
                exercises = JSON.parse(rawJson);
            } else if (Array.isArray(rawJson)) {
                exercises = rawJson;
            }
        } catch (e) {
            console.error("JSON Parse Error: ", e);
            exercises = [];
        }

        if (Array.isArray(exercises) && exercises.length > 0) {
            badge.innerText = exercises.length + " Exercises";
            container.innerHTML = "";

            exercises.forEach((ex, index) => {
                let name = ex.Name || ex.name || ('Exercise ' + (index + 1));
                let target = ex.Target || ex.target || 'General';
                let equipment = ex.Equipment || ex.equipment || '';
                let thumbnail = ex.Thumbnail || ex.thumbnail || '';
                let sets = ex.Sets || ex.sets || 3;
                let reps = ex.Reps || ex.reps || 10;
                let rest = ex.Rest || ex.rest || '60';

                let imageHtml = thumbnail
                    ? `<img src="${thumbnail}" class="w-12 h-12 rounded-xl object-cover" alt="${name}" />`
                    : `<div class="w-12 h-12 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 flex items-center justify-center font-black text-base">${index + 1}</div>`;

                let html = `
                        <div class="flex items-center justify-between p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200/80 dark:border-zinc-700/60 transition hover:border-lime-400/50">
                            <div class="flex items-center gap-4">
                                ${imageHtml}
                                <div>
                                    <h4 class="text-sm font-bold text-zinc-900 dark:text-white">${name}</h4>
                                    <span class="text-xs text-zinc-500">Target: ${target} ${equipment ? '• ' + equipment : ''}</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-6 text-right">
                                <div>
                                    <span class="text-xs font-bold text-zinc-900 dark:text-white block">${sets} Sets x ${reps} Reps</span>
                                    <span class="text-[11px] text-zinc-500">Rest: ${rest} sec</span>
                                </div>
                                <input type="checkbox" class="w-5 h-5 accent-lime-400 rounded cursor-pointer" />
                            </div>
                        </div>
                    `;
                container.innerHTML += html;
            });
        } else {
            badge.innerText = "0 Exercises";
            container.innerHTML = `<div class="p-6 text-center text-zinc-400 text-xs">No specific exercises attached to this workout plan.</div>`;
        }
    });
</script>