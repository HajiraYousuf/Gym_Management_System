@model GymManagementSystem.Models.NutritionPlan

@{
    ViewData["Title"] = "Nutrition Plan";
    Layout = "~/Views/layouts/MemberMaster.cshtml";

    var plan = Model ?? ViewBag.NutritionPlan as GymManagementSystem.Models.NutritionPlan;
}

<div class="max-w-7xl mx-auto space-y-8 pb-12 text-zinc-800 dark:text-zinc-100">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Diet & Meals</span>
            <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white mt-1">
                <span id="lblPlanTitle">@(plan?.Title ?? "My Nutrition Plan")</span>
            </h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-lime-400/10 border border-lime-400/20 text-lime-600 dark:text-lime-400 text-xs font-bold flex items-center gap-1.5">
                <i data-lucide="apple" class="w-4 h-4"></i> Goal: <span id="lblGoal">@(plan?.TargetGoal ?? "Muscle Hypertrophy")</span>
            </span>
        </div>
    </div>

    @if (plan != null)
    {
        <!-- MACRONUTRIENT & DAILY PROGRESS CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Calories Progress -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-zinc-500 font-medium">Daily Target Calories</span>
                    <i data-lucide="flame" class="w-5 h-5 text-amber-500"></i>
                </div>
                <div>
                    <h3 class="text-2xl font-black text-zinc-900 dark:text-white">
                        <span id="lblDailyCalories">@plan.Calories</span>
                        <span class="text-xs text-zinc-400 font-normal">kcal</span>
                    </h3>
                    <div class="w-full bg-zinc-100 dark:bg-zinc-800 h-2 rounded-full mt-2 overflow-hidden">
                        <div class="bg-amber-500 h-full rounded-full" style="width: 100%;"></div>
                    </div>
                    <span class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-1 block font-bold">Protein: @plan.Protein g | Carbs: @plan.Carbs g | Fats: @plan.Fats g</span>
                </div>
            </div>

            <!-- Trainer In-Charge -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-zinc-500 font-medium">Trainer In-Charge</span>
                    <i data-lucide="user-check" class="w-5 h-5 text-rose-500"></i>
                </div>
                <div>
                    <h3 class="text-xl font-black text-zinc-900 dark:text-white">
                        <span id="lblTrainerName">Capt. Mohamed</span>
                    </h3>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 mt-3 block font-bold">Assigned Coach</span>
                </div>
            </div>

            <!-- Created Date -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-zinc-500 font-medium">Assigned Date</span>
                    <i data-lucide="calendar" class="w-5 h-5 text-lime-500"></i>
                </div>
                <div>
                    <h3 class="text-xl font-black text-zinc-900 dark:text-white">
                        <span id="lblCreatedAt">@plan.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </h3>
                    <span class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-3 block font-bold">Duration: @plan.DurationWeeks Weeks</span>
                </div>
            </div>

            <!-- Water Progress -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-xs text-zinc-500 font-medium">Water Progress</span>
                    <i data-lucide="glass-water" class="w-5 h-5 text-sky-500"></i>
                </div>
                <div>
                    <h3 class="text-2xl font-black text-zinc-900 dark:text-white">2.5L <span class="text-xs text-zinc-400 font-normal">/ 3.5L</span></h3>
                    <div class="w-full bg-zinc-100 dark:bg-zinc-800 h-2 rounded-full mt-2 overflow-hidden">
                        <div class="bg-sky-400 h-full rounded-full" style="width: 71%;"></div>
                    </div>
                    <span class="text-[10px] text-sky-600 dark:text-sky-400 mt-1 block font-bold">1.0L Remaining</span>
                </div>
            </div>

        </div>

        <!-- MEAL PLAN SECTION & WATER TRACKER -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- MEAL SCHEDULE LIST -->
            <div class="lg:col-span-2 space-y-4">
                <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800 pb-4 mb-4">
                        Meal Instructions & Details
                    </h3>

                    <div class="space-y-4">
                        <div id="lblMealDetails" class="text-sm text-zinc-700 dark:text-zinc-300 whitespace-pre-line leading-relaxed block">
                            @if (!string.IsNullOrEmpty(plan.Notes))
                            {
                                @plan.Notes
                            }
                            else
                            {
                                <text>
                                    Meal 1: Breakfast (08:00 AM) - Oatmeal with 1 scoop whey protein, 1 banana, and a handful of almonds.
                                    Meal 2: Lunch (12:30 PM) - 200g grilled chicken breast, 1.5 cups brown rice, and steamed broccoli.
                                    Meal 3: Pre-Workout (04:00 PM) - 2 slices of whole wheat toast with peanut butter and honey.
                                    Meal 4: Post-Workout / Dinner (08:00 PM) - 250g grilled steak or fish, sweet potato, and mixed green salad.
                                </text>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- WATER TRACKER & TRAINER TIP -->
            <div class="space-y-6">
                <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm space-y-4">
                    <div class="flex justify-between items-center">
                        <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                            <i data-lucide="glass-water" class="w-4 h-4 text-sky-500"></i> Quick Water Log
                        </h3>
                        <span class="text-xs font-bold text-sky-500">2.5L / 3.5L</span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <button type="button" class="py-2.5 bg-sky-500/10 text-sky-600 dark:text-sky-400 rounded-xl text-xs font-bold border border-sky-500/20 hover:bg-sky-500 hover:text-white transition cursor-pointer">+250ml Glass</button>
                        <button type="button" class="py-2.5 bg-sky-500/10 text-sky-600 dark:text-sky-400 rounded-xl text-xs font-bold border border-sky-500/20 hover:bg-sky-500 hover:text-white transition cursor-pointer">+500ml Bottle</button>
                    </div>
                </div>

                <!-- Trainer Tip Card -->
                <div class="bg-zinc-900 text-white rounded-3xl p-6 space-y-3 shadow-xl relative overflow-hidden">
                    <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-lime-400/10 rounded-full blur-2xl"></div>
                    <div class="flex items-center gap-2 text-lime-400">
                        <i data-lucide="lightbulb" class="w-4 h-4"></i>
                        <span class="text-[10px] font-bold uppercase tracking-widest">Trainer Tip & Notes</span>
                    </div>
                    <h4 class="text-xs font-bold">Hydration & Recovery</h4>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Cab biyo kafi ah ka hor iyo ka dib jimicsiga si aad u ilaaliso koritaanka muruqyada iyo habsami u socodka metabolism-ka.
                    </p>
                    <span class="block text-[10px] text-zinc-500 text-right font-medium">
                        - <span id="lblTrainerTipAuthor">Capt. Ahmed</span>
                    </span>
                </div>
            </div>

        </div>
    }
    else
    {
        <!-- No Plan Panel -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-12 text-center space-y-3 shadow-sm">
            <i data-lucide="alert-circle" class="w-10 h-10 text-zinc-400 mx-auto"></i>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Ma Jiraan Qorshe Cunto</h3>
            <p class="text-xs text-zinc-500">Hadda ma jiro wax qorshe cunto ah oo ku diiwaangashan database-ka.</p>
        </div>
    }

</div>