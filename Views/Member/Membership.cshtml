@model IEnumerable<GymManagementSystem.Models.MembershipPlan>

@{
    ViewData["Title"] = "My Membership Plan";
    Layout = "~/Views/layouts/MemberMaster.cshtml";

    string activePlanName = ViewBag.ActivePlanName ?? "Pro Plan";
    string accountStatus = ViewBag.AccountStatus ?? "Active";
    string startDate = ViewBag.StartDate ?? "Aug 16, 2026";
    string expiryDate = ViewBag.ExpiryDate ?? "Sep 15, 2026";
    int daysRemaining = ViewBag.DaysRemaining ?? 29;
    int progressPercent = ViewBag.ProgressPercent ?? 97;
}

<div class="max-w-7xl mx-auto space-y-8 pb-12 text-zinc-800 dark:text-zinc-100">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Subscription & Plans</span>
            <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white mt-1">My Membership Plan</h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-lime-400/10 border border-lime-400/20 text-lime-600 dark:text-lime-400 text-xs font-bold flex items-center gap-1.5">
                <i data-lucide="shield-check" class="w-4 h-4"></i> Account Status: <span id="litAccountStatus">@accountStatus</span>
            </span>
        </div>
    </div>

    <!-- 1. CURRENT ACTIVE MEMBERSHIP CARD -->
    <div class="relative rounded-3xl overflow-hidden bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-6 md:p-8 shadow-xl">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-lime-400/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 relative z-10">

            <!-- Left: Active Plan Info -->
            <div class="space-y-4 max-w-xl">
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-lime-400 text-black">
                        <span id="litActiveBadge">CURRENT PLAN</span>
                    </span>
                </div>

                <div>
                    <h2 class="text-3xl font-black text-zinc-900 dark:text-white">
                        <span>@activePlanName</span>
                    </h2>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
                        <span>Qorshaha xubinnimadaada ee hadda firfircoon.</span>
                    </p>
                </div>

                <!-- Dates & Badges -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
                    <div class="p-3 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60">
                        <span class="text-[11px] text-zinc-500 dark:text-zinc-400 block font-medium">Start Date</span>
                        <span class="text-xs font-bold text-zinc-900 dark:text-white mt-0.5 block">@startDate</span>
                    </div>

                    <div class="p-3 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60">
                        <span class="text-[11px] text-zinc-500 dark:text-zinc-400 block font-medium">Expiry Date</span>
                        <span class="text-xs font-bold text-zinc-900 dark:text-white mt-0.5 block">@expiryDate</span>
                    </div>

                    <div class="p-3 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60">
                        <span class="text-[11px] text-zinc-500 dark:text-zinc-400 block font-medium">Status</span>
                        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-0.5 block flex items-center gap-1">
                            <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> @accountStatus
                        </span>
                    </div>
                </div>
            </div>

            <!-- Right: Progress Meter -->
            <div class="lg:w-80 bg-zinc-50 dark:bg-zinc-800/40 p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 space-y-5">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-zinc-700 dark:text-zinc-300">Days Remaining</span>
                        <span class="text-xs font-black text-lime-600 dark:text-lime-400">@daysRemaining Days</span>
                    </div>

                    <div class="w-full bg-zinc-200 dark:bg-zinc-700 h-3 rounded-full overflow-hidden p-0.5">
                        <div class="bg-lime-400 h-full rounded-full transition-all duration-500" style="width: @progressPercent%;"></div>
                    </div>

                    <div class="flex items-center justify-between text-[11px] text-zinc-500 dark:text-zinc-400">
                        <span>@progressPercent% Valid</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- 2. PLANS SELECTION SECTION -->
    <div class="space-y-6 pt-4">
        <div class="text-center max-w-2xl mx-auto space-y-2">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Choose or Change Your Plan</h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">Dooro qorshaha adiga ku haboon.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @if (Model != null && Model.Any())
            {
                foreach (var plan in Model)
                {
                    bool isCurrentActive = plan.Name.Equals(activePlanName, StringComparison.OrdinalIgnoreCase);

                    <div class="bg-white dark:bg-zinc-900 @(isCurrentActive ? "border-2 border-lime-400 shadow-xl relative" : "border border-zinc-200 dark:border-zinc-800 shadow-sm hover:border-lime-400/50") rounded-3xl p-6 flex flex-col justify-between transition">

                        @if (isCurrentActive)
                        {
                            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-lime-400 text-black text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-md">Your Current Plan</div>
                        }

                        <div class="space-y-4 mt-@(isCurrentActive ? "2" : "0")">
                            <div class="flex justify-between items-center mt-1">
                                <span class="text-xs font-bold text-lime-600 dark:text-lime-400 uppercase tracking-wider">@plan.Name</span>
                                <span class="px-2.5 py-1 rounded-full bg-lime-400/10 text-lime-600 dark:text-lime-400 text-[10px] font-bold border border-lime-400/20">@plan.DurationDays Days</span>
                            </div>

                            <div>
                                <span class="text-3xl font-black text-zinc-900 dark:text-white">$@plan.Price</span>
                                <span class="text-xs text-zinc-500 dark:text-zinc-400"> / @plan.DurationDays days</span>
                            </div>

                            <p class="text-xs text-zinc-500 dark:text-zinc-400 border-b border-zinc-100 dark:border-zinc-800 pb-4">
                                @plan.Description
                            </p>
                        </div>

                        <div class="pt-6">
                            <form asp-action="SelectPlan" asp-route-planId="@plan.PlanId" method="post">
                                <button type="submit" class="w-full py-2.5 rounded-xl @(isCurrentActive ? "bg-lime-400 text-black font-black" : "bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white hover:bg-zinc-200 dark:hover:bg-zinc-700 font-bold") text-xs transition cursor-pointer">
                                    @(isCurrentActive ? "Selected" : "Select Plan")
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>