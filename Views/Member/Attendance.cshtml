@model IEnumerable<GymManagementSystem.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Member Attendance Tracker";
    Layout = "~/Views/layouts/MemberMaster.cshtml";

    int totalVisits = ViewBag.TotalVisits ?? 0;
    string todayStatus = ViewBag.TodayStatus ?? "Absent";
    string checkInTime = ViewBag.CheckInTime ?? "N/A";
    int streak = ViewBag.Streak ?? 0;
    string selectedMonth = ViewBag.SelectedMonth ?? DateTime.Now.ToString("yyyy-MM");
}

<div class="max-w-7xl mx-auto space-y-8 pb-12 text-zinc-800 dark:text-zinc-100">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Gym Activity</span>
            <h1 class="text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white mt-1">Attendance Tracker</h1>
        </div>
        <div class="flex items-center gap-3">
            <form method="get" class="flex items-center gap-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-3 py-2 rounded-xl shadow-sm">
                <i data-lucide="calendar" class="w-4 h-4 text-lime-500"></i>
                <label for="monthFilter" class="text-xs font-bold text-zinc-600 dark:text-zinc-300">Filter Month:</label>
                <input type="month" id="monthFilter" name="monthFilter" value="@selectedMonth" onchange="this.form.submit()" class="bg-transparent text-xs font-bold text-zinc-900 dark:text-white focus:outline-none cursor-pointer" />
            </form>
        </div>
    </div>

    <!-- STATS METRICS ROW -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Total Visits -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-xs text-zinc-500 font-medium">Monthly Visits</span>
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-500"></i>
            </div>
            <div>
                <h3 class="text-2xl font-black text-zinc-900 dark:text-white">
                    <span>@totalVisits</span> <span class="text-xs text-zinc-400 font-normal">sessions</span>
                </h3>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400 mt-2 block font-bold">Consistent Activity</span>
            </div>
        </div>

        <!-- Current Status -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-xs text-zinc-500 font-medium">Today's Status</span>
                <i data-lucide="activity" class="w-5 h-5 text-lime-500"></i>
            </div>
            <div>
                <h3 class="text-xl font-black text-zinc-900 dark:text-white truncate">
                    <span>@todayStatus</span>
                </h3>
                <span class="text-[10px] text-lime-600 dark:text-lime-400 mt-2 block font-bold">@checkInTime</span>
            </div>
        </div>

        <!-- Current Streak -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-xs text-zinc-500 font-medium">Active Streak</span>
                <i data-lucide="flame" class="w-5 h-5 text-amber-500"></i>
            </div>
            <div>
                <h3 class="text-2xl font-black text-zinc-900 dark:text-white">
                    <span>@streak</span> <span class="text-xs text-zinc-400 font-normal">days</span>
                </h3>
                <span class="text-[10px] text-amber-500 mt-2 block font-bold">Keep it burning!</span>
            </div>
        </div>

        <!-- Avg Duration -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 shadow-sm space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-xs text-zinc-500 font-medium">Avg. Session Duration</span>
                <i data-lucide="clock" class="w-5 h-5 text-sky-500"></i>
            </div>
            <div>
                <h3 class="text-2xl font-black text-zinc-900 dark:text-white">
                    1 hr <span class="text-xs text-zinc-400 font-normal">15 mins</span>
                </h3>
                <span class="text-[10px] text-sky-600 dark:text-sky-400 mt-2 block font-bold">Optimal Workout Time</span>
            </div>
        </div>

    </div>

    <!-- MAIN GRID: ATTENDANCE HISTORY TABLE -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-4">
            <h3 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <i data-lucide="history" class="w-4 h-4 text-lime-500"></i> Attendance Logs
            </h3>
            <span class="text-xs text-zinc-400 font-semibold">Showing Selected Month (@selectedMonth)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="border-b border-zinc-100 dark:border-zinc-800 text-zinc-400 font-semibold uppercase tracking-wider text-[10px]">
                        <th class="py-3 px-3">Date</th>
                        <th class="py-3 px-3">Class Name</th>
                        <th class="py-3 px-3">Check-In</th>
                        <th class="py-3 px-3">Check-Out</th>
                        <th class="py-3 px-3">Notes</th>
                        <th class="py-3 px-3 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-medium text-zinc-800 dark:text-zinc-200">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var att in Model)
                        {
                            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-3 font-bold text-zinc-900 dark:text-white">@att.Date.ToString("MMM dd, yyyy")</td>
                                <td class="py-3.5 px-3 text-zinc-600 dark:text-zinc-300">@att.ClassName</td>
                                <td class="py-3.5 px-3 font-bold">@(att.CheckIn != null ? att.CheckIn.ToString() : "N/A")</td>
                                <td class="py-3.5 px-3 text-zinc-400">@(att.CheckOut != null ? att.CheckOut.ToString() : "Active / Out")</td>
                                <td class="py-3.5 px-3 text-zinc-500">@(att.Notes ?? "-")</td>
                                <td class="py-3.5 px-3 text-right">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @(att.Status == "Present" ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20" : "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20")">
                                        @att.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-6 text-center text-zinc-400">Wali xog attendance ah ma diiwaangashana bishan.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>