@model IEnumerable<GymManagementSystem.Models.NutritionPlan>

@{
    ViewData["Title"] = "Nutrition Management";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}

<div class="bg-zinc-50 dark:bg-[#0a0f0d] text-zinc-800 dark:text-gray-100 p-4 md:p-6 rounded-2xl border border-zinc-200 dark:border-white/[0.08] w-full min-h-screen font-sans selection:bg-lime-400 selection:text-black transition-colors duration-200">

    <!-- 1. HEADER SECTION -->
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-6">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-lime-400 to-lime-500 text-black text-xl font-bold shadow-md shadow-lime-400/20 shrink-0">
                <i class="fa-solid fa-apple-whole"></i>
            </div>
            <div>
                <div class="flex items-center gap-2.5">
                    <h2 class="text-xl md:text-2xl font-black tracking-tight text-zinc-900 dark:text-white">Nutrition Dashboard</h2>
                    <span class="bg-lime-400/10 border border-lime-400/30 text-lime-600 dark:text-lime-400 font-extrabold px-2.5 py-1 rounded-full text-xs">@ViewBag.ActivePlansCount Active</span>
                </div>
                <p class="text-sm text-zinc-500 dark:text-gray-400 mt-0.5">Manage, track and analyze member nutrition programs</p>
            </div>
        </div>
    </div>

    <!-- 2. STATISTICS CARDS -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Card 1 -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#141c17] dark:to-[#0e1410] p-4 rounded-xl border border-zinc-200 dark:border-white/[0.08] shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-400/20 text-sm">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
                <span class="text-xs font-black uppercase bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-400/20 px-2 py-0.5 rounded-md">All Plans</span>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-gray-400">Total Plans</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-2xl font-black text-zinc-900 dark:text-white">@ViewBag.TotalPlans</span>
                <span class="text-xs font-bold text-lime-600 dark:text-lime-400"><i class="fa-solid fa-arrow-up text-[10px] mr-0.5"></i>Active</span>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#101e18] dark:to-[#0c1612] p-4 rounded-xl border border-zinc-200 dark:border-white/[0.08] shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 border border-emerald-400/20 text-sm">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <span class="text-xs font-black uppercase bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 border border-emerald-400/20 px-2 py-0.5 rounded-md">Active</span>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-gray-400">Active Plans</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-2xl font-black text-zinc-900 dark:text-white">@ViewBag.ActivePlansCount</span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Running</span>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#101b22] dark:to-[#0a1217] p-4 rounded-xl border border-zinc-200 dark:border-white/[0.08] shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-cyan-400/10 text-cyan-600 dark:text-cyan-400 border border-cyan-400/20 text-sm">
                    <i class="fa-solid fa-users"></i>
                </div>
                <span class="text-xs font-black uppercase bg-cyan-400/10 text-cyan-600 dark:text-cyan-400 border border-cyan-400/20 px-2 py-0.5 rounded-md">Enrolled</span>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-gray-400">Assigned Members</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-2xl font-black text-zinc-900 dark:text-white">@ViewBag.AssignedMembersCount</span>
                <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400">Total</span>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#211a12] dark:to-[#14100b] p-4 rounded-xl border border-zinc-200 dark:border-white/[0.08] shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-amber-400/10 text-amber-600 dark:text-amber-400 border border-amber-400/20 text-sm">
                    <i class="fa-solid fa-fire"></i>
                </div>
                <span class="text-xs font-black uppercase bg-amber-400/10 text-amber-600 dark:text-amber-400 border border-amber-400/20 px-2 py-0.5 rounded-md">Avg Cal</span>
            </div>
            <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-gray-400">Avg Daily Calories</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-2xl font-black text-zinc-900 dark:text-white">@ViewBag.AvgCalories</span>
                <span class="text-xs font-bold text-amber-600 dark:text-amber-400">kcal / day</span>
            </div>
        </div>
    </div>

    <!-- 3. SEARCH & FILTER BAR -->
    <form asp-action="Index" method="get" class="bg-white dark:bg-[#0e1410] p-3 rounded-xl border border-zinc-200 dark:border-white/[0.08] mb-6 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3 shadow-sm">
        <div class="relative w-full sm:w-80">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Search by Plan ID, name..."
                   class="w-full bg-zinc-100 dark:bg-[#141d17] border border-zinc-300 dark:border-white/10 text-sm text-zinc-800 dark:text-white placeholder-zinc-400 dark:placeholder-gray-500 rounded-xl pl-9 pr-3 py-2 focus:outline-none focus:border-lime-500 dark:focus:border-lime-400/50" />
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto flex-wrap sm:flex-nowrap">
            <select name="goalFilter" class="bg-zinc-100 dark:bg-[#141d17] border border-zinc-300 dark:border-white/10 text-sm text-zinc-700 dark:text-gray-300 rounded-xl px-3 py-2 focus:outline-none focus:border-lime-500 dark:focus:border-lime-400/50 w-full sm:w-auto">
                <option value="All">All Goals</option>
                <option value="Weight Loss">Weight Loss</option>
                <option value="Muscle Building">Muscle Building</option>
                <option value="Maintenance">Maintenance</option>
            </select>

            <button type="submit" class="w-full sm:w-auto bg-zinc-200 hover:bg-zinc-300 dark:bg-white/5 dark:hover:bg-white/10 text-zinc-800 dark:text-gray-200 border border-zinc-300 dark:border-white/10 font-bold px-4 py-2 rounded-xl text-sm transition-all cursor-pointer">
                Filter
            </button>
        </div>
    </form>

    <!-- 4. NUTRITION PLANS TABLE -->
    <div class="bg-white dark:bg-[#0e1410] rounded-2xl border border-zinc-200 dark:border-white/[0.08] overflow-hidden shadow-xl mb-6">
        <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-200 dark:border-white/[0.08] bg-zinc-50 dark:bg-white/[0.01]">
            <div>
                <h3 class="text-base font-extrabold text-zinc-900 dark:text-white">Nutrition Plans Overview</h3>
                <p class="text-xs text-zinc-500 dark:text-gray-400">Complete listing of active and drafted dietary programs</p>
            </div>
            <span class="text-xs font-bold text-lime-600 dark:text-lime-400 bg-lime-400/10 border border-lime-400/20 px-2.5 py-1 rounded-md">@(Model.Count()) Total Plans</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-zinc-700 dark:text-gray-200">
                <thead class="bg-zinc-100 dark:bg-white/[0.02] text-zinc-500 dark:text-gray-400 font-bold border-b border-zinc-200 dark:border-white/[0.06] uppercase tracking-wider text-xs">
                    <tr>
                        <th class="p-4 pl-5">Plan ID</th>
                        <th class="p-4">Plan Name</th>
                        <th class="p-4">Goal Type</th>
                        <th class="p-4">Daily Calories</th>
                        <th class="p-4">Macro Breakdown (P/C/F)</th>
                        <th class="p-4 text-center">Duration</th>
                        <th class="p-4">Created At</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 pr-5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-white/[0.04]">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center p-6 text-zinc-500">No nutrition plans found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var plan in Model)
                        {
                            <tr class="hover:bg-zinc-50 dark:hover:bg-white/[0.02] transition-colors">
                                <td class="p-4 pl-5 font-mono text-lime-600 dark:text-lime-400 font-bold text-sm">#NP-@plan.Id</td>
                                <td class="p-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-lg bg-lime-400/10 border border-lime-400/20 flex items-center justify-center text-lime-600 dark:text-lime-400 shrink-0">
                                            <i class="fa-solid fa-utensils"></i>
                                        </div>
                                        <span class="font-extrabold text-zinc-900 dark:text-white text-sm">@plan.Title</span>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <span class="bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 px-2.5 py-1 rounded-md text-xs font-bold">@plan.TargetGoal</span>
                                </td>
                                <td class="p-4 font-bold text-zinc-900 dark:text-white text-sm">@plan.Calories.ToString("N0") kcal</td>
                                <td class="p-4 text-xs">
                                    <span class="text-lime-600 dark:text-lime-400 font-bold">@(plan.Protein)g P</span> •
                                    <span class="text-cyan-600 dark:text-cyan-400 font-bold">@(plan.Carbs)g C</span> •
                                    <span class="text-amber-600 dark:text-amber-400 font-bold">@(plan.Fats)g F</span>
                                </td>
                                <td class="p-4 text-center font-bold text-zinc-900 dark:text-white text-sm">@plan.DurationWeeks Weeks</td>
                                <td class="p-4 text-xs">
                                    <span class="block text-zinc-800 dark:text-gray-200">@plan.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="p-4">
                                    <span class="bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 border border-emerald-400/20 px-2.5 py-1 rounded-md font-bold text-xs">Active</span>
                                </td>
                                <td class="p-4 pr-5 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1.5">
                                        <button type="button" onclick="openDetailsModal('@plan.Title', '#NP-@plan.Id', '@plan.Calories kcal', '@plan.Protein g P • @plan.Carbs g C • @plan.Fats g F', '@plan.DurationWeeks Weeks', 'Active')" class="text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 dark:hover:text-cyan-300 p-1.5 hover:bg-cyan-400/10 rounded-lg transition-all cursor-pointer" title="View Details">
                                            <i class="fa-solid fa-eye text-base"></i>
                                        </button>
                                        <form asp-action="Delete" asp-route-id="@plan.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this plan?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-rose-600 dark:text-rose-400 hover:text-rose-500 dark:hover:text-rose-300 p-1.5 hover:bg-rose-500/10 rounded-lg transition-all cursor-pointer" title="Delete Plan">
                                                <i class="fa-solid fa-trash text-base"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- NUTRITION PLAN DETAILS MODAL (POP-UP)      -->
<!-- ========================================== -->
<div id="detailsModal" class="fixed inset-0 bg-zinc-950/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-opacity">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col">

        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between bg-zinc-50 dark:bg-zinc-950/50">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-lime-500"></i>
                Nutrition Plan Details
            </h3>
            <button type="button" onclick="closeDetailsModal()" class="text-zinc-400 hover:text-rose-500 transition cursor-pointer w-8 h-8 flex items-center justify-center rounded-full hover:bg-zinc-200 dark:hover:bg-zinc-800">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Modal Body Content -->
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <span class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Plan ID</span>
                <span id="modalPlanId" class="text-sm font-mono font-bold text-lime-600 dark:text-lime-400"></span>
            </div>
            <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <span class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Plan Name</span>
                <span id="modalPlanName" class="text-sm font-bold text-zinc-900 dark:text-white"></span>
            </div>
            <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <span class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Daily Calories</span>
                <span id="modalCalories" class="text-sm font-bold text-zinc-900 dark:text-white"></span>
            </div>
            <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <span class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Macro Breakdown</span>
                <span id="modalMacros" class="text-sm font-bold text-zinc-900 dark:text-white"></span>
            </div>
            <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <span class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Duration</span>
                <span id="modalMembers" class="text-sm font-bold text-zinc-900 dark:text-white"></span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">Status</span>
                <span id="modalStatus" class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 border border-emerald-400/20"></span>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 flex justify-end">
            <button type="button" onclick="closeDetailsModal()" class="bg-zinc-200 hover:bg-zinc-300 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-semibold px-5 py-2 rounded-xl transition cursor-pointer text-sm">
                Close
            </button>
        </div>
    </div>
</div>

<!-- JavaScript for Details Modal -->
<script>
    function openDetailsModal(name, id, calories, macros, members, status) {
        document.getElementById('modalPlanName').innerText = name;
        document.getElementById('modalPlanId').innerText = id;
        document.getElementById('modalCalories').innerText = calories;
        document.getElementById('modalMacros').innerText = macros;
        document.getElementById('modalMembers').innerText = members;
        document.getElementById('modalStatus').innerText = status;

        document.getElementById('detailsModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDetailsModal() {
        document.getElementById('detailsModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Close on backdrop click
    window.onclick = function(event) {
        const modal = document.getElementById('detailsModal');
        if (event.target === modal) {
            closeDetailsModal();
        }
    }
</script>