@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}

<!-- FontAwesome & Chart.js CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="min-h-screen bg-zinc-50 dark:bg-[#050505] text-zinc-900 dark:text-zinc-100 p-4 md:p-8 transition-colors duration-200">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- HEADER -->
        <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4 bg-white dark:bg-[#141414] p-6 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20 shrink-0">
                    <i class="fa-solid fa-chart-line text-xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white">Reports & Analytics</h1>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">Monitor gym performance, revenue and member activity.</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <input type="date" id="txtReportDate" class="bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-3.5 py-2.5 outline-none focus:border-lime-500 font-medium cursor-pointer" />
                
                <button type="button" class="px-4 py-2.5 rounded-xl bg-lime-500 hover:bg-lime-400 text-zinc-950 text-sm font-black transition cursor-pointer shadow-sm">
                    Generate Report
                </button>
                
                <button type="button" onclick="window.print()" class="px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-800 text-sm font-semibold transition cursor-pointer">
                    <i class="fa-solid fa-print mr-1.5"></i> Print
