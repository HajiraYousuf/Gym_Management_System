                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Attendance Today</p>
                        <h3 class="mt-2 text-3xl font-black text-blue-600 dark:text-blue-400">312</h3>
                        <p class="mt-2 text-xs text-blue-600 dark:text-blue-400 font-bold">89.7% attendance rate</p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center border border-blue-500/20">
