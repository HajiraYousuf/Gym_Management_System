                            <td class="py-3 px-3 text-zinc-500 dark:text-zinc-400 font-mono text-xs">Jul 24, 2026</td>
                            <td class="py-3 px-3">
                                <div class="flex justify-end gap-2">
                                    <button type="button" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 cursor-pointer transition">View</button>
