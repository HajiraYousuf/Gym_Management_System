                                <td class="py-2.5 px-2 text-zinc-500 dark:text-zinc-400">20</td>
                                <td class="py-2.5 px-2">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Active</span>
