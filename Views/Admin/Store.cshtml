@model GymManagementSystem.Models.Product

@{
    ViewData["Title"] = "Store Management";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
    // We expect the controller to pass IEnumerable<Product> via ViewBag or a ViewModel, 
    // but here we keep the Index receiving the list or handle listing via Model collection.
}

<!-- Lucide Icons CDN -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="min-h-screen bg-zinc-50 dark:bg-[#050505] text-zinc-900 dark:text-zinc-100 p-4 md:p-8 transition-colors duration-200">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- PAGE HEADER -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-[#141414] p-6 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20 shrink-0">
                    <i data-lucide="store" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white">Store Management</h1>
                        <span class="px-2.5 py-0.5 rounded-full bg-lime-500 text-zinc-950 text-xs font-black">@((ViewBag.Products as List<GymManagementSystem.Models.Product>)?.Count ?? 0)</span>
                    </div>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">Manage your products, inventory, pricing and stock levels.</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button type="button" class="hidden sm:inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white font-semibold text-sm transition-all cursor-pointer">
                    <i data-lucide="download" class="w-4 h-4"></i> Export
                </button>

                <!-- ADD NEW PRODUCT BUTTON (Triggers Shared Modal for Create) -->
                <button type="button" onclick="openProductModal('create')" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold text-sm shadow-lg shadow-lime-500/10 transition-all cursor-pointer">
                    <i data-lucide="plus" class="w-4 h-4"></i> Add New Product
                </button>
            </div>
        </div>

        <!-- STAT CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <!-- TOTAL PRODUCTS -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-lime-500/40 transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Total Products</p>
                        <h3 class="mt-2 text-3xl font-black text-zinc-900 dark:text-white">@ViewBag.TotalProducts</h3>
                        <p class="mt-2 text-xs text-zinc-400 dark:text-zinc-500 flex items-center gap-1 font-medium">
                            <span class="text-lime-600 dark:text-lime-400 font-bold flex items-center gap-0.5"><i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Active</span>
                            <span>catalog items</span>
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20">
                        <i data-lucide="boxes" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

            <!-- IN STOCK -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-emerald-500/40 transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">In Stock</p>
                        <h3 class="mt-2 text-3xl font-black text-zinc-900 dark:text-white">@ViewBag.InStockCount</h3>
                        <p class="mt-2 text-xs text-zinc-400 dark:text-zinc-500 font-medium">
                            <span class="text-emerald-600 dark:text-emerald-400 font-bold">@ViewBag.InStockPercentage%</span>
                            <span>inventory availability</span>
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-500/20">
                        <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

            <!-- LOW STOCK -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-amber-500/40 transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Low Stock</p>
                        <h3 class="mt-2 text-3xl font-black text-amber-600 dark:text-amber-400">@ViewBag.LowStockCount</h3>
                        <p class="mt-2 text-xs text-amber-600 dark:text-amber-400 font-bold flex items-center gap-1">
                            <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i> Attention needed
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center border border-amber-500/20">
                        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

            <!-- OUT OF STOCK -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-rose-500/40 transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Out of Stock</p>
                        <h3 class="mt-2 text-3xl font-black text-rose-600 dark:text-rose-400">@ViewBag.OutOfStockCount</h3>
                        <p class="mt-2 text-xs text-rose-600 dark:text-rose-400 font-bold flex items-center gap-1">
                            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Requires restock
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center border border-rose-500/20">
                        <i data-lucide="x-circle" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- INVENTORY CONTAINER -->
        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl shadow-sm overflow-hidden">
            <!-- INVENTORY HEADER & FILTER FORM -->
            <form asp-action="Index" method="get" class="p-5 sm:p-6 border-b border-zinc-200 dark:border-zinc-800">
                <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-bold text-zinc-900 dark:text-white">Product Inventory</h2>
                        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">View and manage all products available in your gym store.</p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">
                        <div class="relative w-full sm:w-72">
                            <i data-lucide="search" class="w-4 h-4 text-zinc-400 absolute left-4 top-3.5"></i>
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Search products..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl pl-11 pr-4 py-2.5 focus:outline-none focus:border-lime-500 placeholder-zinc-400" />
                        </div>

                        <select name="categoryFilter" class="w-full sm:w-48 bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                            <option value="All">All Categories</option>
                            <option value="Supplements">Supplements</option>
                            <option value="Apparel">Apparel</option>
                            <option value="Equipment">Equipment</option>
                            <option value="Accessories">Accessories</option>
                        </select>

                        <button type="submit" class="px-4 py-2.5 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold rounded-xl text-xs transition cursor-pointer">Filter</button>
                    </div>
                </div>
            </form>

            <!-- PRODUCT TABLE -->
            <div class="overflow-x-auto">
                <table class="w-full min-w-[950px] text-left text-sm">
                    <thead>
                        <tr class="bg-zinc-100 dark:bg-zinc-900 text-zinc-500 dark:text-zinc-400 uppercase text-xs tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                            <th class="px-6 py-4">Product</th>
                            <th class="px-6 py-4">Category</th>
                            <th class="px-6 py-4">Price</th>
                            <th class="px-6 py-4">Stock</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800/60 font-medium">
                        @{
                            var productList = ViewBag.Products as List<GymManagementSystem.Models.Product>;
                        }
                        @if (productList == null || !productList.Any())
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-zinc-500 dark:text-zinc-400">No products found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in productList)
                            {
                                string statusText = item.StockQuantity > 5 ? "In Stock" : (item.StockQuantity > 0 ? "Low Stock" : "Out of Stock");
                                <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl bg-lime-500/10 border border-lime-500/20 flex items-center justify-center text-lime-600 dark:text-lime-400 shrink-0">
                                                <i data-lucide="package" class="w-5 h-5"></i>
                                            </div>
                                            <div>
                                                <div class="font-bold text-zinc-900 dark:text-white">@item.ProductName</div>
                                                <div class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5 font-mono">ID: #@item.ProductID</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-zinc-700 dark:text-zinc-300">@item.Category</td>
                                    <td class="px-6 py-4 font-bold text-lime-600 dark:text-lime-400">$@item.Price.ToString("0.00")</td>
                                    <td class="px-6 py-4">
                                        <span class="font-bold text-zinc-900 dark:text-white">@item.StockQuantity</span> <span class="text-xs text-zinc-400">units</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (statusText == "In Stock")
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-lime-500"></span> In Stock
                                            </span>
                                        }
                                        else if (statusText == "Low Stock")
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Out of Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex justify-end gap-1.5">
                                            <!-- View Details Button -->
                                            <button type="button" onclick="openDetailsModal('@item.ProductName', 'PRD-@item.ProductID', '@item.Category', '$@item.Price.ToString("0.00")', '@item.StockQuantity units', '@statusText', '@item.Description')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="View Details">
                                                <i data-lucide="eye" class="w-4 h-4"></i>
                                            </button>
                                            <!-- EDIT PRODUCT BUTTON (Triggers Shared Modal for Edit) -->
                                            <button type="button" onclick="openProductModal('edit', @item.ProductID, '@item.ProductName', '@item.Category', '@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)', @item.StockQuantity, '@item.Description')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-500 hover:text-zinc-950 text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="Edit Product">
                                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                            </button>
                                            <!-- Delete Form -->
                                            <form asp-action="DeleteProduct" asp-route-id="@item.ProductID" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-rose-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="Delete Product">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SHARED PRODUCT MODAL (Handles both CREATE and EDIT) -->
<div id="productModal" class="fixed inset-0 z-50 hidden bg-zinc-950/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-6">
        
        <!-- Modal Header -->
        <div class="flex justify-between items-center border-b border-zinc-200 dark:border-zinc-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20">
                    <i id="modalHeaderIcon" data-lucide="plus" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 id="modalTitle" class="text-lg font-bold text-zinc-900 dark:text-white">Add New Product</h3>
                    <p id="modalSubtitle" class="text-xs text-zinc-400">Fill in product specifications and stock details</p>
                </div>
            </div>
            <button type="button" onclick="closeProductModal()" class="text-zinc-400 hover:text-rose-500 cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Modal Form -->
        <form id="productForm" asp-action="Create" method="post" class="space-y-4 text-sm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="ProductID" name="ProductID" value="0" />

            <div>
                <label class="block text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 mb-1">Product Name</label>
                <input type="text" id="ProductName" name="ProductName" required placeholder="e.g. Mass Gainer 3kg" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500" />
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 mb-1">Category</label>
                <select id="Category" name="Category" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                    <option value="">Select Category</option>
                    <option value="Supplements">Supplements</option>
                    <option value="Apparel">Apparel</option>
                    <option value="Equipment">Equipment</option>
                    <option value="Accessories">Accessories</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 mb-1">Price ($)</label>
                    <input type="number" step="0.01" id="Price" name="Price" required placeholder="0.00" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 mb-1">Stock (Units)</label>
                    <input type="number" id="StockQuantity" name="StockQuantity" required placeholder="10" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 mb-1">Description</label>
                <textarea rows="3" id="Description" name="Description" placeholder="Enter product description..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 resize-none"></textarea>
            </div>

            <!-- Modal Footer -->
            <div class="flex justify-end gap-3 pt-4 border-t border-zinc-200 dark:border-zinc-800">
                <button type="button" onclick="closeProductModal()" class="px-5 py-2.5 bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 font-bold text-xs rounded-xl transition-all cursor-pointer">Cancel</button>
                <button type="submit" id="modalSubmitBtn" class="px-5 py-2.5 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold text-xs rounded-xl shadow-md shadow-lime-500/10 transition-all cursor-pointer">Save Product</button>
            </div>
        </form>
    </div>
</div>

<!-- PRODUCT DETAILS MODAL -->
<div id="productDetailsModal" class="fixed inset-0 z-50 hidden bg-zinc-950/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-6">
        <div class="flex justify-between items-center border-b border-zinc-200 dark:border-zinc-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center border border-blue-500/20">
                    <i data-lucide="info" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Product Extended Details</h3>
                    <p class="text-xs text-zinc-400 font-mono" id="modalSku">ID: ---</p>
                </div>
            </div>
            <button type="button" onclick="closeDetailsModal()" class="text-zinc-400 hover:text-rose-500 cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="space-y-4 text-sm">
            <div class="grid grid-cols-2 gap-4 bg-zinc-50 dark:bg-zinc-900/50 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800/80">
                <div>
                    <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Product Name</span>
                    <span class="font-bold text-zinc-900 dark:text-white" id="modalName">-</span>
                </div>
                <div>
                    <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Category & Price</span>
                    <span class="font-semibold text-zinc-700 dark:text-zinc-300"><span id="modalCategory">-</span> (<span id="modalPrice" class="text-lime-600 dark:text-lime-400 font-bold">-</span>)</span>
                </div>
            </div>

            <div class="px-1">
                <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Product Description / Notes</span>
                <p class="text-zinc-600 dark:text-zinc-300 text-xs leading-relaxed bg-zinc-50 dark:bg-zinc-900/30 p-3 rounded-xl border border-zinc-200 dark:border-zinc-800/80" id="modalDescription">-</p>
            </div>

            <div class="grid grid-cols-2 gap-4 px-1 pt-2 border-t border-zinc-200 dark:border-zinc-800">
                <div>
                    <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Available Quantity</span>
                    <span class="font-bold text-zinc-900 dark:text-white" id="modalStock">-</span>
                </div>
                <div>
                    <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Current Status</span>
                    <span id="modalStatusBadge" class="inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold">-</span>
                </div>
            </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-zinc-200 dark:border-zinc-800">
            <button type="button" onclick="closeDetailsModal()" class="px-5 py-2.5 bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 font-bold text-xs rounded-xl transition-all cursor-pointer">Close</button>
        </div>
    </div>
</div>

<script>
    // Open Shared Modal for Create or Edit
    function openProductModal(mode, id = 0, name = '', category = '', price = '', stock = '', description = '') {
        const form = document.getElementById('productForm');
        const modalTitle = document.getElementById('modalTitle');
        const modalSubtitle = document.getElementById('modalSubtitle');
        const submitBtn = document.getElementById('modalSubmitBtn');

        if (mode === 'edit') {
            form.action = '/Products/Edit'; // Adjust action if your controller uses Edit/{id} or asp-action
            modalTitle.innerText = 'Edit Product';
            modalSubtitle.innerText = 'Update product details and stock information';
            submitBtn.innerText = 'Update Product';

            document.getElementById('ProductID').value = id;
            document.getElementById('ProductName').value = name;
            document.getElementById('Category').value = category;
            document.getElementById('Price').value = price;
            document.getElementById('StockQuantity').value = stock;
            document.getElementById('Description').value = description;
        } else {
            form.action = '/Products/Create';
            modalTitle.innerText = 'Add New Product';
            modalSubtitle.innerText = 'Fill in product specifications and stock details';
            submitBtn.innerText = 'Save Product';

            form.reset();
            document.getElementById('ProductID').value = 0;
        }

        document.getElementById('productModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        if (window.lucide) { lucide.createIcons(); }
    }

    // Close Shared Modal
    function closeProductModal() {
        document.getElementById('productModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Open Details Modal
    function openDetailsModal(name, sku, category, price, stock, status, description) {
        document.getElementById('modalName').innerText = name;
        document.getElementById('modalSku').innerText = sku;
        document.getElementById('modalCategory').innerText = category;
        document.getElementById('modalPrice').innerText = price;
        document.getElementById('modalStock').innerText = stock;
        document.getElementById('modalDescription').innerText = description || "No description provided.";

        const badge = document.getElementById('modalStatusBadge');
        if (status === 'In Stock') {
            badge.className = "inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-500/20";
            badge.innerText = "In Stock";
        } else if (status === 'Low Stock') {
            badge.className = "inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20";
            badge.innerText = "Low Stock";
        } else {
            badge.className = "inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20";
            badge.innerText = "Out of Stock";
        }

        document.getElementById('productDetailsModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    // Close Details Modal
    function closeDetailsModal() {
        document.getElementById('productDetailsModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Initialize Lucide Icons
    document.addEventListener('DOMContentLoaded', function () {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>