                <button type="button" class="px-6 py-3 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-lime-500 hover:text-zinc-950 text-zinc-800 dark:text-zinc-200 text-sm font-bold transition-all cursor-pointer">
                    Search
