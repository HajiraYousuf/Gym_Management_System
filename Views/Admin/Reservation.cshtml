                                <div class="flex justify-end items-center gap-1.5">
                                    <button type="button" onclick="openDetailsModal('#RES-1025', 'Aisha Mohamed', 'Member #M-2046', 'Personal Training', 'Ali Ahmed', '21 May 2025', '10:00 AM', 'Pending')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="View Details">
