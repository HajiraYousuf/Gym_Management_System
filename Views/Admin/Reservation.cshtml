                    </div>
                </div>
                <div class="text-3xl font-black text-zinc-900 dark:text-white">12</div>
            </div>

            <!-- Confirmed -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-blue-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Confirmed</p>
                        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-0.5">Approved bookings</p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center border border-blue-500/20">
                        <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                    </div>
                </div>
                <div class="text-3xl font-black text-zinc-900 dark:text-white">30</div>
            </div>

            <!-- Cancelled -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-rose-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Cancelled</p>
                        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-0.5">Cancelled bookings</p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center border border-rose-500/20">
                        <i data-lucide="x-circle" class="w-5 h-5"></i>
                    </div>
                </div>
                <div class="text-3xl font-black text-zinc-900 dark:text-white">6</div>
            </div>

        </div>

        <!-- 3. Search & Filters Toolbar -->
        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-4 shadow-sm space-y-3 lg:space-y-0 lg:flex lg:items-center lg:gap-3">
