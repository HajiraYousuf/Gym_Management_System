                    </div>
                </div>
                <div class="text-3xl font-black text-zinc-900 dark:text-white">48</div>
            </div>

            <!-- Pending -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm hover:border-amber-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Pending</p>
                        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-0.5">Awaiting confirmation</p>
                    </div>
