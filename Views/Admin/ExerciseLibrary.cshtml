@{
    ViewData["Title"] = "Exercise Library";
    Layout = "~/Views/layouts/AdminMaster.cshtml";

}

<div class="p-4 md:p-6 bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors duration-200">
    
    <!-- Top Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 md:mb-8 gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white flex items-center gap-3">
                <i class="fa-solid fa-book-open text-lime-500"></i>
                Exercise Library
            </h1>
            <p class="text-zinc-500 dark:text-zinc-400 text-xs md:text-sm mt-1">Browse, organize, and manage movement techniques for workout plans.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="openModal('addExerciseModal')" class="w-full sm:w-auto bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-lime-500/20 transition duration-200 flex items-center justify-center gap-2 text-sm cursor-pointer">
                <i class="fa-solid fa-plus"></i>
                Add New Exercise
            </button>
        </div>
    </div>

    <!-- Metric Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 mb-6 md:mb-8">
        <!-- Total Exercises -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Total Movements</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">128</h3>
                </div>
                <div class="w-12 h-12 bg-lime-500/10 border border-lime-500/20 rounded-xl flex items-center justify-center text-lime-600 dark:text-lime-400">
                    <i class="fa-solid fa-dumbbell text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Major Muscle Groups -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Muscle Groups</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">8 Category</h3>
                </div>
                <div class="w-12 h-12 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                    <i class="fa-solid fa-child-reaching text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Video Demos Available -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Video Tutorials</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">94 Demos</h3>
                </div>
                <div class="w-12 h-12 bg-cyan-500/10 border border-cyan-500/20 rounded-xl flex items-center justify-center text-cyan-600 dark:text-cyan-400">
                    <i class="fa-solid fa-circle-play text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Custom Variations -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Custom Variations</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">16 Custom</h3>
                </div>
                <div class="w-12 h-12 bg-amber-500/10 border border-amber-500/20 rounded-xl flex items-center justify-center text-amber-500 dark:text-amber-400">
                    <i class="fa-solid fa-sliders text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 mb-6 flex flex-col md:flex-row gap-4 justify-between items-center shadow-sm">
        <!-- Search -->
        <div class="relative w-full md:w-96">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
            <input type="text" id="txtSearchExercise" class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl pl-10 pr-4 py-2.5 focus:outline-none focus:border-lime-500 transition" placeholder="Search by exercise or muscle group..." />
        </div>
        
        <!-- Filters -->
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            <select id="ddlTargetMuscle" class="w-full sm:w-auto bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500">
                <option value="All">All Muscle Groups</option>
                <option value="Chest">Chest</option>
                <option value="Back">Back</option>
                <option value="Legs">Legs (Quads/Hamstrings)</option>
                <option value="Shoulders">Shoulders</option>
                <option value="Arms">Arms (Biceps/Triceps)</option>
                <option value="Core">Core / Abs</option>
            </select>

            <select id="ddlEquipment" class="w-full sm:w-auto bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500">
                <option value="All">All Equipment</option>
                <option value="Barbell">Barbell</option>
                <option value="Dumbbell">Dumbbell</option>
                <option value="Cable">Cable Machine</option>
                <option value="Bodyweight">Bodyweight</option>
                <option value="Smith">Smith Machine</option>
            </select>

            <button type="button" class="w-full sm:w-auto bg-zinc-800 dark:bg-zinc-800 hover:bg-zinc-700 text-white font-medium px-5 py-2.5 rounded-xl transition cursor-pointer text-sm">Filter</button>
        </div>
    </div>

    <!-- Exercise Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">

        <!-- Exercise Card 1: Barbell Bench Press -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition duration-300 flex flex-col justify-between">
            <div>
                <!-- Visual Header / Video Placeholder -->
                <div class="relative h-44 bg-zinc-800 flex items-center justify-center overflow-hidden group">
                    <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=600&q=80" alt="Bench Press" class="w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-80" />
                    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
                    
                    <!-- Badges -->
                    <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md text-lime-400 border border-lime-500/30 text-[11px] font-bold px-2.5 py-1 rounded-lg">
                        Barbell
                    </span>
                    <span class="absolute top-3 right-3 bg-zinc-950/80 backdrop-blur-md text-zinc-300 text-[11px] font-semibold px-2.5 py-1 rounded-lg flex items-center gap-1">
                        <i class="fa-solid fa-fire text-amber-400"></i> High Impact
                    </span>

                    <!-- Play Button Icon -->
                    <a href="#" class="absolute w-12 h-12 bg-lime-500/90 hover:bg-lime-400 text-zinc-950 rounded-full flex items-center justify-center shadow-lg transition transform hover:scale-110">
                        <i class="fa-solid fa-play text-sm ml-0.5"></i>
                    </a>
                </div>

                <!-- Card Body -->
                <div class="p-5">
                    <div class="flex items-center justify-between mb-1">
                        <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Barbell Bench Press</h3>
                        <span class="text-xs font-semibold text-lime-600 dark:text-lime-400 bg-lime-500/10 px-2 py-0.5 rounded-md">Chest</span>
                    </div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-4 line-clamp-2">Primary compound movement targeting upper body push strength, pectorals, front deltoids, and triceps.</p>

                    <!-- Specifications Grid -->
                    <div class="grid grid-cols-2 gap-2 text-xs bg-zinc-50 dark:bg-zinc-950 p-3 rounded-xl border border-zinc-100 dark:border-zinc-800/60 mb-2">
                        <div>
                            <span class="text-zinc-400 block font-medium">Secondary Muscle</span>
                            <span class="font-semibold text-zinc-700 dark:text-zinc-300">Triceps, Deltoids</span>
                        </div>
                        <div>
                            <span class="text-zinc-400 block font-medium">Difficulty Level</span>
                            <span class="font-semibold text-emerald-600 dark:text-emerald-400">Intermediate</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="p-4 pt-0 border-t border-zinc-100 dark:border-zinc-800/80 mt-2 grid grid-cols-3 gap-2">
                <button type="button" onclick="openModal('detailsExerciseModal')" class="bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition cursor-pointer">
                    <i class="fa-solid fa-eye text-zinc-500 dark:text-zinc-400"></i> Details
                </button>
                <a href="#" class="bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition">
                    <i class="fa-solid fa-pen-to-square text-zinc-500 dark:text-zinc-400"></i> Edit
                </a>
                <a href="#" class="bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/20 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 transition">
                    <i class="fa-solid fa-trash-can"></i> Delete
                </a>
            </div>
        </div>

    </div>

    <!-- Pagination Controls -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400 shadow-sm">
        <span>Showing 1 to 3 of 128 Exercises</span>
        <div class="flex items-center gap-2">
            <button type="button" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition">Previous</button>
            <button type="button" class="px-3 py-1.5 rounded-lg bg-lime-500 text-zinc-950 font-bold">1</button>
            <button type="button" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition">2</button>
            <button type="button" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition">3</button>
            <button type="button" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition">Next</button>
        </div>
    </div>

</div>

<!-- ========================================== -->
<!-- ADD EXERCISE MODAL (POP-UP)                -->
<!-- ========================================== -->
<div id="addExerciseModal" class="fixed inset-0 bg-zinc-950/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-opacity">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
        
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between bg-zinc-50 dark:bg-zinc-950/50">
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-dumbbell text-lime-500"></i>
                Add New Exercise
            </h2>
            <button type="button" onclick="closeModal('addExerciseModal')" class="text-zinc-400 hover:text-rose-500 transition cursor-pointer w-8 h-8 flex items-center justify-center rounded-full hover:bg-zinc-200 dark:hover:bg-zinc-800">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Modal Body (Scrollable) -->
        <div class="p-6 overflow-y-auto custom-scrollbar">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                
                <!-- Exercise Name -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Exercise Name <span class="text-rose-500">*</span></label>
                    <input type="text" class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition" placeholder="e.g., Barbell Bench Press" />
                </div>

                <!-- Primary Muscle -->
                <div>
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Primary Muscle <span class="text-rose-500">*</span></label>
                    <select class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition">
                        <option value="">Select Muscle</option>
                        <option value="Chest">Chest</option>
                        <option value="Back">Back</option>
                        <option value="Legs">Legs</option>
                        <option value="Shoulders">Shoulders</option>
                        <option value="Arms">Arms</option>
                        <option value="Core">Core</option>
                    </select>
                </div>

                <!-- Equipment -->
                <div>
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Equipment <span class="text-rose-500">*</span></label>
                    <select class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition">
                        <option value="">Select Equipment</option>
                        <option value="Barbell">Barbell</option>
                        <option value="Dumbbell">Dumbbell</option>
                        <option value="Machine">Machine</option>
                        <option value="Bodyweight">Bodyweight</option>
                    </select>
                </div>

                <!-- Difficulty Level -->
                <div>
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Difficulty Level</label>
                    <select class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>

                <!-- Video URL -->
                <div>
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Video Demo URL</label>
                    <input type="text" class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition" placeholder="https://youtube.com/..." />
                </div>

                <!-- Description -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Instructions / Description</label>
                    <textarea rows="3" class="w-full bg-zinc-100 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition" placeholder="Enter step-by-step instructions..."></textarea>
                </div>

                <!-- Image Upload -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">Thumbnail Image</label>
                    <input type="file" class="w-full text-sm text-zinc-500 dark:text-zinc-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-lime-500/10 file:text-lime-600 dark:file:text-lime-400 hover:file:bg-lime-500/20 cursor-pointer border border-zinc-300 dark:border-zinc-800 rounded-xl bg-zinc-100 dark:bg-zinc-950" />
                </div>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 flex justify-end gap-3">
            <button type="button" onclick="closeModal('addExerciseModal')" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-800 transition cursor-pointer">
                Cancel
            </button>
            <button type="button" class="bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold px-6 py-2.5 rounded-xl shadow-lg shadow-lime-500/20 transition cursor-pointer text-sm">
                Save Exercise
            </button>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- EXERCISE DETAILS MODAL (POP-UP FIXED)      -->
<!-- ========================================== -->
<div id="detailsExerciseModal" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-opacity">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh] relative">
        
        <!-- Close Button (Fixed Top-Right) -->
        <button type="button" onclick="closeModal('detailsExerciseModal')" class="absolute top-4 right-4 bg-black/60 hover:bg-rose-500 text-white transition cursor-pointer w-9 h-9 flex items-center justify-center rounded-full backdrop-blur-md z-20">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>

        <!-- Modal Body (Scrollable Container) -->
        <div class="overflow-y-auto custom-scrollbar">
            
            <!-- Video/Image Header -->
            <div class="relative h-56 sm:h-64 bg-zinc-950 w-full shrink-0">
                <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=800&q=80" alt="Exercise View" class="w-full h-full object-cover opacity-60" />
                <div class="absolute inset-0 flex items-center justify-center">
                    <button type="button" class="w-14 h-14 bg-lime-500 hover:bg-lime-400 text-zinc-950 rounded-full flex items-center justify-center shadow-[0_0_25px_rgba(132,204,22,0.5)] transition transform hover:scale-110 cursor-pointer">
                        <i class="fa-solid fa-play text-xl ml-1"></i>
                    </button>
                </div>
            </div>

            <!-- Details Content -->
            <div class="p-6">
                <!-- Badges -->
                <div class="flex flex-wrap gap-2 mb-3">
                    <span class="bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 text-xs font-bold px-3 py-1 rounded-lg">
                        <i class="fa-solid fa-dumbbell mr-1"></i> Barbell
                    </span>
                    <span class="bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-xs font-bold px-3 py-1 rounded-lg">
                        <i class="fa-solid fa-gauge-high mr-1"></i> Intermediate
                    </span>
                </div>

                <!-- Title & Primary Muscle -->
                <h2 class="text-2xl font-black text-zinc-900 dark:text-white mb-1">Barbell Bench Press</h2>
                
                <div class="flex items-center gap-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6">
                    <span class="text-lime-600 dark:text-lime-400"><i class="fa-solid fa-bullseye mr-1"></i> Primary: Chest</span>
                    <span class="w-1 h-1 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
                    <span>Secondary: Triceps, Deltoids</span>
                </div>

                <!-- Instructions -->
                <div class="border-t border-zinc-200 dark:border-zinc-800 pt-4">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-900 dark:text-white mb-3">Instructions</h3>
                    <ol class="space-y-2.5 text-zinc-600 dark:text-zinc-300 text-sm leading-relaxed list-decimal list-inside">
                        <li>Lie flat on the bench with your feet firmly on the ground.</li>
                        <li>Grip the bar slightly wider than shoulder-width apart.</li>
                        <li>Unrack the bar and lower it slowly to your mid-chest.</li>
                        <li>Press the bar back up until your arms are fully extended.</li>
                    </ol>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="px-6 py-3.5 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 flex justify-end shrink-0">
            <button type="button" onclick="closeModal('detailsExerciseModal')" class="bg-zinc-200 hover:bg-zinc-300 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-semibold px-5 py-2 rounded-xl transition cursor-pointer text-sm">
                Close
            </button>
        </div>
    </div>
</div>

<!-- JavaScript for Modals -->
<script>
    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if(modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if(modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }
    }

    // Close modal when clicking outside the box
    window.onclick = function(event) {
        const addModal = document.getElementById('addExerciseModal');
        const detailModal = document.getElementById('detailsExerciseModal');
        if (event.target === addModal) {
            closeModal('addExerciseModal');
        }
        if (event.target === detailModal) {
            closeModal('detailsExerciseModal');
        }
    }
</script>