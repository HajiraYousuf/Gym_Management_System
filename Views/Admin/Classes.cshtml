<!-- MODAL 3: DELETE CONFIRMATION POP-UP        -->
<!-- ========================================== -->
<div id="deleteClassModal" class="fixed inset-0 z-50 hidden bg-zinc-950/70 backdrop-blur-sm overflow-y-auto flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="p-6 text-center space-y-4">
            <div class="w-14 h-14 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto border border-rose-500/20">
                <i data-lucide="alert-triangle" class="w-7 h-7"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Delete Class Program?</h3>
                <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2">
                    Are you sure you want to delete <span id="deleteClassName" class="font-bold text-zinc-900 dark:text-white"></span>? This action cannot be undone.
                </p>
            </div>
        </div>

        <div class="flex items-center justify-center gap-3 px-6 py-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
            <button type="button" onclick="closeDeleteModal()" class="px-5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors w-1/2 cursor-pointer">
                Cancel
            </button>
            <button type="button" onclick="closeDeleteModal()" class="px-5 py-2.5 rounded-xl bg-rose-500 hover:bg-rose-600 text-white font-bold text-sm transition-colors cursor-pointer w-1/2 shadow-lg shadow-rose-500/10">
                Delete
            </button>
        </div>
    </div>
</div>

<!-- JavaScript Controls -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) {
            lucide.createIcons();
        }
    });

    // Add / Edit Modal Controls
    function openAddClassModal() {
        document.getElementById('modalTitle').innerText = "Add New Class";
        document.getElementById('classListModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function openEditModal(className) {
        document.getElementById('modalTitle').innerText = "Edit Class: " + className;
        document.getElementById('classListModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeClassModal() {
        document.getElementById('classListModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // View Modal Controls
    function openViewModal(name, category, difficulty, duration, capacity, equipment, status, description) {
        document.getElementById('viewClassName').innerText = name;
        document.getElementById('viewCategory').innerText = category;
        document.getElementById('viewDifficulty').innerText = difficulty;
        document.getElementById('viewDuration').innerText = duration;
        document.getElementById('viewCapacity').innerText = capacity;
        document.getElementById('viewEquipment').innerText = equipment;
        document.getElementById('viewStatus').innerText = status;
        document.getElementById('viewDescription').innerText = description;
        document.getElementById('viewClassModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeViewModal() {
        document.getElementById('viewClassModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Delete Modal Controls
    function openDeleteModal(className) {
        document.getElementById('deleteClassName').innerText = className;
        document.getElementById('deleteClassModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        document.getElementById('deleteClassModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
</script>