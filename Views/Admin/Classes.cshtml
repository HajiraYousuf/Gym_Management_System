@{
    ViewData["Title"] = "Class List";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}


<div class="space-y-8 pt-4 pb-12 px-4 sm:px-6 lg:px-8 bg-zinc-50 dark:bg-[#050505] text-zinc-900 dark:text-zinc-100 min-h-screen transition-colors duration-200">

    <!-- 1. Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white">Class List</h1>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Manage master gym classes, difficulty levels, equipment, and default configurations.</p>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors shadow-sm cursor-pointer">
                <i data-lucide="download" class="w-4 h-4 text-zinc-500 dark:text-zinc-400"></i>
                Export List
            </button>
            <button type="button" onclick="openAddClassModal()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold text-sm transition-colors cursor-pointer shadow-lg shadow-lime-500/10">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Add New Class
            </button>
        </div>
    </div>

    <!-- 2. Stat Cards Section -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 tracking-wider">Total Classes</p>
                <h3 class="text-2xl font-black text-zinc-900 dark:text-white mt-1">12</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Master programs available</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 tracking-wider">Active Classes</p>
                <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">10</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Currently offered in schedules</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-500/20">
                <i data-lucide="check-circle-2" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 tracking-wider">Inactive Classes</p>
                <h3 class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1">2</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Paused or seasonal programs</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center border border-rose-500/20">
                <i data-lucide="pause-circle" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400 tracking-wider">Categories</p>
                <h3 class="text-2xl font-black text-blue-600 dark:text-blue-400 mt-1">4</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Strength, HIIT, Yoga, Combat</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center border border-blue-500/20">
                <i data-lucide="grid" class="w-6 h-6"></i>
            </div>
        </div>
    </div>

    <!-- 3. Action Toolbar & Controls -->
    <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="relative flex-1 min-w-[260px]">
                <i data-lucide="search" class="w-5 h-5 text-zinc-400 absolute left-4 top-3.5"></i>
                <input type="text" placeholder="Search class name, equipment, or category..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl pl-12 pr-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-500" />
            </div>

            <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                <div class="relative flex-1 sm:flex-none">
                    <select class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 pr-10 focus:outline-none focus:border-lime-500 appearance-none font-medium cursor-pointer">
                        <option value="">All Categories</option>
                        <option value="Strength Training">Strength Training</option>
                        <option value="Cardio & HIIT">Cardio & HIIT</option>
                        <option value="Yoga & Wellness">Yoga & Wellness</option>
                        <option value="Boxing & Combat">Boxing & Combat</option>
                    </select>
                    <i data-lucide="chevron-down" class="w-4 h-4 text-zinc-400 absolute right-3 top-3.5 pointer-events-none"></i>
                </div>

                <div class="relative flex-1 sm:flex-none">
                    <select class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 pr-10 focus:outline-none focus:border-lime-500 appearance-none font-medium cursor-pointer">
                        <option value="">All Difficulty Levels</option>
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                    <i data-lucide="chevron-down" class="w-4 h-4 text-zinc-400 absolute right-3 top-3.5 pointer-events-none"></i>
                </div>

                <div class="relative flex-1 sm:flex-none">
                    <select class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 pr-10 focus:outline-none focus:border-lime-500 appearance-none font-medium cursor-pointer">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <i data-lucide="chevron-down" class="w-4 h-4 text-zinc-400 absolute right-3 top-3.5 pointer-events-none"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Class List Table -->
    <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-6 shadow-sm">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h2 class="text-lg font-bold text-zinc-900 dark:text-white tracking-wide">Available Gym Classes</h2>
                <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Master template list of all fitness programs offered.</p>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-zinc-700 dark:text-zinc-200">
                <thead class="bg-zinc-100 dark:bg-zinc-900 text-zinc-500 dark:text-zinc-400 uppercase text-xs tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th scope="col" class="py-4 px-5 rounded-l-xl">Class Name</th>
                        <th scope="col" class="py-4 px-5">Category</th>
                        <th scope="col" class="py-4 px-5">Difficulty</th>
                        <th scope="col" class="py-4 px-5">Duration</th>
                        <th scope="col" class="py-4 px-5">Capacity</th>
                        <th scope="col" class="py-4 px-5">Equipment Needed</th>
                        <th scope="col" class="py-4 px-5">Status</th>
                        <th scope="col" class="py-4 px-5 text-center rounded-r-xl">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800/60 font-medium">
                    
                    <!-- Row 1 -->
                    <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors">
                        <td class="py-4 px-5 font-bold text-zinc-900 dark:text-white flex items-center gap-3 text-base">
                            <div class="w-9 h-9 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold border border-lime-500/20 shrink-0">
                                <i data-lucide="dumbbell" class="w-5 h-5"></i>
                            </div>
                            Morning Strength
                        </td>
                        <td class="py-4 px-5 text-zinc-600 dark:text-zinc-300">
                            <span class="bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 px-3 py-1 rounded-lg text-xs font-semibold">Strength Training</span>
                        </td>
                        <td class="py-4 px-5">
                            <span class="bg-amber-500/10 text-amber-600 dark:text-amber-400 px-2.5 py-1 rounded-md text-xs font-bold border border-amber-500/20">Intermediate</span>
                        </td>
                        <td class="py-4 px-5 font-mono text-zinc-600 dark:text-zinc-300">60 mins</td>
                        <td class="py-4 px-5 font-mono text-zinc-600 dark:text-zinc-300">15 Persons</td>
                        <td class="py-4 px-5 text-zinc-600 dark:text-zinc-300">Dumbbells, Barbells, Bench</td>
                        <td class="py-4 px-5">
                            <span class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-md text-xs font-bold border border-emerald-500/20">Active</span>
                        </td>
                        <td class="py-4 px-5 text-center">
                            <div class="flex justify-center items-center gap-2">
                                <button type="button" onclick="openViewModal('Morning Strength', 'Strength Training', 'Intermediate', '60 mins', '15 Persons', 'Dumbbells, Barbells, Bench', 'Active', 'Full body resistance training designed to build muscle, improve posture, and boost overall endurance.')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="View Details">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                </button>
                                <button type="button" onclick="openEditModal('Morning Strength')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-500 hover:text-zinc-950 text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="Edit Class">
                                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                                </button>
                                <button type="button" onclick="openDeleteModal('Morning Strength')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-rose-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="Delete Class">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors">
                        <td class="py-4 px-5 font-bold text-zinc-900 dark:text-white flex items-center gap-3 text-base">
                            <div class="w-9 h-9 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold border border-lime-500/20 shrink-0">
                                <i data-lucide="heart-pulse" class="w-5 h-5"></i>
                            </div>
                            Cardio Blast
                        </td>
                        <td class="py-4 px-5 text-zinc-600 dark:text-zinc-300">
                            <span class="bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 px-3 py-1 rounded-lg text-xs font-semibold">Cardio & HIIT</span>
                        </td>
                        <td class="py-4 px-5">
                            <span class="bg-rose-500/10 text-rose-600 dark:text-rose-400 px-2.5 py-1 rounded-md text-xs font-bold border border-rose-500/20">Advanced</span>
                        </td>
                        <td class="py-4 px-5 font-mono text-zinc-600 dark:text-zinc-300">45 mins</td>
                        <td class="py-4 px-5 font-mono text-zinc-600 dark:text-zinc-300">20 Persons</td>
                        <td class="py-4 px-5 text-zinc-600 dark:text-zinc-300">Jump Rope, Kettlebell</td>
                        <td class="py-4 px-5">
                            <span class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-md text-xs font-bold border border-emerald-500/20">Active</span>
                        </td>
                        <td class="py-4 px-5 text-center">
                            <div class="flex justify-center items-center gap-2">
                                <button type="button" onclick="openViewModal('Cardio Blast', 'Cardio & HIIT', 'Advanced', '45 mins', '20 Persons', 'Jump Rope, Kettlebell', 'Active', 'High-intensity interval training session engineered for rapid calorie burning and aerobic stamina.')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="View Details">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                </button>
                                <button type="button" onclick="openEditModal('Cardio Blast')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-500 hover:text-zinc-950 text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="Edit Class">
                                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                                </button>
                                <button type="button" onclick="openDeleteModal('Cardio Blast')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-rose-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer" title="Delete Class">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ========================================== -->
<!-- MODAL 1: ADD / EDIT CLASS MODAL            -->
<!-- ========================================== -->
<div id="classListModal" class="fixed inset-0 z-50 hidden bg-zinc-950/70 backdrop-blur-sm overflow-y-auto flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden my-8 transform transition-all">
        <div class="flex items-center justify-between px-6 py-5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold border border-lime-500/20">
                    <i data-lucide="layers" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 id="modalTitle" class="text-lg font-bold text-zinc-900 dark:text-white">Add New Class</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Create or modify a master fitness program template.</p>
                </div>
            </div>
            <button type="button" onclick="closeClassModal()" class="text-zinc-400 hover:text-rose-500 p-2 rounded-lg hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="p-6 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Class Name <span class="text-lime-500">*</span></label>
                    <input type="text" placeholder="e.g. CrossFit Challenge" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-600" />
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Category <span class="text-lime-500">*</span></label>
                    <select class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500">
                        <option value="">-- Select Category --</option>
                        <option value="Strength Training">Strength Training</option>
                        <option value="Cardio & HIIT">Cardio & HIIT</option>
                        <option value="Yoga & Wellness">Yoga & Wellness</option>
                        <option value="Boxing & Combat">Boxing & Combat</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Duration (Mins) <span class="text-lime-500">*</span></label>
                    <input type="number" placeholder="e.g. 60" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-600" />
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Default Capacity <span class="text-lime-500">*</span></label>
                    <input type="number" placeholder="e.g. 15" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-600" />
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Difficulty Level</label>
                    <select class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500">
                        <option value="All Levels">All Levels</option>
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Equipment Required</label>
                    <input type="text" placeholder="e.g. Dumbbell, Mat, Boxing Gloves" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-600" />
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Lucide Icon Name</label>
                    <input type="text" placeholder="e.g. dumbbell, heart-pulse" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-600" />
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Description</label>
                <textarea rows="3" placeholder="Brief details about the class..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 placeholder-zinc-400 dark:placeholder-zinc-600"></textarea>
            </div>

            <div class="space-y-2">
                <label class="text-xs font-bold uppercase text-zinc-700 dark:text-zinc-300">Status <span class="text-lime-500">*</span></label>
                <select class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
            <button type="button" onclick="closeClassModal()" class="px-5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors cursor-pointer">Cancel</button>
            <button type="button" onclick="closeClassModal()" class="px-5 py-2.5 rounded-xl bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold text-sm transition-colors cursor-pointer shadow-lg shadow-lime-500/10">Save Class</button>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: VIEW CLASS DETAILS POP-UP         -->
<!-- ========================================== -->
<div id="viewClassModal" class="fixed inset-0 z-50 hidden bg-zinc-950/70 backdrop-blur-sm overflow-y-auto flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden my-8">
        <div class="flex items-center justify-between px-6 py-5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold border border-blue-500/20">
                    <i data-lucide="info" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Class Details</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Complete specifications and master metrics.</p>
                </div>
            </div>
            <button type="button" onclick="closeViewModal()" class="text-zinc-400 hover:text-rose-500 p-2 rounded-lg hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="p-6 space-y-6">
            <div class="flex items-center justify-between bg-zinc-50 dark:bg-zinc-900 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800">
                <div>
                    <h4 id="viewClassName" class="text-xl font-bold text-zinc-900 dark:text-white">Morning Strength</h4>
                    <span id="viewCategory" class="inline-block mt-1 bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 px-3 py-1 rounded-lg text-xs font-semibold">Strength Training</span>
                </div>
                <span id="viewStatus" class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded-md text-xs font-bold border border-emerald-500/20">Active</span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="bg-zinc-50 dark:bg-zinc-900 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 uppercase font-bold">Duration</p>
                    <p id="viewDuration" class="text-sm font-mono font-bold text-zinc-900 dark:text-zinc-200 mt-1">60 mins</p>
                </div>
                <div class="bg-zinc-50 dark:bg-zinc-900 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 uppercase font-bold">Capacity</p>
                    <p id="viewCapacity" class="text-sm font-mono font-bold text-zinc-900 dark:text-zinc-200 mt-1">15 Persons</p>
                </div>
                <div class="bg-zinc-50 dark:bg-zinc-900 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 uppercase font-bold">Difficulty</p>
                    <p id="viewDifficulty" class="text-sm font-bold text-amber-600 dark:text-amber-400 mt-1">Intermediate</p>
                </div>
                <div class="bg-zinc-50 dark:bg-zinc-900 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 uppercase font-bold">Equipment</p>
                    <p id="viewEquipment" class="text-sm font-bold text-zinc-900 dark:text-zinc-200 mt-1">Dumbbells, Barbells</p>
                </div>
            </div>

            <div class="space-y-2">
                <h5 class="text-xs font-bold uppercase text-zinc-500 dark:text-zinc-400">Class Overview</h5>
                <p id="viewDescription" class="text-sm text-zinc-700 dark:text-zinc-300 bg-zinc-50 dark:bg-zinc-900 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 leading-relaxed">
                    Full body resistance training designed to build muscle, improve posture, and boost overall endurance.
                </p>
            </div>
        </div>

        <div class="flex items-center justify-end px-6 py-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900">
            <button type="button" onclick="closeViewModal()" class="px-5 py-2.5 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-800 dark:text-white font-semibold text-sm transition-colors cursor-pointer">Close</button>
        </div>
    </div>
</div>

