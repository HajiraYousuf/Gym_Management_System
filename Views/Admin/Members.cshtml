                    </div>
                </div>
            </div>

            <!-- Activity & Attendance -->
            <div>
                <h4 class="text-xs sm:text-sm font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-wider mb-2.5">Activity & Attendance</h4>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-zinc-50 dark:bg-zinc-950 p-3.5 sm:p-4 rounded-xl border border-zinc-200 dark:border-zinc-800">
