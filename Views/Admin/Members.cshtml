                <div>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Gender</span>
                    <span class="text-sm font-semibold text-zinc-900 dark:text-white">Male</span>
                </div>
                <div>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Date of Birth</span>
                    <span class="text-sm font-semibold text-zinc-900 dark:text-white">12 May 2000</span>
                </div>
                <div>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Phone</span>
                    <span class="text-sm font-semibold text-zinc-900 dark:text-white">+252 61 5550000</span>
                </div>
                <div>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Email</span>
                    <span class="text-sm font-semibold text-zinc-900 dark:text-white">mohamed@example.com</span>
                </div>
                <div class="col-span-2">
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Address</span>
