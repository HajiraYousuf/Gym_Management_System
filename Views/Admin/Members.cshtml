                    </div>
                    <div>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Assigned Trainer</span>
                        <span class="text-sm font-semibold text-zinc-900 dark:text-white">Captain Ahmed Hassan</span>
                    </div>
                    <div>
