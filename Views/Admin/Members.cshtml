                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-zinc-50 dark:bg-zinc-950 p-3.5 sm:p-4 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <div>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400 block">Membership Plan</span>
                        <span class="text-sm font-semibold text-lime-600 dark:text-lime-400">VIP Monthly Pass</span>
