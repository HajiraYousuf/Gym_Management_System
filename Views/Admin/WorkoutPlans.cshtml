@{
    ViewData["Title"] = "Workout Plans";
    Layout = "~/Views/Layouts/AdminMaster.cshtml";
}

<div class="bg-gray-50 dark:bg-[#080c0a] text-gray-800 dark:text-white p-5 md:p-6 rounded-2xl border border-gray-200 dark:border-white/[0.06] w-full min-h-screen font-sans transition-colors duration-300">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row justify-between lg:items-center gap-4 mb-6">

        <div class="flex items-center gap-3">
            <div class="w-11 h-11 flex items-center justify-center rounded-xl bg-lime-500 text-gray-950 text-lg shadow-lg shadow-lime-500/20">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div>
                <div class="flex items-center gap-2">
                    <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">Workout Plans</h2>
                    <span class="bg-lime-500 text-gray-950 font-extrabold px-2 py-0.5 rounded-md text-xs">6</span>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Manage workout programs and training plans</p>
            </div>
        </div>

    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">

        <!-- Total Plans -->
        <div class="group relative overflow-hidden bg-white dark:bg-gradient-to-b dark:from-[#141c17] dark:to-[#0e1410] p-6 rounded-3xl border border-gray-200 dark:border-white/[0.08] hover:border-lime-500/40 transition-all duration-300 hover:-translate-y-1 shadow-sm dark:shadow-2xl dark:shadow-black/40">
            <div class="absolute -right-8 -top-8 w-28 h-28 bg-lime-500/10 rounded-full blur-xl group-hover:bg-lime-500/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-lime-100 dark:bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-300 dark:border-lime-500/20 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-clipboard-list text-xl"></i>
                </div>
                <span class="text-[10px] font-black tracking-widest uppercase bg-lime-100 dark:bg-lime-500/10 text-lime-700 dark:text-lime-400 border border-lime-300 dark:border-lime-500/20 px-3 py-1 rounded-full">All Plans</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Plans</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-4xl font-black tracking-tight text-gray-900 dark:text-white">24</span>
                <span class="text-xs font-bold text-lime-600 dark:text-lime-400 flex items-center"><i class="fa-solid fa-arrow-up text-[10px] mr-1"></i>+12%</span>
            </div>
            <div class="mt-4 h-1.5 w-full bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden p-0.5 border border-gray-200 dark:border-white/5">
                <div class="h-full w-[85%] bg-lime-500 rounded-full shadow-sm shadow-lime-500"></div>
            </div>
        </div>

        <!-- Active Plans -->
        <div class="group relative overflow-hidden bg-white dark:bg-gradient-to-b dark:from-[#101e18] dark:to-[#0c1612] p-6 rounded-3xl border border-gray-200 dark:border-white/[0.08] hover:border-emerald-500/40 transition-all duration-300 hover:-translate-y-1 shadow-sm dark:shadow-2xl dark:shadow-black/40">
            <div class="absolute -right-8 -top-8 w-28 h-28 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-emerald-100 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-500/20 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-circle-check text-xl"></i>
                </div>
                <span class="text-[10px] font-black tracking-widest uppercase bg-emerald-100 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-500/20 px-3 py-1 rounded-full">Active</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Active Plans</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-4xl font-black tracking-tight text-gray-900 dark:text-white">18</span>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">75% active</span>
            </div>
            <div class="mt-4 h-1.5 w-full bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden p-0.5 border border-gray-200 dark:border-white/5">
                <div class="h-full w-[75%] bg-emerald-500 rounded-full shadow-sm shadow-emerald-500"></div>
            </div>
        </div>

        <!-- Total Exercises -->
        <div class="group relative overflow-hidden bg-white dark:bg-gradient-to-b dark:from-[#101b22] dark:to-[#0a1217] p-6 rounded-3xl border border-gray-200 dark:border-white/[0.08] hover:border-cyan-500/40 transition-all duration-300 hover:-translate-y-1 shadow-sm dark:shadow-2xl dark:shadow-black/40">
            <div class="absolute -right-8 -top-8 w-28 h-28 bg-cyan-500/10 rounded-full blur-xl group-hover:bg-cyan-500/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-cyan-100 dark:bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-300 dark:border-cyan-500/20 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-person-running text-xl"></i>
                </div>
                <span class="text-[10px] font-black tracking-widest uppercase bg-cyan-100 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-300 dark:border-cyan-500/20 px-3 py-1 rounded-full">Workouts</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Exercises</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-4xl font-black tracking-tight text-gray-900 dark:text-white">120</span>
                <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 flex items-center"><i class="fa-solid fa-plus text-[10px] mr-0.5"></i>15 new</span>
            </div>
            <div class="mt-4 h-1.5 w-full bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden p-0.5 border border-gray-200 dark:border-white/5">
                <div class="h-full w-[90%] bg-cyan-500 rounded-full shadow-sm shadow-cyan-500"></div>
            </div>
        </div>

        <!-- Assigned Members -->
        <div class="group relative overflow-hidden bg-white dark:bg-gradient-to-b dark:from-[#211a12] dark:to-[#14100b] p-6 rounded-3xl border border-gray-200 dark:border-white/[0.08] hover:border-amber-500/40 transition-all duration-300 hover:-translate-y-1 shadow-sm dark:shadow-2xl dark:shadow-black/40">
            <div class="absolute -right-8 -top-8 w-28 h-28 bg-amber-500/10 rounded-full blur-xl group-hover:bg-amber-500/20 transition-all"></div>
            <div class="flex items-center justify-between mb-4 relative z-10">
                <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-amber-100 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-300 dark:border-amber-500/20 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-users text-xl"></i>
                </div>
                <span class="text-[10px] font-black tracking-widest uppercase bg-amber-100 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-300 dark:border-amber-500/20 px-3 py-1 rounded-full">Members</span>
            </div>
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Assigned Members</p>
            <div class="flex items-baseline gap-2 mt-1">
                <span class="text-4xl font-black tracking-tight text-gray-900 dark:text-white">350</span>
                <span class="text-xs font-bold text-amber-600 dark:text-amber-400 flex items-center"><i class="fa-solid fa-arrow-up text-[10px] mr-1"></i>+28</span>
            </div>
            <div class="mt-4 h-1.5 w-full bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden p-0.5 border border-gray-200 dark:border-white/5">
                <div class="h-full w-[92%] bg-amber-500 rounded-full shadow-sm shadow-amber-500"></div>
            </div>
        </div>

    </div>

    <!-- Workout Plans Section -->
    <div class="bg-white dark:bg-[#0d120f] rounded-2xl border border-gray-200 dark:border-white/[0.06] overflow-hidden shadow-sm">

        <!-- List Header -->
        <div class="flex flex-col lg:flex-row justify-between lg:items-center gap-4 px-5 py-5 border-b border-gray-200 dark:border-white/[0.06]">
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">All Workout Plans</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Browse and manage available training programs</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-2">
                <!-- Search -->
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-600 text-xs"></i>
                    <input type="text"
                           placeholder="Search plans..."
                           class="w-full sm:w-52 bg-gray-50 dark:bg-[#131a15] border border-gray-300 dark:border-white/[0.08] text-gray-900 dark:text-white text-sm rounded-xl pl-9 pr-3 py-2.5 outline-none focus:border-lime-500/40 placeholder:text-gray-400 dark:placeholder:text-gray-600 transition" />
                </div>

                <!-- Filter -->
                <select class="bg-gray-50 dark:bg-[#131a15] border border-gray-300 dark:border-white/[0.08] text-gray-700 dark:text-gray-300 text-sm rounded-xl px-3 py-2.5 outline-none focus:border-lime-500/40">
                    <option>All Levels</option>
                    <option>Beginner</option>
                    <option>Intermediate</option>
                    <option>Advanced</option>
                </select>
            </div>
        </div>

        <!-- Plans List -->
        <div class="p-4 space-y-3">

            <!-- Plan 1 -->
            <div class="group bg-gray-50 dark:bg-[#131a15] p-4 rounded-xl border border-gray-200 dark:border-white/[0.06] hover:border-lime-500/30 hover:bg-gray-100 dark:hover:bg-[#171f19] transition-all duration-300">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-4 min-w-0">
                        <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?w=100" alt="Workout" class="w-16 h-16 rounded-xl object-cover shrink-0 ring-1 ring-gray-200 dark:ring-white/10" />
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-base font-bold text-gray-900 dark:text-white block truncate">Muscle Gain Plan</span>
                                <span class="text-[10px] font-bold text-lime-600 dark:text-lime-400 bg-lime-100 dark:bg-lime-500/10 px-2 py-1 rounded-md">ACTIVE</span>
                            </div>
                            <span class="text-sm text-lime-600 dark:text-lime-400 font-semibold block mt-1">Intermediate</span>
                            <div class="flex flex-wrap items-center gap-4 text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <span><i class="fa-solid fa-dumbbell text-lime-500 mr-1"></i>12 Exercises</span>
                                <span><i class="fa-regular fa-calendar text-lime-500 mr-1"></i>12 Weeks Program</span>
                                <span><i class="fa-solid fa-users text-lime-500 mr-1"></i>85 Members</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="openPlanDetails('Muscle Gain Plan', 'Intermediate', '12 Exercises', '12 Weeks Program', '85 Members', 'https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?w=100', 'A comprehensive intermediate program designed to maximize muscle hypertrophy through progressive overload and structured split routines.')" class="flex items-center justify-center gap-2 border border-lime-300 dark:border-lime-500/20 text-lime-700 dark:text-lime-400 hover:bg-lime-500 hover:text-gray-950 text-xs font-bold px-4 py-2.5 rounded-xl transition shrink-0 cursor-pointer">
                        View Details <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </button>
                </div>
            </div>

            <!-- Plan 2 -->
            <div class="group bg-gray-50 dark:bg-[#131a15] p-4 rounded-xl border border-gray-200 dark:border-white/[0.06] hover:border-lime-500/30 hover:bg-gray-100 dark:hover:bg-[#171f19] transition-all duration-300">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-4 min-w-0">
                        <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=100" alt="Workout" class="w-16 h-16 rounded-xl object-cover shrink-0 ring-1 ring-gray-200 dark:ring-white/10" />
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-base font-bold text-gray-900 dark:text-white block truncate">Weight Loss Plan</span>
                                <span class="text-[10px] font-bold text-lime-600 dark:text-lime-400 bg-lime-100 dark:bg-lime-500/10 px-2 py-1 rounded-md">ACTIVE</span>
                            </div>
                            <span class="text-sm text-lime-600 dark:text-lime-400 font-semibold block mt-1">Beginner</span>
                            <div class="flex flex-wrap items-center gap-4 text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <span><i class="fa-solid fa-dumbbell text-lime-500 mr-1"></i>10 Exercises</span>
                                <span><i class="fa-regular fa-calendar text-lime-500 mr-1"></i>08 Weeks Program</span>
                                <span><i class="fa-solid fa-users text-lime-500 mr-1"></i>72 Members</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="openPlanDetails('Weight Loss Plan', 'Beginner', '10 Exercises', '08 Weeks Program', '72 Members', 'https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=100', 'An energetic fat burning and cardiovascular endurance routine tailored for beginners aiming to tone up and lose weight safely.')" class="flex items-center justify-center gap-2 border border-lime-300 dark:border-lime-500/20 text-lime-700 dark:text-lime-400 hover:bg-lime-500 hover:text-gray-950 text-xs font-bold px-4 py-2.5 rounded-xl transition shrink-0 cursor-pointer">
                        View Details <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </button>
                </div>
            </div>

            <!-- Plan 3 -->
            <div class="group bg-gray-50 dark:bg-[#131a15] p-4 rounded-xl border border-gray-200 dark:border-white/[0.06] hover:border-lime-500/30 hover:bg-gray-100 dark:hover:bg-[#171f19] transition-all duration-300">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-4 min-w-0">
                        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=100" alt="Workout" class="w-16 h-16 rounded-xl object-cover shrink-0 ring-1 ring-gray-200 dark:ring-white/10" />
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-base font-bold text-gray-900 dark:text-white block truncate">Strength Building</span>
                                <span class="text-[10px] font-bold text-lime-600 dark:text-lime-400 bg-lime-100 dark:bg-lime-500/10 px-2 py-1 rounded-md">ACTIVE</span>
                            </div>
                            <span class="text-sm text-lime-600 dark:text-lime-400 font-semibold block mt-1">Advanced</span>
                            <div class="flex flex-wrap items-center gap-4 text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <span><i class="fa-solid fa-dumbbell text-lime-500 mr-1"></i>15 Exercises</span>
                                <span><i class="fa-regular fa-calendar text-lime-500 mr-1"></i>10 Weeks Program</span>
                                <span><i class="fa-solid fa-users text-lime-500 mr-1"></i>64 Members</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="openPlanDetails('Strength Building', 'Advanced', '15 Exercises', '10 Weeks Program', '64 Members', 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=100', 'Heavy compound lifting routine engineered for advanced athletes looking to peak their maximal strength thresholds.')" class="flex items-center justify-center gap-2 border border-lime-300 dark:border-lime-500/20 text-lime-700 dark:text-lime-400 hover:bg-lime-500 hover:text-gray-950 text-xs font-bold px-4 py-2.5 rounded-xl transition shrink-0 cursor-pointer">
                        View Details <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </button>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- DETAIL POPUP MODAL -->
<div id="planDetailModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-50 flex items-center justify-center hidden p-4 overflow-y-auto">
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl my-auto">
        <!-- Modal Header -->
        <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-lime-100 dark:bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold">
                    <i class="fas fa-dumbbell text-sm"></i>
                </div>
                <h3 id="modalPlanTitle" class="text-base font-bold text-gray-900 dark:text-white">Plan Details</h3>
            </div>
            <button type="button" onclick="closePlanDetails()" class="text-gray-400 hover:text-gray-700 dark:hover:text-white cursor-pointer">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-4 text-xs text-gray-700 dark:text-gray-300">
            <div class="flex items-center gap-4">
                <img id="modalPlanImg" src="" alt="Plan Image" class="w-20 h-20 rounded-xl object-cover border border-gray-200 dark:border-gray-800" />
                <div>
                    <span id="modalPlanLevel" class="inline-block bg-lime-100 dark:bg-lime-500/10 text-lime-700 dark:text-lime-400 font-semibold px-2.5 py-1 rounded-md mb-2"></span>
                    <div class="flex flex-wrap gap-3 text-gray-500 dark:text-gray-400">
                        <span id="modalPlanEx"><i class="fa-solid fa-dumbbell text-lime-500 mr-1"></i></span>
                        <span id="modalPlanWeeks"><i class="fa-regular fa-calendar text-lime-500 mr-1"></i></span>
                        <span id="modalPlanMembers"><i class="fa-solid fa-users text-lime-500 mr-1"></i></span>
                    </div>
                </div>
            </div>

            <div>
                <span class="font-semibold text-gray-900 dark:text-white block mb-1">Description:</span>
                <p id="modalPlanDesc" class="bg-gray-50 dark:bg-gray-950 p-3.5 rounded-xl border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 leading-relaxed"></p>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end border-t border-gray-200 dark:border-gray-800 px-6 py-3 bg-gray-50 dark:bg-gray-950">
            <button type="button" onclick="closePlanDetails()" class="px-5 py-2 bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-xl text-xs font-semibold hover:bg-gray-300 dark:hover:bg-gray-700 cursor-pointer">Close</button>
        </div>
    </div>
</div>

<!-- JavaScript for Modal Control -->
<script>
    function openPlanDetails(title, level, exercises, weeks, members, imgSrc, description) {
        document.getElementById('modalPlanTitle').innerText = title;
        document.getElementById('modalPlanLevel').innerText = level;
        document.getElementById('modalPlanEx').innerHTML = '<i class="fa-solid fa-dumbbell text-lime-500 mr-1"></i>' + exercises;
        document.getElementById('modalPlanWeeks').innerHTML = '<i class="fa-regular fa-calendar text-lime-500 mr-1"></i>' + weeks;
        document.getElementById('modalPlanMembers').innerHTML = '<i class="fa-solid fa-users text-lime-500 mr-1"></i>' + members;
        document.getElementById('modalPlanImg').src = imgSrc;
        document.getElementById('modalPlanDesc').innerText = description;

        document.getElementById('planDetailModal').classList.remove('hidden');
    }

    function closePlanDetails() {
        document.getElementById('planDetailModal').classList.add('hidden');
    }
</script>