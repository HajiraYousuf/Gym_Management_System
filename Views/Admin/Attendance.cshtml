@{
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}


<div class="min-h-screen p-4 sm:p-6 lg:p-8 bg-zinc-50 dark:bg-[#050505] text-zinc-800 dark:text-zinc-100 transition-colors duration-200">

    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-8">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-lime-500/10 border border-lime-500/20 flex items-center justify-center shadow-lg shadow-lime-500/5">
                <i class="fa-solid fa-calendar-check text-lime-600 dark:text-lime-400 text-xl"></i>
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
                    Attendance
                </h1>
                <p class="text-zinc-500 dark:text-gray-400 text-sm mt-1">
                    Track daily member presence and attendance records.
                </p>
            </div>
        </div>

        <!-- Date Display -->
        <div class="flex items-center gap-3 bg-white dark:bg-[#131920] border border-zinc-200 dark:border-gray-800 rounded-xl px-4 py-3 shadow-sm">
            <i class="fa-regular fa-calendar text-lime-600 dark:text-lime-400 text-lg"></i>
            <div>
                <p class="text-sm font-bold text-zinc-900 dark:text-white">31 May 2026</p>
                <p class="text-xs text-zinc-500 dark:text-gray-400">Today</p>
            </div>
        </div>
    </div>        

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        <!-- Total Present -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#142315] dark:to-[#0e170e] border border-zinc-200 dark:border-lime-500/30 hover:border-lime-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-gray-300 uppercase tracking-wider">Total Present</span>
                <div class="w-9 h-9 rounded-xl bg-lime-500/10 border border-lime-500/20 flex items-center justify-center text-lime-600 dark:text-lime-400">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-lime-600 dark:text-lime-400">142</span>
                <span class="text-[10px] text-lime-600 dark:text-lime-300 font-bold bg-lime-500/20 px-2 py-0.5 rounded-full border border-lime-500/30">Today</span>
            </div>
        </div>

        <!-- Late Arrivals -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#282212] dark:to-[#17140b] border border-zinc-200 dark:border-amber-500/30 hover:border-amber-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-gray-300 uppercase tracking-wider">Late Arrivals</span>
                <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-600 dark:text-amber-400">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-amber-600 dark:text-amber-400">18</span>
                <span class="text-[10px] text-amber-600 dark:text-amber-300 font-bold bg-amber-500/20 px-2 py-0.5 rounded-full border border-amber-500/30">Requires Review</span>
            </div>
        </div>

        <!-- Absent -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#2a1414] dark:to-[#180c0c] border border-zinc-200 dark:border-red-500/30 hover:border-red-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-gray-300 uppercase tracking-wider">Absent</span>
                <div class="w-9 h-9 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-600 dark:text-red-400">
                    <i data-lucide="x-circle" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-red-600 dark:text-red-400">9</span>
                <span class="text-[10px] text-red-600 dark:text-red-300 font-bold bg-red-500/20 px-2 py-0.5 rounded-full border border-red-500/30">Unexcused</span>
            </div>
        </div>

        <!-- Attendance Rate -->
        <div class="bg-white dark:bg-gradient-to-b dark:from-[#181a28] dark:to-[#0f111a] border border-zinc-200 dark:border-indigo-500/30 hover:border-indigo-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-gray-300 uppercase tracking-wider">Attendance Rate</span>
                <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-zinc-900 dark:text-white">92.4%</span>
                <span class="text-[10px] text-lime-600 dark:text-lime-400 font-bold bg-lime-500/20 px-2 py-0.5 rounded-full border border-lime-500/30">+3.1%</span>
            </div>
        </div>
    </div>

    <!-- Charts & Summary Section -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
        <!-- Chart Card -->
        <div class="xl:col-span-2 bg-white dark:bg-[#131920] border border-zinc-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
                <div>
                    <h2 class="text-lg font-bold text-zinc-900 dark:text-white">Daily Attendance Analytics</h2>
                    <p class="text-sm text-zinc-500 dark:text-gray-400 mt-0.5">Member presence trends over time</p>
                </div>
                <div class="flex items-center gap-5 bg-zinc-100 dark:bg-[#0b0f12] px-3 py-1.5 rounded-xl border border-zinc-200 dark:border-gray-800">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-lime-500"></span>
                        <span class="text-xs font-semibold text-zinc-700 dark:text-gray-300">Present</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                        <span class="text-xs font-semibold text-zinc-700 dark:text-gray-300">Absent</span>
                    </div>
                </div>
            </div>

            <div class="h-[280px]">
                <canvas id="attendanceChart"></canvas>
            </div>
        </div>

        <!-- Overview Circle Card -->
        <div class="bg-white dark:bg-[#131920] border border-zinc-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
            <div>
                <h2 class="text-lg font-bold text-zinc-900 dark:text-white">Today's Overview</h2>
                <p class="text-sm text-zinc-500 dark:text-gray-400 mt-0.5">Real-time presence breakdown</p>
            </div>

            <div class="flex justify-center my-4">
                <div class="relative w-40 h-40">
                    <svg class="w-full h-full -rotate-90" viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="48" fill="none" stroke="#e4e4e7" class="dark:stroke-[#1c242e]" stroke-width="10" />
                        <circle cx="60" cy="60" r="48" fill="none" stroke="#84cc16" stroke-width="10" stroke-linecap="round" stroke-dasharray="301.6" stroke-dashoffset="48.25" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-3xl font-black text-zinc-900 dark:text-white">84%</span>
                        <span class="text-xs text-zinc-500 dark:text-gray-400 font-semibold mt-0.5">Present</span>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between p-3.5 rounded-xl bg-zinc-50 dark:bg-[#1a232d] border border-lime-500/20">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-lime-500/10 flex items-center justify-center">
                            <i class="fa-solid fa-check text-lime-600 dark:text-lime-400 text-sm"></i>
                        </div>
                        <span class="text-sm font-semibold text-zinc-800 dark:text-gray-200">Present</span>
                    </div>
                    <span class="font-extrabold text-lime-600 dark:text-lime-400">142</span>
                </div>

                <div class="flex items-center justify-between p-3.5 rounded-xl bg-zinc-50 dark:bg-[#231a1d] border border-red-500/20">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center">
                            <i class="fa-solid fa-xmark text-red-600 dark:text-red-400 text-sm"></i>
                        </div>
                        <span class="text-sm font-semibold text-zinc-800 dark:text-gray-200">Absent</span>
                    </div>
                    <span class="font-extrabold text-red-600 dark:text-red-400">9</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-white dark:bg-[#131920] border border-zinc-200 dark:border-gray-800 rounded-2xl p-4 mb-6 flex flex-col md:flex-row gap-4 items-center justify-between shadow-sm">
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <div class="relative w-full sm:w-72">
                <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400"></i>
                <input type="text" placeholder="Search by name or ID..." class="w-full bg-zinc-100 dark:bg-[#0b0f12] border border-zinc-300 dark:border-gray-700/70 rounded-xl pl-10 pr-4 py-2.5 text-xs text-zinc-800 dark:text-white placeholder-zinc-400 dark:placeholder-gray-500 focus:outline-none focus:border-lime-500 transition-all" />
            </div>
            
            <div class="relative">
                <input type="date" value="2026-05-31" class="bg-zinc-100 dark:bg-[#0b0f12] border border-zinc-300 dark:border-gray-700/70 rounded-xl px-3 py-2.5 text-xs text-zinc-700 dark:text-gray-300 focus:outline-none focus:border-lime-500 transition-all cursor-pointer" />
            </div>
        </div>

        <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end">
            <div class="flex items-center gap-2">
                <span class="text-xs text-zinc-500 dark:text-gray-400 font-semibold">Status:</span>
                <select class="bg-zinc-100 dark:bg-[#0b0f12] border border-zinc-300 dark:border-gray-700/70 rounded-xl px-3 py-2.5 text-xs text-zinc-700 dark:text-gray-200 focus:outline-none focus:border-lime-500 cursor-pointer">
                    <option value="All">All Statuses</option>
                    <option value="Present">Present</option>
                    <option value="Late">Late</option>
                    <option value="Absent">Absent</option>
                </select>
            </div>

            <a href="#" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-lime-500 hover:bg-lime-400 text-zinc-950 text-xs font-bold transition-all shadow-md shadow-lime-500/10">
                <i class="fa-solid fa-chart-column text-xs"></i>
                Full Report
            </a>
        </div>
    </div>

    <!-- Table Section -->
    <div class="bg-white dark:bg-[#131920] border border-zinc-200 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm mb-6">
        <div class="p-5 border-b border-zinc-200 dark:border-gray-800/80 flex items-center justify-between">
            <h2 class="text-base font-bold text-zinc-900 dark:text-white">Today's Detailed Records</h2>
            <span class="text-xs text-zinc-500 dark:text-gray-400">Showing recent entries</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-zinc-700 dark:text-gray-300">
                <thead class="bg-zinc-100 dark:bg-[#1a222c] text-zinc-500 dark:text-gray-400 uppercase text-[10px] font-extrabold tracking-wider border-b border-zinc-200 dark:border-gray-800">
                    <tr>
                        <th scope="col" class="py-4 px-5">Member Name</th>
                        <th scope="col" class="py-4 px-5">Class</th>
                        <th scope="col" class="py-4 px-5">Check In</th>
                        <th scope="col" class="py-4 px-5">Check Out</th>
                        <th scope="col" class="py-4 px-5">Date</th>
                        <th scope="col" class="py-4 px-5">Status</th>
                        <th scope="col" class="py-4 px-5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-gray-800/60 bg-white dark:bg-[#131920]">
                    
                    <!-- Static Model Data Row Examples -->
                    <tr class="hover:bg-zinc-50 dark:hover:bg-[#1a232d] transition-colors">
                        <td class="py-4 px-5 font-bold text-zinc-900 dark:text-white">Axmed Cali</td>
                        <td class="py-4 px-5 font-medium text-zinc-600 dark:text-gray-300">
                            <span class="bg-zinc-200 dark:bg-gray-800 text-zinc-700 dark:text-gray-300 border border-zinc-300 dark:border-gray-700 px-2.5 py-1 rounded-lg text-[11px]">Class A</span>
                        </td>
                        <td class="py-4 px-5 font-mono font-bold text-lime-600 dark:text-lime-400">08:00 AM</td>
                        <td class="py-4 px-5 font-mono font-bold text-zinc-500 dark:text-gray-400">04:00 PM</td>
                        <td class="py-4 px-5 text-zinc-500 dark:text-gray-400 font-medium">31 May 2026</td>
                        <td class="py-4 px-5">
                            <span class="bg-lime-500/10 text-lime-600 dark:text-lime-400 border-lime-500/30 border text-[10px] px-3 py-1 rounded-full font-bold inline-block">Present</span>
                        </td>
                        <td class="py-4 px-5 text-center">
                            <div class="flex justify-center items-center">
                                <button type="button" onclick="openDetailsModal('Axmed Cali', 'Class A', '08:00 AM', '04:00 PM', '31 May 2026', 'Present')" class="w-8 h-8 rounded-lg bg-zinc-100 hover:bg-lime-500 hover:text-zinc-950 dark:bg-gray-800 dark:hover:bg-lime-400 dark:hover:text-black border border-zinc-300 dark:border-gray-700 text-zinc-600 dark:text-gray-300 transition-all flex items-center justify-center cursor-pointer" title="View Details">
                                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="hover:bg-zinc-50 dark:hover:bg-[#1a232d] transition-colors">
                        <td class="py-4 px-5 font-bold text-zinc-900 dark:text-white">Fadumo Cumar</td>
                        <td class="py-4 px-5 font-medium text-zinc-600 dark:text-gray-300">
                            <span class="bg-zinc-200 dark:bg-gray-800 text-zinc-700 dark:text-gray-300 border border-zinc-300 dark:border-gray-700 px-2.5 py-1 rounded-lg text-[11px]">Class B</span>
                        </td>
                        <td class="py-4 px-5 font-mono font-bold text-lime-600 dark:text-lime-400">08:15 AM</td>
                        <td class="py-4 px-5 font-mono font-bold text-zinc-500 dark:text-gray-400">04:10 PM</td>
                        <td class="py-4 px-5 text-zinc-500 dark:text-gray-400 font-medium">31 May 2026</td>
                        <td class="py-4 px-5">
                            <span class="bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30 border text-[10px] px-3 py-1 rounded-full font-bold inline-block">Late</span>
                        </td>
                        <td class="py-4 px-5 text-center">
                            <div class="flex justify-center items-center">
                                <button type="button" onclick="openDetailsModal('Fadumo Cumar', 'Class B', '08:15 AM', '04:10 PM', '31 May 2026', 'Late')" class="w-8 h-8 rounded-lg bg-zinc-100 hover:bg-lime-500 hover:text-zinc-950 dark:bg-gray-800 dark:hover:bg-lime-400 dark:hover:text-black border border-zinc-300 dark:border-gray-700 text-zinc-600 dark:text-gray-300 transition-all flex items-center justify-center cursor-pointer" title="View Details">
                                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>

        <!-- Pagination Section -->
        <div class="px-5 py-4 border-t border-zinc-200 dark:border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-3 bg-zinc-50 dark:bg-[#131920]">
            <span class="text-xs text-zinc-500 dark:text-gray-400">Showing 1 to 6 of 48 entries</span>
            <div class="flex items-center gap-1.5">
                <button type="button" class="px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-gray-700 text-xs font-semibold text-zinc-600 dark:text-gray-300 hover:bg-zinc-200 dark:hover:bg-gray-800 transition">Previous</button>
                <button type="button" class="px-3 py-1.5 rounded-lg bg-lime-500 text-zinc-950 font-bold text-xs">1</button>
                <button type="button" class="px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-gray-700 text-xs font-semibold text-zinc-600 dark:text-gray-300 hover:bg-zinc-200 dark:hover:bg-gray-800 transition">2</button>
                <button type="button" class="px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-gray-700 text-xs font-semibold text-zinc-600 dark:text-gray-300 hover:bg-zinc-200 dark:hover:bg-gray-800 transition">3</button>
                <button type="button" class="px-3 py-1.5 rounded-lg border border-zinc-300 dark:border-gray-700 text-xs font-semibold text-zinc-600 dark:text-gray-300 hover:bg-zinc-200 dark:hover:bg-gray-800 transition">Next</button>
            </div>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) {
            lucide.createIcons();
        }

        const ctx = document.getElementById('attendanceChart').getContext('2d');

        const presentGradient = ctx.createLinearGradient(0, 0, 0, 300);
        presentGradient.addColorStop(0, 'rgba(132, 204, 22, 0.3)');
        presentGradient.addColorStop(1, 'rgba(132, 204, 22, 0.0)');

        const absentGradient = ctx.createLinearGradient(0, 0, 0, 300);
        absentGradient.addColorStop(0, 'rgba(239, 68, 68, 0.3)');
        absentGradient.addColorStop(1, 'rgba(239, 68, 68, 0.0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [
                    {
                        label: 'Present',
                        data: [120, 135, 128, 142, 150, 110, 142],
                        borderColor: '#84cc16',
                        backgroundColor: presentGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#84cc16',
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Absent',
                        data: [15, 10, 12, 8, 5, 20, 9],
                        borderColor: '#ef4444',
                        backgroundColor: absentGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#ef4444',
                        pointHoverRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#18181b',
                        titleColor: '#fff',
                        bodyColor: '#cbd5e1',
                        borderColor: '#27272a',
                        borderWidth: 1,
                        padding: 10,
                        displayColors: true
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(150, 150, 150, 0.1)' },
                        ticks: { color: '#71717a', font: { size: 11 } }
                    },
                    y: {
                        grid: { color: 'rgba(150, 150, 150, 0.1)' },
                        ticks: { color: '#71717a', font: { size: 11 } },
                        beginAtZero: true
                    }
                }
            }
        });
    });
</script>