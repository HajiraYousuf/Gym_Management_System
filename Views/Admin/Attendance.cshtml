@model GymManagementSystem.Models.AttendanceFilterViewModel
@{
    Layout = "~/Views/layouts/AdminMaster.cshtml";
    var totalPresent = ViewBag.TotalPresent ?? 0;
    var lateArrivals = ViewBag.LateArrivals ?? 0;
    var absentCount = ViewBag.AbsentCount ?? 0;
    var attendanceRate = ViewBag.AttendanceRate ?? "0%";
}

<div class="min-h-screen p-4 sm:p-6 lg:p-8 bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 transition-colors duration-200">

    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5 mb-8">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-lime-500/10 border border-lime-500/20 flex items-center justify-center shadow-lg shadow-lime-500/5">
                <i class="fa-solid fa-calendar-check text-lime-600 dark:text-lime-400 text-xl"></i>
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
                    Attendance
                </h1>
                <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1">
                    Track daily member presence and attendance records.
                </p>
            </div>
        </div>

        <!-- Date Display -->
        <div class="flex items-center gap-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 shadow-sm">
            <i class="fa-regular fa-calendar text-lime-600 dark:text-lime-400 text-lg"></i>
            <div>
                <p class="text-sm font-bold text-zinc-900 dark:text-white">@DateTime.Now.ToString("dd MMM yyyy")</p>
                <p class="text-xs text-zinc-500 dark:text-zinc-400">Today</p>
            </div>
        </div>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        <!-- Total Present -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-lime-500/30 hover:border-lime-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase tracking-wider">Total Present</span>
                <div class="w-9 h-9 rounded-xl bg-lime-500/10 border border-lime-500/20 flex items-center justify-center text-lime-600 dark:text-lime-400">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-lime-600 dark:text-lime-400">@totalPresent</span>
                <span class="text-[10px] text-lime-600 dark:text-lime-300 font-bold bg-lime-500/20 px-2 py-0.5 rounded-full border border-lime-500/30">Today</span>
            </div>
        </div>

        <!-- Late Arrivals -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-amber-500/30 hover:border-amber-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase tracking-wider">Late Arrivals</span>
                <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-600 dark:text-amber-400">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-amber-600 dark:text-amber-400">@lateArrivals</span>
                <span class="text-[10px] text-amber-600 dark:text-amber-300 font-bold bg-amber-500/20 px-2 py-0.5 rounded-full border border-amber-500/30">Requires Review</span>
            </div>
        </div>

        <!-- Absent -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-red-500/30 hover:border-red-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase tracking-wider">Absent</span>
                <div class="w-9 h-9 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-600 dark:text-red-400">
                    <i data-lucide="x-circle" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-red-600 dark:text-red-400">@absentCount</span>
                <span class="text-[10px] text-red-600 dark:text-red-300 font-bold bg-red-500/20 px-2 py-0.5 rounded-full border border-red-500/30">Unexcused</span>
            </div>
        </div>

        <!-- Attendance Rate -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-indigo-500/30 hover:border-indigo-400 transition-all duration-300 rounded-2xl p-5 shadow-sm relative overflow-hidden group">
            <div class="flex justify-between items-start">
                <span class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase tracking-wider">Attendance Rate</span>
                <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mt-4">
                <span class="text-3xl font-black text-zinc-900 dark:text-white">@attendanceRate</span>
                <span class="text-[10px] text-lime-600 dark:text-lime-400 font-bold bg-lime-500/20 px-2 py-0.5 rounded-full border border-lime-500/30">Overall</span>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden shadow-sm mb-6">
        <div class="p-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
            <h2 class="text-base font-bold text-zinc-900 dark:text-white">Detailed Records</h2>
            <span class="text-xs text-zinc-500 dark:text-zinc-400">Showing recent entries</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-zinc-700 dark:text-zinc-300">
                <thead class="bg-zinc-100 dark:bg-zinc-950 text-zinc-500 dark:text-zinc-400 uppercase text-[10px] font-extrabold tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th scope="col" class="py-4 px-5">Member Name</th>
                        <th scope="col" class="py-4 px-5">Class</th>
                        <th scope="col" class="py-4 px-5">Check In</th>
                        <th scope="col" class="py-4 px-5">Check Out</th>
                        <th scope="col" class="py-4 px-5">Date</th>
                        <th scope="col" class="py-4 px-5">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 bg-white dark:bg-zinc-900">
                    @if (Model.Records != null && Model.Records.Any())
                    {
                        foreach (var item in Model.Records)
                        {
                            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">
                                <td class="py-4 px-5 font-bold text-zinc-900 dark:text-white">
                                    @(item.Member?.Name ?? "Unknown Member")
                                </td>
                                <td class="py-4 px-5 font-medium text-zinc-600 dark:text-zinc-300">
                                    <span class="bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 px-2.5 py-1 rounded-lg text-[11px]">@item.ClassName</span>
                                </td>
                                <td class="py-4 px-5 font-mono font-bold text-lime-600 dark:text-lime-400">
                                    @(item.CheckIn.HasValue ? item.CheckIn.Value.ToString(@"hh\:mm") : "-")
                                </td>
                                <td class="py-4 px-5 font-mono font-bold text-zinc-500 dark:text-zinc-400">
                                    @(item.CheckOut.HasValue ? item.CheckOut.Value.ToString(@"hh\:mm") : "-")
                                </td>
                                <td class="py-4 px-5 text-zinc-500 dark:text-zinc-400 font-medium">@item.Date.ToString("dd MMM yyyy")</td>
                                <td class="py-4 px-5">
                                    @if (item.Status == "Present")
                                    {
                                        <span class="bg-lime-500/10 text-lime-600 dark:text-lime-400 border-lime-500/30 border text-[10px] px-3 py-1 rounded-full font-bold inline-block">Present</span>
                                    }
                                    else if (item.Status == "Late")
                                    {
                                        <span class="bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30 border text-[10px] px-3 py-1 rounded-full font-bold inline-block">Late</span>
                                    }
                                    else
                                    {
                                        <span class="bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/30 border text-[10px] px-3 py-1 rounded-full font-bold inline-block">Absent</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-6 text-center text-zinc-500">Waqtigan xogta attendance-ka lama helin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>