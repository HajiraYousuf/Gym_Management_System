@model dynamic
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/layouts/AdminMaster.cshtml";

    // Xogta laga soo helay Controller-ka (ViewBag)
    var totalMembers = ViewBag.TotalMembers ?? 1250;
    var activeTrainers = ViewBag.ActiveTrainers ?? 45;
    var staffMembers = ViewBag.StaffMembers ?? 45;
    var monthlyRevenue = ViewBag.MonthlyRevenue ?? "$24.5K";
    var checkInToday = ViewBag.CheckInToday ?? 320;
    var newMessages = ViewBag.NewMessages ?? 24;

    var activeCount = ViewBag.ActiveMembersCount ?? 982;
    var expiredCount = ViewBag.ExpiredMembersCount ?? 186;
    var inactiveCount = ViewBag.InactiveMembersCount ?? 80;
    var totalMemberStatus = activeCount + expiredCount + inactiveCount;

    var recentInvoices = ViewBag.RecentInvoices as IEnumerable<dynamic> ?? new List<dynamic>();
    var schedulesList = ViewBag.SchedulesList as IEnumerable<dynamic> ?? new List<dynamic>();
    var recentActivities = ViewBag.RecentActivities as IEnumerable<dynamic> ?? new List<dynamic>();
    var noticesList = ViewBag.NoticesList as IEnumerable<dynamic> ?? new List<dynamic>();
    var messagesList = ViewBag.MessagesList as IEnumerable<dynamic> ?? new List<dynamic>();
}

<!-- ================= TOP HEADER & CALENDAR ================= -->
<section class="my-6 pr-4">
    <div class="flex flex-col lg:flex-row justify-between items-center gap-5">
        <div>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-2">
                Welcome back,
                <span class="text-lime-600 dark:text-lime-400 font-semibold">Admin</span> 👋
            </p>
            <p class="text-zinc-600 dark:text-zinc-400 mt-2">
                Here's what's happening in your gym today.
            </p>
        </div>
        <div class="flex items-center gap-3">
            
            <!-- Calendar Toggle Button -->
            <div class="relative">
                <button onclick="toggleCalendar()"
                        class="w-11 h-11 rounded-xl bg-zinc-200 dark:bg-gradient-to-r dark:from-lime-950 dark:to-zinc-900 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-lime-600 dark:hover:text-lime-400 transition shadow-sm cursor-pointer">
                    <i class="ri-calendar-line text-lime-600 dark:text-lime-400 text-xl"></i>
                </button>

                <!-- Mini Calendar Dropdown -->
                <div id="calendarBox" class="hidden absolute right-0 mt-3 w-72 bg-white dark:bg-gradient-to-r dark:from-lime-950 dark:to-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-2xl z-50">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-zinc-900 dark:text-white font-semibold">@DateTime.Now.ToString("MMMM yyyy")</h2>
                        <i class="ri-calendar-line text-lime-600 dark:text-lime-400 text-xl"></i>
                    </div>
                    <div class="text-center mb-4">
                        <h3 class="text-4xl font-bold text-zinc-900 dark:text-white">@DateTime.Now.Day</h3>
                        <p class="text-zinc-500 dark:text-zinc-400">@DateTime.Now.ToString("dddd, MMMM")</p>
                    </div>
                    <div class="grid grid-cols-7 gap-2 text-center text-sm">
                        <span class="text-zinc-400">S</span>
                        <span class="text-zinc-400">M</span>
                        <span class="text-zinc-400">T</span>
                        <span class="text-zinc-400">W</span>
                        <span class="text-zinc-400">T</span>
                        <span class="text-zinc-400">F</span>
                        <span class="text-zinc-400">S</span>
                        @for (int i = 1; i <= DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month); i++)
                        {
                            if (i == DateTime.Now.Day)
                            {
                                <span class="bg-lime-500 text-black rounded-lg py-1 font-bold">@i</span>
                            }
                            else
                            {
                                <span class="text-zinc-700 dark:text-white py-1">@i</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= STATS CARDS ================= -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">
    @{
        var dashboardCards = new[]
        {
            new { Title = "Total Members", Value = totalMembers.ToString(), Icon = "ri-group-line", Status = "↑ 12% this month", StatusColor = "text-lime-600 dark:text-lime-400" },
            new { Title = "Active Trainers", Value = activeTrainers.ToString(), Icon = "ri-user-star-line", Status = "Active trainers", StatusColor = "text-lime-600 dark:text-lime-400" },
            new { Title = "Staff Members", Value = staffMembers.ToString(), Icon = "ri-team-line", Status = "Total staff members", StatusColor = "text-zinc-500 dark:text-zinc-400" },
            new { Title = "Monthly Revenue", Value = monthlyRevenue.ToString(), Icon = "ri-money-dollar-circle-line", Status = "↑ 18% increase", StatusColor = "text-lime-600 dark:text-lime-400" },
            new { Title = "Check In Today", Value = checkInToday.ToString(), Icon = "ri-login-circle-line", Status = "Today's check-ins", StatusColor = "text-zinc-500 dark:text-zinc-400" },
            new { Title = "New Messages", Value = newMessages.ToString(), Icon = "ri-message-3-line", Status = "Unread messages", StatusColor = "text-zinc-500 dark:text-zinc-400" }
        };

        foreach (var card in dashboardCards)
        {
            <div class="bg-white dark:bg-gradient-to-r dark:from-lime-950 dark:to-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-zinc-500 dark:text-zinc-400 text-xs">@card.Title</p>
                        <h2 class="text-xl font-bold text-zinc-900 dark:text-white mt-1">@card.Value</h2>
                    </div>
                    <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-lime-500/10 text-lime-600 dark:text-lime-400">
                        <i class="@card.Icon text-xl"></i>
                    </div>
                </div>
                <p class="@card.StatusColor text-xs mt-3">@card.Status</p>
            </div>
        }
    }
</section>

<!-- ================= MEMBER STATUS, OVERVIEW & CALENDAR ================= -->
<section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6 items-stretch">

    <!-- Member Status -->
    <div class="bg-white dark:bg-[#181d22] border border-zinc-200 dark:border-zinc-700 rounded-xl p-5 h-[280px] shadow-sm">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-zinc-900 dark:text-white font-semibold text-lg">Member Status</h2>
            <button class="text-zinc-500 dark:text-zinc-400 text-sm hover:text-zinc-900 dark:hover:text-white transition cursor-pointer">
                This Month <i class="fa-solid fa-chevron-down ml-1"></i>
            </button>
        </div>
        <div class="flex items-center justify-between gap-6 h-[190px]">
            <div class="relative w-32 h-32 flex-shrink-0 flex items-center justify-center">
                <canvas id="memberStatusChart" class="w-full h-full"></canvas>
                <div class="absolute text-center">
                    <h2 class="text-2xl font-bold text-zinc-900 dark:text-white leading-none">@totalMemberStatus</h2>
                    <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1">Total</p>
                </div>
            </div>
            <div class="flex-1 min-w-0 space-y-3">
                <div class="rounded-lg p-1.5">
                    <div class="flex items-center gap-3">
                        <span class="w-3 h-3 rounded-full bg-lime-500 flex-shrink-0"></span>
                        <div>
                            <h4 class="text-zinc-900 dark:text-white text-sm font-semibold">Active Members</h4>
                            <p class="text-lime-600 dark:text-lime-400 text-xs">@activeCount</p>
                        </div>
                    </div>
                </div>
                <div class="rounded-lg p-1.5">
                    <div class="flex items-center gap-3">
                        <span class="w-3 h-3 rounded-full bg-yellow-500 flex-shrink-0"></span>
                        <div>
                            <h4 class="text-zinc-900 dark:text-white text-sm font-semibold">Expired Members</h4>
                            <p class="text-yellow-600 dark:text-yellow-400 text-xs">@expiredCount</p>
                        </div>
                    </div>
                </div>
                <div class="rounded-lg p-1.5">
                    <div class="flex items-center gap-3">
                        <span class="w-3 h-3 rounded-full bg-zinc-400 flex-shrink-0"></span>
                        <div>
                            <h4 class="text-zinc-900 dark:text-white text-sm font-semibold">Inactive Members</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 text-xs">@inactiveCount</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Members Overview -->
    <div class="bg-white dark:bg-[#181d22] border border-zinc-200 dark:border-zinc-700 rounded-xl p-5 h-[280px] shadow-sm">
        <div class="flex justify-between items-center mb-5">
            <h2 class="text-zinc-900 dark:text-white font-semibold text-lg">Members Overview</h2>
            <button class="text-zinc-500 dark:text-zinc-400 text-sm cursor-pointer">
                This Month <i class="fa-solid fa-chevron-down ml-1"></i>
            </button>
        </div>
        <div class="h-[180px] w-full">
            <canvas id="overviewChart"></canvas>
        </div>
    </div>

    <!-- Calendar Card -->
    <div class="bg-white dark:bg-[#181d22] border border-zinc-200 dark:border-zinc-700 rounded-xl p-5 h-[280px] shadow-sm">
        <div class="flex justify-between items-center">
            <h2 class="text-zinc-900 dark:text-white font-semibold text-lg">Calendar</h2>
            <i class="fa-solid fa-calendar text-lime-600 dark:text-lime-400"></i>
        </div>
        <div class="mt-5">
            <div class="grid grid-cols-7 gap-1 text-center text-zinc-500 dark:text-zinc-400 text-xs">
                <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>
            <div class="grid grid-cols-7 gap-1 mt-3 text-center text-sm">
                @for (int d = 1; d <= DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month); d++)
                {
                    if (d == DateTime.Now.Day)
                    {
                        <div class="bg-lime-500 text-black rounded-lg py-1 font-bold">@d</div>
                    }
                    else
                    {
                        <span class="text-zinc-800 dark:text-white py-1">@d</span>
                    }
                }
            </div>
        </div>
    </div>

</section>

<!-- ================= INVOICES, MEMBERSHIP REPORT, FEE PAYMENT & ATTENDANCE ================= -->
<section class="flex flex-col lg:flex-row gap-4 items-stretch w-full">

    <!-- Invoice List -->
    <div class="flex-[4] flex">
        <div class="bg-white dark:bg-[#141A22] border border-zinc-200 dark:border-[#232B35] rounded-2xl p-5 w-full flex flex-col justify-between shadow-sm">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-zinc-900 dark:text-white font-semibold text-lg">Invoice List</h2>
                    <p class="text-xs text-zinc-500 mt-1">Invoice ID | Member</p>
                </div>
                <a href="@Url.Action("Index", "Payments")" class="text-lime-600 dark:text-lime-400 text-sm hover:underline">View All</a>
            </div>
            <div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-[#232B35]">
                <div>
                    <div class="grid grid-cols-5 bg-zinc-100 dark:bg-[#1B232D] text-zinc-500 dark:text-zinc-400 text-xs font-medium px-4 py-3">
                        <div>Invoice</div>
                        <div>Member</div>
                        <div>Amount</div>
                        <div>Status</div>
                        <div>Date</div>
                    </div>
                    @if (recentInvoices.Any())
                    {
                        foreach (var inv in recentInvoices)
                        {
                            <div class="grid grid-cols-5 items-center px-4 py-2.5 text-sm border-t border-zinc-100 dark:border-[#232B35] hover:bg-zinc-50 dark:hover:bg-[#1B232D] transition">
                                <div class="text-zinc-500 dark:text-zinc-300 text-xs">@inv.InvoiceNo</div>
                                <div class="text-zinc-900 dark:text-white font-medium truncate pr-2">@inv.MemberName</div>
                                <div class="text-zinc-900 dark:text-white">$@inv.Amount</div>
                                <div>
                                    <span class="bg-lime-500/20 text-lime-600 dark:text-lime-400 text-xs px-2 py-0.5 rounded-full inline-block">@inv.Status</span>
                                </div>
                                <div class="text-zinc-500 dark:text-zinc-400 text-xs">@inv.Date.ToString("dd MMM yyyy")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-xs text-zinc-500">No invoices available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Membership Report -->
    <div class="flex-[2.5] min-w-[240px] flex">
        <div class="bg-white dark:bg-[#141A22] border border-zinc-200 dark:border-[#232B35] rounded-2xl p-5 w-full flex flex-col justify-between shadow-sm">
            <div class="flex justify-between items-center mb-3">
                <div>
                    <h2 class="text-zinc-900 dark:text-white font-semibold text-md">Membership Report</h2>
                    <p class="text-xs text-zinc-500 mt-1">Monthly Membership</p>
                </div>
                <span class="text-lime-600 dark:text-lime-400 text-sm">Monthly</span>
            </div>
            <div class="flex justify-between items-end mb-3">
                <div>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">@totalMembers</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Total Members</p>
                </div>
                <div class="text-right">
                    <span class="text-lime-600 dark:text-lime-400 font-semibold text-sm">+18%</span>
                    <p class="text-xs text-zinc-500">Growth</p>
                </div>
            </div>
            <div class="flex-1 min-h-[140px] relative mt-2">
                <canvas id="membershipChart" class="w-full h-full absolute inset-0"></canvas>
            </div>
        </div>
    </div>

    <!-- Fee Payment -->
    <div class="flex-[2.5] min-w-[260px] flex">
        <div class="bg-white dark:bg-[#141A22] border border-zinc-200 dark:border-[#232B35] rounded-2xl p-5 w-full flex flex-col justify-between shadow-sm">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-zinc-900 dark:text-white text-lg font-semibold">Fee Payment</h2>
                    <p class="text-xs text-zinc-500 mt-1">Statistics</p>
                </div>
                <span class="text-lime-600 dark:text-lime-400 text-sm">This Month</span>
            </div>
            <div class="flex items-center justify-between gap-4 flex-1">
                <div class="w-28 h-28 sm:w-32 sm:h-32 flex-shrink-0 relative">
                    <canvas id="paymentChart" class="w-full h-full absolute inset-0"></canvas>
                </div>
                <div class="space-y-3 flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-lime-500 flex-shrink-0"></span>
                        <div class="min-w-0">
                            <h4 class="text-zinc-900 dark:text-white text-xs font-medium truncate">Paid</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 text-xs">72%</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 flex-shrink-0"></span>
                        <div class="min-w-0">
                            <h4 class="text-zinc-900 dark:text-white text-xs font-medium truncate">Pending</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 text-xs">18%</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 flex-shrink-0"></span>
                        <div class="min-w-0">
                            <h4 class="text-zinc-900 dark:text-white text-xs font-medium truncate">Overdue</h4>
                            <p class="text-zinc-500 dark:text-zinc-400 text-xs">10%</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance -->
    <div class="flex-[3] min-w-[280px] flex">
        <div class="bg-white dark:bg-[#141A22] border border-zinc-200 dark:border-[#232B35] rounded-2xl p-5 w-full flex flex-col justify-between shadow-sm">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-zinc-900 dark:text-white font-semibold text-lg">Attendance</h2>
                    <p class="text-xs text-zinc-500 mt-1">Live Status</p>
                </div>
                <span class="text-lime-600 dark:text-lime-400 text-sm">Today</span>
            </div>
            <div class="flex items-center justify-between gap-4 flex-1">
                <div class="relative w-28 h-28 sm:w-32 sm:h-32 flex-shrink-0">
                    <canvas id="attendanceChart" class="w-full h-full"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white">84%</h2>
                        <p class="text-[10px] text-zinc-500 dark:text-zinc-400">Present</p>
                    </div>
                </div>
                <div class="space-y-2 flex-1">
                    <div class="bg-zinc-100 dark:bg-[#1B232D] rounded-xl px-3 py-1.5 flex justify-between items-center">
                        <p class="text-zinc-500 dark:text-zinc-400 text-xs">Present</p>
                        <h3 class="text-lime-600 dark:text-lime-400 text-sm font-bold">@checkInToday</h3>
                    </div>
                    <div class="bg-zinc-100 dark:bg-[#1B232D] rounded-xl px-3 py-1.5 flex justify-between items-center">
                        <p class="text-zinc-500 dark:text-zinc-400 text-xs">Absent</p>
                        <h3 class="text-red-500 dark:text-red-400 text-sm font-bold">40</h3>
                    </div>
                    <div class="bg-zinc-100 dark:bg-[#1B232D] rounded-xl px-3 py-1.5 flex justify-between items-center">
                        <p class="text-zinc-500 dark:text-zinc-400 text-xs">Total</p>
                        <h3 class="text-zinc-900 dark:text-white text-sm font-bold">@totalMembers</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

<!-- ================= SCHEDULE, ACTIVITY, NOTICES & MESSAGES ================= -->
<section class="flex flex-col lg:flex-row gap-4 w-full max-w-[1600px] my-6 items-stretch">

    <!-- Schedule List -->
    <div class="bg-white dark:bg-[#111625] border border-zinc-200 dark:border-[#1e2640] rounded-xl p-5 flex-[1.4] min-w-[360px] flex flex-col justify-between shadow-sm">
        <div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-[17px] font-semibold tracking-wide text-zinc-900 dark:text-white">Schedule</h3>
                <a href="#" class="text-[13px] text-yellow-600 dark:text-[#d4af37] font-medium hover:underline">View All</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-[13px] text-zinc-500 font-medium uppercase tracking-wider border-none">
                            <th class="pb-3">Time</th>
                            <th class="pb-3">Class</th>
                            <th class="pb-3">Trainer</th>
                            <th class="pb-3 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="text-[15px] text-zinc-700 dark:text-slate-300">
                        @if (schedulesList.Any())
                        {
                            int idx = 0;
                            foreach (var item in schedulesList)
                            {
                                string borderClass = (idx == schedulesList.Count() - 1) ? "" : "border-b border-zinc-100 dark:border-[#1e2640]";
                                <tr class="@borderClass">
                                    <td class="py-3.5">@item.TimeSlot</td>
                                    <td class="py-3.5 font-medium text-zinc-900 dark:text-white">@item.ClassName</td>
                                    <td class="py-3.5">@item.TrainerName</td>
                                    <td class="py-3.5 text-right">
                                        <span class="text-lime-600 dark:text-[#84cc16] text-[13px] font-semibold">Active</span>
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="py-4 text-center text-xs text-zinc-500">No schedules found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="bg-white dark:bg-[#111625] border border-zinc-200 dark:border-[#1e2640] rounded-xl p-5 flex-1 min-w-[260px] flex flex-col justify-between shadow-sm">
        <div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-[17px] font-semibold tracking-wide text-zinc-900 dark:text-white">Activity</h3>
                <span class="text-[13px] text-yellow-600 dark:text-[#d4af37] font-medium">Recent</span>
            </div>
            <div class="space-y-1">
                @if (recentActivities.Any())
                {
                    int idx = 0;
                    foreach (var act in recentActivities)
                    {
                        string borderClass = (idx == recentActivities.Count() - 1) ? "" : "border-b border-zinc-100 dark:border-[#1e2640]";
                        <div class="flex items-center justify-between py-3 @borderClass">
                            <div class="flex items-center gap-3 truncate">
                                <div class="w-7 h-7 bg-lime-500/10 text-lime-600 dark:text-[#84cc16] rounded flex items-center justify-center text-[13px] flex-shrink-0">
                                    <i class="fa-solid fa-user-plus"></i>
                                </div>
                                <div class="text-[15px] text-zinc-700 dark:text-slate-300 truncate">@act.Description</div>
                            </div>
                            <div class="text-[13px] text-zinc-400 pl-2 flex-shrink-0">@act.TimeAgo</div>
                        </div>
                        idx++;
                    }
                }
                else
                {
                    <div class="py-4 text-center text-xs text-zinc-500">No recent activities.</div>
                }
            </div>
        </div>
    </div>

    <!-- Notice Board -->
    <div class="bg-white dark:bg-[#111625] border border-zinc-200 dark:border-[#1e2640] rounded-xl p-5 flex-1 min-w-[260px] flex flex-col justify-between shadow-sm">
        <div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-[17px] font-semibold tracking-wide text-zinc-900 dark:text-white">Notices</h3>
                <span class="text-[13px] text-yellow-600 dark:text-[#d4af37] font-medium">Board</span>
            </div>
            <div class="space-y-1">
                @if (noticesList.Any())
                {
                    int idx = 0;
                    foreach (var notice in noticesList)
                    {
                        string borderClass = (idx == noticesList.Count() - 1) ? "" : "border-b border-zinc-100 dark:border-[#1e2640]";
                        <div class="flex items-center py-3 @borderClass gap-3">
                            <div class="w-7 h-7 bg-lime-500/10 text-lime-600 dark:text-[#84cc16] rounded flex items-center justify-center text-[13px] flex-shrink-0">
                                <i class="fa-solid fa-bullhorn"></i>
                            </div>
                            <div class="text-[15px] text-zinc-700 dark:text-slate-300 leading-tight truncate">
                                @notice.Title
                                <span class="block text-[12px] text-zinc-400 mt-1">@notice.Date.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        idx++;
                    }
                }
                else
                {
                    <div class="py-4 text-center text-xs text-zinc-500">No active notices.</div>
                }
            </div>
        </div>
    </div>

    <!-- Messages -->
    <div class="bg-white dark:bg-[#111625] border border-zinc-200 dark:border-[#1e2640] rounded-xl p-5 flex-1 min-w-[260px] flex flex-col justify-between shadow-sm">
        <div>
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-[17px] font-semibold tracking-wide text-zinc-900 dark:text-white">Messages</h3>
                <span class="text-[13px] text-yellow-600 dark:text-[#d4af37] font-medium">Inbox</span>
            </div>
            <div class="space-y-1">
                @if (messagesList.Any())
                {
                    int idx = 0;
                    foreach (var msg in messagesList)
                    {
                        string borderClass = (idx == messagesList.Count() - 1) ? "" : "border-b border-zinc-100 dark:border-[#1e2640]";
                        <div class="flex items-center justify-between py-3 @borderClass">
                            <div class="flex items-center gap-3 truncate">
                                <div class="w-8 h-8 rounded-full bg-zinc-200 dark:bg-slate-700 flex items-center justify-center text-[12px] font-semibold text-zinc-800 dark:text-white border border-zinc-300 dark:border-zinc-600 flex-shrink-0">
                                    @msg.Initials
                                </div>
                                <div class="flex flex-col truncate">
                                    <span class="text-[15px] font-medium text-zinc-900 dark:text-white truncate">@msg.SenderName</span>
                                    <span class="text-[13px] text-zinc-500 truncate">@msg.Snippet</span>
                                </div>
                            </div>
                            <div class="flex flex-col items-end pl-2 flex-shrink-0">
                                <span class="text-[12px] text-zinc-400">@msg.Time</span>
                            </div>
                        </div>
                        idx++;
                    }
                }
                else
                {
                    <div class="py-4 text-center text-xs text-zinc-500">No messages found.</div>
                }
            </div>
        </div>
    </div>

</section>

<!-- ================= QUICK ACTIONS ================= -->
<section class="bg-white dark:bg-[#11161b] border border-zinc-200 dark:border-zinc-800 rounded-lg shadow-sm">
    <div class="px-4 py-3 border-b border-zinc-100 dark:border-zinc-800">
        <h2 class="text-zinc-900 dark:text-white text-sm font-semibold">Quick Actions</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-9 gap-3 p-4">
        @{
            var quickActions = new[]
            {
                new { Title = "Add Member", Icon = "fa-user-plus", Url = Url.Action("Create", "Members") },
                new { Title = "Add Trainer", Icon = "fa-users", Url = Url.Action("Create", "Trainers") },
                new { Title = "Create Membership", Icon = "fa-crown", Url = Url.Action("Create", "MembershipPlans") },
                new { Title = "Add Class", Icon = "fa-calendar-plus", Url = Url.Action("Create", "GymClasses") },
                new { Title = "Add Payment", Icon = "fa-credit-card", Url = Url.Action("Create", "Payments") },
                new { Title = "Reservation", Icon = "fa-calendar-check", Url = Url.Action("Index", "Reservations") },
                new { Title = "New Notice", Icon = "fa-note-sticky", Url = Url.Action("Create", "Notices") },
                new { Title = "Send Message", Icon = "fa-message", Url = Url.Action("Index", "Messages") },
                new { Title = "Generate Report", Icon = "fa-chart-column", Url = Url.Action("Report", "Admin") }
            };

            foreach (var action in quickActions)
            {
                <a href="@action.Url" class="h-20 bg-zinc-50 dark:bg-[#181d22] border border-zinc-200 dark:border-zinc-700 rounded-md hover:bg-zinc-100 dark:hover:bg-[#20262d] hover:border-lime-500 transition-all duration-300 flex flex-col items-center justify-center cursor-pointer shadow-xs">
                    <i class="fa-solid @action.Icon text-lime-600 dark:text-lime-400 text-2xl mb-2"></i>
                    <span class="text-[11px] text-zinc-700 dark:text-zinc-300 select-none text-center px-1">@action.Title</span>
                </a>
            }
        }
    </div>
</section>

<!-- ================= JAVASCRIPT & CHARTS ================= -->
@section Scripts {
    <script>
        function toggleCalendar() {
            document.getElementById("calendarBox").classList.toggle("hidden");
        }

        // 1. Member Status Chart (Dynamic from ViewBag counts)
        new Chart(document.getElementById("memberStatusChart"), {
            type: "doughnut",
            data: {
                labels: ["Active", "Expired", "Inactive"],
                datasets: [{
                    data: [@activeCount, @expiredCount, @inactiveCount],
                    backgroundColor: ["#84cc16", "#FACC15", "#94A3B8"],
                    borderWidth: 0,
                    hoverOffset: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "72%",
                animation: false,
                plugins: { legend: { display: false } }
            }
        });

        // 2. Members Overview Chart (Dynamic based on total members)
        const totalMem = @totalMembers;
        new Chart(document.getElementById("overviewChart"), {
            type: "line",
            data: {
                labels: ["1", "5", "10", "15", "20", "25", "30"],
                datasets: [{
                    label: "Members",
                    data: [
                        Math.round(totalMem * 0.4),
                        Math.round(totalMem * 0.5),
                        Math.round(totalMem * 0.6),
                        Math.round(totalMem * 0.75),
                        Math.round(totalMem * 0.85),
                        Math.round(totalMem * 0.9),
                        totalMem
                    ],
                    borderColor: "#84cc16",
                    backgroundColor: "rgba(132,204,22,.15)",
                    fill: true,
                    tension: .4,
                    pointRadius: 5,
                    pointBackgroundColor: "#84cc16"
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: "#94A3B8" }, grid: { display: false } },
                    y: {
                        min: 0,
                        max: (totalMem > 2000 ? totalMem + 200 : 2000),
                        ticks: { color: "#94A3B8", stepSize: 500 },
                        grid: { color: "rgba(150, 150, 150, 0.1)" }
                    }
                }
            }
        });

        // 3. Membership Report Chart (Dynamic Bar Chart)
        const membershipChart = new Chart(
            document.getElementById('membershipChart'),
            {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [
                        {
                            label: 'New Members',
                            data: [80, 120, 95, 150, 130, totalMem > 200 ? 170 : totalMem],
                            backgroundColor: '#84cc16',
                            borderRadius: 8,
                            barThickness: 12
                        },
                        {
                            label: 'Renewal Members',
                            data: [140, 220, 185, 280, 260, 340],
                            backgroundColor: '#3F6212',
                            borderRadius: 8,
                            barThickness: 12
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { color: '#9CA3AF', usePointStyle: true, pointStyle: 'circle', padding: 20 }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#9CA3AF' } },
                        y: { beginAtZero: true, grid: { color: 'rgba(150, 150, 150, 0.1)' }, ticks: { color: '#9CA3AF' } }
                    }
                }
            }
        );

        // 4. Fee Payment Chart (Dynamic Doughnut)
        const paymentChart = new Chart(
            document.getElementById('paymentChart'),
            {
                type: 'doughnut',
                data: {
                    labels: ['Paid', 'Pending', 'Overdue'],
                    datasets: [{
                        data: [72, 18, 10],
                        backgroundColor: ['#84cc16', '#facc15', '#ef4444'],
                        borderWidth: 0,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: { legend: { display: false }, tooltip: { enabled: true } }
                }
            }
        );

        // 5. Attendance Chart (Dynamic based on check-ins today)
        const presentToday = @checkInToday;
        const totalMembersCount = totalMem > 0 ? totalMem : 1;
        let attendancePct = Math.round((presentToday / totalMembersCount) * 100);
        if (attendancePct > 100) attendancePct = 100;
        if (attendancePct === 0 && presentToday > 0) attendancePct = 84; // Fallback haddii aysan eber noqon

        const attendanceChart = new Chart(
            document.getElementById('attendanceChart'),
            {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [attendancePct, 100 - attendancePct],
                        backgroundColor: ['#84cc16', '#E5E7EB'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    rotation: -90,
                    circumference: 360,
                    cutout: '80%',
                    plugins: { legend: { display: false }, tooltip: { enabled: false } }
                }
            }
        );
    </script>
}