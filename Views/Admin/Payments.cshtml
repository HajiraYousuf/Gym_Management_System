@{
    ViewData["Title"] = "Payments & Transactions";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}


<div class="min-h-screen bg-zinc-50 dark:bg-[#050505] text-zinc-900 dark:text-zinc-100 p-4 md:p-8 transition-colors duration-200">
