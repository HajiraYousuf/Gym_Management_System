@model IEnumerable<GymManagementSystem.Models.Payment>
@{
    ViewData["Title"] = "Payments & Transactions";
    Layout = "~/Views/layouts/AdminMaster.cshtml";

    // Halkan ayaan ku saxay si uu u aqoonsado "Paid" halkii uu ka ahaan lahaa "Success"
    var totalPayments = Model?.Count() ?? 0;
    var totalRevenue = Model?.Where(p => p.Status == "Paid" || p.Status == "Success" || p.Status == "Completed").Sum(p => p.AmountPaid) ?? 0;
    var successCount = Model?.Count(p => p.Status == "Paid" || p.Status == "Success" || p.Status == "Completed") ?? 0;
    var pendingCount = Model?.Count(p => p.Status == "Pending") ?? 0;
    var failedCount = Model?.Count(p => p.Status == "Failed" || p.Status == "Refunded") ?? 0;
}
<!-- Lucide Icons CDN -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="min-h-screen bg-zinc-50 dark:bg-[#050505] text-zinc-900 dark:text-zinc-100 p-4 md:p-8 transition-colors duration-200">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- PAGE HEADER -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-[#141414] p-6 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20 shrink-0">
                    <i data-lucide="wallet" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white">Payments & Transactions</h1>
                        <span class="px-2.5 py-0.5 rounded-full bg-lime-500 text-zinc-950 text-xs font-black">@totalPayments</span>
                    </div>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">Monitor financial logs, income flow, and gateway transactions.</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button type="button" class="hidden sm:inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white font-semibold text-sm transition-all cursor-pointer">
                    <i data-lucide="download" class="w-4 h-4"></i> Export Statement
                </button>
            </div>
        </div>

        <!-- STAT CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            
            <!-- TOTAL REVENUE -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Total Revenue</p>
                        <h3 class="mt-2 text-3xl font-black text-zinc-900 dark:text-white">$@totalRevenue.ToString("0.00")</h3>
                        <p class="mt-2 text-xs text-zinc-400 font-medium">
                            <span class="text-lime-600 dark:text-lime-400 font-bold flex items-center gap-0.5 inline-flex"><i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Verified</span> income flow
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center border border-lime-500/20">
                        <i data-lucide="dollar-sign" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

            <!-- SUCCESSFUL TRANSACTIONS -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Successful</p>
                        <h3 class="mt-2 text-3xl font-black text-emerald-600 dark:text-emerald-400">@successCount</h3>
                        <p class="mt-2 text-xs text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i> Verified logs
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-500/20">
                        <i data-lucide="shield-check" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

            <!-- PENDING PAYMENTS -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Pending</p>
                        <h3 class="mt-2 text-3xl font-black text-amber-600 dark:text-amber-400">@pendingCount</h3>
                        <p class="mt-2 text-xs text-amber-600 dark:text-amber-400 font-bold flex items-center gap-1">
                            <i data-lucide="clock" class="w-3.5 h-3.5"></i> Awaiting gateway
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center border border-amber-500/20">
                        <i data-lucide="clock" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

            <!-- REFUNDED / FAILED -->
            <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Failed / Refunded</p>
                        <h3 class="mt-2 text-3xl font-black text-rose-600 dark:text-rose-400">@failedCount</h3>
                        <p class="mt-2 text-xs text-rose-600 dark:text-rose-400 font-bold flex items-center gap-1">
                            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Reversed payments
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center border border-rose-500/20">
                        <i data-lucide="rotate-ccw" class="w-5 h-5"></i>
                    </div>
                </div>
            </div>

        </div>

        <!-- TRANSACTIONS CONTAINER -->
        <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800/80 rounded-2xl shadow-sm overflow-hidden">

            <form asp-action="Index" method="get" class="p-5 sm:p-6 border-b border-zinc-200 dark:border-zinc-800">
                <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-bold text-zinc-900 dark:text-white">Transaction Logs</h2>
                        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">List of all incoming and outgoing financial transactions.</p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">
                        <div class="relative w-full sm:w-72">
                            <i data-lucide="search" class="w-4 h-4 text-zinc-400 absolute left-4 top-3.5"></i>
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Search reference or user..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl pl-11 pr-4 py-2.5 focus:outline-none focus:border-lime-500" />
                        </div>
                        <select name="methodFilter" class="w-full sm:w-48 bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                            <option value="All">All Gateways</option>
                            <option value="Zaad">Zaad Service</option>
                            <option value="eDahab">eDahab</option>
                            <option value="Card">Credit Card</option>
                            <option value="Cash">Cash</option>
                        </select>
                        <button type="submit" class="px-4 py-2.5 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold rounded-xl text-xs transition cursor-pointer">Filter</button>
                    </div>
                </div>
            </form>

            <!-- TABLE -->
            <div class="overflow-x-auto">
                <table class="w-full min-w-[1050px] text-left text-sm">
                    <thead>
                        <tr class="bg-zinc-100 dark:bg-zinc-900 text-zinc-500 dark:text-zinc-400 uppercase text-xs tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                            <th class="px-6 py-4">Transaction ID</th>
                            <th class="px-6 py-4">Payer / Customer</th>
                            <th class="px-6 py-4">Date & Time</th>
                            <th class="px-6 py-4">Payment Method</th>
                            <th class="px-6 py-4">Amount</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800/60 font-medium">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="px-6 py-8 text-center text-zinc-500">No payment logs found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var txn in Model)
                            {
                                string initials = "US";
                                if (!string.IsNullOrEmpty(txn.MemberName))
                                {
                                    var parts = txn.MemberName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                    initials = parts.Length > 1 ? $"{parts[0][0]}{parts[1][0]}" : $"{parts[0][0]}";
                                    initials = initials.ToUpper();
                                }

                                <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors">
                                    <td class="px-6 py-4 font-mono font-bold text-zinc-900 dark:text-white">@txn.ReceiptNumber</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold text-xs">@initials</div>
                                            <div>
                                                <div class="font-bold text-zinc-900 dark:text-white">@txn.MemberName</div>
                                                <div class="text-xs text-zinc-400">For: @txn.PaymentFor</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-zinc-500 dark:text-zinc-400 text-xs font-mono">@txn.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-bold">
                                            <i data-lucide="smartphone" class="w-3.5 h-3.5 text-blue-500"></i> @txn.Method
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 font-bold text-lime-600 dark:text-lime-400">$@txn.AmountPaid.ToString("0.00")</td>
                                    <td class="px-6 py-4">
                                        @if (txn.Status == "Success" || txn.Status == "Completed")
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Success
                                            </span>
                                        }
                                        else if (txn.Status == "Pending")
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 text-xs font-bold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> @txn.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="inline-flex items-center gap-1.5">
                                            <button type="button" class="view-txn-btn p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500 hover:text-white text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer"
                                                    data-txnid="@txn.ReceiptNumber"
                                                    data-name="@txn.MemberName"
                                                    data-phone="N/A"
                                                    data-email="@txn.PaymentFor"
                                                    data-method="@txn.Method"
                                                    data-date="@txn.PaymentDate.ToString("dd MMM yyyy, hh:mm:ss tt")"
                                                    data-amount="$@txn.AmountPaid.ToString("0.00")"
                                                    data-fee="$0.00"
                                                    data-status="@txn.Status"
                                                    data-ref="@txn.Reference">
                                                <i data-lucide="eye" class="w-4 h-4 pointer-events-none"></i>
                                            </button>
                                            <button type="button" onclick="window.print()" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-600 dark:text-zinc-300 rounded-lg transition-all cursor-pointer">
                                                <i data-lucide="printer" class="w-4 h-4 pointer-events-none"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- TRANSACTION DETAILS POP-UP MODAL -->
<div id="txnDetailsModal" style="display: none;" class="fixed inset-0 z-50 bg-zinc-950/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#141414] border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-5">
        
        <div class="flex justify-between items-center border-b border-zinc-200 dark:border-zinc-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center border border-blue-500/20">
                    <i data-lucide="receipt" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-white" id="modalTxnId">Transaction #---</h3>
                    <p class="text-xs text-zinc-400 font-mono" id="modalGatewayRef">Gateway Ref: ---</p>
                </div>
            </div>
            <button type="button" id="closeModalX" class="text-zinc-400 hover:text-rose-500 cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="space-y-4 text-sm">
            
            <div class="bg-zinc-50 dark:bg-zinc-900/50 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 space-y-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-lime-600 dark:text-lime-400 flex items-center gap-1.5">
                    <i data-lucide="user" class="w-4 h-4"></i> Payer Profile
                </h4>
                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div>
                        <span class="block text-zinc-400 font-medium">Full Name</span>
                        <span class="font-bold text-zinc-900 dark:text-white text-sm" id="modalName">-</span>
                    </div>
                    <div>
                        <span class="block text-zinc-400 font-medium">Phone Number</span>
                        <span class="font-semibold text-zinc-700 dark:text-zinc-300 font-mono" id="modalPhone">-</span>
                    </div>
                    <div>
                        <span class="block text-zinc-400 font-medium">Payment For</span>
                        <span class="font-semibold text-zinc-700 dark:text-zinc-300" id="modalEmail">-</span>
                    </div>
                    <div>
                        <span class="block text-zinc-400 font-medium">Timestamp</span>
                        <span class="font-mono text-xs text-zinc-500" id="modalDate">-</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="p-3.5 bg-zinc-50 dark:bg-zinc-900/30 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Gateway Method</span>
                    <span class="font-semibold text-zinc-800 dark:text-zinc-200 text-xs" id="modalMethod">-</span>
                </div>
                <div class="p-3.5 bg-zinc-50 dark:bg-zinc-900/30 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <span class="block text-xs font-bold uppercase text-zinc-400 mb-1">Processing Fee</span>
                    <span class="font-semibold text-zinc-800 dark:text-zinc-200 text-xs font-mono" id="modalFee">-</span>
                </div>
            </div>

            <div class="flex justify-between items-center bg-lime-500/5 border border-lime-500/20 p-4 rounded-xl">
                <div>
                    <span class="block text-xs font-bold uppercase text-zinc-400">Status</span>
                    <span id="modalStatusBadge" class="inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold mt-1">-</span>
                </div>
                <div class="text-right">
                    <span class="block text-xs font-bold uppercase text-zinc-400">Net Amount</span>
                    <span class="text-lg font-black text-lime-600 dark:text-lime-400" id="modalAmount">-</span>
                </div>
            </div>
        </div>

        <div class="flex justify-end pt-3 border-t border-zinc-200 dark:border-zinc-800">
            <button type="button" id="closeModalBtn" class="px-5 py-2.5 bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 font-bold text-xs rounded-xl transition-all cursor-pointer">Close</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (window.lucide) {
            lucide.createIcons();
        }

        const modal = document.getElementById('txnDetailsModal');

        document.querySelectorAll('.view-txn-btn').forEach(button => {
            button.addEventListener('click', function () {
                document.getElementById('modalTxnId').innerText = "Transaction " + this.getAttribute('data-txnid');
                document.getElementById('modalGatewayRef').innerText = "Ref: " + this.getAttribute('data-ref');
                document.getElementById('modalName').innerText = this.getAttribute('data-name');
                document.getElementById('modalPhone').innerText = this.getAttribute('data-phone');
                document.getElementById('modalEmail').innerText = this.getAttribute('data-email');
                document.getElementById('modalMethod').innerText = this.getAttribute('data-method');
                document.getElementById('modalDate').innerText = this.getAttribute('data-date');
                document.getElementById('modalFee').innerText = this.getAttribute('data-fee');
                document.getElementById('modalAmount').innerText = this.getAttribute('data-amount');

                const status = this.getAttribute('data-status');
                const badge = document.getElementById('modalStatusBadge');
                if (status === 'Success' || status === 'Completed') {
                    badge.className = "inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20";
                    badge.innerText = "Success";
                } else if (status === 'Pending') {
                    badge.className = "inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20";
                    badge.innerText = "Pending";
                } else {
                    badge.className = "inline-flex px-2.5 py-0.5 rounded-md text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20";
                    badge.innerText = status;
                }

                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            });
        });

        function closeModal() {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('closeModalX').addEventListener('click', closeModal);

        modal.addEventListener('click', function (e) {
            if (e.target === modal) {
                closeModal();
            }
        });
    });
</script>