                <button type="button" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 hover:bg-rose-500/20"><i class="fas fa-trash-alt mr-1"></i> Delete</button>
            </div>
            <button type="button" onclick="closeDetailsModal()" class="px-4 py-2 rounded-xl text-sm font-medium bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300">Back to Receptionists</button>
        </div>
    </div>
</div>

<script>
    function openAddModal() {
        document.getElementById('addStaffModal').classList.remove('hidden');
