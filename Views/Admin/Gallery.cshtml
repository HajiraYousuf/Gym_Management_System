@{
    ViewData["Title"] = "Gallery Management";
    Layout = "~/Views/layouts/AdminMaster.cshtml";
}
<div class="min-h-screen bg-zinc-50 dark:bg-[#050505] text-zinc-800 dark:text-zinc-100 p-4 md:p-8 transition-colors duration-300">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Top Header & Actions -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white dark:bg-[#141414] p-6 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white flex items-center gap-2">
                    <span>Gallery Management</span>
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Admin Panel</span>
                </h1>
                <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1">Add, hide, or delete images displayed on the guest portal.</p>
            </div>

            <div class="flex items-center gap-3">
                <!-- Add Image Button -->
                <button type="button" onclick="openModal('uploadModal')" class="inline-flex items-center gap-2 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-lime-500/10 transition-all duration-200 cursor-pointer text-sm">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    New Image
                </button>
            </div>
        </div>

        <!-- Filter & Search Section -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white dark:bg-[#141414] p-4 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div class="flex items-center gap-3">
                <span class="text-zinc-500 dark:text-zinc-400 text-sm font-semibold whitespace-nowrap">Filter By:</span>
                <select id="categoryFilter" onchange="filterGallery(this.value)" class="w-full sm:w-auto bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:border-lime-500 focus:outline-none font-medium cursor-pointer">
                    <option value="All">All Categories</option>
                    <option value="Gym">Gym & Equipment</option>
                    <option value="Training">Training Sessions</option>
                    <option value="Events">Events & Competitions</option>
                </select>
            </div>
            
            <div class="flex items-center justify-between sm:justify-end gap-6 text-xs font-medium text-zinc-500 dark:text-zinc-400">
                <div>Total Images: <span id="totalImagesCount" class="font-bold text-zinc-900 dark:text-lime-400">4</span></div>
                <div>Guest Visible: <span id="visibleImagesCount" class="font-bold text-lime-600 dark:text-lime-400">3</span></div>
            </div>
        </div>

        <!-- Image Grid Container -->
        <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            
            <!-- Sample Card 1 -->
            <div class="gallery-card bg-white dark:bg-[#141414] rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80 overflow-hidden group hover:border-lime-500/50 transition-all duration-300 flex flex-col" data-category="Gym" data-visible="true">
                <div class="relative h-48 bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=600&auto=format&fit=crop" alt="Gym Equipment" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md text-lime-400 text-xs px-3 py-1 rounded-full font-semibold border border-zinc-800">
                        Gym
                    </span>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-base line-clamp-1">Modern Equipment Area</h3>
                        <p class="text-zinc-400 dark:text-zinc-500 text-xs mt-1">Uploaded: 12 Aug 2026</p>
                    </div>
                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
                        <span class="status-badge inline-flex items-center gap-1.5 text-xs font-semibold text-lime-600 dark:text-lime-400 bg-lime-500/10 px-2.5 py-1 rounded-lg border border-lime-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-lime-500"></span> Guest Clear
                        </span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="toggleVisibility(this)" class="p-2 text-zinc-400 hover:text-lime-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Toggle Visibility">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button type="button" onclick="deleteCard(this)" class="p-2 text-zinc-400 hover:text-rose-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Delete Image">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sample Card 2 -->
            <div class="gallery-card bg-white dark:bg-[#141414] rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80 overflow-hidden group hover:border-lime-500/50 transition-all duration-300 flex flex-col" data-category="Training" data-visible="true">
                <div class="relative h-48 bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=600&auto=format&fit=crop" alt="Training Session" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md text-lime-400 text-xs px-3 py-1 rounded-full font-semibold border border-zinc-800">
                        Training
                    </span>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-base line-clamp-1">Intensive Training Session</h3>
                        <p class="text-zinc-400 dark:text-zinc-500 text-xs mt-1">Uploaded: 10 Aug 2026</p>
                    </div>
                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
                        <span class="status-badge inline-flex items-center gap-1.5 text-xs font-semibold text-lime-600 dark:text-lime-400 bg-lime-500/10 px-2.5 py-1 rounded-lg border border-lime-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-lime-500"></span> Guest Clear
                        </span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="toggleVisibility(this)" class="p-2 text-zinc-400 hover:text-lime-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Toggle Visibility">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button type="button" onclick="deleteCard(this)" class="p-2 text-zinc-400 hover:text-rose-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Delete Image">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sample Card 3 (Hidden from Guest) -->
            <div class="gallery-card bg-white dark:bg-[#141414] rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80 overflow-hidden group hover:border-lime-500/50 transition-all duration-300 flex flex-col opacity-75 hover:opacity-100" data-category="Events" data-visible="false">
                <div class="relative h-48 bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=600&auto=format&fit=crop" alt="Event" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 grayscale group-hover:grayscale-0 transition-all" />
                    <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md text-lime-400 text-xs px-3 py-1 rounded-full font-semibold border border-zinc-800">
                        Events
                    </span>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-base line-clamp-1">Annual Championship Ceremony</h3>
                        <p class="text-zinc-400 dark:text-zinc-500 text-xs mt-1">Uploaded: 05 Aug 2026</p>
                    </div>
                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
                        <span class="status-badge inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-lg border border-amber-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Hidden
                        </span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="toggleVisibility(this)" class="p-2 text-zinc-400 hover:text-lime-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Toggle Visibility">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button type="button" onclick="deleteCard(this)" class="p-2 text-zinc-400 hover:text-rose-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Delete Image">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Empty State Alert -->
        <div id="emptyState" class="hidden text-center py-16 bg-white dark:bg-[#141414] rounded-2xl border border-zinc-200 dark:border-zinc-800/80">
            <div class="w-16 h-16 bg-lime-500/10 text-lime-600 dark:text-lime-400 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-lime-500/20">
                <i data-lucide="image-off" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">No Images Found</h3>
            <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1 max-w-sm mx-auto">There are no images available in this category. Click the button above to upload a new one.</p>
        </div>

    </div>
</div>

<!-- Upload Image Modal Popup (Redesigned & Clean) -->
<div id="uploadModal" class="fixed inset-0 bg-zinc-950/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-all">
    <div class="bg-white dark:bg-[#141414] rounded-2xl shadow-2xl border border-zinc-200 dark:border-zinc-800 w-full max-w-lg overflow-hidden transform transition-all">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-6 border-b border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-lime-500/10 text-lime-500 flex items-center justify-center border border-lime-500/20 font-bold">
                    <i data-lucide="upload" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-bold text-zinc-900 dark:text-white text-base">Upload New Image</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Add a new photo to the guest gallery feed.</p>
                </div>
            </div>
            <button type="button" onclick="closeModal('uploadModal')" class="text-zinc-400 hover:text-rose-500 p-2 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Modal Form -->
        <form id="uploadForm" onsubmit="handleImageSubmit(event)" class="p-6 space-y-4">
            <!-- Title -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">Image Title</label>
                <input type="text" id="imgTitle" required placeholder="e.g. Free Weights Area" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white text-sm focus:border-lime-500 focus:outline-none transition-all placeholder-zinc-400" />
            </div>

            <!-- Category -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">Category</label>
                <select id="imgCategory" required class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white text-sm focus:border-lime-500 focus:outline-none transition-all font-medium cursor-pointer">
                    <option value="Gym">Gym & Equipment</option>
                    <option value="Training">Training Sessions</option>
                    <option value="Events">Events & Competitions</option>
                </select>
            </div>

            <!-- Image URL Input -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">Image URL</label>
                <input type="url" id="imgUrl" required placeholder="https://images.unsplash.com/..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white text-sm focus:border-lime-500 focus:outline-none transition-all placeholder-zinc-400 font-mono text-xs" />
            </div>

            <!-- Visibility Toggle -->
            <div class="flex items-center gap-3 pt-2 bg-zinc-50 dark:bg-zinc-900/50 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800/80">
                <input type="checkbox" id="imgVisible" checked class="w-4 h-4 text-lime-500 bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 rounded focus:ring-lime-500 focus:ring-2 cursor-pointer" />
                <label for="imgVisible" class="text-sm text-zinc-800 dark:text-zinc-200 font-medium cursor-pointer">Make Visible to Guests Immediately</label>
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-200 dark:border-zinc-800">
                <button type="button" onclick="closeModal('uploadModal')" class="px-4 py-2.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white text-xs font-semibold transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2.5 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold rounded-xl text-xs shadow-lg shadow-lime-500/10 transition-all cursor-pointer">
                    Save Image
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Front-end Client Interactivity Scripts -->
<script type="text/javascript">
    // 1. Modal Open/Close Controls
    function openModal(modalId) {
        document.getElementById(modalId).classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(modalId) {
        document.getElementById(modalId).classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // 2. Dynamic Card Submit (Frontend Only Demo)
    function handleImageSubmit(event) {
        event.preventDefault();

        const title = document.getElementById('imgTitle').value;
        const category = document.getElementById('imgCategory').value;
        const url = document.getElementById('imgUrl').value;
        const isVisible = document.getElementById('imgVisible').checked;

        const grid = document.getElementById('galleryGrid');

        const cardHtml = `
            <div class="gallery-card bg-white dark:bg-[#141414] rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80 overflow-hidden group hover:border-lime-500/50 transition-all duration-300 flex flex-col ${!isVisible ? 'opacity-75' : ''}" data-category="${category}" data-visible="${isVisible}">
                <div class="relative h-48 bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
                    <img src="${url}" alt="${title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md text-lime-400 text-xs px-3 py-1 rounded-full font-semibold border border-zinc-800">
                        ${category}
                    </span>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-base line-clamp-1">${title}</h3>
                        <p class="text-zinc-400 dark:text-zinc-500 text-xs mt-1">Uploaded: Just now</p>
                    </div>
                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
                        <span class="status-badge inline-flex items-center gap-1.5 text-xs font-semibold ${isVisible ? 'text-lime-600 dark:text-lime-400 bg-lime-500/10 border-lime-500/20' : 'text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20'} px-2.5 py-1 rounded-lg border">
                            <span class="w-1.5 h-1.5 rounded-full ${isVisible ? 'bg-lime-500' : 'bg-amber-500'}"></span> ${isVisible ? 'Guest Clear' : 'Hidden'}
                        </span>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="toggleVisibility(this)" class="p-2 text-zinc-400 hover:text-lime-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Toggle Visibility">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button type="button" onclick="deleteCard(this)" class="p-2 text-zinc-400 hover:text-rose-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Delete Image">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;

        grid.insertAdjacentHTML('afterbegin', cardHtml);
        document.getElementById('uploadForm').reset();
        closeModal('uploadModal');
        updateCounts();
        
        if (window.lucide) {
            lucide.createIcons();
        }
    }

    // 3. Toggle Visibility On Click
    function toggleVisibility(btn) {
        const card = btn.closest('.gallery-card');
        const badge = card.querySelector('.status-badge');
        const isVisible = card.getAttribute('data-visible') === 'true';

        if (isVisible) {
            card.setAttribute('data-visible', 'false');
            card.classList.add('opacity-75');
            badge.className = "status-badge inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-lg border border-amber-500/20";
            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Hidden';
        } else {
            card.setAttribute('data-visible', 'true');
            card.classList.remove('opacity-75');
            badge.className = "status-badge inline-flex items-center gap-1.5 text-xs font-semibold text-lime-600 dark:text-lime-400 bg-lime-500/10 px-2.5 py-1 rounded-lg border border-lime-500/20";
            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-lime-500"></span> Guest Clear';
        }
        updateCounts();
    }

    // 4. Delete Card On Click
    function deleteCard(btn) {
        if (confirm('Are you sure you want to delete this image?')) {
            const card = btn.closest('.gallery-card');
            card.remove();
            updateCounts();
        }
    }

    // 5. Category Filtering
    function filterGallery(category) {
        const cards = document.querySelectorAll('.gallery-card');
        let visibleCount = 0;

        cards.forEach(card => {
            if (category === 'All' || card.getAttribute('data-category') === category) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        const emptyState = document.getElementById('emptyState');
        if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
        } else {
            emptyState.classList.add('hidden');
        }
    }

    // 6. Dynamic Counts Update
    function updateCounts() {
        const total = document.querySelectorAll('.gallery-card').length;
        const visible = document.querySelectorAll('.gallery-card[data-visible="true"]').length;

        document.getElementById('totalImagesCount').innerText = total;
        document.getElementById('visibleImagesCount').innerText = visible;
    }

    // Initialize Lucide Icons
    document.addEventListener('DOMContentLoaded', function () {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>