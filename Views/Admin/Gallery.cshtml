@model IEnumerable<GymManagementSystem.Models.GalleryImage>

@{
    ViewData["Title"] = "Gallery Management";
    Layout = "~/Views/layouts/AdminMaster.cshtml";

    int totalImages = ViewBag.TotalImages ?? 0;
    int visibleImages = ViewBag.VisibleImages ?? 0;
    string selectedCategory = ViewBag.SelectedCategory ?? "All";
}

<div class="min-h-screen bg-zinc-50 dark:bg-[#050505] text-zinc-800 dark:text-zinc-100 p-4 md:p-8 transition-colors duration-300">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Top Header & Actions -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white dark:bg-[#141414] p-6 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div>
                <h1 class="text-2xl font-black tracking-tight text-zinc-900 dark:text-white flex items-center gap-2">
                    <span>Gallery Management</span>
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-lime-500/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Admin Panel</span>
                </h1>
                <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1">Add, hide, or delete images displayed on the guest portal.</p>
            </div>

            <div class="flex items-center gap-3">
                <button type="button" onclick="openModal('uploadModal')" class="inline-flex items-center gap-2 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-lime-500/10 transition-all duration-200 cursor-pointer text-sm">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    New Image
                </button>
            </div>
        </div>

        <!-- Alerts -->
        @if (TempData["Message"] != null)
        {
            <div class="p-4 rounded-xl bg-lime-500/10 border border-lime-500/20 text-lime-600 text-sm font-semibold">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 text-sm font-semibold">@TempData["Error"]</div>
        }

        <!-- Filter & Search Section -->
        <form method="get" asp-action="Gallery" class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 bg-white dark:bg-[#141414] p-4 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80">
            <div class="flex items-center gap-3">
                <span class="text-zinc-500 dark:text-zinc-400 text-sm font-semibold whitespace-nowrap">Filter By:</span>
                <select name="category" onchange="this.form.submit()" class="w-full sm:w-auto bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-sm rounded-xl px-4 py-2.5 focus:border-lime-500 focus:outline-none font-medium cursor-pointer">
                    <option value="All" selected="@(selectedCategory == "All")">All Categories</option>
                    <option value="Gym" selected="@(selectedCategory == "Gym")">Gym & Equipment</option>
                    <option value="Training" selected="@(selectedCategory == "Training")">Training Sessions</option>
                    <option value="Events" selected="@(selectedCategory == "Events")">Events & Competitions</option>
                </select>
            </div>
            
            <div class="flex items-center justify-between sm:justify-end gap-6 text-xs font-medium text-zinc-500 dark:text-zinc-400">
                <div>Total Images: <span class="font-bold text-zinc-900 dark:text-lime-400">@totalImages</span></div>
                <div>Guest Visible: <span class="font-bold text-lime-600 dark:text-lime-400">@visibleImages</span></div>
            </div>
        </form>

        <!-- Image Grid Container -->
        <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="gallery-card bg-white dark:bg-[#141414] rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800/80 overflow-hidden group hover:border-lime-500/50 transition-all duration-300 flex flex-col @(!item.IsVisible ? "opacity-75" : "")">
                        <div class="relative h-48 bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
                            <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 @(!item.IsVisible ? "grayscale group-hover:grayscale-0" : "")" />
                            <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md text-lime-400 text-xs px-3 py-1 rounded-full font-semibold border border-zinc-800">
                                @item.Category
                            </span>
                        </div>
                        <div class="p-4 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-base line-clamp-1">@item.Title</h3>
                                <p class="text-zinc-400 dark:text-zinc-500 text-xs mt-1">Uploaded: @item.UploadedAt.ToString("dd MMM yyyy")</p>
                            </div>
                            <div class="flex items-center justify-between mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold @(item.IsVisible ? "text-lime-600 dark:text-lime-400 bg-lime-500/10 border-lime-500/20" : "text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20") px-2.5 py-1 rounded-lg border">
                                    <span class="w-1.5 h-1.5 rounded-full @(item.IsVisible ? "bg-lime-500" : "bg-amber-500")"></span> @(item.IsVisible ? "Guest Clear" : "Hidden")
                                </span>
                                <div class="flex items-center gap-1">
                                    <button type="button" onclick="toggleVisibility(@item.Id)" class="p-2 text-zinc-400 hover:text-lime-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Toggle Visibility">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </button>
                                    <form asp-action="DeleteGalleryImage" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ma hubtaa inaad tirtirto sawirkan?');" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-2 text-zinc-400 hover:text-rose-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors cursor-pointer" title="Delete Image">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center py-16 bg-white dark:bg-[#141414] rounded-2xl border border-zinc-200 dark:border-zinc-800/80">
                    <div class="w-16 h-16 bg-lime-500/10 text-lime-600 dark:text-lime-400 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-lime-500/20">
                        <i data-lucide="image-off" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-white">No Images Found</h3>
                    <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1 max-w-sm mx-auto">There are no images available. Click the button above to upload a new one.</p>
                </div>
            }
        </div>

    </div>
</div>

<!-- Upload Image Modal Popup -->
<div id="uploadModal" class="fixed inset-0 bg-zinc-950/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 transition-all">
    <div class="bg-white dark:bg-[#141414] rounded-2xl shadow-2xl border border-zinc-200 dark:border-zinc-800 w-full max-w-lg overflow-hidden transform transition-all">
        
        <div class="flex items-center justify-between p-6 border-b border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-lime-500/10 text-lime-500 flex items-center justify-center border border-lime-500/20 font-bold">
                    <i data-lucide="upload" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="font-bold text-zinc-900 dark:text-white text-base">Upload New Image</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">Add a new photo to the guest gallery feed.</p>
                </div>
            </div>
            <button type="button" onclick="closeModal('uploadModal')" class="text-zinc-400 hover:text-rose-500 p-2 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-action="SaveGalleryImage" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">Image Title</label>
                <input type="text" name="Title" required placeholder="e.g. Free Weights Area" class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white text-sm focus:border-lime-500 focus:outline-none transition-all" />
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">Category</label>
                <select name="Category" required class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white text-sm focus:border-lime-500 focus:outline-none font-medium cursor-pointer">
                    <option value="Gym">Gym & Equipment</option>
                    <option value="Training">Training Sessions</option>
                    <option value="Events">Events & Competitions</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-1.5">Image URL</label>
                <input type="url" name="ImageUrl" required placeholder="https://images.unsplash.com/..." class="w-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-white text-sm focus:border-lime-500 focus:outline-none transition-all font-mono text-xs" />
            </div>

            <div class="flex items-center gap-3 pt-2 bg-zinc-50 dark:bg-zinc-900/50 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800/80">
                <input type="checkbox" name="IsVisible" value="true" checked class="w-4 h-4 text-lime-500 bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 rounded focus:ring-lime-500 focus:ring-2 cursor-pointer" />
                <label class="text-sm text-zinc-800 dark:text-zinc-200 font-medium cursor-pointer">Make Visible to Guests Immediately</label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-200 dark:border-zinc-800">
                <button type="button" onclick="closeModal('uploadModal')" class="px-4 py-2.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white text-xs font-semibold transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2.5 bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold rounded-xl text-xs shadow-lg shadow-lime-500/10 transition-all cursor-pointer">
                    Save Image
                </button>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript">
    function openModal(modalId) {
        document.getElementById(modalId).classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(modalId) {
        document.getElementById(modalId).classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    async function toggleVisibility(id) {
        try {
            const response = await fetch('@Url.Action("ToggleGalleryVisibility", "Admin")/' + id, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            });
            if(response.ok) {
                location.reload(); // Refresh si uu u muujiyo isbeddelka xogta database-ka
            }
        } catch(error) {
            alert('Khalad ayaa dhacay.');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>