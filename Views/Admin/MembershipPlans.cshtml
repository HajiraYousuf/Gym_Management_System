@model IEnumerable<GymManagementSystem.Models.MembershipPlan>

@{
    ViewData["Title"] = "Membership Management";
    Layout = "~/Views/Layouts/AdminMaster.cshtml";

    int totalPlans = ViewBag.TotalPlans ?? 0;
    int activeMembers = ViewBag.ActiveMembers ?? 1050;
    decimal avgPrice = ViewBag.AvgPrice ?? 0;
    int installmentsCount = ViewBag.InstallmentsCount ?? 0;
}

<div class="space-y-6 min-h-screen bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 p-2 sm:p-4 transition-colors duration-300">

    <!-- Alerts -->
    @if (TempData["Message"] != null)
    {
        <div class="p-4 rounded-xl bg-lime-500/10 border border-lime-500/20 text-lime-600 text-sm font-semibold">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 text-sm font-semibold">@TempData["Error"]</div>
    }

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight flex items-center gap-2">
                <span class="w-3 h-3 bg-lime-500 rounded-full animate-pulse"></span>
                Membership Plans Management
            </h1>
            <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1">Manage gym membership plans, payments, and member schedules.</p>
        </div>
        <button type="button" onclick="openPlanModal()" class="w-full sm:w-auto justify-center bg-lime-500 hover:bg-lime-400 text-zinc-950 font-bold px-5 py-2.5 rounded-xl text-sm transition-all shadow-lg shadow-lime-500/20 cursor-pointer active:scale-95 flex items-center gap-2">
            <i class="fas fa-plus text-xs"></i> Add New Plan
        </button>
    </div>

    <!-- 1. Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Total Plans</span>
                    <div class="text-3xl font-black text-zinc-900 dark:text-white mt-2">@totalPlans</div>
                </div>
                <div class="p-3 bg-lime-100 dark:bg-lime-500/10 rounded-xl text-lime-600 dark:text-lime-400">
                    <i class="fas fa-layer-group text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Active Members</span>
                    <div class="text-3xl font-black text-lime-600 dark:text-lime-400 mt-2">@activeMembers</div>
                </div>
                <div class="p-3 bg-lime-100 dark:bg-lime-500/10 rounded-xl text-lime-600 dark:text-lime-400">
                    <i class="fas fa-users text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Avg. Plan Price</span>
                    <div class="text-3xl font-black text-zinc-900 dark:text-white mt-2">$@avgPrice.ToString("0.00")</div>
                </div>
                <div class="p-3 bg-emerald-100 dark:bg-emerald-500/10 rounded-xl text-emerald-600 dark:text-emerald-400">
                    <i class="fas fa-dollar-sign text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start">
                <div>
                    <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Installments</span>
                    <div class="text-3xl font-black text-purple-600 dark:text-purple-400 mt-2">@installmentsCount Plans</div>
                </div>
                <div class="p-3 bg-purple-100 dark:bg-purple-500/10 rounded-xl text-purple-600 dark:text-purple-400">
                    <i class="fas fa-credit-card text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Table Section -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-6 shadow-sm">
        <div class="flex justify-between items-center mb-6">
            <div>
                <h2 class="text-base font-bold text-zinc-900 dark:text-white tracking-wide">Membership Plans Directory</h2>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Complete list of available gym membership plans.</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-zinc-600 dark:text-zinc-300">
                <thead class="bg-zinc-100 dark:bg-zinc-950 text-zinc-700 dark:text-zinc-400 uppercase text-xs font-semibold tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="py-4 px-4">Membership Name</th>
                        <th class="py-4 px-4">Short Code</th>
                        <th class="py-4 px-4">Type</th>
                        <th class="py-4 px-4">Period</th>
                        <th class="py-4 px-4">Price</th>
                        <th class="py-4 px-4">Installments</th>
                        <th class="py-4 px-4">Signup Fee</th>
                        <th class="py-4 px-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var plan in Model)
                        {
                            <tr class="hover:bg-lime-500/5 dark:hover:bg-zinc-800/50 transition-colors">
                                <td class="py-4 px-4 font-bold text-zinc-900 dark:text-white flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-lime-100 dark:bg-lime-500/10 text-lime-700 dark:text-lime-400 flex items-center justify-center font-bold text-xs border border-lime-300 dark:border-lime-500/30">
                                        <i class="fas fa-shield-alt text-sm"></i>
                                    </div>
                                    <div>
                                        <div class="text-zinc-900 dark:text-white font-semibold">@plan.Name</div>
                                        <div class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate max-w-[180px]">@plan.Description</div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 font-mono text-lime-600 dark:text-lime-400 font-semibold">@plan.ShortCode</td>
                                <td class="py-4 px-4">
                                    <span class="bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 px-2.5 py-1 rounded-md text-xs font-medium border border-zinc-200 dark:border-zinc-700">@plan.Type</span>
                                </td>
                                <td class="py-4 px-4 text-zinc-700 dark:text-zinc-300">@plan.DurationDays Days</td>
                                <td class="py-4 px-4 font-bold text-zinc-900 dark:text-white">$@plan.Price.ToString("0.00")</td>
                                <td class="py-4 px-4">
                                    @if (plan.Installments > 0)
                                    {
                                        <span class='bg-purple-100 dark:bg-purple-500/10 text-purple-700 dark:text-purple-400 px-2.5 py-1 rounded-md text-xs font-semibold border border-purple-200 dark:border-purple-500/20'>@plan.Installments Inst.</span>
                                    }
                                    else
                                    {
                                        <span class='bg-red-500/10 text-red-500 px-2.5 py-1 rounded-md text-xs font-semibold border border-red-500/20'>None</span>
                                    }
                                </td>
                                <td class="py-4 px-4 font-medium text-zinc-700 dark:text-zinc-300">
                                    @if (plan.SignupFee == 0)
                                    {
                                        <span class='text-lime-600 dark:text-lime-400 font-semibold'>Free</span>
                                    }
                                    else
                                    {
                                        <span>$@plan.SignupFee.ToString("0.00")</span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-center">
                                    <div class="flex justify-center items-center gap-1.5">
                                        <button type="button" title="View Details" onclick="viewPlanDetails('@plan.Name', '@plan.ShortCode', '@plan.Type', '@plan.DurationDays', '@plan.Price', '@plan.Installments', '@plan.SignupFee', '@plan.Description', '@plan.Features')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-emerald-50 dark:hover:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded-lg transition-all cursor-pointer">
                                            <i class="fas fa-eye text-sm"></i>
                                        </button>
                                        <button type="button" title="Edit Plan" onclick="editPlan('@plan.PlanId', '@plan.Name', '@plan.ShortCode', '@plan.Type', '@plan.DurationDays', '@plan.Price', '@plan.Installments', '@plan.SignupFee', '@plan.Description', '@plan.Features')" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-50 dark:hover:bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-lg transition-all cursor-pointer">
                                            <i class="fas fa-edit text-sm"></i>
                                        </button>
                                        <form asp-action="Delete" asp-route-id="@plan.PlanId" method="post" onsubmit="return confirm('Are you sure you want to delete this plan?');" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" title="Delete Plan" class="p-2 bg-zinc-100 dark:bg-zinc-800 hover:bg-rose-50 dark:hover:bg-rose-500/10 text-rose-600 dark:text-rose-400 rounded-lg transition-all cursor-pointer">
                                                <i class="fas fa-trash-alt text-sm"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-10 text-zinc-500">No membership plans found. Click "Add New Plan" to create one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. Add/Edit Plan Modal -->
    <div id="planModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-50 flex items-center justify-center hidden p-2 sm:p-4 overflow-y-auto">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl my-auto">
            <div class="flex justify-between items-center px-4 sm:px-6 py-3.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
                <h3 id="modalTitle" class="text-base sm:text-lg font-bold text-zinc-900 dark:text-white">Add New Membership Plan</h3>
                <button type="button" onclick="closePlanModal()" class="text-zinc-400 hover:text-zinc-700 dark:hover:text-white cursor-pointer">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <form asp-action="SavePlan" method="post" class="p-4 sm:p-6 space-y-4 max-h-[60vh] overflow-y-auto">
                @Html.AntiForgeryToken()
                <input type="hidden" id="hfPlanID" name="PlanId" value="0" />

                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Plan Name *</label>
                    <input type="text" id="txtPlanName" name="Name" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="e.g. VIP Monthly" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Short Code *</label>
                        <input type="text" id="txtShortCode" name="ShortCode" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="e.g. VIP-01" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Membership Type *</label>
                        <input type="text" id="txtMembershipType" name="Type" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="e.g. Full Access" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Duration (Days) *</label>
                        <input type="number" id="txtDurationDays" name="DurationDays" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="30" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Price ($) *</label>
                        <input type="number" step="0.01" id="txtPrice" name="Price" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="0.00" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Installments Allowed</label>
                        <input type="number" id="txtInstallments" name="Installments" value="0" class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Signup Fee ($)</label>
                        <input type="number" step="0.01" id="txtSignupFee" name="SignupFee" value="0.00" class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Description</label>
                    <textarea id="txtDescription" name="Description" rows="2" class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="Brief description..."></textarea>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Features (Separate with | symbol)</label>
                    <textarea id="txtFeatures" name="Features" rows="2" class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-300 dark:border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-lime-500" placeholder="Free Water|Personal Trainer|Sauna Access"></textarea>
                </div>

                <div class="flex justify-end gap-3 pt-3 border-t border-zinc-200 dark:border-zinc-800">
                    <button type="button" onclick="closePlanModal()" class="px-4 py-2 bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-xl text-xs font-medium hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-lime-500 text-zinc-950 font-bold rounded-xl text-xs hover:bg-lime-400 shadow cursor-pointer">Save Plan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. VIEW DETAILS MODAL -->
    <div id="viewModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-50 flex items-center justify-center hidden p-2 sm:p-4 overflow-y-auto">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl my-auto">
            <div class="flex justify-between items-center px-4 sm:px-6 py-3.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-lime-100 dark:bg-lime-500/10 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold">
                        <i class="fas fa-shield-alt text-sm"></i>
                    </div>
                    <div>
                        <h3 id="viewPlanName" class="text-sm sm:text-base font-bold text-zinc-900 dark:text-white">Plan Details</h3>
                        <span id="viewShortCode" class="text-xs font-mono text-lime-600 dark:text-lime-400 font-semibold"></span>
                    </div>
                </div>
                <button type="button" onclick="closeViewModal()" class="text-zinc-400 hover:text-zinc-700 dark:hover:text-white cursor-pointer">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <div class="p-4 sm:p-6 space-y-4 text-xs text-zinc-700 dark:text-zinc-300 max-h-[60vh] overflow-y-auto">
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-zinc-50 dark:bg-zinc-950 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    <div>
                        <span class="text-zinc-400 block">Type</span>
                        <span id="viewType" class="font-semibold text-zinc-900 dark:text-white"></span>
                    </div>
                    <div>
                        <span class="text-zinc-400 block">Duration</span>
                        <span id="viewDuration" class="font-semibold text-zinc-900 dark:text-white"></span>
                    </div>
                    <div>
                        <span class="text-zinc-400 block">Price</span>
                        <span id="viewPrice" class="font-semibold text-lime-600 dark:text-lime-400 text-sm"></span>
                    </div>
                    <div>
                        <span class="text-zinc-400 block">Signup Fee</span>
                        <span id="viewSignupFee" class="font-semibold text-zinc-900 dark:text-white"></span>
                    </div>
                    <div>
                        <span class="text-zinc-400 block">Installments</span>
                        <span id="viewInstallments" class="font-semibold text-purple-600 dark:text-purple-400"></span>
                    </div>
                </div>

                <div>
                    <span class="text-zinc-700 dark:text-zinc-300 font-semibold block mb-1">Description:</span>
                    <p id="viewDescription" class="bg-zinc-50 dark:bg-zinc-950 p-3 rounded-xl border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 leading-relaxed"></p>
                </div>

                <div>
                    <span class="text-zinc-700 dark:text-zinc-300 font-semibold block mb-1">Features Included:</span>
                    <ul id="viewFeaturesList" class="space-y-1.5 bg-zinc-50 dark:bg-zinc-950 p-3 rounded-xl border border-zinc-200 dark:border-zinc-800">
                    </ul>
                </div>
            </div>

            <div class="flex justify-end border-t border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 py-3 bg-zinc-50 dark:bg-zinc-950">
                <button type="button" onclick="closeViewModal()" class="px-5 py-2 bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 rounded-xl text-xs font-semibold hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript Functions -->
<script>
    function openPlanModal() {
        document.getElementById('hfPlanID').value = "0";
        document.getElementById('txtPlanName').value = "";
        document.getElementById('txtShortCode').value = "";
        document.getElementById('txtMembershipType').value = "";
        document.getElementById('txtDurationDays').value = "";
        document.getElementById('txtPrice').value = "";
        document.getElementById('txtInstallments').value = "0";
        document.getElementById('txtSignupFee').value = "0.00";
        document.getElementById('txtDescription').value = "";
        document.getElementById('txtFeatures').value = "";

        document.getElementById('modalTitle').innerText = "Add New Membership Plan";
        document.getElementById('planModal').classList.remove('hidden');
    }

    function editPlan(id, name, code, type, duration, price, installments, signupFee, description, features) {
        document.getElementById('hfPlanID').value = id;
        document.getElementById('txtPlanName').value = name;
        document.getElementById('txtShortCode').value = code;
        document.getElementById('txtMembershipType').value = type;
        document.getElementById('txtDurationDays').value = duration;
        document.getElementById('txtPrice').value = price;
        document.getElementById('txtInstallments').value = installments;
        document.getElementById('txtSignupFee').value = signupFee;
        document.getElementById('txtDescription').value = description;
        document.getElementById('txtFeatures').value = features;

        document.getElementById('modalTitle').innerText = "Edit Membership Plan";
        document.getElementById('planModal').classList.remove('hidden');
    }

    function closePlanModal() {
        document.getElementById('planModal').classList.add('hidden');
    }

    function viewPlanDetails(name, code, type, duration, price, installments, signupFee, description, features) {
        document.getElementById('viewPlanName').innerText = name;
        document.getElementById('viewShortCode').innerText = code;
        document.getElementById('viewType').innerText = type;
        document.getElementById('viewDuration').innerText = duration + " Days";
        document.getElementById('viewPrice').innerText = "$" + parseFloat(price).toFixed(2);
        document.getElementById('viewSignupFee').innerText = parseFloat(signupFee) === 0 ? "Free" : "$" + parseFloat(signupFee).toFixed(2);
        document.getElementById('viewInstallments').innerText = parseInt(installments) > 0 ? installments + " Installments" : "Not Allowed";
        document.getElementById('viewDescription').innerText = description || "No description provided.";

        var featuresList = document.getElementById('viewFeaturesList');
        featuresList.innerHTML = "";

        if (features && features.trim() !== "") {
            var items = features.split('|');
            items.forEach(function(item) {
                if (item.trim() !== "") {
                    var li = document.createElement('li');
                    li.className = "flex items-center gap-2 text-zinc-700 dark:text-zinc-300 text-xs";
                    li.innerHTML = '<i class="fas fa-check text-lime-600 dark:text-lime-400"></i>' + item.trim();
                    featuresList.appendChild(li);
                }
            });
        } else {
            featuresList.innerHTML = '<li class="text-zinc-500 italic text-xs">No features listed.</li>';
        }

        document.getElementById('viewModal').classList.remove('hidden');
    }

    function closeViewModal() {
        document.getElementById('viewModal').classList.add('hidden');
    }
</script>