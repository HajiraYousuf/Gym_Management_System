@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<!DOCTYPE html>
<html lang="en" class="h-full overflow-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IronCore Fitness</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        }
    </script>
    
    <!-- Icons & Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="h-full overflow-hidden bg-white dark:bg-zinc-950 font-sans antialiased">
    <div class="h-full overflow-hidden">
        <!-- ================= NAVBAR (FIXED TOP) ================= -->
        <nav class="fixed top-0 left-0 right-0 z-50 h-[70px] bg-[#13250E] dark:bg-zinc-950 border-b border-[#1f3a17] dark:border-zinc-800 transition-colors duration-300">
            <div class="h-full flex items-center justify-between px-4 md:px-6 gap-4">

                <!-- LEFT -->
                <div class="flex items-center gap-3 lg:gap-5 shrink-0">
                    <!-- Logo -->
                    <a href="@Url.Action("Dashboard", "Trainer")" class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-10 h-10 md:w-11 md:h-11 rounded-xl bg-lime-400 flex items-center justify-center shadow-lg shadow-lime-400/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-[#13250E] dark:text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 10v4m3-6v8m10-8v8m3-6v4M7 12h10"/>
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-lg md:text-xl font-extrabold text-white dark:text-zinc-100 tracking-wide leading-none">
                                Iron<span class="text-lime-400">Core</span>
                            </h1>
                            <p class="text-[9px] md:text-[10px] tracking-[3px] text-lime-400/70 dark:text-zinc-500 mt-0.5 font-medium">FITNESS</p>
                        </div>
                    </a>

                    <div class="hidden sm:block w-px h-8 bg-[#1f3a17] dark:bg-zinc-800"></div>

                    <!-- Dashboard Header Label -->
                    <div class="hidden md:flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-8 9 8M5 10v10h14V10"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-[11px] text-lime-400/70 dark:text-zinc-400 leading-none">Welcome Back</p>
                            <h2 class="text-sm font-bold text-white dark:text-zinc-100 leading-tight mt-0.5">Dashboard</h2>
                        </div>
                    </div>
                </div>

                <!-- SEARCH (Tablet/Desktop) -->
                <div class="hidden sm:flex flex-1 justify-center max-w-md mx-2">
                    <div class="relative w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-lime-400/60 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/>
                        </svg>
                        <input type="text" placeholder="Search members, workouts..." class="w-full h-10 pl-10 pr-4 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 text-sm text-emerald-100 dark:text-zinc-100 placeholder:text-lime-400/50 dark:placeholder:text-zinc-500 outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/20 transition-all" />
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <!-- Mobile Search Toggle Button -->
                    <button type="button" onclick="toggleMobileSearch()" class="sm:hidden w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition text-lime-400 dark:text-zinc-400 cursor-pointer">
                        🔍
                    </button>

                    <!-- New Button -->
                    <a href="@Url.Action("WorkoutPlans", "Trainer")" class="h-10 px-3 md:px-4 rounded-xl bg-lime-400 hover:bg-lime-300 text-[#13250E] dark:text-zinc-950 text-xs md:text-sm font-bold flex items-center gap-1.5 md:gap-2 shadow-lg shadow-lime-400/20 hover:shadow-lime-400/40 hover:-translate-y-0.5 transition-all duration-200 active:scale-95 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        <span class="hidden sm:inline">New</span>
                    </a>

                    <!-- Theme Toggle Button -->
                    <button id="themeToggle" type="button" onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 hidden dark:block hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
                        </svg>
                    </button>

                    <!-- Notification -->
                    <div class="relative shrink-0">
                        <a href="@Url.Action("Notifications", "Trainer")" class="w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 dark:text-zinc-400 hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14V11a6 6 0 10-12 0v3a2 2 0 01-.6 1.4L4 17h5"/>
                            </svg>
                        </a>
                        <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-lime-400 text-[#13250E] dark:text-zinc-950 text-[10px] font-extrabold flex items-center justify-center shadow-md animate-pulse">8</span>
                    </div>

                    <div class="hidden sm:block w-px h-8 bg-[#1f3a17] dark:bg-zinc-800"></div>

                    <!-- Profile -->
                    <a href="@Url.Action("Profile", "Trainer")" class="flex items-center gap-2.5 bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 rounded-xl p-1.5 sm:px-2.5 hover:border-lime-400 transition-all duration-200 shrink-0">
                        <img src="https://i.pravatar.cc/100?img=12" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg border border-lime-400 object-cover" alt="Profile">
                        <div class="hidden md:block text-left">
                            <p class="text-xs text-emerald-100 dark:text-zinc-100 font-semibold leading-tight">Trainer</p>
                            <span class="text-[10px] text-lime-400 leading-none font-medium">Cardio Trainer</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Mobile Search Bar Dropdown -->
            <div id="mobileSearch" class="hidden sm:hidden px-4 pb-3 pt-1 bg-[#13250E] dark:bg-zinc-950 border-b border-[#1f3a17] dark:border-zinc-800">
                <div class="relative w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-lime-400/60 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/>
                    </svg>
                    <input type="text" placeholder="Search..." class="w-full h-10 pl-10 pr-4 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 text-sm text-emerald-100 dark:text-zinc-100 placeholder:text-lime-400/50 dark:placeholder:text-zinc-500 focus:outline-none focus:border-lime-400" />
                </div>
            </div>
        </nav>

        <!-- ================= SIDEBAR (FIXED LEFT) ================= -->
        <aside class="fixed top-[70px] left-0 z-40 w-[260px] h-[calc(100vh-70px)] bg-[#13250E] dark:bg-zinc-950 border-r border-[#1f3a17] dark:border-zinc-800 flex flex-col justify-between transition-colors duration-200">

            @{
                string GetActive(string controller, string action) {
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    
                    bool isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                                    string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

                    return isActive 
                        ? "nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl bg-lime-400 text-black text-[13px] font-semibold shadow-lg shadow-lime-400/10 mb-1"
                        : "nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl text-zinc-300 text-[13px] font-medium hover:bg-zinc-900 hover:text-lime-400 transition mb-1";
                }
            }

            <div id="sidebarMenu" class="p-4 space-y-1 overflow-y-auto flex-1 [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-zinc-800 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-zinc-700">

                <a href="@Url.Action("Dashboard", "Trainer")" class="@GetActive("Trainer", "Dashboard")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z" />
                    </svg>
                    Dashboard
                </a>

                <a href="@Url.Action("Profile", "Trainer")" class="@GetActive("Trainer", "Profile")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    Profile
                </a>

                <a href="@Url.Action("MyMembers", "Trainer")" class="@GetActive("Trainer", "MyMembers")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    My Members
                </a>

                <a href="@Url.Action("MySchedule", "Trainer")" class="@GetActive("Trainer", "MySchedule")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M5 11h14M5 19h14a2 2 0 002-2V7H3v10a2 2 0 002 2z" />
                    </svg>
                    My Schedule
                </a>

                <a href="@Url.Action("WorkoutPlans", "Trainer")" class="@GetActive("Trainer", "WorkoutPlans")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Workout Plans
                </a>

                <a href="@Url.Action("ExerciseLibrary", "Trainer")" class="@GetActive("Trainer", "ExerciseLibrary")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    Exercise Library
                </a>

                <a href="@Url.Action("NutritionPlans", "Trainer")" class="@GetActive("Trainer", "NutritionPlans")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                    Nutrition Plans
                </a>

                <a href="@Url.Action("ClassAttendance", "Trainer")" class="@GetActive("Trainer", "ClassAttendance")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    Class Attendance
                </a>

                <a href="@Url.Action("Messages", "Trainer")" class="@GetActive("Trainer", "Messages")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    Messages
                </a>

                <a href="@Url.Action("Notifications", "Trainer")" class="@GetActive("Trainer", "Notifications")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    Notifications
                </a>

                <a href="@Url.Action("Reports", "Trainer")" class="@GetActive("Trainer", "Reports")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-6m4 6V7m4 10v-9" />
                    </svg>
                    Reports
                </a>

            </div>

            <!-- LOGOUT -->
            <div class="p-4 border-t border-[#1f3a17] dark:border-zinc-900 bg-[#13250E] dark:bg-zinc-950 shrink-0">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-400 bg-zinc-950 dark:text-red-400 text-[13px] font-medium hover:bg-red-500/10 dark:hover:bg-red-950/30 hover:text-red-300 dark:hover:text-red-300 transition w-full cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        <span>Logout</span>
                    </button>
                </form>
            </div>

        </aside>
        
        <!-- ================= MAIN CONTENT ================= -->
        <main class="fixed top-[70px] left-[260px] w-[calc(100%-260px)] h-[calc(100vh-70px)] overflow-y-auto p-4 md:p-6 bg-white dark:bg-zinc-950 text-zinc-700 dark:text-zinc-100 transition-colors duration-300 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-zinc-300 dark:[&::-webkit-scrollbar-thumb]:bg-zinc-800 [&::-webkit-scrollbar-thumb]:rounded-full">
            @RenderBody()
        </main>
    </div>

    <!-- JavaScript -->
    <script>
        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        function toggleMobileSearch() {
            const searchDiv = document.getElementById('mobileSearch');
            if (searchDiv) {
                searchDiv.classList.toggle('hidden');
            }
        }
    </script>
</body>
</html>
