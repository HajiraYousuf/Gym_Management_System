@inject ApplicationDbContext _context

@{
}

<!DOCTYPE html>
<html lang="en" class="h-full overflow-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IronCore Fitness</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: 'class'
            }
    </script>

    <!-- Icons & Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="h-full overflow-hidden bg-white dark:bg-zinc-950 font-sans antialiased">
    <div class="h-full overflow-hidden">
        <!-- ================= NAVBAR (FIXED TOP) ================= -->
        <nav class="fixed top-0 left-0 right-0 z-50 h-[70px] bg-[#13250E] dark:bg-zinc-950 border-b border-[#1f3a17] dark:border-zinc-800 transition-colors duration-300">
            <div class="h-full flex items-center justify-between px-4 md:px-6 gap-4">

                <!-- LEFT -->
                <div class="flex items-center gap-3 lg:gap-5 shrink-0">
                    <!-- Logo -->
                    <a href="@Url.Action("Dashboard", "Trainer")" class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-10 h-10 md:w-11 md:h-11 rounded-xl bg-lime-400 flex items-center justify-center shadow-lg shadow-lime-400/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-[#13250E] dark:text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 10v4m3-6v8m10-8v8m3-6v4M7 12h10" />
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-lg md:text-xl font-extrabold text-white dark:text-zinc-100 tracking-wide leading-none">
                                Iron<span class="text-lime-400">Core</span>
                            </h1>
                            <p class="text-[9px] md:text-[10px] tracking-[3px] text-lime-400/70 dark:text-zinc-500 mt-0.5 font-medium">FITNESS</p>
                        </div>
                    </a>

                    <div class="hidden sm:block w-px h-8 bg-[#1f3a17] dark:bg-zinc-800"></div>

                    <!-- Dashboard Header Label -->
                    <div class="hidden md:flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-8 9 8M5 10v10h14V10" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-[11px] text-lime-400/70 dark:text-zinc-400 leading-none">Welcome Back</p>
                            <h2 class="text-sm font-bold text-white dark:text-zinc-100 leading-tight mt-0.5">Trainer Dashboard</h2>
                        </div>
                    </div>
                </div>

                <!-- SEARCH (Tablet/Desktop) -->
                <div class="hidden sm:flex flex-1 justify-center max-w-md mx-2">
                    <div class="relative w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-lime-400/60 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z" />
                        </svg>
                        <input type="text" placeholder="Search members, workouts..." class="w-full h-10 pl-10 pr-4 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 text-sm text-emerald-100 dark:text-zinc-100 placeholder:text-lime-400/50 dark:placeholder:text-zinc-500 outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/20 transition-all" />
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <!-- Mobile Search Toggle Button -->
                    <button type="button" onclick="toggleMobileSearch()" class="sm:hidden w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition text-lime-400 dark:text-zinc-400 cursor-pointer">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                    <!-- New Button -->
                    <a href="@Url.Action("WorkoutPlans", "Trainer")" class="h-10 px-3 md:px-4 rounded-xl bg-lime-400 hover:bg-lime-300 text-[#13250E] dark:text-zinc-950 text-xs md:text-sm font-bold flex items-center gap-1.5 md:gap-2 shadow-lg shadow-lime-400/20 hover:shadow-lime-400/40 hover:-translate-y-0.5 transition-all duration-200 active:scale-95 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        <span class="hidden sm:inline">New Plan</span>
                    </a>
                    <!-- Notification -->
                    <div class="relative shrink-0">
                        <a href="/Shared/Notifications?role=Trainer" class="w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 dark:text-zinc-400 hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14V11a6 6 0 10-12 0v3a2 2 0 01-.6 1.4L4 17h5" />
                            </svg>
                        </a>
                        <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-lime-400 text-[#13250E] dark:text-zinc-950 text-[10px] font-extrabold flex items-center justify-center shadow-md animate-pulse">
                            @_context.Notifications.Count(n => (n.TargetRole == "Trainer" || n.TargetRole == "All") && !n.IsRead)
                        </span>
                    </div>

                    <div class="hidden sm:block w-px h-8 bg-[#1f3a17] dark:bg-zinc-800"></div>

                    <!-- Theme Toggle Button -->
                    <button id="themeToggle" type="button" onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95 shrink-0 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 hidden dark:block hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z" />
                        </svg>
                    </button>

                    <!-- Profile -->
                    <a href="@Url.Action("Profile", "Shared", new { role = "Trainer" })" class="flex items-center gap-2.5 bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 rounded-xl p-1.5 sm:px-2.5 hover:border-lime-400 hover:bg-[#224219] dark:hover:bg-zinc-850 transition-all duration-200 shrink-0 group">
                        <!-- User Avatar Dynamic -->
                        <img src="@(ViewBag.TrainerAvatar ?? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(ViewBag.TrainerName ?? "Trainer") + "&background=a3e635&color=000")"
                             class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg border border-lime-400 object-cover"
                             alt="Profile">

                        <!-- User Details (Magaca Kor, Role-ka Hoos) -->
                        <div class="hidden md:block text-left">
                            <p class="text-xs text-emerald-100 dark:text-zinc-100 font-semibold leading-tight group-hover:text-white transition-colors">@(ViewBag.TrainerName ?? "Fitness Coach")</p>
                            <span class="text-[10px] text-lime-400 leading-none font-medium">@(ViewBag.TrainerRole ?? "Trainer")</span>
                        </div>

                        <!-- Arrow Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="hidden md:block w-3.5 h-3.5 text-lime-400/60 dark:text-zinc-500 ml-0.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Mobile Search Bar Dropdown -->
            <div id="mobileSearch" class="hidden sm:hidden px-4 pb-3 pt-1 bg-[#13250E] dark:bg-zinc-950 border-b border-[#1f3a17] dark:border-zinc-800">
                <div class="relative w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-lime-400/60 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z" />
                    </svg>
                    <input type="text" placeholder="Search..." class="w-full h-10 pl-10 pr-4 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 text-sm text-emerald-100 dark:text-zinc-100 placeholder:text-lime-400/50 dark:placeholder:text-zinc-500 focus:outline-none focus:border-lime-400" />
                </div>
            </div>
        </nav>

        <!-- ================= SIDEBAR (FIXED LEFT) ================= -->
        <aside class="fixed top-[70px] left-0 z-40 w-[260px] h-[calc(100vh-70px)] bg-[#13250E] dark:bg-zinc-950 border-r border-[#1f3a17] dark:border-zinc-800 flex flex-col justify-between transition-colors duration-200">

            @{
                string GetActive(string controller, string action)
                {
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

                    bool isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                                    string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

                    return isActive
                        ? "flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold bg-lime-400 text-[#13250E] shadow-[0_0_20px_rgba(163,230,53,0.5)] scale-[1.02] transition-all"
                        : "flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-emerald-100/80 dark:text-zinc-400 hover:bg-[#1a3313] dark:hover:bg-zinc-900/60 hover:text-white dark:hover:text-zinc-200 transition-all";
                }
            }

            <!-- Sidebar Navigation Links -->
            <div id="sidebarMenu" class="p-4 space-y-1 overflow-y-auto flex-1 [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-[#23421a] dark:[&::-webkit-scrollbar-thumb]:bg-zinc-800 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-[#2e5723]">

                <a href="@Url.Action("Dashboard", "Trainer")" class="@GetActive("Trainer", "Dashboard")">
                    <i class="fa-solid fa-gauge-high w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("Members", "Trainer")" class="@GetActive("Trainer", "Members")">
                    <i class="fa-solid fa-users w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Members</span>
                </a>

                <a href="@Url.Action("MemberDetail", "Trainer")" class="@GetActive("Trainer", "MemberDetail")">
                    <i class="fa-solid fa-user-injured w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Member Detail</span>
                </a>

                <a href="@Url.Action("MySchedule", "Trainer")" class="@GetActive("Trainer", "ClassesSchedule")">
                    <i class="fa-solid fa-calendar-days w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Classes Schedule</span>
                </a>

                <a href="@Url.Action("ClassAttendance", "Trainer")" class="@GetActive("Trainer", "ClassAttendance")">
                    <i class="fa-solid fa-clipboard-check w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Class Attendance</span>
                </a>

                <a href="@Url.Action("WorkoutPlans", "Trainer")" class="@GetActive("Trainer", "WorkoutPlans")">
                    <i class="fa-solid fa-dumbbell w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Workout Plans</span>
                </a>

                <a href="@Url.Action("NutritionPlans", "Trainer")" class="@GetActive("Trainer", "NutritionPlans")">
                    <i class="fa-solid fa-utensils w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Nutrition Plans</span>
                </a>

                <a href="@Url.Action("Messages", "Shared", new { role = "trainer" })" class="@GetActive("Trainer", "Messages")">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6l3.5-3H19a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v9a2 2 0 002 2h1v3z" />
                    </svg>
                    <span>Messages</span>
                </a>


                <a href="@Url.Action("Report", "Trainer")" class="@GetActive("Trainer", "Report")">
                    <i class="fa-solid fa-chart-pie w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Reports</span>
                </a>

            </div>

            <!-- LOGOUT -->
            <div class="p-4 border-t border-[#1f3a17] dark:border-zinc-900 bg-[#13250E] dark:bg-black shrink-0">
                <button type="button" onclick="openLogoutModal()" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-400 bg-[#1a3313] dark:bg-zinc-900/60 text-[13px] font-medium hover:bg-red-500/20 dark:hover:bg-red-950/40 hover:text-red-300 transition w-full cursor-pointer">
                    <i class="fa-solid fa-power-off w-4"></i>
                    <span>Logout</span>
                </button>
            </div>

        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <main class="fixed top-[70px] left-[260px] w-[calc(100%-260px)] h-[calc(100vh-70px)] overflow-y-auto p-4 md:p-6 bg-white dark:bg-zinc-950 text-zinc-700 dark:text-zinc-100 transition-colors duration-300 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-zinc-300 dark:[&::-webkit-scrollbar-thumb]:bg-zinc-800 [&::-webkit-scrollbar-thumb]:rounded-full">
            @RenderBody()
        </main>
    </div>

    <!-- ========================= LOGOUT POPUP MODAL ========================= -->
    <div id="logoutModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden">
        <div class="bg-[#13250E] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 rounded-2xl p-6 w-full max-w-sm mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="logoutModalContent">
            <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 text-xl mx-auto mb-4">
                <i class="fa-solid fa-power-off"></i>
            </div>
            <h3 class="text-lg font-bold text-white text-center mb-1">Confirm Logout</h3>
            <p class="text-xs text-lime-400/70 dark:text-zinc-400 text-center mb-6">Are you sure you want to log out of your account?</p>
            <div class="flex items-center gap-3">
                <button type="button" onclick="closeLogoutModal()" class="flex-1 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-800 border border-[#274b1e] dark:border-zinc-700 text-emerald-100 dark:text-zinc-200 text-xs font-semibold hover:border-lime-400 transition cursor-pointer">
                    Cancel
                </button>
                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-1">
                    <button type="submit" class="w-full h-10 rounded-xl bg-red-500 hover:bg-red-600 text-white text-xs font-semibold shadow-lg shadow-red-500/20 transition cursor-pointer">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
            function toggleTheme() {
                const html = document.documentElement;
                if (html.classList.contains('dark')) {
                    html.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    html.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            }

            function toggleMobileSearch() {
                const searchDiv = document.getElementById('mobileSearch');
                if (searchDiv) {
                    searchDiv.classList.toggle('hidden');
                }
            }

            // Logout Popup Modal Functions
            function openLogoutModal() {
                const modal = document.getElementById('logoutModal');
                const content = document.getElementById('logoutModalContent');
                modal.classList.remove('hidden');
                setTimeout(() => {
                    content.classList.remove('scale-95', 'opacity-0');
                    content.classList.add('scale-100', 'opacity-100');
                }, 10);
            }

            function closeLogoutModal() {
                const modal = document.getElementById('logoutModal');
                const content = document.getElementById('logoutModalContent');
                content.classList.remove('scale-100', 'opacity-100');
                content.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 200);
            }

            (function() {
                const savedTheme = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
    </script>
</body>
</html>