    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management System</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        }
    </script>
    
    <!-- Icons & Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-100 dark:bg-black text-slate-800 dark:text-white min-h-screen font-sans antialiased transition-colors duration-200">
    
    <div div class="min-h-screen">
        <!-- ================= NAVBAR ================= -->
        <nav class="fixed top-0 left-0 right-0 z-50 h-[70px] bg-[#13250E] dark:bg-zinc-950 border-b border-[#1f3a17] dark:border-zinc-800 transition-colors duration-300">
            <div class="h-full flex items-center justify-between px-4 md:px-6 gap-4">

                <!-- LEFT -->
                <div class="flex items-center gap-3 lg:gap-5 shrink-0">
                    <!-- Logo -->
                    <a href="@Url.Action("Dashboard", "Receptionist")" class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-10 h-10 md:w-11 md:h-11 rounded-xl bg-lime-400 flex items-center justify-center shadow-lg shadow-lime-400/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-[#13250E] dark:text-zinc-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 10v4m3-6v8m10-8v8m3-6v4M7 12h10"/>
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-lg md:text-xl font-extrabold text-white dark:text-zinc-100 tracking-wide leading-none">
                                Iron<span class="text-lime-400">Core</span>
                            </h1>
                            <p class="text-[9px] md:text-[10px] tracking-[3px] text-lime-400/70 dark:text-zinc-500 mt-0.5 font-medium">FITNESS</p>
                        </div>
                    </a>

                    <div class="hidden sm:block w-px h-8 bg-[#1f3a17] dark:bg-zinc-800"></div>

                    <!-- Dashboard Header Label -->
                    <div class="hidden md:flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-8 9 8M5 10v10h14V10"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-[11px] text-lime-400/70 dark:text-zinc-400 leading-none">Welcome Back</p>
                            <h2 class="text-sm font-bold text-white dark:text-zinc-100 leading-tight mt-0.5">Dashboard</h2>
                        </div>
                    </div>
                </div>

                <!-- SEARCH (Tablet/Desktop) -->
                <div class="hidden sm:flex flex-1 justify-center max-w-md mx-2">
                    <div class="relative w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-lime-400/60 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/>
                        </svg>
                        <input type="text" placeholder="Search users, payments..." class="w-full h-10 pl-10 pr-4 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 text-sm text-emerald-100 dark:text-zinc-100 placeholder:text-lime-400/50 dark:placeholder:text-zinc-500 outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/20 transition-all" />
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <!-- Mobile Search Toggle Button -->
                    <button type="button" onclick="toggleMobileSearch()" class="sm:hidden w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition text-lime-400 dark:text-zinc-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/>
                        </svg>
                    </button>

                    <!-- New Button -->
                    <a href="@Url.Action("AddMember", "Receptionist")" class="h-10 px-3 md:px-4 rounded-xl bg-lime-400 hover:bg-lime-300 text-[#13250E] dark:text-zinc-950 text-xs md:text-sm font-bold flex items-center gap-1.5 md:gap-2 shadow-lg shadow-lime-400/20 hover:shadow-lime-400/40 hover:-translate-y-0.5 transition-all duration-200 active:scale-95 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        <span class="hidden sm:inline">New</span>
                    </a>

                    <!-- Theme Toggle Button -->
                    <button id="themeToggle" type="button" onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 hidden dark:block hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
                        </svg>
                    </button>

                    <!-- Notification -->
                    <div class="relative shrink-0">
                        <a href="@Url.Action("Notifications", "Receptionist")" class="w-10 h-10 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 dark:text-zinc-400 hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14V11a6 6 0 10-12 0v3a2 2 0 01-.6 1.4L4 17h5"/>
                            </svg>
                        </a>
                        <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-lime-400 text-[#13250E] dark:text-zinc-950 text-[10px] font-extrabold flex items-center justify-center shadow-md animate-pulse">8</span>
                    </div>

                    <div class="hidden sm:block w-px h-8 bg-[#1f3a17] dark:bg-zinc-800"></div>

                    <!-- Profile -->
                    <a href="@Url.Action("Profile", "Receptionist")" class="flex items-center gap-2.5 bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 rounded-xl p-1.5 sm:px-2.5 hover:border-lime-400 transition-all duration-200 shrink-0">
                        <img src="https://i.pravatar.cc/100?img=12" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg border border-lime-400 object-cover" alt="Profile">
                        <div class="hidden md:block text-left">
                            <p class="text-xs text-emerald-100 dark:text-zinc-100 font-semibold leading-tight">Receptionist</p>
                            <span class="text-[10px] text-lime-400 leading-none font-medium">Mohamed Adam</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Mobile Search Bar Dropdown -->
            <div id="mobileSearch" class="hidden sm:hidden px-4 pb-3 pt-1 bg-[#13250E] dark:bg-zinc-950 border-b border-[#1f3a17] dark:border-zinc-800">
                <div class="relative w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-lime-400/60 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/>
                    </svg>
                    <input type="text" placeholder="Search..." class="w-full h-10 pl-10 pr-4 rounded-xl bg-[#1b3414] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-800 text-sm text-emerald-100 dark:text-zinc-100 placeholder:text-lime-400/50 dark:placeholder:text-zinc-500 focus:outline-none focus:border-lime-400" />
                </div>
            </div>
        </nav>

        <!-- ================= SIDEBAR ================= -->
        <aside class="fixed top-[70px] left-0 z-40 w-[260px] h-[calc(100vh-70px)] bg-[#13250E] dark:bg-zinc-950 border-r border-[#1f3a17] dark:border-zinc-800 flex flex-col justify-between transition-colors duration-200">
            <div class="p-4 space-y-1 overflow-y-auto flex-1 [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-[#23421a] dark:[&::-webkit-scrollbar-thumb]:bg-zinc-800 [&::-webkit-scrollbar-thumb]:rounded-full hover:[&::-webkit-scrollbar-thumb]:bg-[#2e5723] dark:hover:[&::-webkit-scrollbar-thumb]:bg-zinc-700">

                @{
                    string GetActive(string controller, string action) {
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        
                        bool isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                                        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

                        return isActive 
                            ? "flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold bg-lime-400 text-[#13250E] shadow-lg shadow-lime-400/10 transition-all"
                            : "flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-emerald-100/80 dark:text-zinc-400 hover:bg-[#1a3313] dark:hover:bg-zinc-900/60 hover:text-white dark:hover:text-zinc-200 transition-all";
                    }
                }

                <a href="@Url.Action("Dashboard", "Receptionist")" class="@GetActive("Receptionist", "Dashboard")">
                    <i class="fa-solid fa-gauge-high w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("QuickCheck", "Receptionist")" class="@GetActive("Receptionist", "QuickCheck")">
                    <i class="fa-solid fa-qrcode w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Quick Check-In</span>
                </a>

                <a href="@Url.Action("CheckOut", "Receptionist")" class="@GetActive("Receptionist", "CheckOut")">
                    <i class="fa-solid fa-right-from-bracket w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Check-Out</span>
                </a>

                <a href="@Url.Action("MembersList", "Receptionist")" class="@GetActive("Receptionist", "MembersList")">
                    <i class="fa-solid fa-users w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Members</span>
                </a>

                <a href="@Url.Action("AddMember", "Receptionist")" class="@GetActive("Receptionist", "AddMember")">
                    <i class="fa-solid fa-user-plus w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Add Member</span>
                </a>

                <a href="@Url.Action("Memberships", "Receptionist")" class="@GetActive("Receptionist", "Memberships")">
                    <i class="fa-solid fa-id-badge w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Memberships</span>
                </a>

                <a href="@Url.Action("RenewMembership", "Receptionist")" class="@GetActive("Receptionist", "RenewMembership")">
                    <i class="fa-solid fa-arrows-rotate w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Renew Membership</span>
                </a>

                <a href="@Url.Action("AttendanceLog", "Receptionist")" class="@GetActive("Receptionist", "AttendanceLog")">
                    <i class="fa-solid fa-calendar-check w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Attendance Log</span>
                </a>

                <a href="@Url.Action("VisitorLog", "Receptionist")" class="@GetActive("Receptionist", "VisitorLog")">
                    <i class="fa-solid fa-clipboard-user w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Visitor Log</span>
                </a>

                <a href="@Url.Action("Payments", "Receptionist")" class="@GetActive("Receptionist", "Payments")">
                    <i class="fa-solid fa-cash-register w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Payments</span>
                </a>

                <a href="@Url.Action("ClassSchedule", "Receptionist")" class="@GetActive("Receptionist", "ClassSchedule")">
                    <i class="fa-solid fa-calendar-days w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Class Schedule</span>
                </a>

                <a href="@Url.Action("Reservation", "Receptionist")" class="@GetActive("Receptionist", "Reservation")">
                    <i class="fa-solid fa-bookmark w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Reservations</span>
                </a>

                <a href="@Url.Action("Report", "Receptionist")" class="@GetActive("Receptionist", "Report")">
                    <i class="fa-solid fa-chart-pie w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Reports</span>
                </a>

                <a href="@Url.Action("Notifications", "Receptionist")" class="@GetActive("Receptionist", "Notifications")">
                    <i class="fa-solid fa-bell w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Notifications</span>
                </a>

                <a href="@Url.Action("Messages", "Receptionist")" class="@GetActive("Receptionist", "Messages")">
                    <i class="fa-solid fa-comments w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>Messages</span>
                </a>

                <a href="@Url.Action("Profile", "Receptionist")" class="@GetActive("Receptionist", "Profile")">
                    <i class="fa-solid fa-user-gear w-4 text-lime-400/80 dark:text-zinc-400"></i>
                    <span>My Profile</span>
                </a>

            </div>

            <!-- LOGOUT -->
            <div class="p-4 border-t border-[#1f3a17] dark:border-zinc-900 bg-[#13250E] dark:bg-black shrink-0">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-400 bg-[#1a3313] dark:bg-zinc-900/60 dark:text-red-400 text-[13px] font-medium hover:bg-red-500/20 dark:hover:bg-red-950/40 hover:text-red-300 dark:hover:text-red-300 transition w-full">
                        <i class="fa-solid fa-right-from-bracket w-4"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <main class="ml-[260px] pt-[70px] min-h-[calc(100vh-70px)] p-6 bg-white dark:bg-zinc-950 text-zinc-700 dark:text-zinc-100 transition-colors duration-300">
            @RenderBody()
        </main>
    </div>

    <!-- JavaScript -->
    <script>
        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        }

        function toggleMobileSearch() {
            const searchBar = document.getElementById('mobileSearch');
            if (searchBar) {
                searchBar.classList.toggle('hidden');
            }
        }

        (function () {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = savedTheme === 'dark' || (!savedTheme && prefersDark);

            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>