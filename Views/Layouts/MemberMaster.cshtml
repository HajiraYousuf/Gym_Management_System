    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitZone Gym Management</title>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            darkMode: 'class'
        }
    </script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-white font-sans antialiased transition-colors duration-200">
    <div class="min-h-screen">
        <!-- Mobile Overlay -->
        <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden"></div>

        <!-- ================= NAVBAR START ================= -->
        <nav class="fixed top-0 left-0 right-0 z-50 h-[70px] bg-[#13250E] dark:bg-black/95 backdrop-blur-xl border-b border-[#23451A] dark:border-lime-400/20 transition-colors">
            <div class="h-full flex items-center justify-between px-6">

                <!-- LEFT -->
                <div class="flex items-center gap-5">
                    <!-- Logo -->
                    <a href="@Url.Action("Dashboard", "Member")" class="flex items-center gap-3 group">
                        <div class="w-11 h-11 rounded-xl bg-lime-400 flex items-center justify-center shadow-lg shadow-lime-400/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 10v4m3-6v8m10-8v8m3-6v4M7 12h10"/>
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-xl font-extrabold text-white tracking-wide">
                                Iron<span class="text-lime-400">Core</span>
                            </h1>
                            <p class="text-[10px] tracking-[3px] text-zinc-400">FITNESS</p>
                        </div>
                    </a>

                    <div class="hidden sm:block w-px h-9 bg-[#23451A] dark:bg-zinc-700"></div>

                    <!-- Dashboard Label -->
                    <div class="hidden md:flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-[#1a3313] dark:bg-zinc-900 border border-[#274b1e] dark:border-zinc-700 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-8 9 8M5 10v10h14V10"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-[11px] text-zinc-400">Welcome Back</p>
                            <h2 class="text-sm font-bold text-white">Dashboard</h2>
                        </div>
                    </div>
                </div>

                <!-- SEARCH -->
                <div class="hidden md:flex flex-1 justify-center px-8">
                    <div class="relative w-full max-w-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/>
                        </svg>
                        <input type="text" placeholder="Search members, payments, classes..." class="w-full h-11 pl-11 pr-4 rounded-xl bg-[#1c3815] dark:bg-zinc-900 border border-[#2b5420] dark:border-zinc-700 text-sm text-white placeholder:text-zinc-400 outline-none focus:border-lime-400 transition" />
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="flex items-center gap-3">
                    <!-- Add Button -->
                    <a href="@Url.Action("WorkoutPlan", "Member")" class="h-10 px-5 rounded-xl bg-lime-400 hover:bg-lime-300 transition text-black text-sm font-bold flex items-center gap-2 shadow-lg shadow-lime-400/20">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        <span class="hidden sm:inline">New</span>
                    </a>

                    <!-- Theme Toggle Button -->
                    <button id="themeToggle" type="button" onclick="toggleTheme()" class="w-10 h-10 rounded-xl bg-[#1c3815] dark:bg-zinc-900 border border-[#2b5420] dark:border-zinc-800 hover:border-lime-400 flex items-center justify-center transition-all duration-200 active:scale-95 shrink-0 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-lime-400 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 hidden dark:block hover:text-lime-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
                        </svg>
                    </button>

                    <!-- Notification -->
                    <div class="relative">
                        <a href="@Url.Action("Notifications", "Member")" class="w-10 h-10 rounded-xl bg-[#1c3815] dark:bg-zinc-900 border border-[#2b5420] dark:border-zinc-700 hover:border-lime-400 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14V11a6 6 0 10-12 0v3a2 2 0 01-.6 1.4L4 17h5"/>
                            </svg>
                        </a>
                        <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-lime-400 text-black text-[10px] font-bold flex items-center justify-center">
                            8
                        </span>
                    </div>

                    <div class="hidden sm:block w-px h-8 bg-[#23451A] dark:bg-zinc-700"></div>

                    <!-- Profile -->
                    <a href="@Url.Action("Profile", "Member")" class="flex items-center gap-3 bg-[#1c3815] dark:bg-zinc-900 border border-[#2b5420] dark:border-zinc-700 rounded-xl px-2 py-1.5 hover:border-lime-400 transition">
                        <img src="https://i.pravatar.cc/100?img=12" class="w-9 h-9 rounded-lg border border-lime-400 object-cover" alt="Profile">
                        <div class="text-left hidden sm:block">
                            <p class="text-sm text-white font-semibold">Hajira Yousuf</p>
                            <span class="text-[11px] text-lime-400 font-medium">Member</span>
                        </div>
                    </a>
                </div>
            </div>
        </nav>

        <!-- ================= SIDEBAR START ================= -->
        <aside id="sidebar" class="fixed top-0 bottom-0 left-0 z-40 w-[260px] bg-[#13250E] dark:bg-zinc-950 border-r border-[#23451A] dark:border-zinc-800 flex flex-col justify-between transition-transform duration-300 -translate-x-full lg:translate-x-0">
            
            <div class="flex flex-col h-full overflow-hidden">
                <!-- Logo & Brand -->
                <div class="p-5 flex items-center gap-3 border-b border-[#1c3815] dark:border-zinc-900 shrink-0">
                    <div class="bg-lime-400 p-2 rounded-xl text-black shadow-md shadow-lime-400/20">
                        <i data-lucide="dumbbell" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-base text-white tracking-wide leading-none">FitZone</h1>
                        <span class="text-[10px] text-zinc-400 font-semibold tracking-wider uppercase">STRONGER EVERYDAY</span>
                    </div>
                </div>

                <!-- User Profile Card -->
                <div class="p-3 mx-3 my-3 bg-[#1a3313] dark:bg-zinc-900/60 border border-[#274b1e] dark:border-zinc-800/80 rounded-2xl flex items-center gap-3 shrink-0">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100&auto=format&fit=crop" alt="Profile" class="w-9 h-9 rounded-full object-cover ring-2 ring-lime-400/30" />
                    <div class="truncate">
                        <h2 class="text-xs font-semibold text-white truncate">Hajira Yousuf</h2>
                        <span class="inline-flex items-center gap-1 text-[10px] text-lime-400 font-medium">
                            <i data-lucide="check-circle-2" class="w-3 h-3"></i> Member
                        </span>
                    </div>
                </div>

                @{
                    string GetActive(string controller, string action) {
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        
                        bool isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                                        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

                        return isActive 
                            ? "nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-lime-400 text-black font-semibold text-[13px] shadow-lg shadow-lime-400/20 transition"
                            : "nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-zinc-300 hover:bg-[#1a3313] dark:hover:bg-zinc-900 hover:text-lime-400 text-[13px] font-medium transition";
                    }
                }

                <!-- Navigation Links -->
                <nav id="sidebarNav" class="px-3 space-y-1 overflow-y-auto flex-1 [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-[#274b1e] dark:[&::-webkit-scrollbar-thumb]:bg-zinc-800 [&::-webkit-scrollbar-thumb]:rounded-full">
                    
                    <a href="@Url.Action("Dashboard", "Member")" class="@GetActive("Member", "Dashboard")">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        <span>Dashboard</span>
                    </a>

                    <a href="@Url.Action("Profile", "Member")" class="@GetActive("Member", "Profile")">
                        <i data-lucide="user" class="w-4 h-4"></i>
                        <span>My Profile</span>
                    </a>

                    <a href="@Url.Action("Membership", "Member")" class="@GetActive("Member", "Membership")">
                        <i data-lucide="id-card" class="w-4 h-4"></i>
                        <span>Membership</span>
                    </a>

                    <a href="@Url.Action("WorkoutPlan", "Member")" class="@GetActive("Member", "WorkoutPlan")">
                        <i data-lucide="activity" class="w-4 h-4"></i>
                        <span>Workout Plan</span>
                    </a>

                    <a href="@Url.Action("NutritionPlan", "Member")" class="@GetActive("Member", "NutritionPlan")">
                        <i data-lucide="utensils" class="w-4 h-4"></i>
                        <span>Nutrition Plan</span>
                    </a>

                    <a href="@Url.Action("ClassSchedule", "Member")" class="@GetActive("Member", "ClassSchedule")">
                        <i data-lucide="calendar" class="w-4 h-4"></i>
                        <span>Class Schedule</span>
                    </a>

                    <a href="@Url.Action("Attendance", "Member")" class="@GetActive("Member", "Attendance")">
                        <i data-lucide="clipboard-check" class="w-4 h-4"></i>
                        <span>Attendance</span>
                    </a>

                    <a href="@Url.Action("Progress", "Member")" class="@GetActive("Member", "Progress")">
                        <i data-lucide="line-chart" class="w-4 h-4"></i>
                        <span>Progress</span>
                    </a>

                    <a href="@Url.Action("Notifications", "Member")" class="@GetActive("Member", "Notifications")">
                        <i data-lucide="bell" class="w-4 h-4"></i>
                        <span>Notifications</span>
                    </a>

                    <a href="@Url.Action("Messages", "Member")" class="@GetActive("Member", "Messages")">
                        <i data-lucide="message-square" class="w-4 h-4"></i>
                        <span>Messages</span>
                    </a>

                </nav>
            </div>

            <!-- BOTTOM CONTENT: GO PREMIUM & LOGOUT -->
            <div class="p-3 border-t border-[#1c3815] dark:border-zinc-900 bg-[#13250E] dark:bg-zinc-950 space-y-2 shrink-0">
                <div class="p-3 bg-[#1a3313] dark:bg-gradient-to-r dark:from-zinc-900 dark:to-zinc-800 rounded-xl border border-[#274b1e] dark:border-zinc-800/80 flex items-center justify-between">
                    <div>
                        <span class="text-[9px] font-bold text-zinc-400 uppercase tracking-wider block">GO PREMIUM</span>
                        <p class="text-xs text-white font-medium">Get more with Premium</p>
                    </div>
                    <div class="bg-lime-400/20 text-lime-400 p-1.5 rounded-lg border border-lime-400/30">
                        <i data-lucide="crown" class="w-4 h-4"></i>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-red-400 text-[13px] font-medium hover:bg-red-950/30 hover:text-red-300 transition w-full cursor-pointer">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>

        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <main class="lg:ml-[260px] pt-20 px-6 min-h-screen">
            @RenderBody()
        </main>
    </div>

    <!-- JavaScript -->
    <script>
        lucide.createIcons();

        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        });

        function toggleTheme() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('-translate-x-full');
                overlay.classList.toggle('hidden');
            }
        }
    </script>
</body>
</html>
