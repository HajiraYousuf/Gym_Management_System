@{
    ViewData["Title"] = "Gallery";
    Layout = "~/Views/Layouts/GuestMaster.cshtml";

    // Tusaale xog ah (Sample Gallery List) - Waxaad ku xiri kartaa Model-kaaga markaad backend-ka dhiseyso
    var galleryItems = new List<dynamic>
    {
        new { ImageURL = "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=1000&q=80", Title = "Heavy Lifting" },
        new { ImageURL = "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1000&q=80", Title = "Cardio Session" },
        new { ImageURL = "https://images.unsplash.com/photo-1540497077202-7c8a3999166f?auto=format&fit=crop&w=1000&q=80", Title = "Modern Equipment" },
        new { ImageURL = "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1000&q=80", Title = "Personal Training" }
    };
}

<!-- GALLERY SECTION -->
<section id="gallery" class="bg-black text-white py-20 px-4 sm:px-6 lg:px-8 border-t border-neutral-900">
    <div class="max-w-7xl mx-auto space-y-10">

        <!-- Section Header -->
        <div class="text-center space-y-2">
            <span class="text-xs sm:text-sm font-bold tracking-widest uppercase text-[#a3e635]">
                GALLERY
            </span>
            <h2 class="text-4xl sm:text-5xl font-black uppercase tracking-tight">
                Moments That <span class="text-[#a3e635]">Inspire</span>
            </h2>
        </div>

        <!-- Dynamic Gallery Image Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto pt-4">

            @foreach (var item in galleryItems)
            {
                <div class="group relative aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-950 border border-neutral-900 cursor-pointer">
                    <img src="@item.ImageURL"
                         alt="@item.Title"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />

                    <!-- Hover Overlay -->
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center p-4 text-center">
                        <i data-lucide="zoom-in" class="w-8 h-8 text-[#a3e635] mb-2"></i>
                        <span class="text-xs font-bold uppercase tracking-wider text-white">@item.Title</span>
                    </div>
                </div>
            }

        </div>

        <!-- View More Photos Link -->
        <div class="text-center pt-4">
            <a href="@Url.Action("Gallery", "Guest")"
               class="inline-block px-8 py-3.5 rounded-xl bg-[#a3e635] text-black font-extrabold hover:bg-[#86efac] transition-all shadow-lg shadow-[#a3e635]/10 hover:-translate-y-1">
                View More Photos
            </a>
        </div>

    </div>
</section>