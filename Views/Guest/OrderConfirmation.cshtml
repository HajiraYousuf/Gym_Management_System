@model GymManagementSystem.Models.GuestOrder
@{
    ViewData["Title"] = "Order Confirmed";
    Layout = "~/Views/Layouts/GuestMaster.cshtml";
}

<div class="min-h-screen bg-black text-white py-12 px-4 sm:px-6 lg:px-8 border-t border-neutral-900">
    <div class="max-w-3xl mx-auto space-y-8">

        <div class="text-center space-y-3">
            <div class="w-16 h-16 rounded-2xl bg-neutral-950 border border-neutral-800 flex items-center justify-center mx-auto text-[#a3e635] text-2xl">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight">
                Order <span class="text-[#a3e635]">Confirmed</span>
            </h1>
            <p class="text-sm text-neutral-400">
                Order number: <span class="font-bold text-white">@Model.OrderNumber</span>
            </p>
        </div>

        <div class="bg-neutral-950 border border-neutral-800 rounded-2xl p-6 space-y-4">
            <h2 class="text-lg font-bold text-white border-b border-neutral-800 pb-3">Order Details</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <div>
                    <p class="text-neutral-400 text-xs">Full Name</p>
                    <p class="font-semibold text-white">@Model.FullName</p>
                </div>
                <div>
                    <p class="text-neutral-400 text-xs">Phone</p>
                    <p class="font-semibold text-white">@Model.Phone</p>
                </div>
                <div class="sm:col-span-2">
                    <p class="text-neutral-400 text-xs">Delivery Address</p>
                    <p class="font-semibold text-white">@Model.Address</p>
                </div>
                <div>
                    <p class="text-neutral-400 text-xs">Payment Method</p>
                    <p class="font-semibold text-white">@Model.PaymentMethod</p>
                </div>
                <div>
                    <p class="text-neutral-400 text-xs">Order Date</p>
                    <p class="font-semibold text-white">@Model.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            </div>

            <div class="border-t border-neutral-800 pt-4 space-y-2">
                @foreach (var item in Model.Items)
                {
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-neutral-400">@item.ProductName (x@(item.Quantity))</span>
                        <span class="font-bold text-white">$@string.Format("{0:F2}", item.TotalPrice)</span>
                    </div>
                }
            </div>

            <div class="border-t border-neutral-800 pt-4 space-y-2 text-sm">
                <div class="flex justify-between text-neutral-400">
                    <span>Subtotal</span>
                    <span class="font-semibold text-white">$@string.Format("{0:F2}", Model.Subtotal)</span>
                </div>
                <div class="flex justify-between text-neutral-400">
                    <span>Shipping</span>
                    <span class="font-semibold text-white">$@string.Format("{0:F2}", Model.ShippingFee)</span>
                </div>
                <div class="flex justify-between items-center border-t border-neutral-800 pt-3 font-extrabold">
                    <span>Total Paid</span>
                    <span class="text-xl text-[#a3e635]">$@string.Format("{0:F2}", Model.TotalAmount)</span>
                </div>
            </div>
        </div>

        <div class="text-center">
            <a href="@Url.Action("Store", "Guest")"
               class="inline-block px-8 py-3.5 rounded-xl bg-[#a3e635] text-black font-extrabold hover:bg-[#86efac] transition-all">
                Continue Shopping
            </a>
        </div>

    </div>
</div>
