                        <div>
                            <p class="text-xs text-neutral-400 font-medium">Our Location</p>
                            <p class="text-sm font-bold text-white">123 Fitness Ave, Gym City</p>
                        </div>
                    </div>

                    <!-- Item 2: Email -->
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-[#a3e635] shrink-0">
                            <i data-lucide="mail" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <p class="text-xs text-neutral-400 font-medium">Email Us</p>
                            <p class="text-sm font-bold text-white">support@ironcoregym.com</p>
                        </div>
                    </div>

                    <!-- Item 3: Phone -->
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center text-[#a3e635] shrink-0">
                            <i data-lucide="phone" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <p class="text-xs text-neutral-400 font-medium">Call Us</p>
                            <p class="text-sm font-bold text-white">+1 (555) 123-4567</p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Column: Contact Form -->
            <div class="lg:col-span-7">
