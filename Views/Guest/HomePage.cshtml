@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Layouts/GuestMaster.cshtml";
}

@section Head {
    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
}

<!-- 1. HERO SECTION -->
<section id="home" class="relative min-h-[calc(100vh-80px)] flex flex-col justify-between pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden border-b border-neutral-900">
    
    <!-- Hero Main Content (Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center my-auto">
      
      <!-- Left Column: Text & Call to Action -->
      <div class="lg:col-span-6 space-y-6 z-10">
        <div class="inline-block">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight leading-[1.05]">
            Stronger <br />
            <span class="text-[#a3e635]">Every Day</span>
          </h1>
        </div>

        <p class="text-neutral-400 text-base sm:text-lg max-w-md leading-relaxed">
          Build your body. Boost your mind. <br class="hidden sm:inline" />
          Join the best gym in town.
        </p>

        <!-- Navigation Buttons -->
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="@Url.Action("Register", "Account")" 
             class="px-8 py-3.5 rounded-lg bg-[#a3e635] text-black font-extrabold flex items-center gap-2 hover:bg-[#86efac] transition-all shadow-lg shadow-[#a3e635]/20">
            Join Now
          </a>

          <a href="@Url.Action("Login", "Account")" 
             class="px-8 py-3.5 rounded-lg bg-neutral-900/90 border border-neutral-700 text-white font-bold flex items-center gap-2 hover:bg-neutral-800 transition-all">
            <i data-lucide="lock" class="w-4 h-4"></i> Login
          </a>
        </div>
      </div>

      <!-- Right Column: Hero Image with Gradient Overlay -->
      <div class="lg:col-span-6 relative flex justify-center items-center">
        <!-- Glow Behind Image -->
        <div class="absolute inset-0 bg-[#a3e635]/10 blur-3xl rounded-full"></div>
        
        <!-- Main Image Container -->
        <div class="relative w-full max-w-lg aspect-[4/3] rounded-2xl overflow-hidden border border-neutral-800 shadow-2xl">
          <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=1000&q=80" 
               alt="Gym Athlete" 
               class="w-full h-full object-cover object-center" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
        </div>
      </div>

    </div>

    <!-- Bottom Feature Bar -->
    <div class="mt-12 pt-8 border-t border-neutral-800/60 grid grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="flex items-center gap-4 p-3 rounded-xl bg-neutral-950/50 border border-neutral-900">
        <div class="p-3 rounded-lg bg-neutral-900 text-[#a3e635] shrink-0">
          <i data-lucide="dumbbell" class="w-6 h-6"></i>
        </div>
        <div>
          <h4 class="font-bold text-sm text-white">Modern Equipment</h4>
          <p class="text-xs text-neutral-400">State of the art machines</p>
        </div>
      </div>

      <div class="flex items-center gap-4 p-3 rounded-xl bg-neutral-950/50 border border-neutral-900">
        <div class="p-3 rounded-lg bg-neutral-900 text-[#a3e635] shrink-0">
          <i data-lucide="user-check" class="w-6 h-6"></i>
        </div>
        <div>
          <h4 class="font-bold text-sm text-white">Expert Trainers</h4>
          <p class="text-xs text-neutral-400">Certified & experienced</p>
        </div>
      </div>

      <div class="flex items-center gap-4 p-3 rounded-xl bg-neutral-950/50 border border-neutral-900">
        <div class="p-3 rounded-lg bg-neutral-900 text-[#a3e635] shrink-0">
          <i data-lucide="target" class="w-6 h-6"></i>
        </div>
        <div>
          <h4 class="font-bold text-sm text-white">Personalized Plans</h4>
          <p class="text-xs text-neutral-400">Achieve your goals</p>
        </div>
      </div>

      <div class="flex items-center gap-4 p-3 rounded-xl bg-neutral-950/50 border border-neutral-900">
        <div class="p-3 rounded-lg bg-neutral-900 text-[#a3e635] shrink-0">
          <i data-lucide="headset" class="w-6 h-6"></i>
        </div>
        <div>
          <h4 class="font-bold text-sm text-white">Friendly Support</h4>
          <p class="text-xs text-neutral-400">We are here for you</p>
        </div>
      </div>

    </div>

</section>