@model GymManagementSystem.Models.GuestModel
@{
    ViewData["Title"] = "Membership Plans";
    Layout = "~/Views/Layouts/GuestMaster.cshtml";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Success / Error Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-8 p-4 bg-lime-400/10 border border-lime-400/20 text-lime-400 rounded-2xl text-sm font-bold text-center">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-8 p-4 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-2xl text-sm font-bold text-center">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Section Header -->
    <div class="text-center space-y-2 mb-12">
        <span class="text-xs sm:text-sm font-bold tracking-widest uppercase text-[#a3e635]">
            MEMBERSHIP PLANS
        </span>
        <h2 class="text-4xl sm:text-5xl font-black uppercase tracking-tight text-white">
            Choose Your <span class="text-[#a3e635]">Plan</span>
        </h2>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch max-w-6xl mx-auto">

        @foreach (var plan in Model.MembershipPlans)
        {
            <!-- Membership Card -->
            <div class="bg-neutral-950 border border-neutral-800/80
                rounded-3xl p-8 flex flex-col justify-between
                transition-all duration-300 ease-in-out
                hover:-translate-y-2 hover:bg-neutral-900
                hover:border-neutral-700
                hover:shadow-2xl hover:shadow-black/60">

                <div>
                    <!-- Plan Title -->
                    <h3 class="text-xl font-extrabold uppercase tracking-wider text-center text-white mb-6">
                        @plan.Name
                    </h3>

                    <!-- Price -->
                    <div class="text-center mb-8">
                        <span class="text-5xl font-black text-white">
                            $@string.Format("{0:F2}", plan.Price)
                        </span>
                        <span class="text-neutral-400 text-sm">/month</span>
                    </div>

                    <!-- Features -->
                    <ul class="space-y-4 text-sm text-neutral-300 mb-8">

                        @if (!string.IsNullOrEmpty(plan.Features))
                        {
                            @foreach (var feature in plan.Features.Split('|'))
                            {
                                <li class="flex items-center gap-3">
                                    <i data-lucide="check" class="w-4 h-4 text-[#a3e635]"></i>
                                    <span>@feature.Trim()</span>
                                </li>
                            }
                        }

                    </ul>
                </div>

                <!-- Join Now Button (Triggers Modal) -->
                <button type="button" onclick="openJoinModal('@plan.Name', '@plan.Price')"
                        class="w-full py-3.5 block rounded-xl bg-[#a3e635] text-black font-extrabold text-center hover:bg-[#86efac] transition-all cursor-pointer">
                    Join Now
                </button>

            </div>
        }

    </div>
</div>

<!-- ================= MEMBERSHIP REQUEST MODAL ================= -->
<div id="joinModal" class="fixed inset-0 z-50 hidden bg-neutral-950/80 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-neutral-900 border border-neutral-800 rounded-3xl w-full max-w-md p-6 shadow-2xl space-y-6 my-8 text-white">

        <div class="flex justify-between items-center border-b border-neutral-800 pb-4">
            <div>
                <h3 class="text-lg font-black uppercase tracking-wider text-white">Confirm Membership Request</h3>
                <p class="text-xs text-neutral-400 mt-0.5" id="modalPlanSubtitle">Selected Plan: -</p>
            </div>
            <button type="button" onclick="closeJoinModal()" class="w-9 h-9 rounded-xl bg-neutral-800 text-neutral-400 hover:text-rose-500 flex items-center justify-center cursor-pointer transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-action="SubmitMembershipRequest" method="post" class="space-y-4 text-xs">
            <input type="hidden" id="modalPlanNameInput" name="planName" />

            <div class="p-4 bg-neutral-950 rounded-2xl border border-neutral-800 text-neutral-300">
                <p class="font-bold text-white mb-1">Xusuusin:</p>
                <p class="text-[11px] text-neutral-400">Codsigaaga waxaa lagugu xiri doonaa koontadaada (Account) aad ku soo gashay. Receptionist-ka ayaa hubin doona lacag bixintaada.</p>
            </div>

            <div>
                <label class="block font-bold uppercase text-neutral-400 mb-1.5">Payment Method</label>
                <select name="paymentMethod" class="w-full h-11 bg-neutral-950 border border-neutral-800 focus:border-[#a3e635] rounded-xl px-3 text-white text-xs outline-none transition">
                    <option value="EVC Plus">EVC Plus</option>
                    <option value="Zaad">Zaad Service</option>
                    <option value="Cash">Cash at Reception</option>
                </select>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-neutral-800">
                <button type="button" onclick="closeJoinModal()" class="px-5 py-2.5 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-bold rounded-xl transition cursor-pointer">Cancel</button>
                <button type="submit" class="px-5 py-2.5 bg-[#a3e635] hover:bg-[#86efac] text-neutral-950 font-extrabold rounded-xl shadow-md transition cursor-pointer">Submit Request</button>
            </div>
        </form>

    </div>
</div>
<!-- Modal Script -->
<script>
    function openJoinModal(planName, planPrice) {
        document.getElementById('modalPlanNameInput').value = planName;
        document.getElementById('modalPlanSubtitle').innerText = "Selected Plan: " + planName + " ($" + planPrice + "/month)";
        document.getElementById('joinModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeJoinModal() {
        document.getElementById('joinModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
</script>