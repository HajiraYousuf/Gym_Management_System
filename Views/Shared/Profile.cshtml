@{
    Layout = "~/Views/layouts/AdminMaster.cshtml";
    ViewData["Title"] = "User Profile";
}

<!-- Main Profile Container -->
<div class="flex flex-col h-[calc(100vh-5rem)] bg-zinc-100 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 transition-all duration-300 rounded-3xl shadow-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800/80 m-2">

    <!-- Banner -->
    <div class="relative h-40 bg-gradient-to-r from-lime-500 to-emerald-600 p-6">
        <div class="absolute inset-0 bg-black/10"></div>
        <div class="relative z-10 flex justify-between">
            <div>
                <h2 class="text-xl font-extrabold text-zinc-950 tracking-tight">Personal Profile</h2>
                <p class="text-xs text-zinc-900/80 font-medium mt-0.5">Manage your account and preferences</p>
            </div>
            <button onclick="toggleTheme()" class="p-2.5 rounded-2xl bg-white/80 dark:bg-zinc-900/80 hover:bg-white dark:hover:bg-zinc-900 shadow-sm backdrop-blur-md">
                <i id="theme-icon" class="fas fa-moon text-xs"></i>
            </button>
        </div>
    </div>

    <!-- Body -->
    <div class="flex-1 overflow-y-auto px-6 pb-6 -mt-12 relative z-10 space-y-6">
        <div class="bg-white dark:bg-zinc-900 p-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-lg flex flex-col md:flex-row items-center gap-6">
            <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-lime-400 to-emerald-500 flex items-center justify-center font-extrabold text-3xl text-zinc-950 shadow-xl border-4 border-white dark:border-zinc-900">
                <span id="user-initials">AD</span>
            </div>
            <div class="flex-1 text-center md:text-left">
                <h3 id="user-fullname" class="text-xl font-bold text-zinc-900 dark:text-zinc-100">Aadan Maxamed</h3>
                <span id="user-role-badge" class="px-3 py-0.5 rounded-full bg-lime-500/10 text-lime-600 text-xs font-bold">Administrator</span>
                <p class="text-xs text-zinc-500 mt-2">aadan.admin@gymsystem.com</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- General Info -->
            <div class="bg-white dark:bg-zinc-900 p-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-4">
                <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 pb-3 border-b border-zinc-100 dark:border-zinc-800">General Information</h4>
                <div class="space-y-3">
                    <input type="text" value="Aadan Maxamed" class="w-full px-4 py-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800 text-xs">
                    <input type="text" value="+252 63 1234567" class="w-full px-4 py-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800 text-xs">
                </div>
            </div>

            <!-- Role Specific Data -->
            <div class="bg-white dark:bg-zinc-900 p-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-4">
                <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 pb-3 border-b border-zinc-100 dark:border-zinc-800">Role Specific Data</h4>
                <div id="role-specific-data" class="space-y-3">
                    <!-- Dynamic Content -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Configuration Data for different roles
    const rolesData = {
        "Member": [
            { label: "Subscription Plan", value: "Gold Package (Pro)" },
            { label: "Trainer Assigned", value: "Khaalid (Master Trainer)" }
        ],
        "Trainer": [
            { label: "Specialization", value: "CrossFit & Bodybuilding" },
            { label: "Active Members", value: "24 Members" }
        ],
        "Receptionist": [
            { label: "Assigned Shift", value: "Morning (06:00 - 14:00)" },
            { label: "Station ID", value: "Front-Desk Station 01" }
        ],
        "Admin": [
            { label: "Access Level", value: "Super Admin (Full)" },
            { label: "System Version", value: "v2.0.4 (GymManagement)" }
        ]
    };

    // Simulation function to change content (You can trigger this based on user session)
    function loadUserData(role) {
        const container = document.getElementById('role-specific-data');
        const badge = document.getElementById('user-role-badge');
        
        container.innerHTML = '';
        badge.innerText = role;

        rolesData[role].forEach(item => {
            container.innerHTML += `
                <div>
                    <label class="block text-[10px] font-semibold text-zinc-400 uppercase mb-1">${item.label}</label>
                    <input type="text" readonly value="${item.value}" class="w-full px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800 text-xs text-zinc-800 dark:text-zinc-200">
                </div>
            `;
        });
    }

    // Default load - You can call this based on your login system
    loadUserData("Admin");

    function toggleTheme() {
        document.documentElement.classList.toggle('dark');
        document.getElementById('theme-icon').className = document.documentElement.classList.contains('dark') ? 'fas fa-sun text-yellow-400 text-xs' : 'fas fa-moon text-xs';
    }
</script>