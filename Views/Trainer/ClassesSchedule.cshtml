            <button type="button" onclick="closeClassNoteModal()" class="w-8 h-8 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-lime-400 hover:text-black flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-4 text-xs">
            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Select Class</label>
                <select class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl p-3 focus:outline-none focus:border-lime-500 transition cursor-pointer">
                    <option value="Morning HIIT">Morning HIIT (07:00 AM)</option>
                    <option value="Strength Training">Strength Training (09:30 AM)</option>
                    <option value="Yoga Session">Yoga Session (04:00 PM)</option>
                    <option value="CrossFit">CrossFit (06:00 PM)</option>
                </select>
            </div>
            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Class Note / Feedback</label>
                <textarea id="classNoteTextArea" rows="4" placeholder="Enter notes regarding equipment, session intensity, or room changes..." class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl p-3 focus:outline-none focus:border-lime-500 transition resize-none"></textarea>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-5 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-end gap-3 bg-zinc-50 dark:bg-zinc-950">
            <button type="button" onclick="closeClassNoteModal()" class="px-5 py-2.5 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold transition cursor-pointer text-xs">
                Cancel
            </button>
            <button type="button" onclick="alert('Class note saved successfully!'); closeClassNoteModal();" class="px-6 py-2.5 rounded-xl bg-lime-400 hover:bg-lime-500 text-black font-extrabold shadow-lg shadow-lime-500/20 transition cursor-pointer text-xs">
                Save Note
            </button>
        </div>

    </div>
</div>

<!-- JavaScript View Switcher & Modal Control -->
<script type="text/javascript">
    function switchScheduleView(viewMode) {
        const dayContainer = document.getElementById('dayViewContainer');
        const weekContainer = document.getElementById('weekViewContainer');
        const btnDay = document.getElementById('btnDayView');
        const btnWeek = document.getElementById('btnWeekView');
        const dateDisplay = document.getElementById('dateDisplay');
        const viewSubtitle = document.getElementById('viewSubtitle');

        if (viewMode === 'day') {
            dayContainer.classList.remove('hidden');
            weekContainer.classList.add('hidden');

            btnDay.className = "w-1/2 sm:w-auto bg-lime-500 text-zinc-950 font-bold px-4 py-1.5 rounded-lg text-xs transition cursor-pointer";
            btnWeek.className = "w-1/2 sm:w-auto text-zinc-500 dark:text-zinc-400 font-medium px-4 py-1.5 rounded-lg text-xs hover:text-zinc-900 dark:hover:text-white transition cursor-pointer";

            dateDisplay.innerText = "Thursday, Aug 6, 2026";
            viewSubtitle.innerText = "Today Classes";
        } else {
            dayContainer.classList.add('hidden');
            weekContainer.classList.remove('hidden');

            btnWeek.className = "w-1/2 sm:w-auto bg-lime-500 text-zinc-950 font-bold px-4 py-1.5 rounded-lg text-xs transition cursor-pointer";
            btnDay.className = "w-1/2 sm:w-auto text-zinc-500 dark:text-zinc-400 font-medium px-4 py-1.5 rounded-lg text-xs hover:text-zinc-900 dark:hover:text-white transition cursor-pointer";

            dateDisplay.innerText = "Aug 3 - Aug 9, 2026";
            viewSubtitle.innerText = "Weekly Class Overview";
        }
    }

    function openClassNoteModal(className) {
        if (className) {
            document.getElementById('classNoteModalTitle').innerText = 'Class Note for ' + className;
        } else {
            document.getElementById('classNoteModalTitle').innerText = 'Add Class Note';
        }
        document.getElementById('classNoteTextArea').value = '';
        document.getElementById('classNoteModal').classList.remove('hidden');
    }

    function closeClassNoteModal() {
        document.getElementById('classNoteModal').classList.add('hidden');
    }
</script>