        <!-- Left 8 Columns: Active Plans, Attendance & Progress History -->
        <div class="lg:col-span-8 space-y-6">

            <!-- 4. Active Assigned Plans (With Plan Status: Active, Expired, Completed) -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-clipboard-list text-lime-500"></i> Active Assigned Plans
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Active Workout Card -->
                    <div class="bg-zinc-50 dark:bg-zinc-950 p-4 rounded-xl border border-zinc-200/60 dark:border-zinc-800 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-2">
                                <span class="bg-lime-500/10 text-lime-500 text-[10px] font-extrabold px-2 py-0.5 rounded uppercase">Workout Plan</span>
                                <select class="bg-emerald-500/10 text-emerald-500 text-xs font-bold px-2 py-0.5 rounded-full border border-emerald-500/20 focus:outline-none cursor-pointer">
                                    <option value="Active" selected>Active</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Expired">Expired</option>
                                </select>
                            </div>
                            <h3 class="font-bold text-sm text-zinc-900 dark:text-white">Hypertrophy Upper Split</h3>
