                        AH
                    </div>
                    <span class="w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-zinc-900 absolute bottom-0 right-0" title="Active Membership"></span>
                </div>

                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-xl md:text-2xl font-black text-zinc-900 dark:text-white">Ahmed Ali Hassan</h2>
                        <span class="bg-emerald-500/10 text-emerald-500 text-xs font-bold px-2.5 py-0.5 rounded-full border border-emerald-500/20">Active Member</span>
                    </div>
                    <p class="text-xs text-zinc-400 font-medium mt-1">ID: <span class="text-zinc-700 dark:text-zinc-300 font-bold">#MEM-8801</span> • Joined: Jan 15, 2026</p>

                    <div class="flex items-center gap-4 mt-3 text-xs text-zinc-500 dark:text-zinc-400 flex-wrap">
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-envelope text-lime-500"></i> ahmed.ali@example.com</span>
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-phone text-lime-500"></i> +252 61 555 0192</span>
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-user-gear text-lime-500"></i> Trainer: You</span>
                    </div>
                </div>
            </div>

            <!-- Membership Package -->
            <div class="flex md:flex-col items-start md:items-end justify-between border-t md:border-t-0 border-zinc-100 dark:border-zinc-800 pt-4 md:pt-0">
                <div class="text-left md:text-right">
                    <span class="text-[10px] uppercase font-extrabold tracking-wider text-zinc-400">Membership Package</span>
                    <p class="text-sm font-bold text-zinc-900 dark:text-white mt-0.5">VIP Personal Training</p>
                </div>
                <div class="text-right mt-0 md:mt-3">
