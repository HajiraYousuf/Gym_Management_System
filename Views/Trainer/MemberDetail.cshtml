<div class="p-4 md:p-6 bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors duration-200">

    <!-- 1. Top Navigation & Action Header (With Back to My Members) -->
    <div class="mb-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="@Url.Action("MyMembers", "Trainer")" class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 font-bold px-3.5 py-2.5 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-arrow-left"></i> Back to My Members
            </a>
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">Member Profile</h1>
                <p class="text-zinc-500 dark:text-zinc-400 text-xs md:text-sm mt-0.5">Manage member workout, nutrition plans, and track progress.</p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a href="@Url.Action("CreateWorkoutPlan", "Trainer", new { memberId = 8801 })" class="bg-lime-500 hover:bg-lime-400 text-zinc-950 font-extrabold px-4 py-2.5 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm">
