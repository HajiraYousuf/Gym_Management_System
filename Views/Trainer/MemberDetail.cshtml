                    <i class="fa-solid fa-ruler-vertical"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Height</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">178 <span class="text-xs font-normal text-zinc-400">cm</span></p>
                </div>
            </div>

            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-percent"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Body Fat %</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">16.2%</p>
                </div>
            </div>

            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-bullseye"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Target Weight</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">78.0 <span class="text-xs font-normal text-zinc-400">kg</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Dashboard Split Layout -->
