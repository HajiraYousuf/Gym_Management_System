                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Aug 06, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Upper Body Strength</td>
                                <td class="py-3.5 px-4 text-right"><span class="bg-emerald-500/10 text-emerald-500 text-xs px-2.5 py-0.5 rounded-full border border-emerald-500/20">Completed</span></td>
                            </tr>
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Aug 05, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Shoulders Focus</td>
                                <td class="py-3.5 px-4 text-right"><span class="bg-emerald-500/10 text-emerald-500 text-xs px-2.5 py-0.5 rounded-full border border-emerald-500/20">Completed</span></td>
                            </tr>
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Aug 03, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Back & Biceps</td>
                                <td class="py-3.5 px-4 text-right"><span class="bg-emerald-500/10 text-emerald-500 text-xs px-2.5 py-0.5 rounded-full border border-emerald-500/20">Completed</span></td>
                            </tr>
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Aug 01, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Chest & Triceps</td>
                                <td class="py-3.5 px-4 text-right"><span class="bg-emerald-500/10 text-emerald-500 text-xs px-2.5 py-0.5 rounded-full border border-emerald-500/20">Completed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- NEW SECTION: Progress History -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
                <div class="p-4 md:p-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
                    <h2 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-timeline text-lime-500"></i> Progress History
                    </h2>
                    <span class="text-xs text-zinc-400 font-semibold">Weight Tracker</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs md:text-sm">
