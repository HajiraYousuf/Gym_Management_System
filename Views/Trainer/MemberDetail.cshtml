                    <p class="text-lg font-black text-zinc-900 dark:text-white">74.5 <span class="text-xs font-normal text-zinc-400">kg</span></p>
                </div>
            </div>

            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
