@model GymManagementSystem.Models.User

@{
    ViewData["Title"] = "Member Profile";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";

    var latestProgress = ViewBag.LatestProgress as GymManagementSystem.Models.MemberProgress;
    var progressHistory = ViewBag.ProgressHistory as List<GymManagementSystem.Models.MemberProgress> ?? new List<GymManagementSystem.Models.MemberProgress>();
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-4 md:p-6 bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors duration-200">

    <!-- Top Navigation -->
    <div class="mb-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Members", "Trainer")" class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 font-bold px-3.5 py-2.5 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-arrow-left"></i> Back to My Members
            </a>
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">Member Profile</h1>
                <p class="text-zinc-500 dark:text-zinc-400 text-xs md:text-sm mt-0.5">Manage member workout, nutrition plans, and track progress.</p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a href="@Url.Action("CreateWorkoutPlan", "Trainer", new { memberId = Model.Id })" class="bg-lime-500 hover:bg-lime-400 text-zinc-950 font-extrabold px-4 py-2.5 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-dumbbell"></i> Assign Workout
            </a>
            <a href="@Url.Action("CreateNutritionPlan", "Trainer", new { memberId = Model.Id })" class="bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-white font-extrabold px-4 py-2.5 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-utensils"></i> Assign Nutrition
            </a>
        </div>
    </div>

    <!-- Member Profile Header Card -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 md:p-6 shadow-sm mb-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-lime-500/10 border-2 border-lime-500 text-lime-600 dark:text-lime-400 font-black text-2xl md:text-3xl flex items-center justify-center">
                    @(Model.Name?.Length >= 2 ? Model.Name.Substring(0, 2).ToUpper() : "US")
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-xl md:text-2xl font-black text-zinc-900 dark:text-white">@Model.Name</h2>
                        <span class="bg-emerald-500/10 text-emerald-500 text-xs font-bold px-2.5 py-0.5 rounded-full border border-emerald-500/20">@(Model.Status ?? "Active") Member</span>
                    </div>
                    <p class="text-xs text-zinc-400 font-medium mt-1">ID: <span class="text-zinc-700 dark:text-zinc-300 font-bold">#MEM-@Model.Id</span> • Shift: @(Model.Shift ?? "General")</p>
                </div>
            </div>

            <!-- Package & Dynamic Goal from Progress -->
            <div class="flex md:flex-col items-start md:items-end justify-between border-t md:border-t-0 border-zinc-100 dark:border-zinc-800 pt-4 md:pt-0">
                <div class="text-left md:text-right">
                    <span class="text-[10px] uppercase font-extrabold tracking-wider text-zinc-400">Membership Package</span>
                    <p class="text-sm font-bold text-zinc-900 dark:text-white mt-0.5">@(Model.MembershipType ?? "Standard Membership")</p>
                </div>
                <div class="text-right mt-0 md:mt-3">
                    <span class="text-[10px] uppercase font-extrabold tracking-wider text-zinc-400">Current Goal</span>
                    <p class="text-sm font-bold text-lime-500 mt-0.5">@(latestProgress?.Goal ?? "General Fitness")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Body Metrics Row -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-extrabold text-zinc-400 uppercase tracking-wider">Body Metrics</h2>
            <span class="text-xs font-semibold text-zinc-400 flex items-center gap-1">
                <i class="fa-regular fa-clock text-lime-500"></i> Last Updated: @(latestProgress != null ? latestProgress.CheckDate.ToString("MMM dd, yyyy") : "No records")
            </span>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-lime-500/10 text-lime-500 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-weight-scale"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Current Weight</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">@(latestProgress != null ? latestProgress.Weight.ToString() : "-") <span class="text-xs font-normal text-zinc-400">kg</span></p>
                </div>
            </div>

            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-percent"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Body Fat %</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">@(latestProgress != null ? latestProgress.BodyFat + "%" : "-")</p>
                </div>
            </div>

            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-ruler-vertical"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Arms Size</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">@(latestProgress != null ? latestProgress.Arms.ToString() : "-") <span class="text-xs font-normal text-zinc-400">cm</span></p>
                </div>
            </div>

            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-4 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-bullseye"></i>
                </div>
                <div>
                    <p class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider">Target Weight</p>
                    <p class="text-lg font-black text-zinc-900 dark:text-white">@(latestProgress?.TargetWeight > 0 ? latestProgress.TargetWeight.ToString() : "-") <span class="text-xs font-normal text-zinc-400">kg</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress History & Trainer Notes Table -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-4 md:p-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
            <h2 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-timeline text-lime-500"></i> Progress History & Trainer Notes
            </h2>
            <span class="text-xs text-zinc-400 font-semibold">@progressHistory.Count Logs Recorded</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs md:text-sm">
                <thead>
                    <tr class="bg-zinc-50/50 dark:bg-zinc-800/30 border-b border-zinc-200 dark:border-zinc-800 font-bold uppercase tracking-wider text-zinc-400 text-[10px]">
                        <th class="py-3 px-4">Date</th>
                        <th class="py-3 px-4">Weight / Target</th>
                        <th class="py-3 px-4">Goal</th>
                        <th class="py-3 px-4">Body Fat</th>
                        <th class="py-3 px-4">Trainer Note (Notes)</th>
                        <th class="py-3 px-4 text-right">Next Check</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-semibold text-zinc-800 dark:text-zinc-200">
                    @if (progressHistory.Any())
                    {
                        foreach (var prog in progressHistory)
                        {
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">@prog.CheckDate.ToString("MMM dd, yyyy")</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">@prog.Weight kg <span class="text-[10px] text-amber-500 font-normal">(Target: @(prog.TargetWeight > 0 ? prog.TargetWeight.ToString() + "kg" : "-"))</span></td>
                                <td class="py-3.5 px-4 text-lime-600 dark:text-lime-400">@(string.IsNullOrEmpty(prog.Goal) ? "-" : prog.Goal)</td>
                                <td class="py-3.5 px-4 text-purple-500">@(prog.BodyFat > 0 ? prog.BodyFat + "%" : "-")</td>
                                <td class="py-3.5 px-4 text-zinc-700 dark:text-zinc-300 italic">@(string.IsNullOrEmpty(prog.Notes) ? "No note added." : prog.Notes)</td>
                                <td class="py-3.5 px-4 text-right text-zinc-500">@prog.NextCheckDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-6 text-center text-zinc-400 text-xs">Wali xog horumar ah laguma diiwaangelin xubintan.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>