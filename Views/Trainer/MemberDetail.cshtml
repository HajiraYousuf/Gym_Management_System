                        </div>
                        <div class="mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800 flex justify-between items-center">
                            <span class="text-[11px] text-zinc-400">Duration: 4 Weeks</span>
                            <a href="@Url.Action("WorkoutPlanDetail", "Trainer", new { id = 202 })" class="text-xs font-bold text-lime-500 hover:underline flex items-center gap-1">
                                View Details <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Active Nutrition Card -->
                    <div class="bg-zinc-50 dark:bg-zinc-950 p-4 rounded-xl border border-zinc-200/60 dark:border-zinc-800 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-2">
                                <span class="bg-blue-500/10 text-blue-500 text-[10px] font-extrabold px-2 py-0.5 rounded uppercase">Nutrition Plan</span>
                                <select class="bg-emerald-500/10 text-emerald-500 text-xs font-bold px-2 py-0.5 rounded-full border border-emerald-500/20 focus:outline-none cursor-pointer">
                                    <option value="Active" selected>Active</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Expired">Expired</option>
                                </select>
                            </div>
                            <h3 class="font-bold text-sm text-zinc-900 dark:text-white">High Protein Muscle Gain</h3>
                            <p class="text-xs text-zinc-400 mt-1">2,400 kcal/day • 4 Meals</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-zinc-200/60 dark:border-zinc-800 flex justify-between items-center">
                            <span class="text-[11px] text-zinc-400">Duration: 4 Weeks</span>
                            <a href="@Url.Action("NutritionPlanDetail", "Trainer", new { id = 101 })" class="text-xs font-bold text-lime-500 hover:underline flex items-center gap-1">
                                View Details <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Attendance Log (Session Time & Status) -->
