                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Aug 01, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">74.5 kg</td>
                                <td class="py-3.5 px-4 text-right font-bold text-emerald-500">+1.5 kg</td>
                            </tr>
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Jul 15, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">73.8 kg</td>
                                <td class="py-3.5 px-4 text-right font-bold text-emerald-500">+0.8 kg</td>
                            </tr>
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition">
                                <td class="py-3.5 px-4 text-zinc-500 dark:text-zinc-400">Jul 01, 2026</td>
                                <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">73.0 kg</td>
                                <td class="py-3.5 px-4 text-right font-bold text-zinc-400">Starting Weight</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- Right 4 Columns: Progress Gauge & Private Notes (With Add/Edit/Delete) -->
        <div class="lg:col-span-4 space-y-6">

            <!-- 6. Overall Goal Progress -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
                <h2 class="text-base font-bold text-zinc-900 dark:text-white mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-chart-line text-lime-500"></i> Overall Goal Progress
                </h2>

                <div class="space-y-4 text-xs">
                    <div>
                        <div class="flex justify-between font-bold mb-1">
                            <span class="text-zinc-600 dark:text-zinc-300">Weight Goal</span>
                            <span class="text-lime-500">50%</span>
                        </div>
                        <div class="w-full h-2 bg-zinc-100 dark:bg-zinc-800 rounded-full overflow-hidden">
                            <div class="h-full bg-lime-500 rounded-full" style="width: 50%"></div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between font-bold mb-1">
                            <span class="text-zinc-600 dark:text-zinc-300">Workout Attendance</span>
                            <span class="text-blue-500">85%</span>
                        </div>
                        <div class="w-full h-2 bg-zinc-100 dark:bg-zinc-800 rounded-full overflow-hidden">
                            <div class="h-full bg-blue-500 rounded-full" style="width: 85%"></div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between font-bold mb-1">
                            <span class="text-zinc-600 dark:text-zinc-300">Nutrition Adherence</span>
                            <span class="text-amber-500">90%</span>
                        </div>
                        <div class="w-full h-2 bg-zinc-100 dark:bg-zinc-800 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-500 rounded-full" style="width: 90%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 7. Private Trainer Notes (With Add, Edit, Delete Actions) -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-user-pen text-lime-500"></i> Private Trainer Notes
                    </h2>
                    <button type="button" onclick="alert('Add Note Modal')" class="bg-lime-500 hover:bg-lime-400 text-zinc-950 font-extrabold px-3 py-1.5 rounded-lg text-xs transition flex items-center gap-1 shadow-sm cursor-pointer">
                        <i class="fa-solid fa-plus"></i> Add Note
                    </button>
                </div>

                <div class="space-y-3 text-xs">
                    <!-- Note 1 -->
                    <div class="bg-zinc-50 dark:bg-zinc-950 p-3 rounded-xl border border-zinc-200/60 dark:border-zinc-800">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-[10px] font-bold text-zinc-400">Aug 04, 2026</span>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="alert('Edit Note')" class="text-zinc-400 hover:text-lime-500 transition cursor-pointer" title="Edit Note"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button type="button" onclick="alert('Delete Note')" class="text-zinc-400 hover:text-rose-500 transition cursor-pointer" title="Delete Note"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>
                        <p class="text-zinc-700 dark:text-zinc-300">Increased bench press weight by 2.5kg. Form was stable. Recommended extra rest day on Wednesday.</p>
                    </div>

                    <!-- Note 2 -->
                    <div class="bg-zinc-50 dark:bg-zinc-950 p-3 rounded-xl border border-zinc-200/60 dark:border-zinc-800">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-[10px] font-bold text-zinc-400">Jul 28, 2026</span>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="alert('Edit Note')" class="text-zinc-400 hover:text-lime-500 transition cursor-pointer" title="Edit Note"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button type="button" onclick="alert('Delete Note')" class="text-zinc-400 hover:text-rose-500 transition cursor-pointer" title="Delete Note"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>
                        <p class="text-zinc-700 dark:text-zinc-300">Member complained of mild lower back tightness. Adjusted deadlift to trap bar setup.</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>