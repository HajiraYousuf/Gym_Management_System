@model IEnumerable<GymManagementSystem.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Class Attendance";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";

    var total = ViewBag.TotalEnrolled ?? 0;
    var present = ViewBag.PresentCount ?? 0;
    var absent = ViewBag.AbsentCount ?? 0;
    var late = ViewBag.LateCount ?? 0;
    var checkedIn = ViewBag.CheckedInCount ?? 0;
    var rate = total > 0 ? (int)((double)checkedIn / total * 100) : 0;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- FILTER FORM -->
<form asp-action="ClassAttendance" method="get" id="filterForm">
    <div class="space-y-4  bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 p-4 md:p-6">

        <!-- Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 rounded-xl bg-lime-400/20 border border-lime-500/30 text-lime-600 dark:text-lime-400 text-xs font-bold">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 rounded-xl bg-rose-400/20 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-xs font-bold">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- HEADER -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-200 dark:border-zinc-800 pb-4">
            <div>
                <div class="flex items-center gap-2 text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-wider mb-0.5">
                    <span>Trainer Module</span>
                    <span>•</span>
                    <span>Class Attendance</span>
                </div>

                <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
                    @(ViewBag.SelectedClass == "All" ? "All Gym Classes" : ViewBag.SelectedClass)
                </h1>

                <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
                    Date: @ViewBag.SelectedDate • Trainer: Alex Morgan • Main Gym Floor
                </p>
            </div>

            <button type="button"
                    onclick="submitSaveForm()"
                    class="bg-lime-400 hover:bg-lime-500 text-black font-extrabold px-5 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg shadow-lime-500/20 transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-save"></i>
                Save Attendance
            </button>
        </div>

        <!-- STATISTICS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <!-- Total -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <div class="flex justify-between items-start mb-2">
                    <div class="w-9 h-9 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-base">
                        <i class="fas fa-users"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-zinc-400">Total</span>
                </div>
                <h3 class="text-xl font-black text-zinc-900 dark:text-white font-mono">@total</h3>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Enrolled Members</p>
            </div>

            <!-- Checked In -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <div class="flex justify-between items-start mb-2">
                    <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20 flex items-center justify-center text-base">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-blue-500">Checked In</span>
                </div>
                <h3 class="text-xl font-black text-zinc-900 dark:text-white font-mono">@checkedIn/@total</h3>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">@rate% Attendance Rate</p>
            </div>

            <!-- Present -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <div class="flex justify-between items-start mb-2">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 flex items-center justify-center text-base">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-emerald-500">Present</span>
                </div>
                <h3 class="text-xl font-black text-zinc-900 dark:text-white font-mono">@present</h3>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">On-time arrivals</p>
            </div>

            <!-- Absent -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <div class="flex justify-between items-start mb-2">
                    <div class="w-9 h-9 rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20 flex items-center justify-center text-base">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-rose-500">Absent</span>
                </div>
                <h3 class="text-xl font-black text-zinc-900 dark:text-white font-mono">@absent</h3>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Unexcused or missing</p>
            </div>

            <!-- Late -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <div class="flex justify-between items-start mb-2">
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center text-base">
                        <i class="fas fa-clock"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-amber-500">Late</span>
                </div>
                <h3 class="text-xl font-black text-zinc-900 dark:text-white font-mono">@late</h3>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Arrived past schedule</p>
            </div>
        </div>

        <!-- FILTERS -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-3.5 shadow-sm grid grid-cols-1 md:grid-cols-3 gap-3 items-center">
            <!-- Class -->
            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1 text-xs">Select Class</label>
                <select name="classFilter" onchange="this.form.submit()" class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-800 dark:text-zinc-100 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                    <option value="All" selected="@(ViewBag.SelectedClass == "All")">-- All Classes --</option>
                    @if (ViewBag.ClassList is List<string> classList)
                    {
                        foreach (var gc in classList)
                        {
                            <option value="@gc" selected="@(ViewBag.SelectedClass == gc)">@gc</option>
                        }
                    }
                </select>
            </div>

            <!-- Date -->
            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1 text-xs">Select Date</label>
                <input type="date" name="dateFilter" value="@ViewBag.SelectedDate" onchange="this.form.submit()" class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-800 dark:text-zinc-100 focus:outline-none focus:border-lime-500 font-medium dark:[color-scheme:dark]" />
            </div>

            <!-- Status -->
            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1 text-xs">Status Filter</label>
                @{
                    var currentStatus = Context.Request.Query["statusFilter"].ToString();
                }
                <select name="statusFilter" onchange="this.form.submit()" class="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-800 dark:text-zinc-100 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                    <option value="">All Statuses</option>
                    <option value="Present" selected="@(currentStatus == "Present")">Present</option>
                    <option value="Absent" selected="@(currentStatus == "Absent")">Absent</option>
                    <option value="Late" selected="@(currentStatus == "Late")">Late</option>
                </select>
            </div>
        </div>

        <!-- SEARCH -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-3.5 shadow-sm flex items-center">
            <div class="relative w-full md:w-96">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-zinc-400">
                    <i class="fas fa-search text-xs"></i>
                </span>
                <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search member name or ID..." class="w-full pl-10 pr-4 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-lime-500 transition-all font-medium" />
            </div>
            <button type="submit" class="ml-3 px-4 py-2 bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 text-xs font-bold rounded-xl cursor-pointer transition">
                Filter
            </button>
        </div>

    </div>
</form>

<div class="my-6"></div>

<!-- SAVE ATTENDANCE FORM -->
<form asp-action="SaveAttendance" method="post" id="saveForm" class="px-4 md:px-6 pb-6 -mt-2">
    @Html.AntiForgeryToken()
    <input type="hidden" name="className" value="@ViewBag.SelectedClass" />
    <input type="hidden" name="date" value="@ViewBag.SelectedDate" />

    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-zinc-600 dark:text-zinc-300">
                <thead class="bg-zinc-50 dark:bg-zinc-950 text-zinc-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="p-4">Member Name & ID</th>
                        <th class="p-4">Class Name</th>
                        <th class="p-4">Check-in Time</th>
                        <th class="p-4">Status</th>
                        <th class="p-4">Attendance Note</th>
                        <th class="p-4 text-right">Quick Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800 text-xs font-medium">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var record in Model)
                        {
                            var memberKey = record.MemberId;

                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/50 transition-colors">
                                <!-- MEMBER -->
                                <td class="p-4">
                                    <span class="font-bold text-zinc-900 dark:text-white block">
                                        @(record.Member?.Name ?? "Unknown Member")
                                    </span>
                                    <span class="text-[11px] text-zinc-400 font-mono">
                                        #@record.MemberId
                                    </span>
                                </td>

                                <!-- CLASS -->
                                <td class="p-4 font-semibold text-zinc-700 dark:text-zinc-300">
                                    @(!string.IsNullOrEmpty(record.ClassName) && record.ClassName != "All"
                                        ? record.ClassName
                                        : "General")
                                </td>

                                <!-- CHECK-IN -->
                                <td class="p-4 font-mono font-semibold text-zinc-800 dark:text-zinc-200">
                                    @(record.CheckIn.HasValue ? record.CheckIn.Value.ToString(@"hh\:mm") : "—")
                                </td>

                                <!-- STATUS -->
                                <td class="p-4">
                                    <input type="hidden" name="statuses[@memberKey]" id="status_@memberKey" value="@record.Status" />

                                    <span id="badge_@memberKey" class="px-2.5 py-1 rounded-full text-[10px] font-bold inline-flex items-center gap-1.5 @(record.Status == "Present" ? "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20" : record.Status == "Late" ? "bg-amber-500/10 text-amber-500 border border-amber-500/20" : "bg-rose-500/10 text-rose-500 border border-rose-500/20")">
                                        <span class="w-1.5 h-1.5 rounded-full @(record.Status == "Present" ? "bg-emerald-500" : record.Status == "Late" ? "bg-amber-500" : "bg-rose-500")"></span>
                                        @record.Status
                                    </span>
                                </td>

                                <!-- NOTES -->
                                <td class="p-4 text-zinc-500">
                                    <input type="text" name="notes[@memberKey]" value="@record.Notes" placeholder="Add note..." class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-lg px-2.5 py-1.5 text-xs text-zinc-800 dark:text-zinc-100 focus:outline-none focus:border-lime-500" />
                                </td>

                                <!-- ACTIONS -->
                                <td class="p-4 text-right space-x-1">
                                    <button type="button"
                                            id="btn_present_@memberKey"
                                            onclick="setStatus('@memberKey', 'Present')"
                                            class="px-2.5 py-1 rounded-lg transition cursor-pointer @(record.Status == "Present" ? "bg-emerald-500 text-white font-bold shadow-sm shadow-emerald-500/30" : "bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-emerald-500 hover:text-white")">
                                        Present
                                    </button>

                                    <button type="button"
                                            id="btn_absent_@memberKey"
                                            onclick="setStatus('@memberKey', 'Absent')"
                                            class="px-2.5 py-1 rounded-lg transition cursor-pointer @(record.Status == "Absent" ? "bg-rose-500 text-white font-bold shadow-sm shadow-rose-500/30" : "bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-rose-500 hover:text-white")">
                                        Absent
                                    </button>

                                    <button type="button"
                                            id="btn_late_@memberKey"
                                            onclick="setStatus('@memberKey', 'Late')"
                                            class="px-2.5 py-1 rounded-lg transition cursor-pointer @(record.Status == "Late" ? "bg-amber-500 text-white font-bold shadow-sm shadow-amber-500/30" : "bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-amber-500 hover:text-white")">
                                        Late
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-zinc-400">
                                <div class="flex flex-col items-center gap-2">
                                    <i class="fas fa-users-slash text-2xl"></i>
                                    <span>No members found for this class and date.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

<script>
    function setStatus(memberId, status) {
        // Update hidden input
        const input = document.getElementById('status_' + memberId);
        if (input) {
            input.value = status;
        }

        // Update badge UI
        const badge = document.getElementById('badge_' + memberId);
        if (badge) {
            let badgeClass = "";
            let dotClass = "";

            if (status === "Present") {
                badgeClass = "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20";
                dotClass = "bg-emerald-500";
            } else if (status === "Late") {
                badgeClass = "bg-amber-500/10 text-amber-500 border border-amber-500/20";
                dotClass = "bg-amber-500";
            } else {
                badgeClass = "bg-rose-500/10 text-rose-500 border border-rose-500/20";
                dotClass = "bg-rose-500";
            }

            badge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold inline-flex items-center gap-1.5 " + badgeClass;
            badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${dotClass}"></span> ${status}`;
        }

        // Update Action Buttons Active States dynamically
        const btnPresent = document.getElementById('btn_present_' + memberId);
        const btnAbsent = document.getElementById('btn_absent_' + memberId);
        const btnLate = document.getElementById('btn_late_' + memberId);

        const inactiveClasses = "bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300";

        // Reset all buttons to default look
        if (btnPresent) btnPresent.className = `px-2.5 py-1 rounded-lg transition cursor-pointer ${inactiveClasses} hover:bg-emerald-500 hover:text-white`;
        if (btnAbsent) btnAbsent.className = `px-2.5 py-1 rounded-lg transition cursor-pointer ${inactiveClasses} hover:bg-rose-500 hover:text-white`;
        if (btnLate) btnLate.className = `px-2.5 py-1 rounded-lg transition cursor-pointer ${inactiveClasses} hover:bg-amber-500 hover:text-white`;

        // Highlight the selected button
        if (status === "Present" && btnPresent) {
            btnPresent.className = "px-2.5 py-1 rounded-lg transition cursor-pointer bg-emerald-500 text-white font-bold shadow-sm shadow-emerald-500/30";
        } else if (status === "Absent" && btnAbsent) {
            btnAbsent.className = "px-2.5 py-1 rounded-lg transition cursor-pointer bg-rose-500 text-white font-bold shadow-sm shadow-rose-500/30";
        } else if (status === "Late" && btnLate) {
            btnLate.className = "px-2.5 py-1 rounded-lg transition cursor-pointer bg-amber-500 text-white font-bold shadow-sm shadow-amber-500/30";
        }
    }

    function submitSaveForm() {
        document.getElementById('saveForm').submit();
    }
</script>