@{
    ViewData["Title"] = "My Performance Overview";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-4 md:p-6 bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors duration-200">

    <!-- Header & Top Actions -->
    <div class="mb-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
                My Performance Overview
            </h1>
            <p class="text-zinc-500 dark:text-zinc-400 text-xs md:text-sm mt-0.5">
                Track your personal training achievements, session rates, class turnouts, and member activity.
            </p>
        </div>

        <!-- Export Buttons -->
        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="window.print()" class="bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-bold px-3.5 py-2 rounded-xl transition text-xs md:text-sm flex items-center gap-2 cursor-pointer">
                <i class="fa-solid fa-print"></i>
                Print
            </button>

            <button type="button" onclick="exportPDF()" class="bg-rose-500 hover:bg-rose-400 text-white font-bold px-3.5 py-2 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm cursor-pointer">
                <i class="fa-solid fa-file-pdf"></i>
                Export PDF
            </button>

            <button type="button" onclick="exportExcel()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3.5 py-2 rounded-xl transition text-xs md:text-sm flex items-center gap-2 shadow-sm cursor-pointer">
                <i class="fa-solid fa-file-excel"></i>
                Export Excel
            </button>
        </div>
    </div>

    <!-- Section 1: Statistics Overview -->
    <div class="mb-6">
        <h2 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-3">Statistics</h2>
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">

            <!-- Classes Taught -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Classes Taught</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">42</h3>
                    <div class="w-9 h-9 rounded-xl bg-lime-500/20 text-lime-600 dark:text-lime-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>
                </div>
            </div>

            <!-- Attendance Rate -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Attendance Rate</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">88.5%</h3>
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
            </div>

            <!-- Active Members -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Active Members</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">38</h3>
                    <div class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>

            <!-- Average Rating -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Average Rating</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-amber-500">4.9 / 5.0</h3>
                    <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-500 flex items-center justify-center text-base">
                        <i class="fa-solid fa-star"></i>
                    </div>
                </div>
            </div>

            <!-- Session Completion Rate -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm col-span-2 lg:col-span-1">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Session Completion</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-emerald-500">94.2%</h3>
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Section 2: Weekly & Monthly Performance Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

        <!-- Weekly Performance -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 md:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-calendar-week text-lime-500"></i> Weekly Performance
                </h3>
                <span class="text-xs text-zinc-400">Current Week</span>
            </div>
            <div class="space-y-2.5">
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Sessions Conducted</span>
                    <span class="font-bold text-zinc-900 dark:text-white">12 Sessions</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Average Turnout Rate</span>
                    <span class="font-bold text-lime-600 dark:text-lime-400">91%</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Hours Coached</span>
                    <span class="font-bold text-zinc-900 dark:text-white">18.5 Hours</span>
                </div>
            </div>
        </div>

        <!-- Monthly Performance -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 md:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-calendar-days text-cyan-500"></i> Monthly Performance
                </h3>
                <span class="text-xs text-zinc-400">August 2026</span>
            </div>
            <div class="space-y-2.5">
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Total Assigned Classes</span>
                    <span class="font-bold text-zinc-900 dark:text-white">48 Classes</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Completed Sessions</span>
                    <span class="font-bold text-emerald-500">45 (93.7%)</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Member Satisfaction</span>
                    <span class="font-bold text-amber-500">98% Positive</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Section 3: Class Performance & Attendance Summary -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">

        <!-- Class Performance Table (7 Cols) -->
        <div class="lg:col-span-7 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-zinc-200 dark:border-zinc-800">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Class Performance</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-zinc-50/50 dark:bg-zinc-800/30 border-b border-zinc-200 dark:border-zinc-800 font-bold uppercase tracking-wider text-zinc-400 text-[10px]">
                            <th class="py-3 px-4">Class</th>
                            <th class="py-3 px-4">Attendance</th>
                            <th class="py-3 px-4 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-semibold text-zinc-800 dark:text-zinc-200">
                        <tr>
                            <td class="py-3 px-4">Morning HIIT</td>
                            <td class="py-3 px-4 text-lime-600 dark:text-lime-400 font-bold">92%</td>
                            <td class="py-3 px-4 text-right">
                                <span class="px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">Excellent</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4">Strength Training</td>
                            <td class="py-3 px-4 text-cyan-600 dark:text-cyan-400 font-bold">85%</td>
                            <td class="py-3 px-4 text-right">
                                <span class="px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-lime-500/20 text-lime-600 dark:text-lime-400 border border-lime-500/30">Good</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4">CrossFit</td>
                            <td class="py-3 px-4 text-amber-500 font-bold">78%</td>
                            <td class="py-3 px-4 text-right">
                                <span class="px-2.5 py-1 rounded-md text-[10px] font-extrabold bg-amber-500/20 text-amber-500 border border-amber-500/30">Average</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Attendance Summary Table (5 Cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-zinc-200 dark:border-zinc-800">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Attendance Summary</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-zinc-50/50 dark:bg-zinc-800/30 border-b border-zinc-200 dark:border-zinc-800 font-bold uppercase tracking-wider text-zinc-400 text-[10px]">
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4 text-right">Sessions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-semibold text-zinc-800 dark:text-zinc-200">
                        <tr>
                            <td class="py-3 px-4 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Present
                            </td>
                            <td class="py-3 px-4 text-right font-bold text-emerald-600 dark:text-emerald-400">272</td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Late
                            </td>
                            <td class="py-3 px-4 text-right font-bold text-amber-500">44</td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Absent
                            </td>
                            <td class="py-3 px-4 text-right font-bold text-rose-500">24</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Section 4: Most Active Members -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 md:p-5 shadow-sm mb-6">
        <h3 class="text-sm font-bold text-zinc-900 dark:text-white mb-3 flex items-center gap-2">
            <i class="fa-solid fa-fire text-amber-500"></i> Most Active Members
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="flex items-center gap-3 p-3 bg-zinc-50 dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800">
                <div class="w-9 h-9 rounded-full bg-lime-500/20 text-lime-700 dark:text-lime-400 font-extrabold flex items-center justify-center text-xs">
                    AA
                </div>
                <div>
                    <h4 class="text-xs font-bold text-zinc-900 dark:text-white">Ahmed Ali Hassan</h4>
                    <p class="text-[11px] font-semibold text-lime-600 dark:text-lime-400">24 Sessions Completed</p>
                </div>
            </div>

            <div class="flex items-center gap-3 p-3 bg-zinc-50 dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800">
                <div class="w-9 h-9 rounded-full bg-cyan-500/20 text-cyan-700 dark:text-cyan-400 font-extrabold flex items-center justify-center text-xs">
                    LK
                </div>
                <div>
                    <h4 class="text-xs font-bold text-zinc-900 dark:text-white">Layla Khalid Mohamed</h4>
                    <p class="text-[11px] font-semibold text-cyan-600 dark:text-cyan-400">21 Sessions Completed</p>
                </div>
            </div>

            <div class="flex items-center gap-3 p-3 bg-zinc-50 dark:bg-zinc-950 rounded-xl border border-zinc-200 dark:border-zinc-800">
                <div class="w-9 h-9 rounded-full bg-purple-500/20 text-purple-700 dark:text-purple-400 font-extrabold flex items-center justify-center text-xs">
                    HN
                </div>
                <div>
                    <h4 class="text-xs font-bold text-zinc-900 dark:text-white">Hassan Nur Jama</h4>
                    <p class="text-[11px] font-semibold text-purple-600 dark:text-purple-400">19 Sessions Completed</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 5: Member Progress Table -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-4 border-b border-zinc-200 dark:border-zinc-800">
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Member Progress</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-zinc-50/50 dark:bg-zinc-800/30 border-b border-zinc-200 dark:border-zinc-800 font-bold uppercase tracking-wider text-zinc-400 text-[10px]">
                        <th class="py-3.5 px-4">Member</th>
                        <th class="py-3.5 px-4">Program</th>
                        <th class="py-3.5 px-4">Attendance</th>
                        <th class="py-3.5 px-4 text-center">Progress</th>
                        <th class="py-3.5 px-4 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-semibold text-zinc-800 dark:text-zinc-200">
                    <tr>
                        <td class="py-4 px-4 font-bold text-zinc-900 dark:text-white">Ahmed Ali Hassan</td>
                        <td class="py-4 px-4 text-zinc-600 dark:text-zinc-400">Strength Training</td>
                        <td class="py-4 px-4 text-emerald-600 dark:text-emerald-400 font-bold">95%</td>
                        <td class="py-4 px-4 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <div class="w-20 h-2 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
                                    <div class="h-full bg-lime-500 rounded-full" style="width: 75%;"></div>
                                </div>
                                <span class="font-bold text-xs">75%</span>
                            </div>
                        </td>
                        <td class="py-4 px-4 text-right">
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">On Track</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="py-4 px-4 font-bold text-zinc-900 dark:text-white">Layla Khalid Mohamed</td>
                        <td class="py-4 px-4 text-zinc-600 dark:text-zinc-400">HIIT Program</td>
                        <td class="py-4 px-4 text-emerald-600 dark:text-emerald-400 font-bold">90%</td>
                        <td class="py-4 px-4 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <div class="w-20 h-2 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
                                    <div class="h-full bg-emerald-500 rounded-full" style="width: 100%;"></div>
                                </div>
                                <span class="font-bold text-xs">100%</span>
                            </div>
                        </td>
                        <td class="py-4 px-4 text-right">
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-lime-500/20 text-lime-600 dark:text-lime-400 border border-lime-500/30">Completed</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="py-4 px-4 font-bold text-zinc-900 dark:text-white">Mohamed Farah Said</td>
                        <td class="py-4 px-4 text-zinc-600 dark:text-zinc-400">Weight Loss</td>
                        <td class="py-4 px-4 text-amber-500 font-bold">70%</td>
                        <td class="py-4 px-4 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <div class="w-20 h-2 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
                                    <div class="h-full bg-amber-500 rounded-full" style="width: 25%;"></div>
                                </div>
                                <span class="font-bold text-xs">25%</span>
                            </div>
                        </td>
                        <td class="py-4 px-4 text-right">
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-500/20 text-amber-500 border border-amber-500/30">Needs Attention</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Export Script Placeholders -->
<script type="text/javascript">
    function exportPDF() {
        alert("Exporting My Performance Overview to PDF...");
    }

    function exportExcel() {
        alert("Exporting My Performance Overview to Excel...");
    }
</script>