@model IEnumerable<GymManagementSystem.Models.ClassSchedule>

@{
    ViewData["Title"] = "My Performance Overview";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";

    var today = DateTime.Today;
    var currentWeekSchedules = Model?.Where(s => s.Date >= today.AddDays(-7) && s.Date <= today).ToList() ?? new List<GymManagementSystem.Models.ClassSchedule>();
    var monthlySchedules = Model?.Where(s => s.Date.Month == today.Month && s.Date.Year == today.Year).ToList() ?? new List<GymManagementSystem.Models.ClassSchedule>();

    int totalClasses = Model?.Count() ?? 0;
    int completedClasses = Model?.Count(s => s.Status == "Completed") ?? 0;
    double completionRate = totalClasses > 0 ? Math.Round((double)completedClasses / totalClasses * 100, 1) : 0;
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="p-4 md:p-6 bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 min-h-screen transition-colors duration-200">

    <!-- Header & Top Actions -->
    <div class="mb-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
                My Performance Overview
            </h1>
            <p class="text-zinc-500 dark:text-zinc-400 text-xs md:text-sm mt-0.5">
                Track your personal training achievements, session rates, class turnouts, and member activity.
            </p>
        </div>

       </div>

    <!-- Section 1: Statistics Overview -->
    <div class="mb-6">
        <h2 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-3">Statistics</h2>
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">

            <!-- Classes Taught -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Classes Taught</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">@completedClasses</h3>
                    <div class="w-9 h-9 rounded-xl bg-lime-500/20 text-lime-600 dark:text-lime-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>
                </div>
            </div>

            <!-- Attendance Rate -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Attendance Rate</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">@ViewBag.AttendanceRate%</h3>
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
            </div>

            <!-- Active Members -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Total Capacity</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">@(Model?.Sum(s => s.Capacity) ?? 0)</h3>
                    <div class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-600 dark:text-purple-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>

            <!-- Average Rating -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Average Rating</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-amber-500">@ViewBag.AverageRating / 5.0</h3>
                    <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-500 flex items-center justify-center text-base">
                        <i class="fa-solid fa-star"></i>
                    </div>
                </div>
            </div>

            <!-- Session Completion Rate -->
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm col-span-2 lg:col-span-1">
                <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase">Session Completion</p>
                <div class="flex items-center justify-between mt-1">
                    <h3 class="text-2xl font-bold text-emerald-500">@completionRate%</h3>
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Section 2: Weekly & Monthly Performance Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

        <!-- Weekly Performance -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 md:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-calendar-week text-lime-500"></i> Weekly Performance
                </h3>
                <span class="text-xs text-zinc-400">Current Week</span>
            </div>
            <div class="space-y-2.5">
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Sessions Conducted</span>
                    <span class="font-bold text-zinc-900 dark:text-white">@currentWeekSchedules.Count Sessions</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Completed This Week</span>
                    <span class="font-bold text-lime-600 dark:text-lime-400">@currentWeekSchedules.Count(s => s.Status == "Completed") Classes</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Total Weekly Capacity</span>
                    <span class="font-bold text-zinc-900 dark:text-white">@currentWeekSchedules.Sum(s => s.Capacity) Slots</span>
                </div>
            </div>
        </div>

        <!-- Monthly Performance -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 md:p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-calendar-days text-cyan-500"></i> Monthly Performance
                </h3>
                <span class="text-xs text-zinc-400">@DateTime.Now.ToString("MMMM yyyy")</span>
            </div>
            <div class="space-y-2.5">
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Total Assigned Classes</span>
                    <span class="font-bold text-zinc-900 dark:text-white">@monthlySchedules.Count Classes</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Completed Sessions</span>
                    <span class="font-bold text-emerald-500">@monthlySchedules.Count(s => s.Status == "Completed") Finished</span>
                </div>
                <div class="flex justify-between items-center text-xs p-2.5 bg-zinc-50 dark:bg-zinc-950 rounded-xl">
                    <span class="font-medium text-zinc-600 dark:text-zinc-400">Member Satisfaction</span>
                    <span class="font-bold text-amber-500">@(ViewBag.SatisfactionRate > 0 ? ViewBag.SatisfactionRate + "% Positive" : "N/A")</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Section 3: Class Performance & Attendance Summary -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">

        <!-- Class Performance Table (7 Cols) -->
        <div class="lg:col-span-7 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-zinc-200 dark:border-zinc-800">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Class Performance (Database)</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-zinc-50/50 dark:bg-zinc-800/30 border-b border-zinc-200 dark:border-zinc-800 font-bold uppercase tracking-wider text-zinc-400 text-[10px]">
                            <th class="py-3 px-4">Class Name</th>
                            <th class="py-3 px-4">Location</th>
                            <th class="py-3 px-4 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-semibold text-zinc-800 dark:text-zinc-200">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model.Take(5))
                            {
                                <tr>
                                    <td class="py-3 px-4">@item.ClassName</td>
                                    <td class="py-3 px-4 text-zinc-500">@item.Location</td>
                                    <td class="py-3 px-4 text-right">
                                        <span class="px-2.5 py-1 rounded-md text-[10px] font-extrabold @(item.Status == "Completed" ? "bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30" : "bg-lime-500/20 text-lime-600 dark:text-lime-400 border border-lime-500/30")">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-zinc-400">No records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Attendance Summary Table (5 Cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-zinc-200 dark:border-zinc-800">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Attendance Summary</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-zinc-50/50 dark:bg-zinc-800/30 border-b border-zinc-200 dark:border-zinc-800 font-bold uppercase tracking-wider text-zinc-400 text-[10px]">
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4 text-right">Sessions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-semibold text-zinc-800 dark:text-zinc-200">
                        <tr>
                            <td class="py-3 px-4 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Present / Completed
                            </td>
                            <td class="py-3 px-4 text-right font-bold text-emerald-600 dark:text-emerald-400">@completedClasses</td>
                        </tr>
                        <tr>
                            <td class="py-3 px-4 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Scheduled
                            </td>
                            <td class="py-3 px-4 text-right font-bold text-amber-500">@(totalClasses - completedClasses)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>

<!-- Export Script Placeholders -->
<script type="text/javascript">
    function exportPDF() {
        alert("Exporting My Performance Overview to PDF...");
    }

    function exportExcel() {
        alert("Exporting My Performance Overview to Excel...");
    }
</script>
