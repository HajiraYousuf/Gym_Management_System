@{
    ViewData["Title"] = "Trainer Members";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="space-y-6 min-h-screen bg-gray-50 dark:bg-black text-gray-800 dark:text-gray-100 p-2 sm:p-4 transition-colors duration-300">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-200 dark:border-zinc-800 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-wider mb-0.5">
                <span>Trainer Module</span> • <span>Trainees</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">My Members</h1>
            <p class="text-xs sm:text-sm text-gray-500 dark:text-zinc-400 mt-1">Manage assigned trainees, workout routines, and nutrition plans.</p>
        </div>

        <!-- Action Button -->
        <div>
            <button type="button" class="bg-lime-400 hover:bg-lime-500 text-black font-extrabold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg shadow-lime-500/20 transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-user-plus"></i> Assign New Member
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Total Members -->
        <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-users"></i>
                </div>
                <span class="text-xs font-mono font-bold text-gray-400">Total</span>
            </div>
            <h3 class="text-2xl font-black text-gray-900 dark:text-white font-mono">24</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1">Total Assigned Members</p>
        </div>

        <!-- Active Today -->
        <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-user-check"></i>
                </div>
                <span class="text-xs font-mono font-bold text-lime-600 dark:text-lime-400">Online</span>
            </div>
            <h3 class="text-2xl font-black text-gray-900 dark:text-white font-mono">18</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1">Active Today</p>
        </div>

        <!-- Pending Workout Plans -->
        <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-dumbbell"></i>
                </div>
                <span class="text-xs font-mono font-bold text-amber-500">Pending</span>
            </div>
            <h3 class="text-2xl font-black text-gray-900 dark:text-white font-mono">5</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1">Pending Workout Plans</p>
        </div>

        <!-- Pending Nutrition Plans -->
        <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-utensils"></i>
                </div>
                <span class="text-xs font-mono font-bold text-purple-500">Pending</span>
            </div>
            <h3 class="text-2xl font-black text-gray-900 dark:text-white font-mono">3</h3>
            <p class="text-xs text-gray-500 dark:text-zinc-400 mt-1">Pending Nutrition Plans</p>
        </div>

    </div>

    <!-- Filter & Search Bar Section -->
    <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm flex flex-col md:flex-row gap-3 justify-between items-center">
        <!-- Search Input -->
        <div class="relative w-full md:w-80">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400">
                <i class="fas fa-search text-xs"></i>
            </span>
            <input type="text" placeholder="Search by member name..." class="w-full pl-10 pr-4 py-2 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-gray-100 focus:outline-none focus:border-lime-500 transition-all font-medium" />
        </div>

        <!-- Filters Dropdown Group -->
        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
            <!-- Status Filter -->
            <select class="px-3 py-2 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-700 dark:text-zinc-300 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                <option value="">All Statuses</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>

            <!-- Goal Filter -->
            <select class="px-3 py-2 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-700 dark:text-zinc-300 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                <option value="">All Goals</option>
                <option value="muscle">Muscle Gain</option>
                <option value="fatloss">Fat Loss</option>
                <option value="endurance">Endurance</option>
            </select>
        </div>
    </div>

    <!-- Members Table Section -->
    <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600 dark:text-zinc-300">
                <thead class="bg-gray-50 dark:bg-black text-gray-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider border-b border-gray-200 dark:border-zinc-800">
                    <tr>
                        <th class="p-4">Member</th>
                        <th class="p-4">Goal</th>
                        <th class="p-4">Workout Plan</th>
                        <th class="p-4">Nutrition Plan</th>
                        <th class="p-4">Attendance</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-zinc-800 text-xs">

                    <!-- Row 1 -->
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-zinc-800/50 transition-colors">
                        <td class="p-4 flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 font-bold flex items-center justify-center text-xs">
                                AA
                            </div>
                            <div>
                                <span class="font-bold text-gray-900 dark:text-white block">Ahmed Ali</span>
                                <span class="text-[11px] text-gray-400 font-mono">MEM-8821</span>
                            </div>
                        </td>
                        <td class="p-4 font-medium text-gray-700 dark:text-zinc-300">Muscle Gain</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Assigned</span>
                        </td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">Pending</span>
                        </td>
                        <td class="p-4 font-mono font-bold text-gray-800 dark:text-zinc-200">5 Days/wk</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 font-bold rounded-full bg-lime-400/20 text-lime-600 dark:text-lime-400">Active</span>
                        </td>
                        <td class="p-4 text-right space-x-1.5">
                            <button type="button" onclick="openProgressModal('Ahmed Ali', 'MEM-8821')" title="Add Progress" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-chart-line text-xs"></i>
                            </button>
                            <button type="button" onclick="openDetailModal('Ahmed Ali', 'MEM-8821', 'Muscle Gain', '82.5 kg', '14.5%', '24.1', '38.0 kg', 'Horumar fiican ayaa ka muuqda!', 'September 01, 2026')" title="View Details" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-eye text-xs"></i>
                            </button>
                            <button title="Edit Routine" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-dumbbell text-xs"></i>
                            </button>
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-zinc-800/50 transition-colors">
                        <td class="p-4 flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-blue-500/20 text-blue-500 font-bold flex items-center justify-center text-xs">
                                MO
                            </div>
                            <div>
                                <span class="font-bold text-gray-900 dark:text-white block">Mohamed Omar</span>
                                <span class="text-[11px] text-gray-400 font-mono">MEM-8822</span>
                            </div>
                        </td>
                        <td class="p-4 font-medium text-gray-700 dark:text-zinc-300">Fat Loss</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">Pending</span>
                        </td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Assigned</span>
                        </td>
                        <td class="p-4 font-mono font-bold text-gray-800 dark:text-zinc-200">3 Days/wk</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 font-bold rounded-full bg-lime-400/20 text-lime-600 dark:text-lime-400">Active</span>
                        </td>
                        <td class="p-4 text-right space-x-1.5">
                            <button type="button" onclick="openProgressModal('Mohamed Omar', 'MEM-8822')" title="Add Progress" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-chart-line text-xs"></i>
                            </button>
                            <button type="button" onclick="openDetailModal('Mohamed Omar', 'MEM-8822', 'Fat Loss', '76.0 kg', '18.2%', '26.4', '32.5 kg', 'Joogtee dadaalkaaga cuntada.', 'September 03, 2026')" title="View Details" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-eye text-xs"></i>
                            </button>
                            <button title="Edit Routine" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-dumbbell text-xs"></i>
                            </button>
                        </td>
                    </tr>

                    <!-- Row 3 -->
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-zinc-800/50 transition-colors">
                        <td class="p-4 flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-500 font-bold flex items-center justify-center text-xs">
                                FH
                            </div>
                            <div>
                                <span class="font-bold text-gray-900 dark:text-white block">Fadumo Hassan</span>
                                <span class="text-[11px] text-gray-400 font-mono">MEM-8823</span>
                            </div>
                        </td>
                        <td class="p-4 font-medium text-gray-700 dark:text-zinc-300">Endurance</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Assigned</span>
                        </td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20">Assigned</span>
                        </td>
                        <td class="p-4 font-mono font-bold text-gray-800 dark:text-zinc-200">4 Days/wk</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 font-bold rounded-full bg-gray-200 dark:bg-zinc-800 text-gray-700 dark:text-zinc-300">Inactive</span>
                        </td>
                        <td class="p-4 text-right space-x-1.5">
                            <button type="button" onclick="openProgressModal('Fadumo Hassan', 'MEM-8823')" title="Add Progress" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-chart-line text-xs"></i>
                            </button>
                            <button type="button" onclick="openDetailModal('Fadumo Hassan', 'MEM-8823', 'Endurance', '64.0 kg', '21.0%', '22.8', '27.0 kg', 'Waxa ay leedahay adkeysi wanaagsan.', 'September 05, 2026')" title="View Details" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-eye text-xs"></i>
                            </button>
                            <button title="Edit Routine" class="p-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-dumbbell text-xs"></i>
                            </button>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-gray-100 dark:border-zinc-800 text-xs">
            <span class="text-gray-500 dark:text-zinc-400 font-medium">Showing members list (1 to 3 of 24 entries)</span>

            <div class="flex items-center gap-2">
                <button type="button" class="px-3.5 py-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 font-bold transition-all cursor-pointer">
                    Previous
                </button>
                <button type="button" class="px-3.5 py-2 rounded-xl bg-gray-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-gray-700 dark:text-zinc-300 font-bold transition-all cursor-pointer">
                    Next
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ADD PROGRESS MODAL -->
<div id="addProgressModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden p-4">
    <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-200">
        <div class="flex justify-between items-center p-5 border-b border-gray-100 dark:border-zinc-800">
            <div>
                <span class="text-[10px] font-bold text-lime-600 dark:text-lime-400 uppercase tracking-widest">Trainee Metric Logger</span>
                <h3 id="modalMemberName" class="text-base font-bold text-gray-900 dark:text-white">Add Progress</h3>
            </div>
            <button type="button" onclick="closeProgressModal()" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-zinc-800 hover:bg-rose-500 hover:text-white text-gray-500 flex items-center justify-center transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Weight (kg)</label>
                    <input type="number" step="0.1" placeholder="e.g. 75.5" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Body Fat (%)</label>
                    <input type="number" step="0.1" placeholder="e.g. 15.2" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium" />
                </div>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Chest (cm)</label>
                    <input type="number" step="0.1" placeholder="Chest" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Waist (cm)</label>
                    <input type="number" step="0.1" placeholder="Waist" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Arms (cm)</label>
                    <input type="number" step="0.1" placeholder="Arms" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Trainer's Assessment & Notes</label>
                <textarea rows="3" placeholder="Horumar fiican ayaa ka muuqda..." class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium"></textarea>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 dark:text-zinc-300 mb-1">Next Body Check Date</label>
                <input type="date" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-black border border-gray-200 dark:border-zinc-800 rounded-xl text-xs text-gray-900 dark:text-white focus:outline-none focus:border-lime-500 font-medium" />
            </div>
        </div>
        <div class="flex items-center justify-end gap-3 p-4 bg-gray-50 dark:bg-black/50 border-t border-gray-100 dark:border-zinc-800">
            <button type="button" onclick="closeProgressModal()" class="px-4 py-2 rounded-xl bg-gray-200 dark:bg-zinc-800 text-gray-700 dark:text-zinc-300 text-xs font-bold hover:bg-gray-300 dark:hover:bg-zinc-700 transition cursor-pointer">Cancel</button>
            <button type="button" onclick="saveProgress()" class="px-5 py-2 rounded-xl bg-lime-400 hover:bg-lime-500 text-black text-xs font-black shadow-md shadow-lime-500/20 transition cursor-pointer">Save Progress</button>
        </div>
    </div>
</div>


<!-- Modal Control JavaScript -->
<script type="text/javascript">
    function openProgressModal(name, id) {
        document.getElementById('modalMemberName').innerText = "Add Progress for " + name + " (" + id + ")";
        document.getElementById('addProgressModal').classList.remove('hidden');
    }

    function closeProgressModal() {
        document.getElementById('addProgressModal').classList.add('hidden');
    }

    function saveProgress() {
        alert("Progress metrics saved successfully!");
        closeProgressModal();
    }


</script>