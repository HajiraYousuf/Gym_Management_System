@model IEnumerable<GymManagementSystem.Models.WorkoutPlan>

@{
    ViewData["Title"] = "Workout Plans";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";

    var membersList = ViewBag.MembersList as List<GymManagementSystem.Models.UserProfile> ?? new List<GymManagementSystem.Models.UserProfile>();
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="space-y-6 min-h-screen bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 p-4 md:p-6 transition-colors duration-300">

    <!-- TempData Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-lime-400/20 border border-lime-500/30 text-lime-600 dark:text-lime-400 text-xs font-bold">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-500 text-xs font-bold">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-200 dark:border-zinc-800 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-wider mb-0.5">
                <span>Trainer Module</span> • <span>Workout Management</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">Workout Plans</h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">Create, assign, and manage custom workout routines for your members.</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <button type="button" onclick="openAssignModal()" class="bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-extrabold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-user-plus"></i> Assign Member
            </button>
            <button type="button" onclick="openAddModal()" class="bg-lime-400 hover:bg-lime-500 text-black font-extrabold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg shadow-lime-500/20 transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-plus"></i> Create Workout Plan
            </button>

        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-dumbbell"></i>
                </div>
                <span class="text-xs font-mono font-bold text-zinc-400">Total</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">@ViewBag.TotalPlans</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Active Workout Routines</p>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-clipboard-user"></i>
                </div>
                <span class="text-xs font-mono font-bold text-blue-500">Assigned</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">@ViewBag.AssignedCount</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Assigned to Trainees</p>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-fire"></i>
                </div>
                <span class="text-xs font-mono font-bold text-purple-500">Popular</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">@ViewBag.HypertrophyCount</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Hypertrophy Plans</p>
        </div>

        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-chart-line"></i>
                </div>
                <span class="text-xs font-mono font-bold text-amber-500">Avg</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">88%</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Adherence Rate</p>
        </div>
    </div>

    <!-- Filter & Search Section -->
    <form method="get" asp-action="WorkoutPlans" class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm flex flex-col md:flex-row gap-3 justify-between items-center">
        <div class="relative w-full md:w-80">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-zinc-400">
                <i class="fas fa-search text-xs"></i>
            </span>
            <input type="text" name="search" placeholder="Search workout plan name..." value="@Context.Request.Query["search"]" class="w-full pl-10 pr-4 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-lime-500 transition-all font-medium" />
        </div>

        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
            <select name="goalFilter" onchange="this.form.submit()" class="px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-700 dark:text-zinc-300 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                <option value="">All Goals</option>
                <option value="muscle">Muscle Building</option>
                <option value="weightloss">Weight Loss</option>
                <option value="strength">Strength</option>
                <option value="endurance">Endurance</option>
            </select>

            <select name="levelFilter" onchange="this.form.submit()" class="px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-700 dark:text-zinc-300 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                <option value="">All Levels</option>
                <option value="beginner">Beginner</option>
                <option value="intermediate">Intermediate</option>
                <option value="advanced">Advanced</option>
            </select>
        </div>
    </form>

    <!-- Workout Plans Table -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-zinc-600 dark:text-zinc-300">
                <thead class="bg-zinc-50 dark:bg-zinc-950 text-zinc-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="p-4">Plan Name</th>
                        <th class="p-4">Target Goal</th>
                        <th class="p-4">Difficulty</th>
                        <th class="p-4">Duration</th>
                        <th class="p-4">Assigned Member</th>
                        <th class="p-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800 text-xs">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var plan in Model)
                        {
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/50 transition-colors">
                                <td class="p-4 flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 font-bold flex items-center justify-center text-xs">
                                        <i class="fas fa-dumbbell"></i>
                                    </div>
                                    <div>
                                        <span class="font-bold text-zinc-900 dark:text-white block">@plan.Title</span>
                                        <span class="text-[11px] text-zinc-400 font-mono">@plan.DaysPerWeek Days/wk • @plan.SessionDurationMinutes Min</span>
                                    </div>
                                </td>
                                <td class="p-4 font-medium text-zinc-700 dark:text-zinc-300">@plan.TargetGoal</td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">@plan.DifficultyLevel</span>
                                </td>
                                <td class="p-4 font-mono font-bold text-zinc-800 dark:text-zinc-200">@plan.DurationWeeks Weeks</td>
                                <td class="p-4 font-bold text-zinc-900 dark:text-white">@(string.IsNullOrEmpty(plan.AssignedMemberId) ? "Unassigned" : "#MEM-" + plan.AssignedMemberId)</td>
                                <!-- Table Action Column -->
                                <td class="p-4 text-right space-x-2">
                                    <!-- View -->
                                    <button type="button" onclick="openDetailModal('@plan.Id', '@plan.Title', ...)" class="...">
                                        <i class="fas fa-eye text-xs"></i>
                                    </button>
    
                                    <!-- Edit -->
                                    <button type="button" onclick="openEditModal(@plan.Id, '@plan.Title', '@plan.TargetGoal', '@plan.DifficultyLevel', @plan.DurationWeeks, @plan.DaysPerWeek, @plan.SessionDurationMinutes, '@plan.AssignedMemberId', '@plan.Notes')" title="Edit Plan" class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer">
                                        <i class="fas fa-pen text-xs"></i>
                                    </button>

                                    <!-- Delete -->
                                    <form asp-action="DeleteWorkoutPlan" method="post" class="inline-block" onsubmit="return confirm('Ma hubtaa in aad tirtirto plan-kan?');">
                                        <input type="hidden" name="id" value="@plan.Id" />
                                        <button type="submit" class="p-2 rounded-xl bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white transition-all">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-6 text-center text-zinc-400">No workout plans found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== ASSIGN WORKOUT PLAN MODAL ==================== -->
<div id="assignModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl my-8">
        <form asp-action="AssignWorkout" method="post">
            <div class="p-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between bg-zinc-50 dark:bg-zinc-950">
                <h3 class="text-lg font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-user-plus text-lime-500"></i> Assign Workout Plan
                </h3>
                <button type="button" onclick="closeAssignModal()" class="w-8 h-8 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-lime-400 hover:text-black flex items-center justify-center transition cursor-pointer">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto text-xs">
                <div>
                    <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Select Member <span class="text-rose-500">*</span></label>
                    <select name="memberId" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 cursor-pointer">
                        <option value="">Choose member...</option>
                        @foreach (var mem in membersList)
                        {
                            <option value="@mem.Id">@mem.Name (#MEM-@mem.Id)</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Select Workout Plan <span class="text-rose-500">*</span></label>
                    <select name="planId" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 cursor-pointer">
                        <option value="">Choose workout plan...</option>
                        @if (Model != null)
                        {
                            foreach (var p in Model)
                            {
                                <option value="@p.Id">@p.Title (@p.TargetGoal)</option>
                            }
                        }
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Start Date <span class="text-rose-500">*</span></label>
                        <input type="date" name="startDate" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 dark:[color-scheme:dark]" />
                    </div>
                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">End Date <span class="text-rose-500">*</span></label>
                        <input type="date" name="endDate" required class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 dark:[color-scheme:dark]" />
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Trainer Notes</label>
                    <textarea name="notes" rows="3" placeholder="Add specific instructions..." class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl p-3 focus:outline-none focus:border-lime-500 resize-none"></textarea>
                </div>
            </div>

            <div class="p-5 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-end gap-3 bg-zinc-50 dark:bg-zinc-950">
                <button type="button" onclick="closeAssignModal()" class="px-5 py-2.5 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-bold cursor-pointer text-xs">Cancel</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-lime-400 hover:bg-lime-500 text-black font-extrabold shadow-lg shadow-lime-500/20 cursor-pointer text-xs">Assign Plan</button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== CREATE WORKOUT PLAN MODAL ==================== -->
<!-- ==================== CREATE / EDIT WORKOUT PLAN MODAL ==================== -->
<div id="addModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl w-full max-w-3xl overflow-hidden shadow-2xl my-8">

        <!-- Fiiro gaar ah: asp-action waxaan ka dhignay 'SaveWorkoutPlan' si uu labadaba u qabto -->
        <form asp-action="SaveWorkoutPlan" method="post">

            <!-- Hidden ID Field: Haddii uu 0 yahay waa Create, haddii kale waa Edit -->
            <input type="hidden" name="Id" id="planId" value="0" />

            <!-- Modal Header -->
            <div class="flex justify-between items-center p-6 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
                <div>
                    <h2 id="modalHeaderTitle" class="text-xl font-black text-zinc-900 dark:text-white">Create Workout Plan</h2>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Select exercises from system library and assign workout routines to members.</p>
                </div>
                <button type="button" onclick="closeAddModal()" class="w-9 h-9 rounded-xl bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-lime-400 hover:text-black transition cursor-pointer">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <!-- Modal Body / Form -->
            <div class="p-6 space-y-6 max-h-[75vh] overflow-y-auto text-xs">

                <!-- Plan Information Group -->
                <div class="space-y-4">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800 pb-2">Plan Information</h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Plan Name *</label>
                            <input type="text" name="Title" id="planTitle" required placeholder="e.g. Advanced Hypertrophy Split" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                        </div>

                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Assign Member</label>
                            <select name="AssignedMemberId" id="planMember" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                                <option value="">Select Member...</option>
                                @foreach (var mem in membersList)
                                {
                                    <option value="@mem.Id">@mem.Name (#MEM-@mem.Id)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Target Goal</label>
                            <select name="TargetGoal" id="planGoal" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                                <option value="muscle">Muscle Building</option>
                                <option value="weightloss">Weight Loss</option>
                                <option value="strength">Strength</option>
                                <option value="endurance">Endurance</option>
                            </select>
                        </div>

                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Difficulty Level</label>
                            <select name="DifficultyLevel" id="planLevel" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                                <option value="beginner">Beginner</option>
                                <option value="intermediate">Intermediate</option>
                                <option value="advanced">Advanced</option>
                            </select>
                        </div>

                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Duration (Weeks)</label>
                            <input type="number" name="DurationWeeks" id="planDuration" value="4" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Days per Week</label>
                            <input type="number" name="DaysPerWeek" id="planDays" value="4" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                        </div>
                        <div>
                            <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Session Duration (Min)</label>
                            <input type="number" name="SessionDurationMinutes" id="planMinutes" value="60" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                        </div>
                    </div>
                </div>

                <!-- Routine & Trainer Notes Section -->
                <div class="space-y-3 pt-2">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800 pb-2">Routine Notes</h3>

                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Trainer Notes, Warm-up & Cool-down Instructions</label>
                        <textarea name="Notes" id="planNotes" rows="4" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500"></textarea>
                    </div>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="flex justify-end gap-3 p-6 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
                <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="saveButtonText" class="px-5 py-2.5 rounded-xl bg-lime-400 hover:bg-lime-500 text-black font-extrabold shadow-lg shadow-lime-500/20 transition cursor-pointer">
                    Save Workout Plan
                </button>
            </div>

        </form>
    </div>
</div>
<!-- ==================== VIEW WORKOUT PLAN DETAIL MODAL ==================== -->
<div id="detailModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl w-full max-w-3xl overflow-hidden shadow-2xl my-8">
        <div class="flex justify-between items-center p-6 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 flex items-center justify-center font-bold">
                    <i class="fas fa-dumbbell"></i>
                </div>
                <div>
                    <h2 id="modalTitle" class="text-xl font-black text-zinc-900 dark:text-white">Plan Details</h2>
                </div>
            </div>
            <button type="button" onclick="closeDetailModal()" class="w-9 h-9 rounded-xl bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-lime-400 hover:text-black transition cursor-pointer">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <div class="p-6 space-y-6 max-h-[75vh] overflow-y-auto text-xs">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800">
                <div>
                    <span class="text-[10px] font-bold text-zinc-400 uppercase">Target Goal</span>
                    <p id="modalGoal" class="font-bold text-zinc-900 dark:text-white mt-0.5">-</p>
                </div>
                <div>
                    <span class="text-[10px] font-bold text-zinc-400 uppercase">Difficulty Level</span>
                    <p id="modalLevel" class="font-bold text-amber-500 mt-0.5">-</p>
                </div>
                <div>
                    <span class="text-[10px] font-bold text-zinc-400 uppercase">Duration & Schedule</span>
                    <p id="modalDuration" class="font-bold text-zinc-900 dark:text-white mt-0.5">-</p>
                </div>
                <div>
                    <span class="text-[10px] font-bold text-zinc-400 uppercase">Session Time</span>
                    <p id="modalTime" class="font-bold text-zinc-900 dark:text-white mt-0.5">-</p>
                </div>
            </div>

            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800 space-y-2">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                    <i class="fas fa-clipboard-list text-lime-500"></i> Routine Notes
                </h3>
                <p id="modalNotes" class="text-zinc-600 dark:text-zinc-400 leading-relaxed">-</p>
            </div>
        </div>

        <div class="flex justify-end gap-3 p-6 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
            <button type="button" onclick="closeDetailModal()" class="px-5 py-2.5 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-bold transition cursor-pointer">Close</button>
        </div>
    </div>
</div>

<!-- Modal Control JavaScript -->
<script>
        function openAssignModal() { document.getElementById('assignModal').classList.remove('hidden'); }
        function closeAssignModal() { document.getElementById('assignModal').classList.add('hidden'); }

        function openDetailModal(title, goal, level, duration, time, notes) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalGoal').innerText = goal;
            document.getElementById('modalLevel').innerText = level;
        document.getElementById('modalDuration').innerText = duration;
        document.getElementById('modalTime').innerText = time;
        document.getElementById('modalNotes').innerText = notes || 'No special notes provided.';
        document.getElementById('detailModal').classList.remove('hidden');
        }
       function closeDetailModal() { document.getElementById('detailModal').classList.add('hidden'); }
       // 1. Marka la rabo in la abuuro plan cusub (Create)
function openAddModal() {
    document.getElementById('planId').value = 0; // 0 = New Record
    document.getElementById('modalHeaderTitle').innerText = "Create Workout Plan";
    document.getElementById('saveButtonText').innerText = "Save Workout Plan";
    
    // Nadiifi foomka
    document.getElementById('planTitle').value = "";
    document.getElementById('planMember').value = "";
    document.getElementById('planGoal').value = "muscle";
    document.getElementById('planLevel').value = "beginner";
    document.getElementById('planDuration').value = 4;
    document.getElementById('planDays').value = 4;
    document.getElementById('planMinutes').value = 60;
    document.getElementById('planNotes').placeholder = "Warm-up: 10 mins dynamic stretching. Cool-down: 5 mins static chest stretches.";

    document.getElementById('addModal').classList.remove('hidden');
}

// 2. Marka la rabo in wax laga beddelo plan jiray (Edit)
function openEditModal(id, title, goal, level, duration, days, minutes, memberId, notes) {
    document.getElementById('planId').value = id; // ID-ga saxda ah ee la tafatirayo
    document.getElementById('modalHeaderTitle').innerText = "Edit Workout Plan";
    document.getElementById('saveButtonText').innerText = "Update Workout Plan";

    // Buuxi foomka xogtiisa hore
    document.getElementById('planTitle').value = title;
    document.getElementById('planGoal').value = goal;
    document.getElementById('planLevel').value = level;
    document.getElementById('planDuration').value = duration;
    document.getElementById('planDays').value = days;
    document.getElementById('planMinutes').value = minutes;
    document.getElementById('planMember').value = memberId || "";
    document.getElementById('planNotes').value = notes || "";

    document.getElementById('addModal').classList.remove('hidden');
}

function closeAddModal() {
    document.getElementById('addModal').classList.add('hidden');
}
</script>