@{
    ViewData["Title"] = "Workout Plans";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="space-y-6 min-h-screen bg-zinc-50 dark:bg-zinc-950 text-zinc-800 dark:text-zinc-100 p-4 md:p-6 transition-colors duration-300">
    
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-200 dark:border-zinc-800 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-lime-600 dark:text-lime-400 uppercase tracking-wider mb-0.5">
                <span>Trainer Module</span> • <span>Workout Management</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">Workout Plans</h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">Create, assign, and manage custom workout routines for your members.</p>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <button type="button" onclick="openAssignModal()" class="bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-extrabold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-user-plus"></i> Assign Member
            </button>
            <button type="button" onclick="openAddModal()" class="bg-lime-400 hover:bg-lime-500 text-black font-extrabold px-4 py-2.5 rounded-xl flex items-center justify-center gap-2 text-sm shadow-lg shadow-lime-500/20 transition-all w-full sm:w-auto cursor-pointer">
                <i class="fas fa-plus"></i> Create Workout Plan
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Total Plans -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-lime-100 dark:bg-lime-400/10 text-lime-600 dark:text-lime-400 border border-lime-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-dumbbell"></i>
                </div>
                <span class="text-xs font-mono font-bold text-zinc-400">Total</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">18</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Active Workout Routines</p>
        </div>

        <!-- Assigned Plans -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-clipboard-user"></i>
                </div>
                <span class="text-xs font-mono font-bold text-blue-500">Assigned</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">14</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Assigned to Trainees</p>
        </div>

        <!-- Muscle Building -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-fire"></i>
                </div>
                <span class="text-xs font-mono font-bold text-purple-500">Popular</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">8</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Hypertrophy Plans</p>
        </div>

        <!-- Completion Rate -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5 shadow-sm">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center text-lg">
                    <i class="fas fa-chart-line"></i>
                </div>
                <span class="text-xs font-mono font-bold text-amber-500">Avg</span>
            </div>
            <h3 class="text-2xl font-black text-zinc-900 dark:text-white font-mono">88%</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Adherence Rate</p>
        </div>

    </div>

    <!-- Filter & Search Section -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm flex flex-col md:flex-row gap-3 justify-between items-center">
        <!-- Search Input -->
        <div class="relative w-full md:w-80">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-zinc-400">
                <i class="fas fa-search text-xs"></i>
            </span>
            <input type="text" placeholder="Search workout plan name..." class="w-full pl-10 pr-4 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-900 dark:text-zinc-100 focus:outline-none focus:border-lime-500 transition-all font-medium" />
        </div>

        <!-- Filters Dropdown Group -->
        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
            <select class="px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-700 dark:text-zinc-300 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                <option value="">All Goals</option>
                <option value="muscle">Muscle Building</option>
                <option value="weightloss">Weight Loss</option>
                <option value="strength">Strength</option>
                <option value="endurance">Endurance</option>
            </select>

            <select class="px-3 py-2 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-xs text-zinc-700 dark:text-zinc-300 focus:outline-none focus:border-lime-500 font-medium cursor-pointer">
                <option value="">All Levels</option>
                <option value="beginner">Beginner</option>
                <option value="intermediate">Intermediate</option>
                <option value="advanced">Advanced</option>
            </select>
        </div>
    </div>

    <!-- Workout Plans Table -->
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-zinc-600 dark:text-zinc-300">
                <thead class="bg-zinc-50 dark:bg-zinc-950 text-zinc-700 dark:text-zinc-400 uppercase text-[11px] font-bold tracking-wider border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="p-4">Plan Name</th>
                        <th class="p-4">Target Goal</th>
                        <th class="p-4">Difficulty</th>
                        <th class="p-4">Duration</th>
                        <th class="p-4">Assigned Member</th>
                        <th class="p-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800 text-xs">
                    
                    <!-- Row 1 -->
                    <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/50 transition-colors">
                        <td class="p-4 flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-lime-400/20 text-lime-600 dark:text-lime-400 font-bold flex items-center justify-center text-xs">
                                <i class="fas fa-dumbbell"></i>
                            </div>
                            <div>
                                <span class="font-bold text-zinc-900 dark:text-white block">Hypertrophy Upper Split</span>
                                <span class="text-[11px] text-zinc-400 font-mono">4 Days/wk • 60 Min</span>
                            </div>
                        </td>
                        <td class="p-4 font-medium text-zinc-700 dark:text-zinc-300">Muscle Building</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">Intermediate</span>
                        </td>
                        <td class="p-4 font-mono font-bold text-zinc-800 dark:text-zinc-200">4 Weeks</td>
                        <td class="p-4 font-bold text-zinc-900 dark:text-white">Ahmed Ali (#MEM-8801)</td>
                        <td class="p-4 text-right space-x-2">
                            <button type="button" onclick="openDetailModal()" title="View Plan Details" class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-eye text-xs"></i>
                            </button>
                            <button type="button" onclick="openAddModal()" title="Edit Plan" class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-4 border-t border-zinc-100 dark:border-zinc-800 text-xs">
            <span class="text-zinc-500 dark:text-zinc-400 font-medium">Showing workout plans (1 to 1 of 18 entries)</span>
            <div class="flex items-center gap-2">
                <button type="button" class="px-3.5 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-zinc-700 dark:text-zinc-300 font-bold transition-all cursor-pointer">Previous</button>
                <button type="button" class="px-3.5 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-lime-400 hover:text-black dark:hover:bg-lime-400 text-zinc-700 dark:text-zinc-300 font-bold transition-all cursor-pointer">Next</button>
            </div>
        </div>
    </div>

</div>

<!-- ==================== ASSIGN WORKOUT PLAN MODAL ==================== -->
<div id="assignModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl my-8">
        
        <!-- Modal Header -->
        <div class="p-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between bg-zinc-50 dark:bg-zinc-950">
            <h3 id="modalTitle" class="text-lg font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-user-plus text-lime-500"></i>
                <span>Assign Workout Plan</span>
            </h3>
            <button type="button" onclick="closeAssignModal()" class="w-8 h-8 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-lime-400 hover:text-black flex items-center justify-center transition cursor-pointer">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <!-- Modal Body / Form -->
        <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto text-xs">
            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Select Member <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <select class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 transition appearance-none cursor-pointer">
                        <option value="">Choose member...</option>
                        <option value="8801">Ahmed Ali (#MEM-8801)</option>
                        <option value="8802">Mohamed Omar (#MEM-8802)</option>
                        <option value="8803">Fadumo Hassan (#MEM-8803)</option>
                    </select>
                    <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none text-xs"></i>
                </div>
            </div>

            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Select Workout Plan <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <select class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-3 focus:outline-none focus:border-lime-500 transition appearance-none cursor-pointer">
                        <option value="">Choose workout plan...</option>
                        <option value="202">Hypertrophy Upper Split (Muscle Building)</option>
                        <option value="203">Shredded Fat Loss (Weight Loss)</option>
                    </select>
                    <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-zinc-400 pointer-events-none text-xs"></i>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Start Date <span class="text-rose-500">*</span></label>
                    <input type="date" class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition dark:[color-scheme:dark]" />
                </div>
                <div>
                    <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">End Date <span class="text-rose-500">*</span></label>
                    <input type="date" class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl px-4 py-2.5 focus:outline-none focus:border-lime-500 transition dark:[color-scheme:dark]" />
                </div>
            </div>

            <div>
                <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Trainer Notes</label>
                <textarea rows="3" placeholder="Add specific instructions..." class="w-full bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-100 text-xs rounded-xl p-3 focus:outline-none focus:border-lime-500 transition resize-none"></textarea>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-5 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-end gap-3 bg-zinc-50 dark:bg-zinc-950">
            <button type="button" onclick="closeAssignModal()" class="px-5 py-2.5 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold transition cursor-pointer text-xs">
                Cancel
            </button>
            <button type="button" onclick="if(confirm('Ma hubtaa in aad sii wadato meelaynta plan-kan?')) { closeAssignModal(); }" class="px-6 py-2.5 rounded-xl bg-lime-400 hover:bg-lime-500 text-black font-extrabold shadow-lg shadow-lime-500/20 transition cursor-pointer text-xs">
                Assign Plan
            </button>
        </div>

    </div>
</div>

<!-- ==================== CREATE / EDIT WORKOUT PLAN MODAL ==================== -->
<div id="addModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4 overflow-y-auto">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl w-full max-w-3xl overflow-hidden shadow-2xl my-8">
        
        <!-- Modal Header -->
        <div class="flex justify-between items-center p-6 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
            <div>
                <h2 class="text-xl font-black text-zinc-900 dark:text-white">Create Workout Plan</h2>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Select exercises from system library and assign workout routines to members.</p>
            </div>
            <button type="button" onclick="closeAddModal()" class="w-9 h-9 rounded-xl bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-lime-400 hover:text-black transition cursor-pointer">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Modal Body / Form -->
        <div class="p-6 space-y-6 max-h-[75vh] overflow-y-auto text-xs">
            
            <!-- Plan Information Group -->
            <div class="space-y-4">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800 pb-2">Plan Information</h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Plan Name *</label>
                        <input type="text" placeholder="e.g. Advanced Hypertrophy Split" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                    </div>

                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Assign Member</label>
                        <select class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                            <option value="">Select Member...</option>
                            <option value="8801">Ahmed Ali (#MEM-8801)</option>
                            <option value="8802">Mohamed Omar (#MEM-8802)</option>
                            <option value="8803">Fadumo Hassan (#MEM-8803)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Target Goal</label>
                        <select class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                            <option value="muscle">Muscle Building</option>
                            <option value="weightloss">Weight Loss</option>
                            <option value="strength">Strength</option>
                            <option value="endurance">Endurance</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Difficulty Level</label>
                        <select class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                            <option value="beginner">Beginner</option>
                            <option value="intermediate">Intermediate</option>
                            <option value="advanced">Advanced</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Duration (Weeks)</label>
                        <input type="number" value="4" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Days per Week</label>
                        <input type="number" value="4" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                    </div>
                    <div>
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Session Duration (Min)</label>
                        <input type="number" value="60" class="w-full px-3.5 py-2.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500" />
                    </div>
                </div>
            </div>

            <!-- Exercise Selection Section (Dropdown & Add Setup) -->
            <div class="space-y-4 pt-2">
                <div class="border-b border-zinc-100 dark:border-zinc-800 pb-2">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Exercise Selection</h3>
                    <p class="text-[11px] text-zinc-400">Select pre-configured exercises from the system library and add them to your routine.</p>
                </div>

                <!-- Exercise Dropdown & Config Inputs -->
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end bg-zinc-50 dark:bg-zinc-950 p-4 rounded-2xl border border-zinc-200/60 dark:border-zinc-800">
                    <div class="sm:col-span-5">
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1">Select Exercise</label>
                        <select class="w-full px-3 py-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 cursor-pointer">
                            <option value="">Choose exercise from library...</option>
                            <option value="bench">Barbell Bench Press (Chest)</option>
                            <option value="incline">Incline Dumbbell Fly (Upper Chest)</option>
                            <option value="press">Overhead Barbell Press (Shoulders)</option>
                            <option value="squat">Barbell Back Squat (Legs)</option>
                            <option value="deadlift">Conventional Deadlift (Back)</option>
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1">Sets</label>
                        <input type="number" placeholder="4" class="w-full px-3 py-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 text-center" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1">Reps</label>
                        <input type="text" placeholder="10-12" class="w-full px-3 py-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 text-center" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-bold text-zinc-700 dark:text-zinc-300 mb-1">Rest</label>
                        <input type="text" placeholder="90s" class="w-full px-3 py-2 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl font-medium focus:outline-none focus:border-lime-500 text-center" />
                    </div>
                    <div class="sm:col-span-1">
                        <button type="button" title="Add Exercise to List" class="w-full py-2 bg-lime-400 hover:bg-lime-500 text-black font-extrabold rounded-xl transition flex items-center justify-center cursor-pointer shadow-md shadow-lime-500/10">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>

                
            <!-- Routine & Trainer Notes Section (Single Textbox) -->
            <div class="space-y-3 pt-2">
