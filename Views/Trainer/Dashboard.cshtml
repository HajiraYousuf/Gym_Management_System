    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";
}

<!-- Main Dashboard Container -->
<div class="p-4 bg-zinc-100 dark:bg-[#0B0C10] text-zinc-900 dark:text-[#C5C6C7] font-sans min-h-screen transition-colors duration-300">

    <!-- 1. TOP STATS CARDS (4 Columns) -->
    @{ 
        var stats = new[] {
            new { title = "My Members", value = "28", sub = "Total Members", trend = "↑ 12% this month", icon = "users" },
            new { title = "Active Training Plans", value = "18", sub = "Active Plans", trend = "↑ 8% this month", icon = "dumbbell" },
            new { title = "Today's Sessions", value = "6", sub = "Sessions", trend = "Today", icon = "calendar-days" },
            new { title = "Pending Sessions", value = "2", sub = "Sessions", trend = "Pending", icon = "clock" }
        };
    }
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        @foreach(var stat in stats) {
            <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm transition-colors duration-300">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs text-zinc-500 dark:text-gray-400 font-medium">@stat.title</p>
                        <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@stat.value</h3>
                        <p class="text-xs text-zinc-400 dark:text-gray-500 mt-0.5">@stat.sub</p>
                    </div>
                    <div class="p-2 bg-lime-500/10 dark:bg-[#1f2833] text-lime-600 dark:text-[#9dfc03] rounded-lg">
                        <i class="fas fa-@stat.icon text-lg"></i>
                    </div>
                </div>
                <div class="mt-4 text-xs font-semibold @(stat.trend.Contains("↑") ? "text-lime-600 dark:text-[#9dfc03]" : "text-amber-500 dark:text-amber-400")">
                    @stat.trend
                </div>
            </div>
        }
    </div>

    <!-- 2. CHARTS & PROGRESS SECTION (3 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
        <!-- Weekly Attendance -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-4">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Weekly Attendance</h4>
                <select class="bg-zinc-100 dark:bg-[#1f2833] text-xs text-zinc-700 dark:text-gray-400 rounded px-2 py-1 border border-zinc-300 dark:border-none focus:ring-1 focus:ring-lime-500 dark:focus:ring-[#9dfc03] cursor-pointer">
                    <option>This Week</option>
                </select>
            </div>
            <div class="h-40 flex items-center justify-center bg-zinc-50 dark:bg-[#0b0c10]/50 rounded-lg border border-dashed border-zinc-300 dark:border-gray-700 relative">
                <canvas id="attendanceChart"></canvas>
            </div>
        </div>

        <!-- Members Progress (Donut) -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Members Progress</h4>
            <div class="h-40 flex items-center justify-center bg-zinc-50 dark:bg-[#0b0c10]/50 rounded-lg border border-dashed border-zinc-300 dark:border-gray-700 relative">
                <canvas id="progressChart"></canvas>
            </div>
        </div>

        <!-- Sessions Completed -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-center mb-4">
                <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">Sessions Completed</h4>
                <select class="bg-zinc-100 dark:bg-[#1f2833] text-xs text-zinc-700 dark:text-gray-400 rounded px-2 py-1 border border-zinc-300 dark:border-none focus:ring-1 focus:ring-lime-500 dark:focus:ring-[#9dfc03] cursor-pointer">
                    <option>This Week</option>
                </select>
            </div>
            <div class="h-40 flex items-center justify-center bg-zinc-50 dark:bg-[#0b0c10]/50 rounded-lg border border-dashed border-zinc-300 dark:border-gray-700 relative">
                <canvas id="sessionsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 3. TABLES SECTION (Today's Schedule & Assigned Members) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        
        <!-- Today's Schedule -->
        @{ 
            var schedule = new[] {
                new { time = "08:00 AM", member = "Ahmed Hassan", type = "Chest Workout", status = "Completed", bg = "bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20" },
                new { time = "10:00 AM", member = "Fatima Ali", type = "Leg Day", status = "Upcoming", bg = "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20" },
                new { time = "12:00 PM", member = "Omar Farah", type = "Back Workout", status = "Upcoming", bg = "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20" },
                new { time = "04:00 PM", member = "Hassan Yusuf", type = "Shoulder Workout", status = "Upcoming", bg = "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20" },
                new { time = "06:00 PM", member = "Maryan Ahmed", type = "Full Body", status = "Pending", bg = "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" }
            };
        }
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Today's Schedule</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-gray-500 border-b border-zinc-200 dark:border-[#1f2833]">
                            <th class="pb-2 font-medium">Time</th>
                            <th class="pb-2 font-medium">Member</th>
                            <th class="pb-2 font-medium">Workout Type</th>
                            <th class="pb-2 font-medium">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-[#1f2833]/50">
                        @foreach(var session in schedule) {
                            <tr>
                                <td class="py-3 text-zinc-600 dark:text-gray-300">@session.time</td>
                                <td class="py-3 text-zinc-900 dark:text-white font-medium">@session.member</td>
                                <td class="py-3 text-zinc-500 dark:text-gray-400">@session.type</td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded text-[10px] @session.bg">@session.status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Assigned Members -->
        @{ 
            var assigned = new[] {
                new { name = "Ahmed Hassan", tier = "Gold", progress = "75%", visit = "18 May 2025" },
                new { name = "Fatima Ali", tier = "Platinum", progress = "60%", visit = "17 May 2025" },
                new { name = "Omar Farah", tier = "Gold", progress = "80%", visit = "19 May 2025" },
                new { name = "Hassan Yusuf", tier = "Silver", progress = "45%", visit = "16 May 2025" },
                new { name = "Maryan Ahmed", tier = "Gold", progress = "70%", visit = "18 May 2025" }
            };
        }
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Assigned Members</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-gray-500 border-b border-zinc-200 dark:border-[#1f2833]">
                            <th class="pb-2 font-medium">Member</th>
                            <th class="pb-2 font-medium">Membership</th>
                            <th class="pb-2 font-medium">Progress</th>
                            <th class="pb-2 font-medium">Last Visit</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-[#1f2833]/50">
                        @foreach(var member in assigned) {
                            <tr>
                                <td class="py-3 flex items-center space-x-2">
                                    <div class="w-6 h-6 rounded-full bg-zinc-300 dark:bg-gray-600 flex items-center justify-center text-[10px] font-bold text-zinc-800 dark:text-white">
                                        @member.name.Substring(0, 1)
                                    </div>
                                    <span class="text-zinc-900 dark:text-white font-medium">@member.name</span>
                                </td>
                                <td class="py-3 text-zinc-500 dark:text-gray-400">@member.tier</td>
                                <td class="py-3">
                                    <div class="flex items-center space-x-2">
                                        <span class="text-zinc-600 dark:text-gray-300 w-8">@member.progress</span>
                                        <div class="w-16 bg-zinc-200 dark:bg-gray-800 rounded-full h-1.5">
                                            <div class="bg-lime-500 dark:bg-[#9dfc03] h-1.5 rounded-full" style="width: @member.progress"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 text-zinc-500 dark:text-gray-400">@member.visit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 4. BOTTOM SECTION (Recent Activity, Performance, Quick Actions) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        
        <!-- Recent Activity -->
        @{ 
            var activities = new[] {
                new { text = "Ahmed Hassan completed Chest Workout", time = "2 hours ago", icon = "dumbbell", color = "text-lime-600 dark:text-[#9dfc03]" },
                new { text = "Fatima Ali renewed training plan", time = "5 hours ago", icon = "file-contract", color = "text-blue-500 dark:text-blue-400" },
                new { text = "Omar Farah missed today's session", time = "Yesterday", icon = "xmark", color = "text-red-500 dark:text-red-400" },
                new { text = "Maryan Ahmed achieved new PR in Squat", time = "Yesterday", icon = "trophy", color = "text-amber-500 dark:text-amber-400" }
            };
        }
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Recent Activity</h4>
            <div class="space-y-4">
                @foreach(var act in activities) {
                    <div class="flex items-start space-x-3 text-xs">
                        <div class="p-1.5 bg-zinc-100 dark:bg-[#1f2833] rounded @act.color mt-0.5">
                            <i class="fas fa-@act.icon text-xs"></i>
                        </div>
                        <div>
                            <p class="text-zinc-800 dark:text-gray-200 font-medium">@act.text</p>
                            <span class="text-[10px] text-zinc-400 dark:text-gray-500">@act.time</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Performance Overview -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Performance Overview</h4>
            <div class="grid grid-cols-2 gap-2 mb-3">
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-500 block">Total Sessions</span>
                    <strong class="text-lg text-zinc-900 dark:text-white font-bold">124</strong>
                </div>
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-400 block">Completed</span>
                    <strong class="text-lg text-green-600 dark:text-green-400 font-bold">102</strong>
                </div>
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-500 block">Cancelled</span>
                    <strong class="text-lg text-red-500 dark:text-red-400 font-bold">12</strong>
                </div>
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-400 block">Success Rate</span>
                    <strong class="text-lg text-lime-600 dark:text-[#9dfc03] font-bold">82%</strong>
                </div>
            </div>
            <div class="h-6 w-full opacity-40 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-lime-500/20 dark:from-[#9dfc03]/20 via-transparent to-transparent"></div>
        </div>

        <!-- Quick Actions -->
        @{ 
            var actions = new[] {
                new { title = "Add Workout Plan", icon = "calendar-plus" },
                new { title = "Mark Attendance", icon = "clipboard-user" },
                new { title = "Update Progress", icon = "chart-line" },
                new { title = "View All Members", icon = "users-gear" }
            };
        }
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm transition-colors duration-300">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Quick Actions</h4>
            <div class="space-y-2">
                @foreach(var action in actions) {
                    <button class="w-full flex items-center justify-between bg-zinc-50 dark:bg-[#0b0c10]/80 border border-zinc-200 dark:border-[#1f2833] hover:border-lime-500/50 dark:hover:border-[#9dfc03]/50 transition-colors rounded-lg px-3 py-2.5 text-xs text-left group cursor-pointer">
                        <div class="flex items-center space-x-3 text-zinc-700 dark:text-gray-300 group-hover:text-zinc-900 dark:group-hover:text-white">
                            <i class="fas fa-@action.icon text-lime-600 dark:text-[#9dfc03]"></i>
                            <span class="font-medium">@action.title</span>
                        </div>
                        <i class="fas fa-chevron-right text-zinc-400 dark:text-gray-600 text-[10px] group-hover:text-lime-600 dark:group-hover:text-[#9dfc03]"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Load Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isDarkMode = () => document.documentElement.classList.contains('dark');
        const getTextColor = () => isDarkMode() ? '#888' : '#71717a';
        const getGridColor = () => isDarkMode() ? '#1f2833' : 'rgba(228, 228, 231, 0.8)';

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 10 } } },
                y: { grid: { display:false }, ticks: { color: getTextColor(), font: { size: 10 } } }
            }
        };

        // 1. Weekly Attendance (Line Chart)
        new Chart(document.getElementById('attendanceChart'), {
            type: 'line',
            data: {
                labels: ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
                datasets: [{
                    data: [12, 19, 15, 25, 22, 30, 18],
                    borderColor: isDarkMode() ? '#9dfc03' : '#65a30d',
                    backgroundColor: isDarkMode() ? 'rgba(157, 252, 3, 0.1)' : 'rgba(101, 163, 13, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 2
                }]
            },
            options: chartOptions
        });

        // 2. Members Progress (Donut Chart)
        new Chart(document.getElementById('progressChart'), {
            type: 'doughnut',
            data: {
                labels: ['On Track', 'Slow', 'Needs Focus'],
                datasets: [{
                    data: [65, 20, 15],
                    backgroundColor: isDarkMode() ? ['#9dfc03', '#4ade80', '#15803d'] : ['#65a30d', '#4ade80', '#16a34a'],
                    borderWidth: 0,
                    weight: 0.5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: true, position: 'right', labels: { color: isDarkMode() ? '#c5c6c7' : '#3f3f46', font: { size: 10 } } } },
                cutout: '70%'
            }
        });

        // 3. Sessions Completed (Bar Chart)
        new Chart(document.getElementById('sessionsChart'), {
            type: 'bar',
            data: {
                labels: ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
                datasets: [{
                    data: [5, 6, 4, 7, 5, 8, 3],
                    backgroundColor: '#65A30D',
                    borderRadius: 4
                }]
            },
            options: chartOptions
        });
    });
</script>