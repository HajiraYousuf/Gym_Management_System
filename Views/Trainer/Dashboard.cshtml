@model IEnumerable<GymManagementSystem.Models.ClassSchedule>

@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/layouts/TrainerMaster.cshtml";

    var schedulesList = Model?.ToList() ?? new List<GymManagementSystem.Models.ClassSchedule>();
    int totalSessions = schedulesList.Count;
    int completedCount = schedulesList.Count(s => s.Status == "Completed");
    int pendingCount = schedulesList.Count(s => s.Status == "Scheduled" || s.Status == "Pending");
    double successRate = totalSessions > 0 ? Math.Round((double)completedCount / totalSessions * 100, 0) : 0;
}

<!-- Main Dashboard Container -->
<div class="p-4 bg-zinc-100 dark:bg-[#0B0C10] text-zinc-900 dark:text-[#C5C6C7] font-sans min-h-screen transition-colors duration-300">

    <!-- 1. TOP STATS CARDS (4 Columns) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        
        <!-- My Members / Total Capacity -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-gray-400 font-medium">Total Capacity</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@schedulesList.Sum(s => s.Capacity)</h3>
                    <p class="text-xs text-zinc-400 dark:text-gray-500 mt-0.5">Active Slots</p>
                </div>
                <div class="p-2 bg-lime-500/10 dark:bg-[#1f2833] text-lime-600 dark:text-[#9dfc03] rounded-lg">
                    <i class="fas fa-users text-lg"></i>
                </div>
            </div>
            <div class="mt-4 text-xs font-semibold text-lime-600 dark:text-[#9dfc03]">
                ↑ Dynamic Data
            </div>
        </div>

        <!-- Active Training Plans / Total Classes -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-gray-400 font-medium">Assigned Classes</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@totalSessions</h3>
                    <p class="text-xs text-zinc-400 dark:text-gray-500 mt-0.5">Total Schedules</p>
                </div>
                <div class="p-2 bg-lime-500/10 dark:bg-[#1f2833] text-lime-600 dark:text-[#9dfc03] rounded-lg">
                    <i class="fas fa-dumbbell text-lg"></i>
                </div>
            </div>
            <div class="mt-4 text-xs font-semibold text-lime-600 dark:text-[#9dfc03]">
                Database Synced
            </div>
        </div>

        <!-- Today's Sessions / Completed -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-gray-400 font-medium">Completed Sessions</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@completedCount</h3>
                    <p class="text-xs text-zinc-400 dark:text-gray-500 mt-0.5">Finished</p>
                </div>
                <div class="p-2 bg-lime-500/10 dark:bg-[#1f2833] text-lime-600 dark:text-[#9dfc03] rounded-lg">
                    <i class="fas fa-calendar-days text-lg"></i>
                </div>
            </div>
            <div class="mt-4 text-xs font-semibold text-lime-600 dark:text-[#9dfc03]">
                Finished
            </div>
        </div>

        <!-- Pending Sessions -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm transition-colors duration-300">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs text-zinc-500 dark:text-gray-400 font-medium">Pending Sessions</p>
                    <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mt-1">@pendingCount</h3>
                    <p class="text-xs text-zinc-400 dark:text-gray-500 mt-0.5">Scheduled</p>
                </div>
                <div class="p-2 bg-lime-500/10 dark:bg-[#1f2833] text-lime-600 dark:text-[#9dfc03] rounded-lg">
                    <i class="fas fa-clock text-lg"></i>
                </div>
            </div>
            <div class="mt-4 text-xs font-semibold text-amber-500 dark:text-amber-400">
                Pending
            </div>
        </div>

    </div>

    <!-- 2. CHARTS SECTION -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Weekly Attendance</h4>
            <div class="h-40 flex items-center justify-center bg-zinc-50 dark:bg-[#0b0c10]/50 rounded-lg border border-dashed border-zinc-300 dark:border-gray-700 relative">
                <canvas id="attendanceChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Members Progress</h4>
            <div class="h-40 flex items-center justify-center bg-zinc-50 dark:bg-[#0b0c10]/50 rounded-lg border border-dashed border-zinc-300 dark:border-gray-700 relative">
                <canvas id="progressChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Sessions Completed</h4>
            <div class="h-40 flex items-center justify-center bg-zinc-50 dark:bg-[#0b0c10]/50 rounded-lg border border-dashed border-zinc-300 dark:border-gray-700 relative">
                <canvas id="sessionsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 3. TABLES SECTION (Today's Schedule from Database) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        
        <!-- Today's Schedule -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 shadow-sm">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">MY Schedules</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-zinc-500 dark:text-gray-500 border-b border-zinc-200 dark:border-[#1f2833]">
                            <th class="pb-2 font-medium">Date & Time</th>
                            <th class="pb-2 font-medium">Class Name</th>
                            <th class="pb-2 font-medium">Location</th>
                            <th class="pb-2 font-medium">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-[#1f2833]/50">
                        @if (schedulesList.Any())
                        {
                            foreach (var item in schedulesList.Take(5))
                            {
                                <tr>
                                    <td class="py-3 text-zinc-600 dark:text-gray-300">@item.Date.ToString("yyyy-MM-dd") @item.StartTime</td>
                                    <td class="py-3 text-zinc-900 dark:text-white font-medium">@item.ClassName</td>
                                    <td class="py-3 text-zinc-500 dark:text-gray-400">@item.Location</td>
                                    <td class="py-3">
                                        <span class="px-2 py-0.5 rounded text-[10px] @(item.Status == "Completed" ? "bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20" : "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20")">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-zinc-400">No schedules found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Performance Overview Card -->
        <div class="bg-white dark:bg-[#1f2833]/40 border border-zinc-200 dark:border-[#1f2833] rounded-xl p-4 flex flex-col justify-between shadow-sm">
            <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-3">Performance Overview</h4>
            <div class="grid grid-cols-2 gap-2 mb-3">
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-500 block">Total Sessions</span>
                    <strong class="text-lg text-zinc-900 dark:text-white font-bold">@totalSessions</strong>
                </div>
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-400 block">Completed</span>
                    <strong class="text-lg text-green-600 dark:text-green-400 font-bold">@completedCount</strong>
                </div>
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-500 block">Pending</span>
                    <strong class="text-lg text-amber-500 dark:text-amber-400 font-bold">@pendingCount</strong>
                </div>
                <div class="bg-zinc-50 dark:bg-[#0b0c10]/60 p-3 rounded-lg border border-zinc-200 dark:border-[#1f2833] text-center">
                    <span class="text-[10px] text-zinc-400 dark:text-gray-400 block">Success Rate</span>
                    <strong class="text-lg text-lime-600 dark:text-[#9dfc03] font-bold">@successRate%</strong>
                </div>
            </div>
            <div class="h-6 w-full opacity-40 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-lime-500/20 dark:from-[#9dfc03]/20 via-transparent to-transparent"></div>
        </div>

    </div>
</div>
<!-- Load Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isDarkMode = () => document.documentElement.classList.contains('dark');
        const getTextColor = () => isDarkMode() ? '#888' : '#71717a';

        // Xogta dynamic-ka ah ee ka timid Controller-ka (C# ViewBag)
        const weeklyAttendance = @Html.Raw(ViewBag.AttendanceJson ?? "[12, 19, 15, 25, 22, 30, 18]");
        const memberProgress = @Html.Raw(ViewBag.ProgressJson ?? "[65, 20, 15]");
        const completedSessions = @Html.Raw(ViewBag.SessionsJson ?? "[5, 6, 4, 7, 5, 8, 3]");

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 10 } } },
                y: { grid: { display: false }, ticks: { color: getTextColor(), font: { size: 10 } } }
            }
        };

        // 1. Weekly Attendance (Line Chart)
        new Chart(document.getElementById('attendanceChart'), {
            type: 'line',
            data: {
                labels: ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
                datasets: [{
                    data: weeklyAttendance,
                    borderColor: isDarkMode() ? '#9dfc03' : '#65a30d',
                    backgroundColor: isDarkMode() ? 'rgba(157, 252, 3, 0.1)' : 'rgba(101, 163, 13, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 2
                }]
            },
            options: chartOptions
        });

        // 2. Members Progress (Donut Chart)
        new Chart(document.getElementById('progressChart'), {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'Other'],
                datasets: [{
                    data: memberProgress,
                    backgroundColor: isDarkMode() ? ['#9dfc03', '#4ade80', '#15803d'] : ['#65a30d', '#4ade80', '#16a34a'],
                    borderWidth: 0,
                    weight: 0.5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: true, position: 'right', labels: { color: isDarkMode() ? '#c5c6c7' : '#3f3f46', font: { size: 10 } } } },
                cutout: '70%'
            }
        });

        // 3. Sessions Completed (Bar Chart)
        new Chart(document.getElementById('sessionsChart'), {
            type: 'bar',
            data: {
                labels: ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
                datasets: [{
                    data: completedSessions,
                    backgroundColor: '#65A30D',
                    borderRadius: 4
                }]
            },
            options: chartOptions
        });
    });
</script>